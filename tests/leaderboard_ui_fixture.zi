// A private renderer fixture using the production Profile bundle/lifecycle.
App :: #import "desktop";
Desktop :: #import "kryon/Desktop";
#import "native_host"
#import "leaderboard_model"
#import "model"
#import "std/c_string"
#import "std/byte_text_linux"
#import "std/bundle_host"
#import "kryon/hosted_values"
#import "kryon/app_context_host"
#import "kryon/session"
#import "kryon/key_input"
#import "kryon/tree"
#import "kryon/tree_input"
#import "kryon/tree_draw"

page: ProfileLeaderboard;
answer: string;
FixtureServices :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(function) != "AppServiceHost" || count != 2 || AppArgumentText(arguments[0]) != LEADERBOARD_SERVICE {
        return EntityHostServices(context, module, function, arguments, count, result)
    }
    EntityFree(answer)
    answer = ProfileLeaderboardEncode(*page)
    result.* = EntityHostText(answer)
    return 1
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 2 || !App.OpenEntity(TextFromCString(argv[1])) { return 1 }
    unused CopyCString("fixture", page.owner[:])
    page.board_count = 2
    for index: cast(s32)0..1 {
        board := *page.boards[index]
        unused CopyCString("arcade", board.app[:])
        unused CopyCString("Arcade", board.app_title[:])
        unused CopyCString(ifx index == 0 then "arcade.shovey" else "arcade.shovey-island", board.id[:])
        unused CopyCString(ifx index == 0 then "Shovey" else "Island", board.title[:])
        unused CopyCString("Levels", board.primary[:])
        unused CopyCString("Average", board.average[:])
    }
    page.row_count = 2
    unused CopyCString("@river", page.rows[0].name[:])
    unused CopyCString("12", page.rows[0].value[:])
    unused CopyCString("1234.56", page.rows[0].average[:])
    unused CopyCString("@you", page.rows[1].name[:])
    unused CopyCString("4", page.rows[1].value[:])
    unused CopyCString("42", page.rows[1].average[:])
    page.rows[1].own = true
    portable.services = FixtureServices
    if !Desktop.OpenDesktopSized(480, 800) { return 1 }
    defer Desktop.CloseDesktop()
    session := SessionOpen()
    if !SessionValid(session) { return 1 }
    defer CloseSession(session)
    while Desktop.PollDesktop() {
        KeyboardModifiersSend(session, Desktop.DesktopModifiers())
        key := Desktop.DesktopPressedKey()
        if key != 0 { KeyboardSend(session, key) }
        point := Desktop.DesktopTypedCodepoint()
        while point != 0 {
            TypedCodepointSend(session, point)
            point = Desktop.DesktopTypedCodepoint()
        }
        if !App.Draw(session) { return 1 }
        Desktop.PauseDesktop()
    }
    return 0
}
