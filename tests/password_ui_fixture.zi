// No window, real data, clipboard or network: exercise the production bundle
// through the host codec and inspect only selection offsets and edit lengths.
Desktop :: #import "kryon/Desktop";
#import "kryon/text_input_props"
#import "native_host"
#import "native_files"
#import "management"
#import "model"
#import "std/file"
#import "std/byte_text_linux"
#import "kryon/geometry"
#import "std/c_string"
#import "std/bundle_host"
#import "kryon/app_context_host"
#import "kryon/hosted_values"
#import "kryon/widget_codec"
#import "kryon/widget_host"
#import "kryon/session"
#import "kryon/tree"
#import "kryon/tree_input"
#import "kryon/tree_draw"
#import "kryon/key_input"

activate: s32;
observed: TextFieldResult;
seen: bool;
management_text: string;
Services :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    name := TextFromCString(function)
    if name == "AppServiceHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.management" {
        result.* = EntityHostText(management_text); return 1
    }
    if name == "WriteStoreHost" || name == "ClipboardCopyHost" {
        result.* = HostScalar("bool", 1); return 1
    }
    return EntityHostServices(context, module, function, arguments, count, result)
}
Widgets :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    called := WidgetHostCall(context, module, function, arguments, count, result)
    name := TextFromCString(function)
    if called != 0 && name == "ButtonHostedHost" && count == 2 {
        button := WidgetDecodeButtonProps(arguments[1], *widget_button_codec)
        if activate != 0 && button.id == activate {
            result.* = HostScalar("s32", activate); activate = 0
        }
    }
    if called != 0 && name == "TextFieldHostedHost" && count == 2 {
        props := WidgetDecodeTextFieldProps(arguments[1], *widget_field_codec)
        if props.key == 104 {
            observed = WidgetDecodeTextFieldResult(result.*, *widget_field_result_codec)
            seen = true
        }
    }
    return called
}
Frame :: (session: Session, key: s32 = 0, modifiers: s32 = 0, text: string = "") -> bool {
    bounds: Rectangle = .{0.0, 0.0, 480.0, 1000.0}
    seen = false
    Desktop.BeginDesktopFrame()
    unused BeginFrame(session, 1, bounds)
    ok := EntityHostFrame(session, bounds, key, modifiers, TextFieldInputFor(key, modifiers, text))
    return EndFrame(session) == FrameStatus.FrameOk && Desktop.EndDesktopFrame() && ok
}
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    bytes, found := ReadEntireFile("build/entity.zx")
    if !found || !EntityHostOpen(bytes, NativeEnvironment("ENTITY_LEADERBOARD_TEST_DATA"), "entity", true) { return 1 }
    snapshot := Management.{.available = true, .account = true, .capabilities = ACCOUNT_BACKUP}
    unused CopyCString("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", snapshot.public_id[:])
    management_text = ManagementEncode(snapshot)
    portable.services = Services; portable.widgets = Widgets
    session := SessionOpen()
    if !Desktop.OpenDesktopSized(480, 1000) { return 20 }
    defer { Desktop.CloseDesktop(); CloseSession(session); EntityFree(management_text) }
    activate = 823
    if !Frame(session) || !Frame(session) || !seen { return 2 }
    node: s32 = -1
    index: s32 = 0
    while index < TreeCount(session) {
        if TreeNodeAt(session, index).key == 104 { node = index }
        index += 1
    }
    if node < 0 || !TreeFocusAt(session, node) || !Frame(session) { return 3 }
    if !Frame(session, 0, 0, "abcdefg1") || !observed.edit.changed || observed.cursor != 8 { return 4 }
    if argc > 1 { return PhysicalKeys(session) }
    if !Frame(session, 65, KeyModifierControl, "a") || observed.anchor != 0 ||
    observed.cursor != 8 || observed.edit.changed { return 5 }
    if !Frame(session, 0, 0, "replacement1") || !observed.edit.changed ||
    observed.edit.start != 0 || observed.edit.end != 8 { return 6 }
    if !Frame(session, 65, KeyModifierControl) || observed.cursor != 12 || observed.anchor != 0 { return 7 }
    if !Frame(session, KeyBackspace) || !observed.edit.changed || observed.edit.start != 0 || observed.edit.end != 12 { return 8 }
    if !Frame(session) || observed.cursor != 0 || observed.anchor != 0 { return 9 }
    print("Hosted password selection, replacement and deletion passed\n")
    return 0
}

// This path runs only inside the test's private Xvfb. The production Desktop
// adapter gathers actual SDL events; the same hosted Profile consumes them.
PhysicalKeys :: (session: Session) -> s32 {
    stage: s32 = 0
    while Desktop.PollDesktop() {
        key := Desktop.DesktopPressedKey()
        modifiers := Desktop.DesktopModifiers()
        typed: [64]u8
        length: s32 = 0
        point := Desktop.DesktopTypedCodepoint()
        while point != 0 {
            length = TypedTextAppend(typed[:], length, point)
            point = Desktop.DesktopTypedCodepoint()
        }
        if !Frame(session, key, modifiers, TextView(typed[:length])) { return 21 }
        if key == 65 && (modifiers & KeyModifierControl) != 0 {
            expected := ifx stage == 0 then 8 else 1
            if observed.cursor != expected || observed.anchor != 0 || observed.edit.changed { return 22 }
            stage += 1
        } else if length > 0 {
            if stage != 1 || !observed.edit.changed || observed.edit.start != 0 || observed.edit.end != 8 { return 23 }
            stage += 1
        } else if key == KeyBackspace {
            if stage != 3 || !observed.edit.changed || observed.edit.start != 0 || observed.edit.end != 1 { return 24 }
            print("Private Desktop password Ctrl+A input passed\n")
            return 0
        }
        Desktop.PauseDesktop()
    }
    return 25
}
