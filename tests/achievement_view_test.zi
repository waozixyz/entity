#import "achievement_view"
#import "achievement_toast"
#import "std/c_string"
#import "std/text_buffer"

ValidPage :: #string JSON
{"version":1,"owner":"profile-a","page":0,"pages":1,"total":2,"earned":1,"alerts":0,"rows":[{"group":"Diary","title":"First page","description":"Save a nonempty diary day.","progress":"1 / 1","date":"Earlier activity","earned":1},{"group":"Diary","title":"Seven pages","description":"Save seven diary days.","progress":"1 / 7","date":"","earned":0}]}
JSON

FilteredPage :: #string JSON
{"version":1,"owner":"profile-a","page":0,"pages":1,"total":1,"earned":1,"alerts":1,"app":"inbe.diary","apps":[{"id":"inbe.diary","title":"Diary"}],"rows":[{"group":"Diary","title":"First page","description":"Save a diary day.","progress":"1 / 1","date":"2026-10-20","earned":1,"icon":"S1.5rr:M4 4H20V20H4Z"}]}
JSON

#program_export
Answer :: () -> s32 {
    page: AchievementPage
    if !AchievementPageDecode(ValidPage, *page) { return 1 }
    if page.count != 2 || page.total != 2 || page.earned != 1 || page.alerts { return 2 }
    if !page.rows[0].earned || page.rows[1].earned { return 3 }
    if AchievementPageDecode("{}", *page) { return 4 }
    if AchievementPageDecode("{\"version\":1,\"owner\":\"a\",\"page\":1,\"pages\":1,\"total\":0,\"earned\":0,\"alerts\":1,\"rows\":[]}", *page) { return 5 }
    if AchievementPageDecode("{\"version\":1,\"owner\":\"a\",\"page\":0,\"pages\":1,\"total\":0,\"earned\":1,\"alerts\":1,\"rows\":[]}", *page) { return 6 }
    if AchievementPageDecode("{\"version\":1,\"owner\":\"a\",\"page\":0,\"pages\":1,\"total\":0,\"earned\":0,\"alerts\":2,\"rows\":[]}", *page) { return 7 }
    if AchievementPageDecode("{\"version\":1,\"owner\":\"a\",\"page\":0,\"pages\":1,\"total\":1,\"earned\":0,\"alerts\":1,\"rows\":[{\"title\":\"Missing fields\"}]}", *page) { return 8 }
    if !AchievementPageDecode("{\"version\":1,\"owner\":\"a\",\"page\":0,\"pages\":1,\"total\":0,\"earned\":0,\"alerts\":1,\"rows\":[]}", *page) { return 9 }
    if !AchievementPageDecode(FilteredPage, *page) { return 10 }
    if page.app_count != 1 || page.rows[0].icon[0] != #char "S" { return 11 }
    if TextUntilNul(page.app[:]) != "inbe.diary" || TextUntilNul(page.apps[0].title[:]) != "Diary" { return 12 }
    toast: AchievementToast
    AchievementToastShow(*toast, "Achievement unlocked", "", "S1.5rr:M4 4H20V20H4Z", 1.0)
    if toast.active { return 13 }
    AchievementToastShow(*toast, "Achievement unlocked", "First page", "S1.5rr:M4 4H20V20H4Z", 2.0)
    if !toast.active || TextUntilNul(toast.title[:]) != "First page" || toast.icon[0] != #char "S" || toast.shown_at != 2.0 { return 14 }
    AchievementToastClose(*toast)
    if toast.active { return 15 }
    return 42
}

#program_export
main :: () -> s32 {
    result := Answer()
    return ifx result == 42 then 0 else result
}
