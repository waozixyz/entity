#import, file "../src/game_shop.zi";
#import "std/vec"
#import "std/text_buffer"

Receipt :: (product: s32, owner: string, amount: s64, reference: string = "", app: string = "entity") -> string {
    out: Vec(u8)
    BuilderPrint(*out, "{\"account_id\":\"%\",\"app_id\":\"%\",\"asset_id\":\"waozi:token\",\"event_type\":\"debit\",\"source_type\":\"%\",\"source_ref\":\"%\",\"amount_delta\":%}", owner, app, ifx product == SHOVEY_ISLAND_PRODUCT then "unlock" else "spend", ifx reference == "" then GameShopReference(product) else reference, amount)
    return BuilderFinish(out)
}
#program_export
main :: () -> s32 {
    owner := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    other := "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
    for product: GAME_SHOP_PRODUCTS {
        p := cast(s32)product
        text := Receipt(p, owner, -GameShopPrice(p))
        if GameShopReceipt(text, owner) != p { return 1 }
        if GameShopReceipt(Receipt(p, owner, -GameShopPrice(p), "", GameShopTitle(p)), owner) != p { return 51 }
        if GameShopReceipt(Receipt(p, owner, -GameShopPrice(p), "", "other-title"), owner) != 0 { return 52 }
        if GameShopReceipt(text, other) != 0 { return 2 }
        if GameShopReceipt(Receipt(p, owner, -1), owner) != 0 { return 3 }
        if GameShopReceipt(Receipt(p, owner, GameShopPrice(p)), owner) != 0 { return 4 }
        if GameShopKey(p) == "" || GameShopKey(p) != GameShopKey(p) { return 5 }
        if p <= 3 && GameShopReceipt(Receipt(p, owner, -GameShopPrice(p) / 10, GameShopLegacyReference(p)), owner) != p { return 8 }
    }
    // Island edition is distinct from cosmetics; both settled historical prices restore.
    if GameShopReceipt(Receipt(15, owner, -SHOVEY_ISLAND_SALE_UNITS), owner) != 15 ||
    GameShopReceipt(Receipt(15, owner, -SHOVEY_ISLAND_SALE_UNITS + 1), owner) != 0 ||
    GameShopShoveyOwned(1 << 15) != 0 { return 31 }
    if GameShopPrice(0) != 0 || GameShopPrice(4) != 0 || GameShopReceipt("{}", owner) != 0 { return 6 }
    if GameShopPrice(7) != 50000000 || GameShopKey(7) == GameShopKey(3) { return 9 }
    if ChristmasClaimWindow(1796083199) || !ChristmasClaimWindow(1796083200) ||
    !ChristmasClaimWindow(1798761599) || ChristmasClaimWindow(1798761600) { return 10 }
    if GameShopKey(1) == GameShopKey(2) || GameShopKey(1) == GameShopKey(3) || GameShopKey(2) == GameShopKey(3) { return 7 }
    // Choano decorations: fixed names, prices and references that never change.
    if GameShopProduct(10) != "choano.pearl" || GameShopKey(10) != "decoration-choano-pearl-v1" || GameShopPrice(10) != 10000000 ||
    GameShopProduct(11) != "choano.flower" || GameShopKey(11) != "decoration-choano-flower-v1" || GameShopPrice(11) != 20000000 ||
    GameShopProduct(12) != "choano.wizard" || GameShopKey(12) != "decoration-choano-wizard-v1" || GameShopPrice(12) != 30000000 { return 16 }
    if GameShopReference(10) != "choano.pearl:decoration-choano-pearl-v1" || GameShopReference(11) != "choano.flower:decoration-choano-flower-v1" ||
    GameShopReference(12) != "choano.wizard:decoration-choano-wizard-v1" { return 17 }
    // A decoration's receipt must carry its own price, not another product's.
    if GameShopReceipt(Receipt(10, owner, -GameShopPrice(11)), owner) != 0 || GameShopReceipt(Receipt(12, owner, -GameShopPrice(10)), owner) != 0 ||
    GameShopReceipt(Receipt(10, owner, -GameShopPrice(10) / 10), owner) != 0 { return 19 }
    if GameShopReceipt(Receipt(1, owner, -10000000, "choano.pearl:decoration-choano-pearl-v2"), owner) != 0 { return 20 }
    // Wurm's reply stays within the bits it accepts, whatever else the account owns.
    if GameShopWurmOwned(910 | 7168 | 24576) != 910 || GameShopDecorations(910 | 7168 | 24576) != 7168 ||
    GameShopDecorations(910) != 0 || GameShopDecorations(24576) != 0 || GameShopWurmOwned(7168 | 24576) != 0 { return 21 }
    if GameShopShoveyOwned(910 | 7168 | 24576) != 24576 || GameShopShoveyOwned(910 | 7168) != 0 { return 22 }
    // Shovey skins use stable Dew-priced receipts, exactly like the older games.
    if GameShopProduct(13) != "shovey.night" || GameShopKey(13) != "skin-shovey-night-v1" || GameShopPrice(13) != 10000000 ||
    GameShopReference(13) != "shovey.night:skin-shovey-night-v1" ||
    GameShopProduct(14) != "shovey.crystal" || GameShopKey(14) != "skin-shovey-crystal-v1" || GameShopPrice(14) != 30000000 ||
    GameShopReference(14) != "shovey.crystal:skin-shovey-crystal-v1" { return 23 }
    // Coin packs: each pack number is one key; the receipt's price names the coins.
    key: [64]u8
    other_key: [64]u8
    if CoinPackPrice(1) != 2000000 || CoinPackPrice(2) != 5000000 || CoinPackPrice(3) != 10000000 ||
    CoinPackCoins(1) != 150 || CoinPackCoins(2) != 400 || CoinPackCoins(3) != 900 { return 29 }
    if CoinPackKey(2, 5, key[:]) != "coins-wurm-2-5-v1" || CoinPackKey(2, 6, other_key[:]) == CoinPackKey(2, 5, key[:]) { return 11 }
    for pack: cast(s32)1..COIN_PACKS {
        ref: Vec(u8)
        BuilderPrint(*ref, "%:%", COIN_PACK_ACTION, CoinPackKey(pack, 3, key[:]))
        reference := BuilderFinish(ref)
        if CoinPackReceipt(Receipt(1, owner, -CoinPackPrice(pack), reference), owner) != CoinPackCoins(pack) { return 12 }
        if CoinPackReceipt(Receipt(1, owner, -CoinPackPrice(pack), reference, "wurm"), owner) != CoinPackCoins(pack) ||
        CoinPackReceipt(Receipt(1, owner, -CoinPackPrice(pack), reference, "shovey"), owner) != 0 { return 53 }
        if CoinPackReceipt(Receipt(1, other, -CoinPackPrice(pack), reference), owner) != 0 { return 13 }
        if CoinPackReceipt(Receipt(1, owner, -CoinPackPrice(pack) + 1, reference), owner) != 0 { return 14 }
    }
    if CoinPackReceipt(Receipt(1, owner, -GameShopPrice(1)), owner) != 0 || GameShopReceipt(Receipt(1, owner, -CoinPackPrice(1), "wurm.coins:coins-wurm-1-1-v1"), owner) != 0 { return 15 }
    // Shovey's packs are a separate receipt namespace from Wurm's.
    shovey_key: [64]u8
    if ShoveyCoinPackPrice(1) != 2000000 || ShoveyCoinPackPrice(2) != 5000000 || ShoveyCoinPackPrice(3) != 10000000 ||
    ShoveyCoinPackCoins(1) != 150 || ShoveyCoinPackCoins(2) != 400 || ShoveyCoinPackCoins(3) != 900 { return 30 }
    if ShoveyCoinPackKey(3, 4, shovey_key[:]) != "coins-shovey-3-4-v1" { return 24 }
    for pack: cast(s32)1..SHOVEY_COIN_PACKS {
        ref: Vec(u8)
        BuilderPrint(*ref, "%:%", SHOVEY_COIN_PACK_ACTION, ShoveyCoinPackKey(pack, 3, shovey_key[:]))
        reference := BuilderFinish(ref)
        if ShoveyCoinPackReceipt(Receipt(14, owner, -ShoveyCoinPackPrice(pack), reference), owner) != ShoveyCoinPackCoins(pack) { return 25 }
        if ShoveyCoinPackReceipt(Receipt(14, owner, -ShoveyCoinPackPrice(pack), reference, "shovey"), owner) != ShoveyCoinPackCoins(pack) ||
        ShoveyCoinPackReceipt(Receipt(14, owner, -ShoveyCoinPackPrice(pack), reference, "wurm"), owner) != 0 { return 59 }
        if ShoveyCoinPackReceipt(Receipt(14, other, -ShoveyCoinPackPrice(pack), reference), owner) != 0 { return 26 }
        if ShoveyCoinPackReceipt(Receipt(14, owner, -ShoveyCoinPackPrice(pack) + 1, reference), owner) != 0 { return 27 }
    }
    wurm_reference: Vec(u8)
    BuilderPrint(*wurm_reference, "%:%", COIN_PACK_ACTION, CoinPackKey(1, 2, key[:]))
    wurm_ref := BuilderFinish(wurm_reference)
    shovey_reference: Vec(u8)
    BuilderPrint(*shovey_reference, "%:%", SHOVEY_COIN_PACK_ACTION, ShoveyCoinPackKey(1, 2, other_key[:]))
    shovey_ref := BuilderFinish(shovey_reference)
    if CoinPackReceipt(Receipt(1, owner, -ShoveyCoinPackPrice(1), shovey_ref), owner) != 0 ||
    ShoveyCoinPackReceipt(Receipt(14, owner, -CoinPackPrice(1), wurm_ref), owner) != 0 ||
    CoinPackReceipt(Receipt(1, owner, -CoinPackPrice(1), wurm_ref), owner) == 0 ||
    ShoveyCoinPackReceipt(Receipt(14, owner, -ShoveyCoinPackPrice(1), shovey_ref), owner) == 0 { return 28 }
    print("Game shop local tests: exact paid receipt, account isolation, amount validation, stable purchase keys, game masks and coin packs.\n")
    if GameShopPackSuffix("wurm.coins:coins-wurm-1-0-v1", "wurm.coins:coins-wurm-1-") ||
    GameShopPackSuffix("wurm.coins:coins-wurm-1-1-v1evil", "wurm.coins:coins-wurm-1-") ||
    !GameShopPackSuffix("wurm.coins:coins-wurm-1-12-v1", "wurm.coins:coins-wurm-1-") { return 58 }
    // Replay title and legacy receipts across a full first page atomically.
    restore: GameShopRestore
    page: Vec(u8)
    BuilderPrint(*page, "{\"events\":[")
    for i: cast(s32)1..100 {
        if i > 1 { BuilderPrint(*page, ",") }
        BuilderPrint(*page, "{\"ledger_seq\":%,\"account_id\":\"%\",\"app_id\":\"wurm\",\"asset_id\":\"waozi:token\",\"event_type\":\"debit\",\"source_type\":\"spend\",\"source_ref\":\"wurm.coins:coins-wurm-1-%-v1\",\"amount_delta\":-2000000}", i, owner, i)
    }
    BuilderPrint(*page, "]}")
    if GameShopRestorePage(TextView(VecSlice(page, 0, page.count)), owner, *restore) != 1 || restore.cursor != 100 || restore.coins != 15000 || restore.packs != 100 { return 54 }
    VecFree(page)
    if GameShopRestorePage("{\"events\":[{\"ledger_seq\":100}]}", owner, *restore) != -1 || restore.coins != 15000 { return 55 }
    if GameShopRestorePage("{\"events\":[{\"ledger_seq\":101}]}", owner, *restore) != 0 || restore.cursor != 101 { return 56 }
    if GameShopRestorePage("{\"events\":[]}", owner, *restore) != 0 || restore.coins != 15000 { return 57 }
    return 0
}
