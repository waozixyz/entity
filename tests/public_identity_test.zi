// The production profile bundle with a private account and retained UI host.
#import "model"
#import "management"
#import "kryon/app_context_host"
#import "kryon/app_protocol"
#import "kryon/hosted_values"
#import "kryon/hosted_app"
#import "kryon/widget_host"
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/tree"
#import "kryon/tree_draw"
#import "kryon/tree_input"
#import "kryon/pixmap"
#import "std/bundle_host"
#import "std/byte_text_linux"
#import "std/c_string"
#import "std/text_buffer"
#import "std/file"

identity :: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
app: AppContext;
document: string;
snapshot: string;
clipboard: [65]u8;
pointer: PointerFrame;
failures: s32;
dew_enabled: bool;
dew_snapshot: string;

Allows :: (context: *void, name: string) -> bool {
    return (dew_enabled && name == "entity.dew") || name == "ReadStoreHost" || name == "WriteStoreHost" ||
    name == "AppServiceHost" || name == "AppLocaleHost" || name == "ClipboardCopyHost" || name == "entity.management";
}
Answer :: (text: string) -> HostValue {
    return HostValue.{.kind = cast(s32)HostValueKind.HostString,
        .type_name = HostTextData("string"), .data = HostTextData(text), .length = cast(usize)text.count};
}
Services :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    name := TextFromCString(function)
    if name == "AppServiceHost" && count == 2 {
        service := AppArgumentText(arguments[0])
        result.* = Answer(ifx service == "entity.management" then snapshot else ifx service == "entity.dew" then dew_snapshot else "")
        return 1
    }
    if name == "AppLocaleHost" && count == 1 { result.* = Answer(AppArgumentText(arguments[0])); return 1 }
    if name == "ClipboardCopyHost" && count == 2 {
        result.* = HostScalar("bool", ifx CopyCString(AppArgumentText(arguments[0]), clipboard[:]) then 1 else 0)
        return 1
    }
    if name == "WriteStoreHost" && count == 2 { result.* = HostScalar("bool", 1); return 1 }
    if name == "ReadStoreHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.json" {
        output := arguments[1]
        if output.elements == null || output.length <= cast(usize)document.count { return 0 }
        for index: 0..document.count {
            byte := ifx index < document.count then document[index] else cast(u8)0
            output.elements[index].bits = cast(u64)byte
            output.elements[index].integer = cast(s64)byte
        }
        result.* = HostScalar("s32", document.count)
        return 1
    }
    return 0
}
Assets :: (path: string) -> bool { return true }
Expect :: (ok: bool, message: string) {
    if !ok { print("FAIL: %\n", message); failures += 1 }
}
Frame :: () {
    unused TreePointerUpdate(app.session, pointer)
    unused BeginFrame(app.session, 1, app.bounds)
    WidgetHostBegin(app.session, Assets)
    Expect(AppContextRun(*app, APP_FRAME), "production profile frame runs")
    WidgetHostEnd()
    unused EndFrame(app.session)
}
Find :: (label: string) -> s32 {
    for index: cast(s32)0..TreeCount(app.session) - 1 {
        node := TreeNodeAt(app.session, index)
        if node.semantic_label == label { return index }
    }
    return -1
}
FindKey :: (key: u64) -> s32 {
    for index: cast(s32)0..TreeCount(app.session) - 1 {
        if TreeNodeAt(app.session, index).key == key { return index }
    }
    return -1
}
ClickKey :: (key: u64) {
    index := FindKey(key)
    Expect(index >= 0, "click target exists")
    if index < 0 { return }
    bounds := TreeNodeAt(app.session, index).bounds
    pointer = PointerFrame.{bounds.x + bounds.width * 0.5, bounds.y + bounds.height * 0.5, true, true, false}
    Frame()
    pointer = PointerFrame.{pointer.x, pointer.y, false, false, true}
    Frame()
    pointer = .{}
    Frame()
}
Command :: (name: string) {
    app.command = name
    Expect(AppContextRun(*app, APP_COMMAND), "profile command runs")
    Frame()
}

#program_export
main :: () -> s32 {
    state := EntityDefault()
    state.controls = 0
    document = EntityEncode(state)
    account := Management.{.available = true, .account = true, .capabilities = ACCOUNT_ALIAS}
    unused CopyCString(identity, account.public_id[:])
    snapshot = ManagementEncode(account)
    bytes, ok := ReadEntireFile("build/entity.zx")
    if !ok { return 1 }
    app.session = SessionOpen()
    app.bounds = Rectangle.{0.0, 0.0, 960.0, 800.0}
    app.scale = 1.0
    app.expected_id = "entity"
    app.allows = Allows
    app.services = Services
    app.widgets = WidgetHostCall
    if !AppContextOpen(*app, bytes) { return 1 }
    Frame()
    ClickKey(9)
    Expect(FindKey(76000) >= 0, "clicking the profile picture opens the picker modal")
    Expect(Find("Abstract") >= 0 && Find("Classic") >= 0 && Find("Avatar") < 0, "picker offers pictures with Avatar hidden")
    Expect(FindKey(76102) < 0 && FindKey(76200) < 0 && FindKey(70000) < 0, "Avatar controls are absent")
    Command("back")
    Expect(FindKey(76000) < 0, "Back dismisses the picture modal")
    Expect(Find("0123…cdef") >= 0 && Find(identity) < 0, "Profile keeps the public ID compact even on a wide screen")
    ClickKey(705)
    Expect(Find(identity) >= 0 && FindKey(19500) >= 0, "ID opens its full modal")
    Expect(FindKey(19000) >= 0, "modal shows the QR code above the ID")
    ClickKey(19503)
    Expect(TextUntilNul(clipboard[:]) == identity, "clicking the modal ID copies the full ID")
    Command("back")
    Expect(app.reply == "", "the next frame consumes the handled Back reply")
    Expect(FindKey(19500) < 0, "Back dismisses the ID modal")
    app.bounds.width = 390.0
    Frame()
    Expect(FindKey(702) < 0 && FindKey(819) >= 0, "account controls are merged into Profile")
    Expect(Find("0123…cdef") >= 0, "narrow view uses the short ID")
    ClickKey(706)
    Expect(TextUntilNul(clipboard[:]) == identity, "narrow copy copies the complete ID")
    ClickKey(705)
    Expect(Find(identity) >= 0 && FindKey(19500) >= 0, "short ID opens the same complete modal")
    qr := FindKey(19000)
    text := FindKey(19502)
    Expect(qr >= 0 && text >= 0 && TreeNodeAt(app.session, qr).bounds.y < TreeNodeAt(app.session, text).bounds.y,
        "QR is above the complete public ID")
    Command("back")
    Command("account")
    ClickKey(819)
    ClickKey(103)
    Expect(app.keyboard, "alias field requests the host keyboard")
    Command("back")
    ClickKey(705)
    account.public_id[0] = #char "a"
    EntityFree(snapshot)
    snapshot = ManagementEncode(account)
    for frame: 0..15 { Frame() }
    Expect(FindKey(19500) < 0, "account changes dismiss the old ID modal")
    account.public_id[0] = #char "0"
    EntityFree(snapshot)
    snapshot = ManagementEncode(account)
    dew_enabled = true
    dew: Vec(u8)
    BuilderPrint(*dew, "{\"owner\":\"%\",\"available\":true,\"busy\":false,\"account\":{\"account_id\":\"%\",\"asset_id\":\"waozi:token\",\"units_per_dew\":1000000,\"free_bytes\":10485760,\"used_bytes\":4096,\"enabled\":true,\"plan\":{\"balance\":12000000,\"limit_bytes\":10485760,\"expires_at\":0,\"size\":\"free\"},\"plans\":[{\"size\":\"1gb\",\"limit_bytes\":1073741824,\"monthly_units\":1000000,\"yearly_units\":10000000},{\"size\":\"5gb\",\"limit_bytes\":5368709120,\"monthly_units\":5000000,\"yearly_units\":50000000}]}}", identity, identity)
    dew_snapshot = BuilderFinish(dew)
    app.bounds = Rectangle.{0.0, 0.0, 960.0, 1600.0}
    state.controls = ENTITY_APPEARANCE | ENTITY_WIDGETS
    for policy: cast(s32)0..1 {
        state.show_storage = policy == 1
        EntityFree(document)
        document = EntityEncode(state)
        Command("reload")
        for frame: 0..15 { Frame() }
        Expect(Find("Widgets") < 0 && FindKey(60) < 0 && FindKey(61) < 0, "appearance has no widget style selector")
        Expect(FindKey(46004) >= 0, "Dew top-up remains available")
        Expect((FindKey(46006) >= 0) == state.show_storage, "storage indicator follows host capability")
        Expect((Find("Storage plans") >= 0) == state.show_storage, "Profile storage plans follow host capability")
        Command("dew")
        Expect(FindKey(45006) >= 0 && FindKey(45008) >= 0, "Dew balance and funding remain available")
        Expect((FindKey(45013) >= 0) == state.show_storage, "dedicated Dew page hides game storage plans")
        Command("back")
    }
    EntityFree(dew_snapshot)
    HostedAppClose(*app.app)
    unused SessionClose(app.session)
    print("Public identity local test failures: %\n", failures)
    return failures
}
