// A throwaway account talks only to a private node supplied by the harness.
#import "account_store"
#import "game_shop_native"
#import "game_shop"
#import "entity_dew"
#import "recovery"
#import "model"
#import "native_files"
#import "dew_model"
#import "std/text_buffer"
#import "std/vec"
#import "std/c_string"
#import "std/json_scan"
#import "std/net_http"
#import "std/timer_linux"
#import "std/date_time_linux"
#import "daochi_client/keys"
#import "daochi_client/async_client"
#import "kryon/http_transfer"

transfer: HttpTransfer;
Start :: (context: *void, request: HttpRequest, output: []u8) -> bool {
    // Authentication still signs the exact API path; only the transport's
    // destination changes. Never contact the public node from this fixture.
    if request.url.count < DewNode.count || request.url[:DewNode.count] != DewNode { return false }
    base := NativeEnvironment("SHOP_TEST_NODE")
    if base.count < 17 || base[:17] != "http://127.0.0.1:" { return false }
    url: Vec(u8)
    BuilderPrint(*url, "%", base)
    BuilderPrint(*url, "%", request.url[DewNode.count:])
    request.url = TextView(VecSlice(url, 0, url.count))
    started := HttpTransferStart(*transfer, request, output, 10000)
    VecFree(url)
    return started
}
OfflineStart :: (context: *void, request: HttpRequest, output: []u8) -> bool { return false }
Poll :: (context: *void, status: *s32) -> s32 { return HttpTransferPoll(*transfer, status) }
Cancel :: (context: *void) { HttpTransferCancel(*transfer) }
// Deterministic delayed transport retains a late response for cancellation tests.
late_output: []u8;
late_answer: [1024]u8;
late_ready: bool;
late_cancelled: bool;
late_http: s32 = 200;
LateStart :: (context: *void, request: HttpRequest, output: []u8) -> bool {
    late_output = output
    return request.method == "POST" && request.body == "{\"product\":\"shovey.island\"}"
}
LatePoll :: (context: *void, status: *s32) -> s32 {
    if !late_ready { return -1 }
    unused CopyCString(TextUntilNul(late_answer[:]), late_output)
    status.* = late_http
    return 1
}
LateCancel :: (context: *void) { late_cancelled = true }
Wait :: () -> bool {
    for round: 0..1200 {
        EntityDewPump()
        if !shop_active && !shop_requested { return shop_status == "done" }
        unused SleepMilliseconds(10)
    }
    return false
}
#program_export
Check :: () -> s32 {
    root := NativeEnvironment("ENTITY_DATA")
    step := NativeEnvironment("SHOP_TEST_STEP")
    if root == "" { return 1 }
    if step == "create" {
        recovery: Recovery
        if CreateAccountKeys(*recovery.keys) != 1 || !NativeDirectory(root) { return 2 }
        text: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
        path: [4096]u8
        if !RecoveryEncode(*recovery, "", text[:]) || !NativeWrite(NativeJoin(path[:], root, "account.key"), TextUntilNul(text[:])) { return 3 }
        state := EntityDefault()
        unused CopyCString(TextUntilNul(recovery.keys.public_id[:]), state.owner_id[:])
        if !NativeWrite(NativeJoin(path[:], root, "entity.json"), EntityEncode(state)) { return 4 }
        return 0
    }
    if !AccountStoreStartAt(root, "game-shop-test") { return 5 }
    shop_transport = AsyncTransport.{.start = Start, .poll = Poll, .cancel = Cancel}
    unused EntityDewAnswer("shop:refresh")
    if step == "local" {
        unused EntityGameShopAnswer("shovey.island.grant")
        if shop_grant_status != "signin" || shop_grant || shop_grant_expires != 0 { return 40 }
        EntityDewPump()
        return ifx shop_status == "signin" && !shop_active && !shop_requested then 0 else 13
    }
    if !Wait() { print("shop restore failed: %, stage %, HTTP %, result %\n", shop_status, shop_request.stage, shop_request.status, cast(s32)shop_request.result); return 6 }
    if step == "grant_unowned" {
        // Spoofing local ownership must not authorize delivery or buy anything.
        shop_owned |= 1 << SHOVEY_ISLAND_PRODUCT
        unused EntityGameShopAnswer("shovey.island.grant")
        if Wait() || shop_grant_status != "unowned" || shop_grant_expires != 0 || shop_grant_token[0] != cast(u8)0 { return 31 }
        return 0
    }
    if step == "grant_owned" {
        // Exercise the actual hosted-browser route with the production handler.
        args: [2]HostValue = .[HostValue.{"entity.game-shop"}, HostValue.{"shovey.island.grant"}]
        answer: HostValue
        browser_mini = true
        if BrowserServices(null, null, null, *args[0], 2, *answer) != 0 || shop_grant { return 32 }
        browser_mini = false
        if BrowserServices(null, null, null, *args[0], 2, *answer) != 1 || !shop_grant || !Wait() { return 33 }
        reply := EntityGameShopAnswer("shovey.island.grant.status")
        if !GameShopField(reply, "status", "done") || !GameShopField(reply, "owner", TextUntilNul(shop_owner[:])) ||
        shop_grant_expires <= UnixNow() || shop_grant_token[0] == cast(u8)0 { return 34 }
        saved: Vec(u8)
        BuilderPrint(*saved, "{\"grant\":\"%\",\"expires_at\":%}", TextUntilNul(shop_grant_token[:]), shop_grant_expires)
        unused CopyCString(TextView(VecSlice(saved, 0, saved.count)), late_answer[:])
        VecFree(saved)
        // Ordinary status must not expose the download credential.
        if FieldAt(EntityGameShopAnswer("status"), 0, "grant") >= 0 { return 35 }
        // Repeated starts reuse the grant without sending another request.
        unused EntityGameShopAnswer("shovey.island.grant")
        if shop_grant || shop_requested { return 41 }
        ShopGrantExpire(shop_grant_expires)
        if shop_grant_expires != 0 || shop_grant_status != "expired" { return 36 }
        // Malformed/expired endpoint answers fail closed with no credential.
        if ShopGrantRead("{}", UnixNow()) || ShopGrantRead("{\"grant\":\"bad/path\",\"expires_at\":1}", UnixNow()) ||
        shop_grant_token[0] != cast(u8)0 { return 42 }
        if ShopGrantRead("{\"grant\":\"ZGFvY2hpLXBhY2stZ3JhbnQtdjEKb3RoZXIucHJvZHVjdAoxMDAx.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"expires_at\":1001}", 1000) { return 43 }
        if ShopGrantRead("{\"grant\":\"ZGFvY2hpLXBhY2stZ3JhbnQtdjEKc2hvdmV5LmlzbGFuZAoxMDAx.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"expires_at\":1002}", 1000) { return 43 }
        if ShopGrantRead("{\"grant\":\"ZGFvY2hpLXBhY2stZ3JhbnQtdjEKc2hvdmV5LmlzbGFuZAoxMDAx.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"expires_at\":1000}", 1000) { return 43 }
        if ShopGrantRead("{\"grant\":\"ZGFvY2hpLXBhY2stZ3JhbnQtdjEKc2hvdmV5LmlzbGFuZAoxMDAx.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"expires_at\":4601}", 1000) { return 43 }
        if ShopGrantRead("{\"grant\":\"ZGFvY2hpLXBhY2stZ3JhbnQtdjEKc2hvdmV5LmlzbGFuZAoxMDAx.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"expires_at\":1001.5}", 1000) { return 43 }
        if ShopGrantRead("{\"grant\":\"\",\"expires_at\":1001}", 1000) { return 43 }
        shop_transport.start = OfflineStart
        unused EntityGameShopAnswer("shovey.island.grant")
        if Wait() || shop_grant_status != "failed" || shop_grant_token[0] != cast(u8)0 { return 37 }
        shop_transport = AsyncTransport.{.start = LateStart, .poll = LatePoll, .cancel = LateCancel}
        late_ready = true
        late_http = 503
        unused EntityGameShopAnswer("shovey.island.grant")
        if Wait() || shop_grant_status != "failed" || shop_grant_expires != 0 { return 44 }
        late_ready = false
        late_http = 200
        unused EntityGameShopAnswer("shovey.island.grant")
        EntityGameShopPump()
        // Switch identity while the request is in flight; no response may leak.
        account_recovery.keys.public_id = .{}
        reply = EntityGameShopAnswer("shovey.island.grant.status")
        if shop_active || shop_grant || shop_grant_expires != 0 || !GameShopField(reply, "grant", "") { return 38 }
        if !late_cancelled { return 45 }
        // Even a stale transport writing the old response after cancellation
        // cannot repopulate the new identity's grant state.
        unused CopyCString(TextUntilNul(late_answer[:]), late_output)
        late_ready = true
        EntityGameShopPump()
        if shop_grant_expires != 0 || shop_grant_token[0] != cast(u8)0 { return 46 }
        account_standalone_ready = false
        unused EntityGameShopAnswer("shovey.island.grant")
        return ifx shop_grant_status == "signin" && !shop_requested then 0 else 39
    }
    if step == "empty" { return ifx shop_owned == 0 then 0 else 7 }
    if step == "restored" {
        if shop_owned != 65166 { return 8 }
        // Each game keeps its own ownership mask and coin total.
        reply := EntityGameShopAnswer("status")
        owned := ReadNumber(reply, FieldAt(reply, 0, "owned"))
        decorations := ReadNumber(reply, FieldAt(reply, 0, "decorations"))
        shovey_owned := ReadNumber(reply, FieldAt(reply, 0, "shovey_owned"))
        coins := ReadNumber(reply, FieldAt(reply, 0, "coins"))
        shovey_coins := ReadNumber(reply, FieldAt(reply, 0, "shovey_coins"))
        valid := owned.valid && owned.value == 654.0 && decorations.valid && decorations.value == 7168.0 &&
        shovey_owned.valid && shovey_owned.value == 24576.0 && coins.valid && coins.value == 400.0 &&
        shovey_coins.valid && shovey_coins.value == 900.0
        if !valid { return 18 }
        shop_transport.start = OfflineStart
        unused EntityGameShopAnswer("refresh")
        if Wait() || (shop_owned & (1 << SHOVEY_ISLAND_PRODUCT)) == 0 { return 29 }
        // An account transition drops the previous owner's verified entitlement and quote.
        account_recovery.keys.public_id = .{}
        unused EntityGameShopAnswer("status")
        return ifx shop_owned == 0 && shop_island_price == 0 then 0 else 30
    }
    if step == "buy" {
        if shop_coin_receipts == 1 && shop_shovey_coin_receipts == 1 {
            // An uncertain confirmed response has no local count; its retry reuses number one.
            shop_coins = 0
            shop_shovey_coins = 0
            shop_coin_receipts = 0
            shop_shovey_coin_receipts = 0
        }
        for product: GAME_SHOP_PRODUCTS {
            if product == SHOVEY_ISLAND_PRODUCT { continue }
            unused EntityGameShopAnswer(GameShopProduct(cast(s32)product))
            if !Wait() || (shop_owned & (1 << product)) == 0 { print("purchase % failed: %\n", product, shop_status); return 9 }
        }
        // An uncertain response has no local ownership; retry those same keys.
        shop_owned = 0
        for product: GAME_SHOP_PRODUCTS {
            if product == SHOVEY_ISLAND_PRODUCT { continue }
            unused EntityGameShopAnswer(GameShopProduct(cast(s32)product))
            if !Wait() { return 10 }
        }
        unused EntityGameShopAnswer("coins:2")
        if !Wait() || shop_coins != 400 || shop_shovey_coins != 0 || shop_coin_receipts != 1 || shop_shovey_coin_receipts != 0 { return 21 }
        unused EntityGameShopAnswer("shovey-coins:3")
        if !Wait() || shop_coins != 400 || shop_shovey_coins != 900 || shop_coin_receipts != 1 || shop_shovey_coin_receipts != 1 { return 22 }
        unused EntityGameShopAnswer("shovey.island.quote")
        if !Wait() || shop_island_price != SHOVEY_ISLAND_SALE_UNITS { return 24 }
        unused EntityGameShopAnswer("shovey.island:51000000")
        if !Wait() || (shop_owned & (1 << SHOVEY_ISLAND_PRODUCT)) == 0 { return 25 }
        // Lost local entitlement retries the same durable server unlock.
        shop_owned &= ~(1 << SHOVEY_ISLAND_PRODUCT)
        unused EntityGameShopAnswer("shovey.island:51000000")
        if !Wait() || (shop_owned & (1 << SHOVEY_ISLAND_PRODUCT)) == 0 { return 26 }
        return 0
    }
    if step == "insufficient" {
        unused EntityGameShopAnswer("wurm.mint")
        if Wait() || shop_owned != 0 { return 11 }
        unused EntityGameShopAnswer("choano.pearl")
        if Wait() || shop_owned != 0 { return 19 }
        unused EntityGameShopAnswer("shovey.night")
        if Wait() || shop_owned != 0 { return 23 }
        unused EntityGameShopAnswer("shovey.island.quote")
        if !Wait() || shop_island_price != SHOVEY_ISLAND_SALE_UNITS { return 27 }
        unused EntityGameShopAnswer("shovey.island:51000000")
        if Wait() || shop_owned != 0 || shop_status != "insufficient" { print("Island unfunded status %, HTTP %, auth %\n", shop_status, shop_request.status, cast(s32)shop_request.result); return 28 }
        return 0
    }
    if step == "holiday_early" {
        return ifx !ShopChristmasClaim(1796083199) && (shop_owned & 256) == 0 then 0 else 14
    }
    if step == "holiday_claim" {
        return ifx ShopChristmasClaim(1796083200) && (shop_owned & 256) != 0 then 0 else 15
    }
    if step == "holiday_after" {
        unused EntityGameShopAnswer("status")
        if (shop_owned & 256) == 0 || ShopChristmasClaim(1798761600) { return 16 }
        return ifx (shop_owned & 256) != 0 then 0 else 17
    }
    return 12
}
