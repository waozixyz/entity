// Real Profile/native-host boundary with synthetic leaderboard rows and no pump.
#import "native_host"
#import "native_files"
#import "leaderboard_model"
#import "model"
#import "std/file"
#import "std/c_string"
#import "std/bundle_host"
#import "std/byte_text_linux"
#import "kryon/desktop_runtime"
#import "kryon/Frame"
#import "kryon/session"
#import "kryon/tree"
#import "kryon/geometry"
TextField :: #import "kryon/text_field";
#import "kryon/hosted_values"
#import "kryon/app_context_host"

page: ProfileLeaderboard;
answer: string;
FixtureServices :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(function) != "AppServiceHost" || count != 2 ||
    AppArgumentText(arguments[0]) != LEADERBOARD_SERVICE {
        return EntityHostServices(context, module, function, arguments, count, result)
    }
    EntityFree(answer)
    answer = ProfileLeaderboardEncode(*page)
    result.* = EntityHostText(answer)
    return 1
}

#program_export
main :: () -> s32 {
    bytes, found := ReadEntireFile(BUNDLE)
    if !found { return 1 }
    defer { EntityFree(bytes) }
    if !EntityHostOpen(bytes, PROFILE, "arcade", true) { return 2 }
    defer { unused EntityHostClose(); EntityFree(answer) }
    unused CopyCString("fixture", page.owner[:])
    page.board_count = 1
    unused CopyCString("arcade", page.boards[0].app[:])
    unused CopyCString("Arcade", page.boards[0].app_title[:])
    unused CopyCString("arcade.shovey", page.boards[0].id[:])
    unused CopyCString("Shovey", page.boards[0].title[:])
    unused CopyCString("Levels", page.boards[0].primary[:])
    page.row_count = 8
    complete := true
    for index: cast(s32)0..7 {
        unused CopyCString("Fixture player", page.rows[index].name[:])
        unused CopyCString("4", page.rows[index].value[:])
        page.rows[index].game_icon = index + 1
        asset := ProfileLeaderboardShoveyAsset("arcade.shovey", index + 1)
        path: [4096]u8
        full := NativeJoin(path[:], PROFILE, asset)
        allowed := EntityHostAssetAllowed(full)
        extracted := PathExists(full)
        print("Thumbnail %: allowed=% extracted=%\n", index, allowed, extracted)
        complete = complete && allowed && extracted
    }
    forbidden: [4]string = .["/etc/passwd", "assets/entity/../shovey-0.png",
    "assets/entity/shovey-8.png", "assets/entity/sub/shovey-0.png"]
    for path: forbidden {
        full: [4096]u8
        if EntityHostAssetAllowed(NativeJoin(full[:], PROFILE, path)) { return 3 }
    }
    portable.services = FixtureServices
    if !EntityHostProfileRequest("leaderboard") { return 4 }
    print("Thumbnail fixture: opening private renderer\n")
    if !OpenDesktopSized(480, 820) { return 5 }
    defer { CloseDesktop() }
    session := SessionOpen()
    if !SessionValid(session) { return 6 }
    defer { SessionClose(session) }
    bounds := Rectangle.{0.0, 0.0, 480.0, 820.0}
    for frame: 1..3 {
        BeginDesktopFrame()
        if BeginFrame(session, cast(u64)frame, bounds) != FrameStatus.FrameOk { return 7 }
        if !EntityHostFrame(session, bounds, 0, 0, TextField.Input.{}, true) { return 8 }
        if EndFrame(session) != FrameStatus.FrameOk || !EndDesktopFrame() { return 9 }
        print("Thumbnail fixture: hosted frame % completed\n", frame)
    }
    if !complete { return 10 }
    return 0
}
