fixture: Recovery;
current_id: [65]u8;
action_count: s32;
apply_count: s32;
choose_result: s32;
backup_alias: string;
backup_path: [4096]u8;
backup_provider: ManagementProvider;

Snapshot :: (context: *void, output: *Management) {
    output.available = true
    output.account = current_id[0] != cast(u8)0
    output.public_id = current_id
    output.capabilities = 2047
    unused CopyCString(backup_alias, output.alias[:])
}
Apply :: (context: *void, incoming: *Recovery, choice: s32) -> s32 {
    apply_count += 1
    if choice == 0 { return 2 }
    current_id = incoming.keys.public_id
    return 1
}
Action :: (context: *void, request: *ManagementRequest) -> s32 {
    action_count += 1
    return 2
}
Choose :: (context: *void, save: bool, output: []u8) -> s32 {
    return choose_result
}
ChooseBackup :: (context: *void, save: bool, output: []u8) -> s32 {
    return ifx CopyCString(TextUntilNul(backup_path[:]), output) then 1 else -1
}
LoadFixture :: (context: *void, output: *Recovery) -> bool {
    output.* = fixture
    return true
}
Finished :: (provider: *ManagementProvider, operation: string, value: string, result: string) -> bool {
    if !Request(provider, operation, value) { return false }
    ProviderPump(provider)
    return !provider.queue.pending && TextUntilNul(provider.queue.result[:]) == result
}
// Default backup names, password rules and the two steps of signing in.
CheckBackupAndSignIn :: () -> s32 {
    name: [128]u8
    id := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    if RecoveryFileName("Live_Tester", id, name[:]) != "Live_Tester.key" { return 100 }
    if RecoveryFileName("", id, name[:]) != "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef.key" { return 101 }
    if RecoveryFileName("../../etc/pass wd", id, name[:]) != "etcpasswd.key" { return 102 }
    if RecoveryFileName("..", id, name[:]) != "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef.key" { return 103 }
    if RecoveryFileName("CON", id, name[:]) == "CON.key" || RecoveryFileName("lpt1", id, name[:]) == "lpt1.key" { return 104 }
    if RecoveryFileName("cones", id, name[:]) != "cones.key" { return 105 }
    long := "a123456789a123456789a123456789a123456789a123456789a123456789a123456789a123456789"
    if RecoveryFileName(long, id, name[:]) != "a123456789a123456789a123456789a123456789a123456789a123456789a123.key" { return 106 }
    if RecoveryFileName("", "", name[:]) != "account.key" { return 107 }
    tiny: [6]u8
    if RecoveryFileName("username", id, tiny[:]) != "" { return 108 }
    if ManagementPasswordAccepted("") || ManagementPasswordAccepted("12345678901") || !ManagementPasswordAccepted("123456789012") ||
    ManagementPasswordAccepted("ééééééééééé") || !ManagementPasswordAccepted("éééééééééééé") { return 109 }

    root: [4096]u8
    if !NativeDirectory(NativeRoot(root[:])) || NativeJoin(backup_path[:], TextUntilNul(root[:]), "fixture-backup.key") == "" { return 111 }
    provider := *backup_provider
    provider.* = ManagementProvider.{.snapshot = Snapshot, .apply = Apply, .action = Action, .choose_file = ChooseBackup, .load = LoadFixture}
    backup_alias = "Fixture_Name"
    if ProviderBackupFileName(provider, name[:]) != "Fixture_Name.key" { return 112 }
    backup_alias = ""
    expected: [128]u8
    if ProviderBackupFileName(provider, name[:]) != RecoveryFileName("", TextUntilNul(current_id[:]), expected[:]) { return 113 }

    // A backup never goes out without a password.
    unused RemoveFile(TextUntilNul(backup_path[:]))
    if !Finished(provider, "backup", "", "error") || !Finished(provider, "backup", "short", "error") || !Finished(provider, "backup", "elevenchars", "error") ||
    PathExists(TextUntilNul(backup_path[:])) { return 114 }
    if !Finished(provider, "backup", "fixture password", "ok") { return 115 }
    file: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    if NativeRead(TextUntilNul(backup_path[:]), file[:]) <= 0 || !RecoveryNeedsPassword(TextUntilNul(file[:])) { return 116 }

    // The file comes first; a wrong password keeps it for another try.
    applied := apply_count
    if !Finished(provider, "import", "", "password") || !ProviderState(provider).password_needed || apply_count != applied { return 117 }
    if !Finished(provider, "import_password", "wrong password", "password") || !ProviderState(provider).password_needed ||
    apply_count != applied || TextUntilNul(provider.queue.message[:]) == "" { return 118 }
    if !Finished(provider, "import_password", "fixture password", "switch") || ProviderState(provider).password_needed ||
    apply_count != applied + 1 || !provider.has_incoming { return 119 }
    if TextUntilNul(provider.incoming.keys.public_id[:]) != TextUntilNul(fixture.keys.public_id[:]) ||
    TextUntilNul(provider.incoming.context[:]) != TextUntilNul(fixture.context[:]) { return 120 }
    if !Finished(provider, "switch_cancel", "", "cancelled") { return 121 }

    // Leaving forgets the held file.
    if !Finished(provider, "import", "", "password") || !Finished(provider, "import_cancel", "", "cancelled") ||
    ProviderState(provider).password_needed || provider.held_backup[0] != cast(u8)0 { return 122 }
    if !Finished(provider, "import_password", "fixture password", "error") { return 123 }

    // Files from before this flow: a plain key opens with no password, and a
    // password given with the file still works.
    if !Finished(provider, "import", "fixture password", "switch") || !Finished(provider, "switch_cancel", "", "cancelled") { return 124 }
    plain: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    if !RecoveryEncode(*fixture, "", plain[:]) || !NativeWrite(TextUntilNul(backup_path[:]), TextUntilNul(plain[:])) { return 125 }
    if !Finished(provider, "import", "", "switch") || ProviderState(provider).password_needed || !Finished(provider, "switch_cancel", "", "cancelled") { return 126 }
    if !NativeWrite(TextUntilNul(backup_path[:]), "not a backup") || !Finished(provider, "import", "", "error") ||
    ProviderState(provider).password_needed { return 127 }
    unused RemoveFile(TextUntilNul(backup_path[:]))

    // The status reaches the profile bundle.
    state: Management
    state.password_needed = true
    state.available = true
    document := ManagementEncode(state)
    defer { EntityFree(document) }
    decoded: Management
    if !ManagementDecode(document, *decoded) || !decoded.password_needed { return 128 }
    return 0
}
Request :: (provider: *ManagementProvider, operation: string, value: string = "", choice: s32 = 0) -> bool {
    request: ManagementRequest
    request.sequence = provider.queue.sequence + 1
    request.owner_id = current_id
    request.choice = choice
    unused CopyCString(operation, request.operation[:])
    unused CopyCString(value, request.value[:])
    encoded := ManagementRequestEncode(request)
    defer { EntityFree(encoded) }
    return ProviderEnqueue(provider, encoded)
}

// A hybrid link in both directions, and everything a relay could try against it.
HybridLinkCheck :: (fixture: *Recovery) -> s32 {
    shower: DeviceLinkKeys
    scanner: DeviceLinkKeys
    if !DeviceLinkNewKeys(*shower) || !DeviceLinkNewKeys(*scanner) { return 1 }
    defer { DeviceLinkForget(*shower); DeviceLinkForget(*scanner) }
    id := "0123456789abcdef0123456789abcdef"
    server := "https://api.waozi.xyz"

    // The code stays short enough to scan and carries no full key.
    receiving := DeviceLinkHybridCodeText(id, *shower, false, server)
    sending := DeviceLinkHybridCodeText(id, *shower, true, server)
    defer { EntityFree(receiving); EntityFree(sending) }
    if receiving.count > 170 || sending.count > 170 { return 2 }
    code := DeviceLinkParse(receiving)
    code_sends := DeviceLinkParse(sending)
    if !code.valid || !code.hybrid || code.sends || !code_sends.valid || !code_sends.hybrid || !code_sends.sends { return 3 }

    // The scanner seals to the shower's keys only after checking the hash.
    shower_text := DeviceLinkBundleText(*shower)
    scanner_text := DeviceLinkBundleText(*scanner)
    defer { EntityFree(shower_text); EntityFree(scanner_text) }
    shower_bundle: [DEVICE_LINK_BUNDLE]u8
    scanner_bundle: [DEVICE_LINK_BUNDLE]u8
    if !DeviceLinkBundleRead(shower_text, *code.public[0], *shower_bundle[0]) { return 4 }
    if DeviceLinkBundleRead(scanner_text, *code.public[0], *scanner_bundle[0]) { return 5 }
    if !DeviceLinkBundleRead(scanner_text, null, *scanner_bundle[0]) { return 6 }

    to_shower := DeviceLinkHybridSeal(*fixture.keys, server, id, *scanner, *shower_bundle[0], false, TextUntilNul(fixture.context[:]))
    defer { EntityFree(to_shower) }
    arrived := DeviceLinkHybridOpen(to_shower, id, *shower, true, null)
    if !arrived.valid || TextUntilNul(arrived.account.public_id[:]) != TextUntilNul(fixture.keys.public_id[:]) ||
    TextUntilNul(arrived.server[:]) != server || TextUntilNul(arrived.context[:]) != TextUntilNul(fixture.context[:]) { return 7 }
    SecureWipe(*arrived.account.private_key_hex[0], ACCOUNT_PRIVATE_KEY_HEX_SIZE)

    // The other way: the shower seals, the scanner checks the sender against the code.
    to_scanner := DeviceLinkHybridSeal(*fixture.keys, server, id, *shower, *scanner_bundle[0], true)
    defer { EntityFree(to_scanner) }
    received := DeviceLinkHybridOpen(to_scanner, id, *scanner, false, *code_sends.public[0])
    if !received.valid || TextUntilNul(received.account.public_id[:]) != TextUntilNul(fixture.keys.public_id[:]) { return 8 }
    SecureWipe(*received.account.private_key_hex[0], ACCOUNT_PRIVATE_KEY_HEX_SIZE)

    // A sender the code did not commit to, another link, or a tampered message.
    if DeviceLinkHybridOpen(to_shower, id, *scanner, false, *code_sends.public[0]).valid { return 9 }
    if DeviceLinkHybridOpen(to_scanner, "fedcba9876543210fedcba9876543210", *scanner, false, *code_sends.public[0]).valid { return 10 }
    // Swapped KEM ciphertext: X25519 alone must not open it.
    copy: [DEVICE_LINK_MESSAGE_MAX]u8
    if !CopyCString(to_scanner, copy[:]) { return 11 }
    at := DEVICE_LINK_KEY * 2 + 40
    copy[at] = ifx copy[at] == cast(u8)48 then cast(u8)49 else cast(u8)48
    if DeviceLinkHybridOpen(TextUntilNul(copy[:]), id, *scanner, false, *code_sends.public[0]).valid { return 12 }
    // A hybrid session never opens an older, X25519-only message.
    older := DeviceLinkSeal(*fixture.keys, server, id, *shower, *scanner.public[0], true)
    defer { EntityFree(older) }
    if DeviceLinkHybridOpen(older, id, *scanner, false, *code_sends.public[0]).valid { return 13 }

    // A relay that replaces the scanner's keys changes the number both show.
    third: DeviceLinkKeys
    if !DeviceLinkNewKeys(*third) { return 14 }
    defer { DeviceLinkForget(*third) }
    third_bundle: [DEVICE_LINK_BUNDLE]u8
    DeviceLinkBundleBytes(*third, *third_bundle[0])
    if DeviceLinkHybridConfirmation(*code_sends.public[0], *scanner_bundle[0]) ==
    DeviceLinkHybridConfirmation(*code_sends.public[0], *third_bundle[0]) { return 15 }

    // Malformed input is refused without crashing.
    if DeviceLinkHybridOpen("", id, *scanner, false, null).valid || DeviceLinkHybridOpen("zz", id, *scanner, false, null).valid { return 16 }
    if DeviceLinkBundleRead("abc", null, *scanner_bundle[0]) { return 17 }
    if DeviceLinkParse("inbe-link:2:short:hash:s:https://api.waozi.xyz").valid { return 18 }
    return 0
}

// The sealed backup: its KDF, its stored layout and every way it must refuse.
RecoverySealedCheck :: (fixture: *Recovery, text: string) -> s32 {
    if !RecoveryNeedsPassword(text) { return 1 }
    prefix := "waozi-account-backup-v3\nalgorithm=ML-DSA-44\nkdf=Argon2id\nmemory_kib=65536\npasses=3\nlanes=1\nsalt="
    if text.count <= prefix.count || text[:prefix.count] != prefix { return 2 }

    // Independent vector: openssl kdf ARGON2ID, 64 MiB, 3 passes, 1 lane, 64 bytes.
    salt: [16]u8
    for index: 0..15 { salt[index] = cast(u8)index }
    keys: RecoveryKeys
    defer { RecoveryKeysClear(*keys) }
    if !RecoveryDerive("correct horse battery", *salt[0], *keys) { return 3 }
    seal_hex: [65]u8
    if BytesToHex(*keys.seal[0], 32, *seal_hex[0], seal_hex.count) == 0 ||
    TextUntilNul(seal_hex[:]) != "91b1d756d2e5d66cfc48e89292d2a4f2b64c5a8e84cffe10a1d4cdc7fc7dd5cc" { return 4 }
    // The proof and the sealing key are separate; the node keeps only the verifier.
    expected: [32]u8
    Sha256(*keys.proof[0], 32, *expected[0])
    same := true
    for index: 0..31 {
        if keys.proof[index] != keys.seal[index] { same = false }
        if expected[index] != keys.verifier[index] { return 5 }
    }
    if same { return 6 }

    // A stored copy opens with its password's keys, and only with them.
    parts := RecoverySealedParse(text)
    if !parts.valid { return 7 }
    opened: Recovery
    defer { RecoveryClear(*opened) }
    right: RecoveryKeys
    defer { RecoveryKeysClear(*right) }
    if !RecoveryDeriveFromHex("fixture passphrase", parts.salt, *right) ||
    !RecoveryOpenSealed(text, *right, *opened) ||
    TextUntilNul(opened.keys.public_id[:]) != TextUntilNul(fixture.keys.public_id[:]) { return 8 }
    if RecoveryOpenSealed(text, *keys, *opened) || opened.keys.private_key_hex[0] != cast(u8)0 { return 9 }

    // A trailing newline from storage is harmless; other edits are refused.
    copy: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE + 2]u8
    if !CopyCString(text, copy[:]) { return 10 }
    copy[text.count] = cast(u8)10
    if !RecoveryOpenSealed(TextUntilNul(copy[:]), *right, *opened) { return 11 }
    copy[text.count] = cast(u8)0
    // A weaker work factor is refused before any key is derived.
    weakened := "waozi-account-backup-v3\nalgorithm=ML-DSA-44\nkdf=Argon2id\nmemory_kib=8\npasses=1\nlanes=1\nsalt=00000000000000000000000000000000\nnonce=000000000000000000000000\nciphertext=00000000000000000000000000000000000000"
    if RecoverySealedParse(weakened).valid || RecoveryDecode(weakened, "fixture passphrase", *opened) { return 12 }
    // Changing an authenticated field breaks the seal, even with the right keys.
    copy[prefix.count + 32 + 7] = ifx copy[prefix.count + 32 + 7] == cast(u8)48 then cast(u8)49 else cast(u8)48
    if RecoveryOpenSealed(TextUntilNul(copy[:]), *right, *opened) { return 13 }
    return 0
}

#program_export
Check :: () -> s32 {
    if CreateAccountKeys(*fixture.keys) == 0 { return 1 }
    defer { RecoveryClear(*fixture) }
    unused CopyCString("{\"werkzeug_vault\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}", fixture.context[:])
    backup: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    opened: Recovery
    defer { RecoveryClear(*opened) }
    if !RecoveryEncode(*fixture, "", backup[:]) || !RecoveryDecode(TextUntilNul(backup[:]), "", *opened) { return 2 }
    if TextUntilNul(opened.context[:]) != TextUntilNul(fixture.context[:]) ||
    TextUntilNul(opened.keys.public_id[:]) != TextUntilNul(fixture.keys.public_id[:]) { return 3 }
    legacy: AccountKeys
    if ParseAccountKeys(TextUntilNul(backup[:]), *legacy) == 0 { return 4 }
    if !RecoveryEncode(*fixture, "fixture passphrase", backup[:]) { return 5 }
    if RecoveryDecode(TextUntilNul(backup[:]), "wrong", *opened) { return 6 }
    if !RecoveryDecode(TextUntilNul(backup[:]), "fixture passphrase", *opened) ||
    TextUntilNul(opened.context[:]) != TextUntilNul(fixture.context[:]) { return 7 }
    // Backups made before the sealed format still open.
    older: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    if AccountKeysEncryptedText(*fixture.keys, "fixture passphrase", *older[0], older.count) == 0 ||
    !RecoveryNeedsPassword(TextUntilNul(older[:])) || !RecoveryDecode(TextUntilNul(older[:]), "fixture passphrase", *opened) ||
    TextUntilNul(opened.keys.public_id[:]) != TextUntilNul(fixture.keys.public_id[:]) { return 8 }
    if RecoverySealedCheck(*fixture, TextUntilNul(backup[:])) != 0 { return 300 + RecoverySealedCheck(*fixture, TextUntilNul(backup[:])) }
    length := TextUntilNul(backup[:]).count
    backup[length - 2] = ifx backup[length - 2] == cast(u8)48 then cast(u8)49 else cast(u8)48
    if RecoveryDecode(TextUntilNul(backup[:]), "fixture passphrase", *opened) { return 9 }
    if opened.keys.private_key_hex[0] != cast(u8)0 { return 10 }

    hybrid_result := HybridLinkCheck(*fixture)
    if hybrid_result != 0 { return 400 + hybrid_result }

    // The older QR wire format keeps working in either direction.
    first: DeviceLinkKeys
    second: DeviceLinkKeys
    if !DeviceLinkNewKeys(*first) || !DeviceLinkNewKeys(*second) { return 11 }
    defer { DeviceLinkForget(*first); DeviceLinkForget(*second) }
    id := "0123456789abcdef0123456789abcdef"
    code_text := DeviceLinkCodeText(id, *first, true, "https://api.waozi.xyz")
    defer { EntityFree(code_text) }
    if !DeviceLinkParse(code_text).valid || DeviceLinkParse("https://example.com").valid { return 12 }
    sealed := DeviceLinkSeal(*fixture.keys, "https://api.waozi.xyz", id, *first, *second.public[0], true)
    defer { EntityFree(sealed) }
    received := DeviceLinkOpen(sealed, id, *second, false, *first.public[0])
    if !received.valid || TextUntilNul(received.account.public_id[:]) != TextUntilNul(fixture.keys.public_id[:]) { return 13 }
    if DeviceLinkOpen(sealed, "fedcba9876543210fedcba9876543210", *second, false, *first.public[0]).valid { return 14 }
    protected := DeviceLinkSeal(*fixture.keys, "https://api.waozi.xyz", id, *first, *second.public[0], true, TextUntilNul(fixture.context[:]))
    defer { EntityFree(protected) }
    recovered := DeviceLinkOpen(protected, id, *second, false, *first.public[0])
    if !recovered.valid || TextUntilNul(recovered.context[:]) != TextUntilNul(fixture.context[:]) { return 30 }
    if DeviceLinkParse(DeviceLinkCodeText(id, *first, true, "https://user:password@example.com")).valid { return 15 }

    provider := ManagementProvider.{.snapshot = Snapshot, .apply = Apply, .action = Action, .choose_file = Choose}
    if !Request(*provider, "sync") { return 16 }
    ProviderPump(*provider)
    ProviderPump(*provider)
    if action_count != 1 || !provider.queue.pending { return 17 }
    ProviderFinish(*provider, "ok", "")
    if !Request(*provider, "import", "fixture transient secret") { return 18 }
    choose_result = 2
    ProviderPump(*provider)
    if !provider.delegated || !provider.queue.pending { return 38 }
    choose_result = 0
    provider.delegated = false
    ProviderPump(*provider)
    if provider.queue.pending || TextUntilNul(provider.queue.result[:]) != "cancelled" ||
    provider.queue.request.value[0] != cast(u8)0 || apply_count != 0 { return 19 }
    provider.incoming = fixture
    provider.has_incoming = true
    if !Request(*provider, "switch_apply", "", 0) { return 20 }
    ProviderPump(*provider)
    if TextUntilNul(provider.queue.result[:]) != "switch" || !provider.has_incoming || current_id[0] != cast(u8)0 { return 21 }
    if !Request(*provider, "switch_cancel") { return 22 }
    ProviderPump(*provider)
    if provider.has_incoming || current_id[0] != cast(u8)0 { return 23 }
    if !Request(*provider, "create") { return 24 }
    current_id = fixture.keys.public_id
    ProviderPump(*provider)
    if provider.queue.pending || TextUntilNul(provider.queue.result[:]) != "error" || apply_count != 1 { return 25 }

    backup_checks := CheckBackupAndSignIn()
    if backup_checks != 0 { return backup_checks }

    // Shared preferences only meet at the same verified identity.
    state := EntityDefault()
    unused CopyCString("Fixture profile", state.name[:])
    if !SharedProfileSave(TextUntilNul(current_id[:]), state) { return 26 }
    loaded := EntityDefault()
    loaded.theme = 2
    EntityAddExtension(*loaded, "inbe", "Inner Breeze")
    if !SharedProfileLoad(TextUntilNul(current_id[:]), *loaded) || TextUntilNul(loaded.name[:]) != "Fixture profile" || loaded.theme != 2 || loaded.extension_count != 1 { return 27 }
    if SharedProfileLoad("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", *loaded) { return 28 }
    path: [4096]u8
    folder: [4096]u8
    document: [16385]u8
    root: [4096]u8
    address := NativeJoin(path[:], NativeRoot(root[:]), "atomic.txt")
    if !NativeWrite(address, "old") || !NativeWrite(address, "new") || NativeRead(address, document[:]) != 3 || TextUntilNul(document[:]) != "new" { return 29 }
    if !AccountStoreStart() { return 31 }
    installation := account_client_id
    if TextUntilNul(installation[:]).count != 32 { return 47 }
    if !AccountStoreStart() || TextUntilNul(account_client_id[:]) != TextUntilNul(installation[:]) { return 48 }
    unused CopyCString("Before switch", account_profile.name[:])
    if AccountStoreApply(null, *fixture, 0) != 2 || account_standalone_ready { return 32 }
    if AccountStoreApply(null, *fixture, 1) != 1 || TextUntilNul(account_profile.name[:]) != "Fixture profile" { return 33 }
    if !AccountStoreStart() || !account_standalone_ready || TextUntilNul(account_recovery.context[:]) != TextUntilNul(fixture.context[:]) { return 34 }
    action := ManagementRequest.{}
    unused CopyCString("alias_saved", action.operation[:])
    unused CopyCString("fixture_alias", action.value[:])
    if AccountStoreAction(null, *action) != 1 || !AccountStoreStart() || TextUntilNul(account_alias[:]) != "fixture_alias" { return 37 }
    unused CopyCString("logout", action.operation[:])
    if AccountStoreAction(null, *action) != 1 || account_standalone_ready || account_profile.name[0] == cast(u8)0 { return 35 }
    if !AccountStoreStart() || account_standalone_ready || account_profile.name[0] == cast(u8)0 { return 36 }
    value: [64]u8
    if !DewFormat(12345678, DewUnits, value[:], "Dew") || TextUntilNul(value[:]) != "12.345678 Dew" { return 49 }
    if !DewFormat(12000000, DewUnits, value[:]) || TextUntilNul(value[:]) != "12" { return 50 }
    if DewFormat(-1, DewUnits, value[:]) { return 51 }
    // Dew accepts node-priced integer balances only for the current account.
    account_recovery = fixture
    account_standalone_ready = true
    account_profile = EntityDefault()
    dew_owner = fixture.keys.public_id
    plan: Vec(u8)
    BuilderPrint(*plan, "{\"account_id\":\"%\",\"asset_id\":\"waozi:token\",\"units_per_dew\":1000000,\"free_bytes\":10485760,\"used_bytes\":4096,\"enabled\":true,\"plan\":{\"balance\":12000000,\"limit_bytes\":10485760,\"expires_at\":0,\"size\":\"free\"},\"plans\":[{\"size\":\"1gb\",\"limit_bytes\":1073741824,\"monthly_units\":1000000,\"yearly_units\":10000000},{\"size\":\"5gb\",\"limit_bytes\":5368709120,\"monthly_units\":5000000,\"yearly_units\":50000000}]}", TextUntilNul(fixture.keys.public_id[:]))
    response := BuilderFinish(plan)
    defer { EntityFree(response) }
    balance: DewAccount
    if !DewParseAccount(response, TextUntilNul(fixture.keys.public_id[:]), *balance) || balance.balance != 12000000 { return 40 }
    if DewParseAccount(response, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", *balance) { return 41 }
    number: s64
    if DewInteger("9223372036854775808", 0, *number) || DewInteger("1.5", 0, *number) || DewInteger("-1", 0, *number) { return 42 }
    unused CopyCString(response, dew_plan[:])
    // Play hosts must reject funding-address requests, while other hosts retain them.
    funding_command: Vec(u8)
    BuilderPrint(*funding_command, "{\"owner\":\"%\",\"sequence\":1,\"operation\":\"address\"}", TextUntilNul(fixture.keys.public_id[:]))
    funding_request := BuilderFinish(funding_command)
    defer { EntityFree(funding_request) }
    DewAllowFunding(false)
    snapshot := DewSnapshot()
    if DewEnqueue(funding_request) || !MatchLiteral(snapshot, FieldAt(snapshot, 0, "funding_allowed"), "false") { return 55 }
    DewAllowFunding(true)
    if !DewEnqueue(funding_request) { return 56 }
    dew_queued = .{}
    dew_sequence = 0
    command: Vec(u8)
    BuilderPrint(*command, "{\"owner\":\"%\",\"sequence\":1,\"operation\":\"buy\",\"size\":\"1gb\",\"period\":\"monthly\"}", TextUntilNul(fixture.keys.public_id[:]))
    request := BuilderFinish(command)
    defer { EntityFree(request) }
    if !DewEnqueue(request) || DewEnqueue(request) { return 43 }
    dew_queued = .{}
    if DewEnqueue(request) { return 44 }
    // Pending purchases cannot be replaced with a new debit.
    unused CopyCString("{\"request_id\":\"fixture-purchase\",\"size\":\"1gb\",\"period\":\"monthly\"}", dew_attempt[:])
    dew_sequence = 0
    if DewEnqueue(request) { return 45 }
    AccountStoreAction(null, *action)
    DewReset()
    if dew_active || dew_attempt[0] != cast(u8)0 || dew_plan[0] != cast(u8)0 { return 46 }
    // A node eligibility rejection must reach the game distinctly from a
    // connection failure. No failed response can become a credited reward.
    unused CopyCString("shovey.secret-chest", dew_reward_name[:])
    account_standalone_ready = true
    dew_reward_owner = account_recovery.keys.public_id
    dew_reward_migration_tried = true
    dew_reward_active = true
    dew_reward.request.done = true
    dew_reward.request.stage = 3
    dew_reward.request.status = 403
    EntityDewPump()
    if EntityDewAnswer("claim-status") != "{\"status\":\"ineligible\",\"reward\":\"shovey.secret-chest\"}" { return 52 }
    dew_reward_active = true
    dew_reward.request.status = 503
    EntityDewPump()
    if EntityDewAnswer("claim-status") != "{\"status\":\"failed\",\"reward\":\"shovey.secret-chest\"}" { return 53 }
    // Independent libsodium vector: account-bound opening proof, not a
    // reusable content key. No real identity or network is used.
    vector: [4096]u8
    if NativeRead("tests/fixtures/reward-migration.json", vector[:]) < 1 { return 54 }
    document_text := TextUntilNul(vector[:])
    response_at := FieldAt(document_text, 0, "response")
    proof_at := FieldAt(document_text, 0, "proof")
    migration_response := document_text[response_at:ValueEnd(document_text, response_at, 0)]
    expected_proof := document_text[proof_at:ValueEnd(document_text, proof_at, 0)]
    if RewardMigrationStatus("{\"status\":\"available\"}\n") != "available" ||
    RewardMigrationStatus("{\"status\":\"available\"}garbage") != "" { return 61 }
    fake_private: [2560]u8
    for index: cast(s32)0..2559 { fake_private[index] = cast(u8)(index % 251) }
    proof_body: [256]u8
    if !RewardMigrationProof(fake_private[:], "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        migration_response, *dew_reward_migration_scratch, proof_body[:]) ||
    TextUntilNul(proof_body[:]) != expected_proof { return 55 }
    if RewardMigrationProof(fake_private[:], "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        migration_response, *dew_reward_migration_scratch, proof_body[:]) || proof_body[0] != 0 { return 56 }
    fake_private[0] = 99
    if RewardMigrationProof(fake_private[:], "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        migration_response, *dew_reward_migration_scratch, proof_body[:]) || proof_body[0] != 0 { return 57 }
    for byte: dew_reward_migration_scratch.plain { if byte != 0 { return 58 } }
    for byte: dew_reward_migration_scratch.envelope { if byte != 0 { return 59 } }
    // An account switch cancels a queued claim and destroys its opening proof.
    dew_reward_active = true
    dew_reward_migration_body[0] = 1
    dew_reward_owner[0] = #char "z"
    EntityDewPump()
    if dew_reward_active || dew_reward_migration_body[0] != 0 || dew_reward_answer[0] != 0 { return 60 }
    // An alias is checked as the node stores it, so a phone keyboard's
    // capital, a leading @ and surrounding spaces still save.
    normalized: [64]u8
    accepted: [5]string = .["waozi", "Waozi", " @Waozi_1 ", "\tWAOZI\n", "a_b_c_d_e_f_g_h_i_j_k_l_m_n_o_p_"]
    expected: [5]string = .["waozi", "waozi", "waozi_1", "waozi", "a_b_c_d_e_f_g_h_i_j_k_l_m_n_o_p_"]
    for index: 0..accepted.count - 1 {
        alias := ProviderNormalizeAlias(accepted[index], normalized[:])
        if alias != expected[index] || !ProviderAliasValid(alias) { return 62 }
    }
    refused: [6]string = .["@@waozi", "wao zi", "wa-ozi", "José1", "", "a_b_c_d_e_f_g_h_i_j_k_l_m_n_o_p_q"]
    for text: refused {
        if ProviderAliasValid(ProviderNormalizeAlias(text, normalized[:])) { return 63 }
    }
    short: [4]u8
    if ProviderNormalizeAlias("waozi", short[:]) != "" { return 64 }
    // A refusal says what to change.
    failing := ManagementProvider.{}
    failing.network_operation = 1
    failing.pending_request.result = Auth.AuthResult.AUTH_REQUEST_FAILED
    failing.pending_request.status = 409
    if ProviderNetworkFailure(*failing) != "That alias is already taken; choose another" { return 65 }
    failing.pending_request.status = 400
    if ProviderNetworkFailure(*failing) != "Use 4–32 lowercase letters, numbers or underscores" { return 66 }
    failing.pending_request.status = 0
    if ProviderNetworkFailure(*failing) != "Could not reach the node; check the connection and try again" { return 67 }
    failing.pending_request.result = Auth.AuthResult.AUTH_FAILED
    if ProviderNetworkFailure(*failing) != "The node did not accept this account's key" { return 68 }
    failing.pending_request.result = Auth.AuthResult.AUTH_REQUEST_FAILED
    failing.pending_request.status = 500
    if ProviderNetworkFailure(*failing) != "The node could not complete the account request" { return 69 }
    return 0
}
