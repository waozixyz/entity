// Shared translations for every current host locale.
ReferralLabel :: (locale: string, key: string) -> string {
    if key == "referral.issuer" { return ReferralIssuerLabel(locale) }
    slot: s32 = -1
    if key == "referral.title" { slot = 0 }
    else if key == "referral.terms" { slot = 1 }
    else if key == "referral.signin" { slot = 2 }
    else if key == "referral.success" { slot = 3 }
    else if key == "referral.error" { slot = 4 }
    else if key == "referral.copy_code" { slot = 5 }
    else if key == "referral.share" { slot = 6 }
    else if key == "referral.earned" { slot = 7 }
    else if key == "referral.adjustments" { slot = 8 }
    else if key == "referral.bound" { slot = 9 }
    else if key == "referral.store" { slot = 10 }
    else if key == "referral.code" { slot = 11 }
    else if key == "referral.confirm" { slot = 12 }
    else if key == "referral.accept" { slot = 13 }
    else if key == "referral.review" { slot = 14 }
    else if key == "referral.accepted" { slot = 15 }
    else if key == "referral.empty" { slot = 16 }
    else if key == "referral.next" { slot = 17 }
    else if key == "referral.pending" { slot = 18 }
    if slot < 0 { return "" }
    if locale == "en" {
        values: [19]string = .["My referrals", "Invite unlimited friends. Earn 5% in Dew on their paid purchases. Each friend gets 20 Dew immediately when they accept.", "Sign in to accept or invite", "Accepted — your 20 Dew welcome gift is credited.", "Could not complete this request. Check the code and connection, then retry. Your account can have only one referrer.", "Copy invite code", "Copy invite link", "Total earned", "Refund adjustments / pending offset", "Your account already has a referrer.", "Referral acceptance is unavailable in this edition.", "Invite code", "Accept this code’s referrer permanently? They will see your public name or ID and acceptance date. You can have only one referrer.", "Confirm referrer and receive 20 Dew", "Review invitation", "Who accepted", "No accepted invitations yet.", "Next page", "Pending invitation"]
        return values[slot]
    }
    else if locale == "es" {
        values: [19]string = .["Mis referidos", "Invita sin límite. Gana un 5% en Dew por sus compras pagadas. Cada amigo recibe 20 Dew al aceptar.", "Inicia sesión para aceptar o invitar", "Aceptado: tus 20 Dew de bienvenida ya se abonaron.", "No se pudo completar. Revisa el código y la conexión y reintenta. Tu cuenta solo puede tener un referente.", "Copiar código", "Copiar enlace", "Total ganado", "Ajustes por reembolsos / compensación pendiente", "Tu cuenta ya tiene un referente.", "Esta edición no permite aceptar invitaciones.", "Código de invitación", "¿Aceptar permanentemente al referente de este código? Verá tu nombre público o ID y la fecha de aceptación. Solo puedes tener uno.", "Confirmar referente y recibir 20 Dew", "Revisar invitación", "Quién aceptó", "Todavía no hay invitaciones aceptadas.", "Página siguiente", "Invitación pendiente"]
        return values[slot]
    }
    else if locale == "pt" {
        values: [19]string = .["Minhas indicações", "Convide sem limite. Ganhe 5% em Dew nas compras pagas. Cada amigo recebe 20 Dew imediatamente ao aceitar.", "Entre para aceitar ou convidar", "Aceito: seus 20 Dew de boas-vindas foram creditados.", "Não foi possível concluir. Confira o código e a conexão e tente novamente. Sua conta só pode ter um indicador.", "Copiar código", "Copiar link", "Total ganho", "Ajustes de reembolso / compensação pendente", "Sua conta já tem um indicador.", "Esta edição não permite aceitar convites.", "Código do convite", "Aceitar permanentemente o indicador deste código? Ele verá seu nome público ou ID e a data de aceitação. Você só pode ter um.", "Confirmar indicador e receber 20 Dew", "Revisar convite", "Quem aceitou", "Nenhum convite aceito ainda.", "Próxima página", "Convite pendente"]
        return values[slot]
    }
    else if locale == "de" {
        values: [19]string = .["Meine Empfehlungen", "Lade unbegrenzt Freunde ein. Erhalte 5% in Dew auf ihre bezahlten Käufe. Jeder Freund erhält beim Annehmen sofort 20 Dew.", "Zum Annehmen oder Einladen anmelden", "Angenommen: Deine 20 Dew Willkommensgutschrift ist da.", "Anfrage fehlgeschlagen. Code und Verbindung prüfen und erneut versuchen. Pro Konto ist nur ein Werber möglich.", "Einladungscode kopieren", "Einladungslink kopieren", "Insgesamt verdient", "Erstattungen / ausstehender Ausgleich", "Dein Konto hat bereits einen Werber.", "In dieser Ausgabe sind keine Annahmen möglich.", "Einladungscode", "Den Werber dieses Codes dauerhaft bestätigen? Er sieht deinen öffentlichen Namen oder deine ID und das Annahmedatum. Nur ein Werber ist möglich.", "Werber bestätigen und 20 Dew erhalten", "Einladung prüfen", "Wer angenommen hat", "Noch keine angenommenen Einladungen.", "Nächste Seite", "Ausstehende Einladung"]
        return values[slot]
    }
    else if locale == "fr" {
        values: [19]string = .["Mes parrainages", "Invitez sans limite. Gagnez 5% en Dew sur leurs achats payés. Chaque ami reçoit 20 Dew dès son acceptation.", "Connectez-vous pour accepter ou inviter", "Accepté : vos 20 Dew de bienvenue sont crédités.", "Échec de la demande. Vérifiez le code et la connexion, puis réessayez. Un seul parrain est autorisé par compte.", "Copier le code", "Copier le lien", "Total gagné", "Remboursements / compensation en attente", "Votre compte a déjà un parrain.", "Cette édition ne permet pas d’accepter un parrainage.", "Code d’invitation", "Accepter définitivement le parrain de ce code ? Il verra votre nom public ou identifiant et la date d’acceptation. Un seul parrain est possible.", "Confirmer le parrain et recevoir 20 Dew", "Vérifier l’invitation", "Qui a accepté", "Aucune invitation acceptée pour le moment.", "Page suivante", "Invitation en attente"]
        return values[slot]
    }
    else if locale == "it" {
        values: [19]string = .["I miei inviti", "Invita senza limiti. Guadagna il 5% in Dew sui loro acquisti pagati. Ogni amico riceve subito 20 Dew quando accetta.", "Accedi per accettare o invitare", "Accettato: i tuoi 20 Dew di benvenuto sono accreditati.", "Richiesta non riuscita. Controlla codice e connessione e riprova. Ogni account può avere un solo referente.", "Copia codice", "Copia link", "Totale guadagnato", "Rimborsi / compensazione in attesa", "Il tuo account ha già un referente.", "Questa edizione non consente di accettare inviti.", "Codice invito", "Accettare definitivamente il referente di questo codice? Vedrà il tuo nome pubblico o ID e la data di accettazione. Puoi averne solo uno.", "Conferma referente e ricevi 20 Dew", "Esamina invito", "Chi ha accettato", "Nessun invito ancora accettato.", "Pagina successiva", "Invito in attesa"]
        return values[slot]
    }
    else if locale == "cs" {
        values: [19]string = .["Moje doporučení", "Zvěte přátele bez omezení. Získejte 5% v Dew z jejich placených nákupů. Každý přítel dostane ihned po přijetí 20 Dew.", "Přihlaste se pro přijetí nebo pozvání", "Přijato: uvítacích 20 Dew bylo připsáno.", "Požadavek se nezdařil. Zkontrolujte kód a připojení a zkuste to znovu. Účet může mít jen jednoho doporučitele.", "Kopírovat kód", "Kopírovat odkaz", "Celkem získáno", "Vratky / čekající vyrovnání", "Váš účet už má doporučitele.", "V této edici nelze přijímat pozvánky.", "Kód pozvánky", "Trvale přijmout doporučitele tohoto kódu? Uvidí vaše veřejné jméno nebo ID a datum přijetí. Můžete mít jen jednoho.", "Potvrdit doporučitele a získat 20 Dew", "Zkontrolovat pozvánku", "Kdo přijal", "Zatím žádné přijaté pozvánky.", "Další stránka", "Čekající pozvánka"]
        return values[slot]
    }
    else if locale == "id" {
        values: [19]string = .["Referal saya", "Undang teman tanpa batas. Dapatkan 5% dalam Dew dari pembelian berbayar mereka. Setiap teman langsung mendapat 20 Dew saat menerima.", "Masuk untuk menerima atau mengundang", "Diterima: hadiah sambutan 20 Dew sudah dikreditkan.", "Permintaan gagal. Periksa kode dan koneksi, lalu coba lagi. Akun hanya boleh memiliki satu pengundang.", "Salin kode undangan", "Salin tautan undangan", "Total diperoleh", "Penyesuaian pengembalian / kompensasi tertunda", "Akun Anda sudah memiliki pengundang.", "Penerimaan referal tidak tersedia di edisi ini.", "Kode undangan", "Terima pengundang kode ini secara permanen? Mereka akan melihat nama publik atau ID dan tanggal penerimaan Anda. Anda hanya boleh memiliki satu pengundang.", "Konfirmasi pengundang dan terima 20 Dew", "Tinjau undangan", "Siapa yang menerima", "Belum ada undangan yang diterima.", "Halaman berikutnya", "Undangan tertunda"]
        return values[slot]
    }
    else if locale == "ru" {
        values: [19]string = .["Мои приглашения", "Приглашайте без ограничений. Получайте 5% в Dew с оплаченных покупок друзей. Каждый друг сразу получает 20 Dew при принятии.", "Войдите, чтобы принять или пригласить", "Принято: приветственные 20 Dew зачислены.", "Запрос не выполнен. Проверьте код и соединение, затем повторите. У аккаунта может быть только один пригласивший.", "Скопировать код", "Скопировать ссылку", "Всего заработано", "Возвраты / ожидающий зачёт", "У вашего аккаунта уже есть пригласивший.", "В этой версии нельзя принимать приглашения.", "Код приглашения", "Навсегда подтвердить пригласившего по этому коду? Он увидит ваше публичное имя или ID и дату принятия. Можно выбрать только одного.", "Подтвердить и получить 20 Dew", "Проверить приглашение", "Кто принял", "Пока никто не принял приглашение.", "Следующая страница", "Ожидающее приглашение"]
        return values[slot]
    }
    else if locale == "ja" {
        values: [19]string = .["紹介した友達", "何人でも招待できます。友達の有料購入額の5%をDewで獲得。友達は招待を承諾するとすぐに20 Dewを受け取れます。", "ログインして承諾・招待", "承諾しました。特典の20 Dewが付与されました。", "処理できませんでした。コードと接続を確認して再試行してください。紹介者は1アカウントにつき1人です。", "招待コードをコピー", "招待リンクをコピー", "累計獲得額", "返金調整 / 相殺待ち", "このアカウントには既に紹介者がいます。", "このエディションでは招待を承諾できません。", "招待コード", "このコードの紹介者を永久に確定しますか？公開名またはIDと承諾日が紹介者に表示されます。紹介者は1人のみです。", "紹介者を確定して20 Dewを受け取る", "招待を確認", "承諾した人", "承諾された招待はまだありません。", "次のページ", "保留中の招待"]
        return values[slot]
    }
    else if locale == "ko" {
        values: [19]string = .["내 추천", "친구를 무제한으로 초대하세요. 친구의 유료 구매액 중 5%를 Dew로 받습니다. 친구는 수락 즉시 20 Dew를 받습니다.", "수락하거나 초대하려면 로그인", "수락 완료: 환영 선물 20 Dew가 지급되었습니다.", "요청을 완료하지 못했습니다. 코드와 연결을 확인하고 다시 시도하세요. 계정당 추천인은 한 명뿐입니다.", "초대 코드 복사", "초대 링크 복사", "총 적립", "환불 조정 / 상계 대기", "이 계정에는 이미 추천인이 있습니다.", "이 버전에서는 초대를 수락할 수 없습니다.", "초대 코드", "이 코드의 추천인을 영구 확정할까요? 추천인에게 공개 이름 또는 ID와 수락 날짜가 표시됩니다. 추천인은 한 명만 가능합니다.", "추천인 확정 및 20 Dew 받기", "초대 검토", "수락한 사람", "아직 수락된 초대가 없습니다.", "다음 페이지", "보류 중인 초대"]
        return values[slot]
    }
    else if locale == "zh" {
        values: [19]string = .["我的推荐", "邀请人数不限。好友付费购买时，您可获得5%的Dew奖励。好友接受邀请后立即获得20 Dew。", "登录以接受或邀请", "已接受，20 Dew欢迎礼已到账。", "请求未完成。请检查邀请码和网络后重试。每个账户只能有一位推荐人。", "复制邀请码", "复制邀请链接", "累计获得", "退款调整 / 待抵扣", "您的账户已有推荐人。", "此版本无法接受邀请。", "邀请码", "永久确认此邀请码的推荐人？对方将看到您的公开名称或ID及接受日期。每个账户只能有一位推荐人。", "确认推荐人并领取20 Dew", "查看邀请", "已接受的好友", "暂无已接受的邀请。", "下一页", "待接受的邀请"]
        return values[slot]
    }
    return ReferralLabel("en", key)
}

ReferralIssuerLabel :: (locale: string) -> string {
    if locale == "cs" { return "Doporučení vyžadují uzel účtu https://api.waozi.xyz. Změňte uzel v profilu." }
    if locale == "de" { return "Empfehlungen erfordern den Konto-Knoten https://api.waozi.xyz. Ändere den Knoten im Profil." }
    if locale == "es" { return "Los referidos requieren el nodo https://api.waozi.xyz. Cambia el nodo de tu cuenta en Perfil." }
    if locale == "fr" { return "Le parrainage nécessite le nœud https://api.waozi.xyz. Changez le nœud du compte dans Profil." }
    if locale == "id" { return "Referal memerlukan node akun https://api.waozi.xyz. Ubah node di Profil." }
    if locale == "it" { return "Gli inviti richiedono il nodo https://api.waozi.xyz. Cambia il nodo dell’account nel Profilo." }
    if locale == "ja" { return "紹介にはアカウントのノード https://api.waozi.xyz が必要です。プロフィールでノードを変更してください。" }
    if locale == "ko" { return "추천에는 계정 노드 https://api.waozi.xyz가 필요합니다. 프로필에서 노드를 변경하세요." }
    if locale == "pt" { return "As indicações exigem o nó https://api.waozi.xyz. Altere o nó da conta no Perfil." }
    if locale == "ru" { return "Для приглашений нужен узел https://api.waozi.xyz. Измените узел аккаунта в профиле." }
    if locale == "zh" { return "推荐功能要求账户使用 https://api.waozi.xyz 节点。请在个人资料中更改节点。" }
    return "Referrals require the account’s node to be https://api.waozi.xyz. Change the node in Profile to continue."
}
