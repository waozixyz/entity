// Included by Entity so Friends uses the same fields and navigation as Profile.
friends_target: [129]u8;
friends_page: [100353]u8;
friends_refresh: bool = true;
friends_remove: [65]u8;
friends_page_owner: [65]u8;

FriendAction :: (operation: string, target: string) {
    out: Vec(u8)
    BuilderPrint(*out, "{\"owner\":")
    EntityQuote(*out, TextUntilNul(management.public_id[:]))
    BuilderPrint(*out, ",\"operation\":")
    EntityQuote(*out, operation)
    BuilderPrint(*out, ",\"target\":")
    EntityQuote(*out, target)
    BuilderPrint(*out, "}")
    request := BuilderFinish(out)
    reply := AppService("entity.friends", request)
    AchievementRelease(request)
    notice = ifx reply == "queued" then Label("entity.working", "Working…") else Label("entity.action_error", "Could not start this action")
    if reply == "queued" { fields = .{} }
}

FriendName :: (document: string, item: s32, name_key: string, id_key: string, output: []u8) -> string {
    alias: [40]u8
    identity: [65]u8
    if ReadStringText(document, FieldAt(document, item, name_key), alias[:]) > 0 {
        out: Vec(u8)
        BuilderPrint(*out, "@%", TextUntilNul(alias[:]))
        name := BuilderFinish(out)
        unused CopyCString(name, output)
        AchievementRelease(name)
    } else {
        unused ReadStringText(document, FieldAt(document, item, id_key), identity[:])
        unused CopyCString(ShortId(TextUntilNul(identity[:])), output)
    }
    return TextUntilNul(output)
}


FriendsPage :: (x: float32, y: *float32, width: float32) {
    if !management.account { SignInChoices(x, y, width); return }
    if TextUntilNul(friends_page_owner[:]) != TextUntilNul(management.public_id[:]) {
        friends_page_owner = management.public_id
        friends_target = .{}
        friends_remove = .{}
        friends_refresh = true
    }
    request := ifx friends_refresh then "refresh" else ""
    friends_refresh = false
    response := AppService("entity.friends", request)
    if response.count >= friends_page.count || !CopyCString(response, friends_page[:]) { return }
    document := TextUntilNul(friends_page[:])
    owner: [65]u8
    if ReadStringText(document, FieldAt(document, 0, "owner"), owner[:]) != 64 ||
    TextUntilNul(owner[:]) != TextUntilNul(management.public_id[:]) { return }
    busy := MatchLiteral(document, FieldAt(document, 0, "busy"), "true")
    if !busy && notice == Label("entity.working", "Working…") { notice = "" }
    unused EditField(2, friends_target[:], Label("profile_friend_target", "Alias or public ID"), Rectangle.{x, y.*, width, 48.0 * scale}, 128)
    y.* += 60.0 * scale
    typed_target := friends_target
    if !busy && WideButton(60000, Label("profile_add_friend", "Add friend"), x, y, width, true) { FriendAction("add", TextUntilNul(typed_target[:])) }
    if WideButton(60001, Label("entity.refresh", "Refresh"), x, y, width) { friends_refresh = true }
    if busy { Muted(60002, Label("entity.working", "Working…"), x, y.*, width); y.* += 32.0 * scale }
    if MatchLiteral(document, FieldAt(document, 0, "error"), "true") {
        Paragraph(60003, Label("profile_friends_error", "Could not update friends. Check the connection and try again."), x, y.*, width, 56.0)
        y.* += 64.0 * scale
    }
    at := FieldAt(document, FieldAt(document, 0, "list"), "friends")
    count := ArrayCount(document, at)
    if count == 0 && !busy { Muted(60004, Label("profile_no_friends", "No friends yet."), x, y.*, width); y.* += 36.0 * scale }
    for index: cast(s32)0..count - 1 {
        if index >= 128 { break }
        item := ElementAt(document, at, index)
        name: [80]u8
        id: [65]u8
        unused ReadStringText(document, FieldAt(document, item, "user_id_hash"), id[:])
        icon := ReadNumber(document, FieldAt(document, item, "profile_icon"))
        picture: s32 = -1
        if icon.valid { picture = EntityPictureFromPublicIcon(cast(s32)icon.value) }
        abstract := ifx icon.valid then EntityAbstractFromPublicIcon(cast(s32)icon.value) else -1
        image_bounds := Rectangle.{x, y.*, 44.0 * scale, 44.0 * scale}
        if abstract >= 0 { Image(session, AbstractPicture(abstract, image_bounds)) }
        else if picture >= 0 { Image(session, Picture(picture, image_bounds)) }
        game: [65]u8
        unused ReadStringText(document, FieldAt(document, 0, "game"), game[:])
        wurm := TextUntilNul(game[:]) == "wurm" || TextUntilNul(game[:]) == "xyz.waozi.wurm"
        if wurm {
            if abstract >= 0 || picture >= 0 {
                image_bounds = Rectangle.{x + 24.0 * scale, y.* + 24.0 * scale, 24.0 * scale, 24.0 * scale}
            }
            unused ProfileLeaderboardWurm(session, cast(u64)(63000 + index * 10), FriendWurmSkin(document, TextUntilNul(id[:])), image_bounds)
        } else if abstract < 0 && picture < 0 {
            fallback := EntityAbstractFromPublicIcon(EntityFriendIcon(0, TextUntilNul(id[:])))
            Image(session, AbstractPicture(fallback, image_bounds))
        }
        TextLine(cast(u64)(60100 + index * 4), FriendName(document, item, "alias", "user_id_hash", name[:]), x + 52.0 * scale, y.*, width - 152.0 * scale, 16)
        confirming := TextUntilNul(friends_remove[:]) == TextUntilNul(id[:])
        if !busy && Action(60101 + index * 4, Label(ifx confirming then "entity.confirm" else "profile_remove_friend", ifx confirming then "Confirm" else "Remove"),
                Rectangle.{x + width - 96.0 * scale, y.*, 96.0 * scale, 44.0 * scale}) {
            if confirming { FriendAction("remove", TextUntilNul(id[:])) } else { friends_remove = id }
        }
        y.* += 56.0 * scale
    }
    request_root := FieldAt(document, 0, "requests")
    for direction: cast(s32)0..1 {
    at = FieldAt(document, request_root, ifx direction == 0 then "incoming" else "outgoing")
    count = ArrayCount(document, at)
    for index: cast(s32)0..count - 1 {
        if index >= 128 { break }
        item := ElementAt(document, at, index)
        if !MatchLiteral(document, FieldAt(document, item, "status"), "\"pending\"") { continue }
        target: [65]u8
        id: [129]u8
        name: [80]u8
        unused ReadStringText(document, FieldAt(document, item, "target_user_id_hash"), target[:])
        unused ReadStringText(document, FieldAt(document, item, "id"), id[:])
        incoming := direction == 0 && TextUntilNul(target[:]) == TextUntilNul(management.public_id[:])
        row_key := 61000 + direction * 1000 + index * 4
        name_text := FriendName(document, item,
            ifx incoming then "requester_alias" else "target_alias", ifx incoming then "requester_user_id_hash" else "target_user_id_hash", name[:])
        if incoming {
            TextLine(cast(u64)row_key, name_text, x, y.*, width, 16)
            y.* += 36.0 * scale
            if !busy {
                half := (width - 8.0 * scale) * 0.5
                if Action(row_key + 1, Label("profile_accept_friend", "Accept"), Rectangle.{x, y.*, half, 44.0 * scale}) { FriendAction("accept", TextUntilNul(id[:])) }
                if Action(row_key + 2, Label("profile_decline_friend", "Decline"), Rectangle.{x + half + 8.0 * scale, y.*, half, 44.0 * scale}) { FriendAction("decline", TextUntilNul(id[:])) }
                y.* += 56.0 * scale
            }
        } else {
            // Keep the sent state beside the name and leave a separate touch target.
            cancel_width := 72.0 * scale
            content_width := width - cancel_width - 16.0 * scale
            status_width := content_width * 0.5
            TextLine(cast(u64)row_key, name_text, x, y.* + 8.0 * scale, content_width - status_width - 8.0 * scale, 16)
            Muted(cast(u64)(row_key + 3), Label("profile_request_sent", "Request sent"),
                x + content_width - status_width, y.* + 8.0 * scale, status_width)
            // Daochi lets the sender withdraw a pending request through decline.
            if !busy && Action(row_key + 2, Label("entity.cancel", "Cancel"),
                    Rectangle.{x + width - cancel_width, y.*, cancel_width, 44.0 * scale}) {
                FriendAction("decline", TextUntilNul(id[:]))
            }
            y.* += 56.0 * scale
        }
    }
    }
}
