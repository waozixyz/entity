// Profile owns the leaderboard UI in every host. The host supplies only
// installed boards and ranked display values through entity.leaderboard.
#import "leaderboard_model"
#import "achievement_view"
#import "kryon/app_context"
#import "kryon/dropdown_props"
#import "kryon/dropdown_widget"
#import "std/number_text"
#import "std/c_string"
#import "std/text_buffer"
#import "std/vec"
#import "model"
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/button_props"
#import "kryon/button_widget"
#import "kryon/scroll_props"
#import "kryon/scroll_widget"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/tree"
#import "kryon/text_widget"
#import "kryon/text_props"
#import "kryon/text_align"
#import "kryon/image_props"
#import "kryon/image_widget"
#import "kryon/svg_icon_props"
#import "kryon/svg_icon_widget"
#import "profile_theme"

profile_leaderboard_open: bool;
profile_leaderboard_ready: bool;
profile_leaderboard_page: ProfileLeaderboard;
profile_leaderboard_scroll: s32;
profile_leaderboard_ticks: s32;
profile_leaderboard_request: [256]u8;

LeaderboardLabel :: (key: string, fallback: string) -> string {
    label := AppLocale(key)
    return ifx label == "" || label == key then fallback else label
}

ProfileLeaderboardPicture :: (session: Session, key: u64, icon: s32, bounds: Rectangle) {
    picture := EntityPictureFromPublicIcon(icon)
    abstract := EntityAbstractFromPublicIcon(icon)
    if picture < 0 && abstract < 0 {
        SvgIcon(session, SvgIconProps.{.bounds = bounds,
            .shape = "S1.7rr:M12 12C16 12 18 16 18 20H6C6 16 8 12 12 12ZM16 6A4 4 0 1 1 8 6A4 4 0 1 1 16 6",
            .color = ThemeOr("text", 0xe5eef3ff, 0x203b4bff)})
        return
    }
    root := AppService("entity.assets", "")
    asset := ifx abstract >= 0 then EntityAbstractPictureAsset(abstract) else ifx picture == 9 then "assets/entity/flowers.png" else "assets/entity/pfp.png"
    out: Vec(u8)
    if root == "" { BuilderPrint(*out, "%", asset) }
    else { BuilderPrint(*out, "%/%", root, asset) }
    path := BuilderFinish(out)
    Image(session, ImageProps.{.key = key, .asset_path = path, .bounds = bounds,
        .source = ifx abstract >= 0 || picture == 9 then Rectangle.{} else Rectangle.{cast(float32)(picture % 5) * 64.0,
            cast(float32)(picture / 5) * 64.0, 64.0, 64.0},
        .fit = ImageFit.ImageFitContain, .alt_text = LeaderboardLabel("entity.picture", "Profile picture")})
    AchievementRelease(path)
}

// The released Apfelwurm skins, rendered with the game's own colours and
// markings. Only its stable board ID may choose this trusted game badge.
ProfileLeaderboardWurm :: (session: Session, key: u64, icon: s32, bounds: Rectangle) -> bool {
    skin := ifx icon >= 1 && icon <= 9 then icon - 1 else 0
    if skin >= 7 {
        root := AppService("entity.assets", "")
        out: Vec(u8)
        if root != "" { BuilderPrint(*out, "%/", root) }
        BuilderPrint(*out, "assets/entity/wurm-special-skins.png")
        path := BuilderFinish(out)
        column := ifx skin == 7 then 0 else 2
        for segment: cast(s32)0..2 {
            head := segment == 2
            size := bounds.width * (ifx head then 0.72 else 0.5)
            Image(session, ImageProps.{.key = key + cast(u64)segment,
                .asset_path = path, .bounds = Rectangle.{bounds.x + cast(float32)segment * bounds.width * 0.16,
                    bounds.y + (ifx head then 0.0 else bounds.height * 0.34), size, size},
                .source = Rectangle.{cast(float32)(column + (ifx head then 0 else 1)) * 543.0, 0.0, 543.0, 724.0},
                .fit = ImageFit.ImageFitContain, .alt_text = LeaderboardLabel("entity.picture", "Profile picture")})
        }
        AchievementRelease(path)
        return true
    }
    colours: [7]Color = .[Color.{236, 151, 67, 255}, Color.{94, 192, 151, 255},
        Color.{154, 119, 207, 255}, Color.{221, 133, 151, 255}, Color.{107, 139, 199, 255},
        Color.{227, 185, 80, 255}, Color.{135, 173, 91, 255}]
    unit := bounds.width / 32.0
    for segment: cast(s32)0..2 {
        size := (ifx segment == 2 then 20.0 else 14.0) * unit
        left := bounds.x + cast(float32)segment * 6.0 * unit
        top := bounds.y + (ifx segment == 2 then 3.0 else 16.0 - cast(float32)segment * 4.0) * unit
        Box(session, BoxProps.{.key = key + cast(u64)segment,
            .bounds = Rectangle.{left, top, size, size}, .fill = colours[skin],
            .radius = size / 2.0, .border = Color.{30, 48, 35, 100}})
    }
    for eye: cast(s32)0..1 {
        left := bounds.x + 25.0 * unit
        top := bounds.y + (8.0 + cast(float32)eye * 8.0) * unit
        Box(session, BoxProps.{.key = key + 3 + cast(u64)eye * 2,
            .bounds = Rectangle.{left, top, 4.0 * unit, 4.0 * unit},
            .fill = Color.{246, 244, 223, 255}, .radius = 2.0 * unit})
        Box(session, BoxProps.{.key = key + 4 + cast(u64)eye * 2,
            .bounds = Rectangle.{left + 1.0 * unit, top + 1.0 * unit, 2.0 * unit, 2.0 * unit},
            .fill = Color.{28, 44, 35, 255}, .radius = 1.0 * unit})
    }
    if skin >= 4 {
        shape := "S2rr:M3 19L9 5L15 15L18 10L22 19Z"
        if skin == 4 { shape = "S1.6rr:M19 15A8 8 0 0 1 9 5A8 8 0 1 0 19 15Z" }
        if skin == 5 { shape = "S1.6rr:M12 2L15 9L22 9L17 14L19 22L12 17L5 22L7 14L2 9L9 9Z" }
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{bounds.x + 16.0 * unit, bounds.y, 10.0 * unit, 10.0 * unit},
            .shape = shape, .color = Color.{249, 229, 157, 255}})
    }
    return true
}

ProfileLeaderboardCommand :: (command: string) -> bool {
    if command == "reload" {
        profile_leaderboard_open = false
        profile_leaderboard_ready = false
        profile_leaderboard_page = .{}
        return false
    }
    if command == "leaderboard" && AppSupports(LEADERBOARD_SERVICE) {
        profile_leaderboard_open = true
        profile_leaderboard_ready = false
        profile_leaderboard_scroll = 0
        profile_leaderboard_request = .{}
        unused CopyCString("refresh", profile_leaderboard_request[:])
        return true
    }
    if command == "back" && profile_leaderboard_open {
        profile_leaderboard_open = false
        profile_leaderboard_ready = false
        AppReply("handled")
        return true
    }
    return false
}

ProfileLeaderboardSelect :: (index: s32, metric: s32) {
    if index < 0 || index >= profile_leaderboard_page.board_count { return }
    request: Vec(u8)
    BuilderPrint(*request, "{\"owner\":")
    EntityQuote(*request, TextUntilNul(profile_leaderboard_page.owner[:]))
    BuilderPrint(*request, ",\"board\":")
    EntityQuote(*request, TextUntilNul(profile_leaderboard_page.boards[index].id[:]))
    BuilderPrint(*request, ",\"metric\":%}", metric)
    document := BuilderFinish(request)
    unused CopyCString(document, profile_leaderboard_request[:])
    AchievementRelease(document)
    profile_leaderboard_ready = false
    profile_leaderboard_scroll = 0
}

ProfileLeaderboardFrame :: (navigation: bool) -> bool {
    if !profile_leaderboard_open { return false }
    profile_leaderboard_ticks += 1
    // Query on every frame to discard account changes and uninstalled boards
    // immediately. Providers cache/rank results outside their network work.
    response := AppService(LEADERBOARD_SERVICE, TextUntilNul(profile_leaderboard_request[:]))
    profile_leaderboard_request = .{}
    next: ProfileLeaderboard
    if ProfileLeaderboardDecode(response, *next) {
        if TextUntilNul(next.owner[:]) != TextUntilNul(profile_leaderboard_page.owner[:]) {
            profile_leaderboard_scroll = 0
        }
        profile_leaderboard_page = next
        profile_leaderboard_ready = true
    } else {
        // Never leave another account's rows on screen after a failed query.
        profile_leaderboard_page = .{}
        profile_leaderboard_ready = false
    }
    page := *profile_leaderboard_page
    session := AppSession()
    scale := AppScale()
    if scale <= 0.0 { scale = 1.0 }
    area := AppBounds()
    width := area.width - 32.0 * scale
    if width > 720.0 * scale { width = 720.0 * scale }
    if width < 120.0 * scale { return true }
    x := area.x + (area.width - width) * 0.5
    y := area.y + 12.0 * scale
    font := cast(s32)(14.0 * scale)
    if navigation {
        if Button(session, ButtonProps.{.id = 55000, .bounds = Rectangle.{x, y, width, 44.0 * scale},
                .label = LeaderboardLabel("entity.back", "Back")}) != 0 {
            profile_leaderboard_open = false
        }
        y += 56.0 * scale
    }
    if navigation {
        AchievementText(session, 55001, LeaderboardLabel("leaderboard_title", "Leaderboard"),
            Rectangle.{x, y, width, 36.0 * scale}, cast(s32)(24.0 * scale))
        y += 44.0 * scale
    }
    if page.error {
        AchievementText(session, 55004, LeaderboardLabel("leaderboard_refresh_failed", "Could not refresh the leaderboard."),
            Rectangle.{x, y, width, 64.0 * scale}, font)
        y += 48.0 * scale
        if Button(session, ButtonProps.{.id = 55005, .bounds = Rectangle.{x, y, width, 44.0 * scale},
                .label = LeaderboardLabel("profile_dew_retry", "Try again")}) != 0 {
            unused CopyCString("refresh", profile_leaderboard_request[:])
        }
        y += 56.0 * scale
    }
    if page.loading {
        for dot: cast(s32)0..2 {
            color := ThemeOr("text", 0xe5eef3ff, 0x203b4bff)
            color.a = ifx (profile_leaderboard_ticks / 10) % 3 == dot then 255 else 64
            Box(session, BoxProps.{.key = cast(u64)(55007 + dot),
                .bounds = Rectangle.{x + cast(float32)dot * 7.0 * scale, y + 12.0 * scale, 4.0 * scale, 4.0 * scale},
                .fill = color, .radius = 2.0 * scale})
        }
        AchievementText(session, 55006, LeaderboardLabel("profile_updating_status", "Updating…"),
            Rectangle.{x + 28.0 * scale, y, width - 28.0 * scale, 32.0 * scale}, font)
        y += 40.0 * scale
    }
    if !profile_leaderboard_ready || page.board_count == 0 {
        AchievementText(session, 55002, LeaderboardLabel("profile_updating_status", "Updating…"),
            Rectangle.{x, y, width, 80.0 * scale}, font)
        return true
    }
    current := *page.boards[page.selected]
    apps: [LEADERBOARD_BOARDS]DropdownOption
    first: [LEADERBOARD_BOARDS]s32
    app_count: s32 = 0
    selected_app: s32 = 0
    for index: cast(s32)0..page.board_count - 1 {
        app := TextUntilNul(page.boards[index].app[:])
        seen := false
        for prior: cast(s32)0..app_count - 1 {
            if TextUntilNul(page.boards[first[prior]].app[:]) == app { seen = true }
        }
        if seen { continue }
        if app == TextUntilNul(current.app[:]) { selected_app = app_count }
        first[app_count] = index
        apps[app_count].label = TextUntilNul(page.boards[index].app_title[:])
        app_count += 1
    }
    if app_count > 1 {
        menu := Dropdown(session, DropdownProps.{.id = 55003, .bounds = Rectangle.{x, y, width, 44.0 * scale},
                .selected_index = selected_app, .scale = scale}, apps[:app_count])
        if menu.changed && menu.selected_index >= 0 && menu.selected_index < app_count {
            ProfileLeaderboardSelect(first[menu.selected_index], 0)
        }
        y += 56.0 * scale
    }
    choices: [LEADERBOARD_BOARDS]s32
    count: s32 = 0
    for index: cast(s32)0..page.board_count - 1 {
        if TextUntilNul(page.boards[index].app[:]) == TextUntilNul(current.app[:]) {
            choices[count] = index
            count += 1
        }
    }
    columns := cast(s32)((width + 8.0 * scale) / (168.0 * scale))
    if columns < 2 { columns = 2 }
    rows: s32 = 0
    if count > 1 {
        rows = (count + columns - 1) / columns
        columns = (count + rows - 1) / rows
    }
    choice_width := (width - cast(float32)(columns - 1) * 8.0 * scale) / cast(float32)columns
    row_height := cast(s32)(44.0 * scale)
    content_height := cast(s32)(cast(float32)rows * 48.0 * scale + 116.0 * scale) + page.row_count * row_height
    scroll := Scroll(session, ScrollProps.{.key = cast(u64)55300,
            .bounds = Rectangle.{x, y, width, area.y + area.height - y - 8.0 * scale},
            .content_height = content_height, .scroll_offset = profile_leaderboard_scroll})
    profile_leaderboard_scroll = scroll.scroll_offset
    if !scroll.opened { return true }
    x = scroll.content.x
    width = scroll.content.width
    choice_width = (width - cast(float32)(columns - 1) * 8.0 * scale) / cast(float32)columns
    y = scroll.content.y
    for index: cast(s32)0..(ifx count > 1 then count else 0) - 1 {
        chosen := choices[index]
        if Button(session, ButtonProps.{.id = 55100 + index,
                .bounds = Rectangle.{x + cast(float32)(index % columns) * (choice_width + 8.0 * scale),
                    y + cast(float32)(index / columns) * 48.0 * scale, choice_width, 40.0 * scale},
                .label = TextUntilNul(page.boards[chosen].title[:]), .selected = chosen == page.selected,
                .fit_content = true}) != 0 && chosen != page.selected {
            ProfileLeaderboardSelect(chosen, 0)
        }
    }
    y += cast(float32)rows * 48.0 * scale + 8.0 * scale
    average := current.average[0] != cast(u8)0
    name_width := width * (ifx average then 0.5 else 0.666667)
    value_width := (width - name_width) / (ifx average then 2.0 else 1.0)
    Text(session, TextProps.{.key = cast(u64)55200,
        .text = LeaderboardLabel("profile_friends_title", "Friends"),
        .bounds = Rectangle.{x + 84.0 * scale, y, name_width - 92.0 * scale, 44.0 * scale},
        .font = font, .vertical_align = TextAlign.TextAlignCenter, .wrap = TextWrap.TextWrapEllipsis})
    for metric: cast(s32)0..(ifx average then 1 else 0) {
        left := x + name_width + cast(float32)metric * value_width
        label := TextUntilNul(ifx metric == 0 then current.primary[:] else current.average[:])
        if Button(session, ButtonProps.{.id = 55201 + metric,
                .bounds = Rectangle.{left, y, value_width, 44.0 * scale},
                .label = label, .invisible = true}) != 0 && metric != page.metric {
            ProfileLeaderboardSelect(page.selected, metric)
        }
        Text(session, TextProps.{.key = cast(u64)(55210 + metric), .text = label,
            .bounds = Rectangle.{left + 8.0 * scale, y, value_width - 16.0 * scale, 44.0 * scale},
            .font = font, .align = TextAlign.TextAlignEnd, .vertical_align = TextAlign.TextAlignCenter,
            .wrap = TextWrap.TextWrapEllipsis})
        if metric == page.metric {
            Box(session, BoxProps.{.key = cast(u64)(55220 + metric),
                .bounds = Rectangle.{left + 8.0 * scale, y + 42.0 * scale, value_width - 16.0 * scale, 2.0 * scale},
                .fill = Color.{73, 166, 142, 255}})
        }
    }
    y += 44.0 * scale
    if page.row_count == 0 {
        AchievementText(session, 55204, LeaderboardLabel("profile_updating_status", "Updating…"),
            Rectangle.{x, y, width, 64.0 * scale}, font)
        unused End(session)
        return true
    }
    for index: cast(s32)0..page.row_count - 1 {
        row := *page.rows[index]
        row_y := y + cast(float32)(index * row_height)
        key := cast(u64)(55400 + index * 16)
        if row.own || index % 2 == 1 {
            Box(session, BoxProps.{.key = key, .bounds = Rectangle.{x, row_y, width, cast(float32)row_height},
                    .fill = ifx row.own then Color.{156, 188, 143, 64} else Color.{156, 156, 156, 24}, .radius = 8.0 * scale})
        }
        rank: [16]u8
        rank_text := FormatInteger(index + 1, rank[:])
        Text(session, TextProps.{.key = key + 1, .text = rank_text,
            .bounds = Rectangle.{x + 8.0 * scale, row_y, 24.0 * scale, cast(float32)row_height},
            .font = font, .align = TextAlign.TextAlignEnd, .vertical_align = TextAlign.TextAlignCenter,
            .wrap = TextWrap.TextWrapEllipsis})
        Text(session, TextProps.{.key = key + 2, .text = TextUntilNul(row.name[:]),
            .bounds = Rectangle.{x + 84.0 * scale, row_y, name_width - 92.0 * scale, cast(float32)row_height},
            .font = font, .vertical_align = TextAlign.TextAlignCenter, .wrap = TextWrap.TextWrapEllipsis})
        Text(session, TextProps.{.key = key + 3, .text = TextUntilNul(row.value[:]),
            .bounds = Rectangle.{x + name_width + 8.0 * scale, row_y, value_width - 16.0 * scale, cast(float32)row_height},
            .font = font, .align = TextAlign.TextAlignEnd, .vertical_align = TextAlign.TextAlignCenter,
            .wrap = TextWrap.TextWrapEllipsis})
        picture_bounds := Rectangle.{x + 40.0 * scale, row_y + 6.0 * scale, 32.0 * scale, 32.0 * scale}
        game := TextUntilNul(current.id[:])
        worm := (game == "xyz.waozi.wurm" || game == "wurm") &&
            ProfileLeaderboardWurm(session, key + 5, row.game_icon, picture_bounds)
        if !worm { ProfileLeaderboardPicture(session, key + 5, row.icon, picture_bounds) }
        if average {
            Text(session, TextProps.{.key = key + 4, .text = TextUntilNul(row.average[:]),
                .bounds = Rectangle.{x + name_width + value_width + 8.0 * scale, row_y, value_width - 16.0 * scale, cast(float32)row_height},
                .font = font, .align = TextAlign.TextAlignEnd, .vertical_align = TextAlign.TextAlignCenter,
                .wrap = TextWrap.TextWrapEllipsis})
        }
    }
    unused End(session)
    AppKeyboard(false)
    return true
}
