#import "game_shop"
#import "account_store"
#import "recovery"
#import "dew_native"
#import "native_files"
#import "model"
#import "entity_records"
#import "std/c_string"
#import "std/text_buffer"
#import "std/json_scan"
#import "std/net_http"
#import "std/vec"
#import "std/date_time_linux"
#import "daochi_client/async_client"
#import "daochi_client/client"
Auth :: #import "daochi_client/auth";
ShopWire :: #import "daochi_client/entity";
#import "kryon/http_transfer"
#import "kryon/open_uri"

shop_owner: [65]u8;
shop_owned: s32;
shop_loaded: bool;
shop_requested: bool;
shop_active: bool;
shop_product: s32;
shop_status: string = "idle";
shop_request: PendingRequest;
shop_session: Auth.Session;
shop_transfer: HttpTransfer;
shop_response: [131072]u8;
shop_answer: [1024]u8;
// Kept only in memory, scoped to the authenticated owner. Never part of status.
shop_grant: bool;
shop_grant_status: string = "idle";
shop_grant_token: [512]u8;
shop_grant_expires: s64;
shop_grant_answer: [1024]u8;
shop_island_quote: bool;
shop_island_price: s64;
shop_island_confirmed: s64;
// Native hosts may supply their platform transport; bundles never see it.
shop_transport: AsyncTransport;
shop_visit: bool;
// Coins bought with Dew, summed from the ledger, and the next pack's number.
shop_coins: s32;
shop_coin_receipts: s32;
shop_pack: s32;
shop_pack_key: [64]u8;
shop_shovey_coins: s32;
shop_shovey_coin_receipts: s32;
shop_shovey_pack: s32;
shop_shovey_pack_key: [64]u8;

ShopOwner :: () {
    owner := TextUntilNul(account_recovery.keys.public_id[:])
    if owner == TextUntilNul(shop_owner[:]) { return }
    CancelRequest(*shop_request)
    HttpTransferCancel(*shop_transfer)
    shop_session = .{}
    ShopGrantClear("idle")
    shop_grant = false
    shop_response = .{}
    shop_owner = account_recovery.keys.public_id
    shop_owned = 0
    shop_loaded = false
    shop_requested = false
    shop_active = false
    shop_product = 0
    shop_coins = 0
    shop_coin_receipts = 0
    shop_pack = 0
    shop_shovey_coins = 0
    shop_shovey_coin_receipts = 0
    shop_shovey_pack = 0
    shop_status = "idle"
    shop_island_quote = false
    shop_island_price = 0
    shop_island_confirmed = 0
}
ShopGrantClear :: (status: string) {
    shop_grant_token = .{}
    shop_grant_expires = 0
    shop_grant_answer = .{}
    shop_grant_status = status
}
ShopGrantExpire :: (now: s64) {
    if shop_grant_expires > 0 && now >= shop_grant_expires { ShopGrantClear("expired") }
}
// Grants remain opaque: the package node verifies the issuer signature and
// product binding. Also bind the canonical payload here and bound its expiry.
ShopGrantRead :: (response: string, now: s64) -> bool {
    expiry := ReadNumber(response, FieldAt(response, 0, "expires_at"))
    bytes: [512]u8
    if ReadStringText(response, FieldAt(response, 0, "grant"), bytes[:]) < 0 { return false }
    token := TextUntilNul(bytes[:])
    if !expiry.valid || expiry.value <= cast(float64)now || expiry.value > cast(float64)(now + 3600) ||
    expiry.value != cast(float64)cast(s64)expiry.value || token.count < 88 || token.count >= shop_grant_token.count { return false }
    dot: s64 = -1
    dots: s32 = 0
    for c, index: token {
        if c == #char "." { dots += 1; dot = index }
        else if !(c >= #char "A" && c <= #char "Z") && !(c >= #char "a" && c <= #char "z") &&
        !(c >= #char "0" && c <= #char "9") && c != #char "-" && c != #char "_" { return false }
    }
    if dots != 1 || token.count - dot - 1 != 86 { return false }
    payload: Vec(u8)
    BuilderPrint(*payload, "daochi-pack-grant-v1\nshovey.island\n%", cast(s64)expiry.value)
    decoded: [256]u8
    length := ShopWire.EntityRecordEnvelope(token[:dot], decoded[:])
    matches := length > 0 && TextView(decoded[:length]) == TextView(VecSlice(payload, 0, payload.count))
    VecFree(payload)
    if !matches { return false }
    unused CopyCString(token, shop_grant_token[:])
    shop_grant_expires = cast(s64)expiry.value
    shop_grant_status = "done"
    return true
}
ShopGrantAnswer :: (start: bool) -> string {
    ShopGrantExpire(UnixNow())
    if !DewReady() { ShopGrantClear("signin") }
    else if start && shop_grant_expires == 0 && !shop_grant {
        ShopGrantClear("pending")
        if shop_active || shop_requested { shop_grant_status = "failed" }
        else {
            // This operation never sets any purchase or quote state.
            shop_product = 0
            shop_pack = 0
            shop_shovey_pack = 0
            shop_island_quote = false
            shop_grant = true
            shop_requested = true
        }
    }
    out: Vec(u8)
    BuilderPrint(*out, "{\"product\":\"shovey.island\",\"owner\":\"%\",\"status\":\"%\",\"grant\":\"%\",\"expires_at\":%}",
        TextUntilNul(shop_owner[:]), shop_grant_status, TextUntilNul(shop_grant_token[:]), shop_grant_expires)
    text := BuilderFinish(out)
    unused CopyCString(text, shop_grant_answer[:])
    EntityFree(text)
    return TextUntilNul(shop_grant_answer[:])
}

ShopStart :: (context: *void, request: HttpRequest, output: []u8) -> bool {
    return HttpTransferStart(*shop_transfer, request, output, 15000)
}
ShopPoll :: (context: *void, status: *s32) -> s32 { return HttpTransferPoll(*shop_transfer, status) }
ShopCancel :: (context: *void) { HttpTransferCancel(*shop_transfer) }

ShopChristmasClaim :: (now: s64) -> bool {
    if !DewReady() { shop_status = "signin"; return false }
    if !ChristmasClaimWindow(now) { shop_status = "expired"; return false }
    answer := EntityRecordsAnswer("{\"operation\":\"put\",\"kind\":\"wurm-cosmetics\",\"id\":\"00000000000000000000000000000001\",\"schema\":\"wurm.cosmetics.v1\",\"document\":{\"christmas_2026\":true}}")
    if !MatchLiteral(answer, FieldAt(answer, 0, "status"), "\"done\"") { shop_status = "failed"; return false }
    shop_owned |= 256
    shop_status = "done"
    return true
}

EntityGameShopAnswer :: (request: string) -> string {
    ShopOwner()
    if request == "shovey.island.grant" || request == "shovey.island.grant.status" {
        return ShopGrantAnswer(request == "shovey.island.grant")
    }
    holiday := EntityRecordsAnswer("{\"operation\":\"get\",\"kind\":\"wurm-cosmetics\",\"id\":\"00000000000000000000000000000001\"}")
    if MatchLiteral(holiday, FieldAt(holiday, FieldAt(holiday, 0, "document"), "christmas_2026"), "true") { shop_owned |= 256 }
    if request == "wurm.christmas-2026" {
        unused ShopChristmasClaim(UnixNow())
    }
    if request == "visit" { shop_visit = true; return "queued" }
    if request == "refresh" && !shop_active { shop_island_quote = false; shop_requested = true; shop_product = 0; shop_pack = 0; shop_shovey_pack = 0 }
    if request.count == 7 && request[:6] == "coins:" && !shop_active && !shop_requested {
        pack := cast(s32)(request[6] - #char "0")
        if CoinPackPrice(pack) <= 0 { shop_status = "failed" }
        else if !shop_loaded { shop_status = "failed"; shop_requested = true }
        else if DewReady() { shop_island_quote = false; shop_pack = pack; shop_product = 0; shop_shovey_pack = 0; shop_requested = true }
        else { shop_status = "signin" }
    }
    if request.count == 14 && request[:13] == "shovey-coins:" && !shop_active && !shop_requested {
        pack := cast(s32)(request[13] - #char "0")
        if ShoveyCoinPackPrice(pack) <= 0 { shop_status = "failed" }
        else if !shop_loaded { shop_status = "failed"; shop_requested = true }
        else if DewReady() { shop_island_quote = false; shop_shovey_pack = pack; shop_product = 0; shop_pack = 0; shop_requested = true }
        else { shop_status = "signin" }
    }
    if request == "shovey.island.quote" && !shop_active && !shop_requested {
        shop_island_price = 0
        shop_island_quote = true
        shop_product = 0
        shop_pack = 0
        shop_shovey_pack = 0
        shop_requested = true
    }
    if request.count > 14 && request[:14] == "shovey.island:" && !shop_active && !shop_requested {
        amount := ReadNumber(request[14:], 0)
        if !DewReady() { shop_status = "signin" }
        else if !amount.valid || ValueEnd(request[14:], 0, 0) != request.count - 14 || shop_island_price <= 0 || amount.value != cast(float64)shop_island_price {
            shop_status = "price_changed"
        } else {
            shop_island_confirmed = shop_island_price
            shop_product = SHOVEY_ISLAND_PRODUCT
            shop_island_quote = false
            shop_pack = 0
            shop_shovey_pack = 0
            shop_requested = true
        }
    }
    for product: GAME_SHOP_PRODUCTS {
        if product == SHOVEY_ISLAND_PRODUCT { continue }
        if request == GameShopProduct(cast(s32)product) && !shop_active && !shop_requested {
            if (shop_owned & (1 << product)) != 0 {
                shop_status = "done"
            } else if DewReady() {
                shop_island_quote = false
                shop_product = cast(s32)product
                shop_requested = true
            } else { shop_status = "signin" }
        }
    }
    if request == "status" && !shop_loaded && !shop_active && shop_status == "idle" { shop_requested = true }
    out: Vec(u8)
    BuilderPrint(*out, "{\"owner\":\"%\",\"device\":\"%\",\"connected\":%,\"owned\":%,\"decorations\":%,\"coins\":%,\"shovey_owned\":%,\"shovey_coins\":%,\"island_owned\":%,\"island_price_units\":%,\"island_regular_price_units\":85000000,\"island_discount_percent\":%,\"special_skins\":true,\"christmas_claimable\":%,\"status\":\"%\"}",
        TextUntilNul(shop_owner[:]), TextUntilNul(account_client_id[:]), DewReady(), GameShopWurmOwned(shop_owned), GameShopDecorations(shop_owned), shop_coins,
        GameShopShoveyOwned(shop_owned), shop_shovey_coins,
        (shop_owned & (1 << SHOVEY_ISLAND_PRODUCT)) != 0, shop_island_price,
        ifx shop_island_price == SHOVEY_ISLAND_SALE_UNITS then 40 else 0,
        ChristmasClaimWindow(UnixNow()),
        ifx shop_active || shop_requested then "pending" else shop_status)
    text := BuilderFinish(out)
    unused CopyCString(text, shop_answer[:])
    EntityFree(text)
    return TextUntilNul(shop_answer[:])
}

EntityGameShopPump :: () {
    ShopOwner()
    if shop_visit { shop_visit = false; unused OpenUri("https://waozi.xyz/") }
    ShopGrantExpire(UnixNow())
    if !DewReady() {
        ShopGrantClear("signin")
        shop_grant = false
        shop_session = .{}
        shop_response = .{}
        CancelRequest(*shop_request)
        HttpTransferCancel(*shop_transfer)
        shop_active = false
        shop_requested = false
        shop_status = "signin"
        return
    }
    if shop_active {
        if !PollRequest(*shop_request) { return }
        shop_active = false
        shop_status = "failed"
        if shop_grant {
            shop_grant = false
            ShopGrantClear("failed")
            if shop_request.result == cast(Auth.AuthResult)Auth.AuthResult.AUTH_OK && shop_request.status == 200 {
                unused ShopGrantRead(TextUntilNul(shop_response[:]), UnixNow())
            } else if shop_request.stage == 3 && shop_request.failure == 0 {
                if shop_request.status == 403 { shop_grant_status = "unowned" }
                if shop_request.status == 401 { shop_grant_status = "signin" }
            }
            shop_response = .{}
            shop_status = shop_grant_status
            return
        }
        if shop_request.result != cast(Auth.AuthResult)Auth.AuthResult.AUTH_OK {
            // Distinguish an authenticated endpoint refusal from a login or transport failure.
            if shop_product == SHOVEY_ISLAND_PRODUCT && shop_request.stage == 3 && shop_request.failure == 0 &&
            shop_request.result == cast(Auth.AuthResult)Auth.AuthResult.AUTH_REQUEST_FAILED {
                if shop_request.status == 409 { shop_island_price = 0; shop_status = "price_changed" }
                if shop_request.status == 402 { shop_status = "insufficient" }
            }
            return
        }
        response := TextUntilNul(shop_response[:])
        if shop_island_quote {
            shop_island_quote = false
            at := FieldAt(response, 0, "products")
            for index: cast(s32)0..8 {
                item := ElementAt(response, at, index)
                if item < 0 { break }
                end := ValueEnd(response, item, 0)
                if end <= item { return }
                row := response[item:end]
                if !GameShopField(row, "product", "shovey.island") { continue }
                price := ReadNumber(row, FieldAt(row, 0, "price_units"))
                regular := ReadNumber(row, FieldAt(row, 0, "regular_price_units"))
                if regular.valid && regular.value == cast(float64)SHOVEY_ISLAND_REGULAR_UNITS && price.valid &&
                (price.value == cast(float64)SHOVEY_ISLAND_REGULAR_UNITS || price.value == cast(float64)SHOVEY_ISLAND_SALE_UNITS) {
                    shop_island_price = cast(s64)price.value
                    shop_status = "done"
                }
                return
            }
        } else if shop_product == SHOVEY_ISLAND_PRODUCT {
            if shop_request.status != 200 { return }
            // Only the subsequent authenticated ledger receipt grants access.
            shop_product = 0
            shop_requested = true
        } else if shop_pack > 0 || shop_shovey_pack > 0 {
            at := FieldAt(response, 0, "receipt")
            end := ValueEnd(response, at, 0)
            wurm_pack := shop_pack > 0
            coins: s32 = 0
            if at >= 0 && end > at {
                if wurm_pack { coins = CoinPackReceipt(response[at:end], TextUntilNul(shop_owner[:])) }
                else { coins = ShoveyCoinPackReceipt(response[at:end], TextUntilNul(shop_owner[:])) }
            }
            shop_pack = 0
            shop_shovey_pack = 0
            if shop_request.status == 409 { shop_status = "insufficient" }
            if coins <= 0 { return }
            // A confirmed receipt is the purchase; the next pack has a new number.
            if wurm_pack {
                shop_coins += coins
                shop_coin_receipts += 1
            } else {
                shop_shovey_coins += coins
                shop_shovey_coin_receipts += 1
            }
            shop_status = "done"
            if !dew_active && dew_queued[0] == cast(u8)0 { unused CopyCString("refresh", dew_queued[:]) }
        } else if shop_product > 0 {
            at := FieldAt(response, 0, "receipt")
            end := ValueEnd(response, at, 0)
            product := ifx at >= 0 && end > at then GameShopReceipt(response[at:end], TextUntilNul(shop_owner[:])) else 0
            if shop_request.status == 409 { shop_status = "insufficient" }
            if product != shop_product { return }
            shop_owned |= 1 << product
            // A confirmed receipt is the entitlement. Never grant on enqueue.
            shop_status = "done"
            if !dew_active && dew_queued[0] == cast(u8)0 { unused CopyCString("refresh", dew_queued[:]) }
        } else {
            at := FieldAt(response, 0, "events")
            if at >= 0 && at + 4 <= response.count && response[at:at + 4] == "null" {
                shop_loaded = true
                shop_status = "done"
                return
            }
            if at < 0 || response[at] != #char "[" { return }
            index: s32 = 0
            coins: s32 = 0
            packs: s32 = 0
            shovey_coins: s32 = 0
            shovey_packs: s32 = 0
            while true {
                item := ElementAt(response, at, index)
                if item < 0 { break }
                end := ValueEnd(response, item, 0)
                if end <= item { return }
                product := GameShopReceipt(response[item:end], TextUntilNul(shop_owner[:]))
                if product > 0 { shop_owned |= 1 << product }
                bought := CoinPackReceipt(response[item:end], TextUntilNul(shop_owner[:]))
                if bought > 0 { coins += bought; packs += 1 }
                shovey_bought := ShoveyCoinPackReceipt(response[item:end], TextUntilNul(shop_owner[:]))
                if shovey_bought > 0 { shovey_coins += shovey_bought; shovey_packs += 1 }
                index += 1
            }
            // The whole ledger was read, so its coin packs replace the count.
            shop_coins = coins
            shop_coin_receipts = packs
            shop_shovey_coins = shovey_coins
            shop_shovey_coin_receipts = shovey_packs
            shop_loaded = true
            shop_status = "done"
        }
        return
    }
    if !shop_requested { return }
    shop_requested = false
    client: Client
    body: Vec(u8)
    purchase := shop_product > 0 || shop_pack > 0 || shop_shovey_pack > 0
    if shop_grant {
        BuilderPrint(*body, "{\"product\":\"shovey.island\"}")
    } else if shop_product == SHOVEY_ISLAND_PRODUCT {
        BuilderPrint(*body, "{\"product\":\"shovey.island\",\"expected_units\":%}", shop_island_confirmed)
    } else if shop_pack > 0 {
        BuilderPrint(*body, "{\"app_id\":\"entity\",\"asset_id\":\"waozi:token\",\"amount\":%,\"action\":\"%\",\"idempotency_key\":\"%\"}",
            CoinPackPrice(shop_pack), COIN_PACK_ACTION, CoinPackKey(shop_pack, shop_coin_receipts + 1, shop_pack_key[:]))
    } else if shop_shovey_pack > 0 {
        BuilderPrint(*body, "{\"app_id\":\"entity\",\"asset_id\":\"waozi:token\",\"amount\":%,\"action\":\"%\",\"idempotency_key\":\"%\"}",
            ShoveyCoinPackPrice(shop_shovey_pack), SHOVEY_COIN_PACK_ACTION, ShoveyCoinPackKey(shop_shovey_pack, shop_shovey_coin_receipts + 1, shop_shovey_pack_key[:]))
    } else if purchase {
        BuilderPrint(*body, "{\"app_id\":\"entity\",\"asset_id\":\"waozi:token\",\"amount\":%,\"action\":\"%\",\"idempotency_key\":\"%\"}",
            GameShopPrice(shop_product), GameShopProduct(shop_product), GameShopKey(shop_product))
    }
    headers: [0]HttpHeader
    transport := shop_transport
    if transport.start == null { transport = AsyncTransport.{.start = ShopStart, .poll = ShopPoll, .cancel = ShopCancel} }
    shop_response = .{}
    shop_active = AccountStoreClient(null, *client) && BeginRequest(*shop_request, client, *shop_session,
        UnixNow(), transport, ifx purchase || shop_grant then "POST" else "GET",
        ifx shop_grant then "/api/v1/unlocks/grant" else ifx shop_island_quote then "/api/v1/unlocks/products" else ifx shop_product == SHOVEY_ISLAND_PRODUCT then "/api/v1/unlocks" else ifx purchase then "/api/v1/tokens/spend" else "/api/v1/tokens/ledger?app_id=entity",
        TextView(VecSlice(body, 0, body.count)), shop_response[:], headers[:])
    VecFree(body)
    if !shop_active {
        shop_status = "failed"
        if shop_grant { shop_grant = false; ShopGrantClear("failed") }
    }
}
