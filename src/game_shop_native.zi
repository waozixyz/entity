#import "game_shop"
#import "account_store"
#import "recovery"
#import "dew_native"
#import "native_files"
#import "model"
#import "std/c_string"
#import "std/text_buffer"
#import "std/json_scan"
#import "std/net_http"
#import "std/vec"
#import "std/date_time_linux"
#import "daochi_client/async_client"
#import "daochi_client/client"
Auth :: #import "daochi_client/auth";
#import "kryon/http_transfer"
#import "kryon/open_uri"

shop_owner: [65]u8;
shop_owned: s32;
shop_loaded: bool;
shop_requested: bool;
shop_active: bool;
shop_product: s32;
shop_status: string = "idle";
shop_request: PendingRequest;
shop_session: Auth.Session;
shop_transfer: HttpTransfer;
shop_response: [131072]u8;
shop_answer: [512]u8;
// Native hosts may supply their platform transport; bundles never see it.
shop_transport: AsyncTransport;
shop_visit: bool;

ShopOwner :: () {
    owner := TextUntilNul(account_recovery.keys.public_id[:])
    if owner == TextUntilNul(shop_owner[:]) { return }
    CancelRequest(*shop_request)
    HttpTransferCancel(*shop_transfer)
    shop_session = .{}
    shop_owner = account_recovery.keys.public_id
    shop_owned = 0
    shop_loaded = false
    shop_requested = false
    shop_active = false
    shop_product = 0
    shop_status = "idle"
}
ShopStart :: (context: *void, request: HttpRequest, output: []u8) -> bool {
    return HttpTransferStart(*shop_transfer, request, output, 15000)
}
ShopPoll :: (context: *void, status: *s32) -> s32 { return HttpTransferPoll(*shop_transfer, status) }
ShopCancel :: (context: *void) { HttpTransferCancel(*shop_transfer) }

EntityGameShopAnswer :: (request: string) -> string {
    ShopOwner()
    if request == "visit" { shop_visit = true; return "queued" }
    if request == "refresh" && !shop_active { shop_requested = true; shop_product = 0 }
    for product: 1..3 {
        if request == GameShopProduct(cast(s32)product) && !shop_active && !shop_requested {
            if (shop_owned & (1 << product)) != 0 {
                shop_status = "done"
            } else if DewReady() {
                shop_product = cast(s32)product
                shop_requested = true
            } else { shop_status = "signin" }
        }
    }
    if request == "status" && !shop_loaded && !shop_active && shop_status == "idle" { shop_requested = true }
    out: Vec(u8)
    BuilderPrint(*out, "{\"owner\":\"%\",\"device\":\"%\",\"connected\":%,\"owned\":%,\"status\":\"%\"}",
        TextUntilNul(shop_owner[:]), TextUntilNul(account_client_id[:]), DewReady(), shop_owned,
        ifx shop_active || shop_requested then "pending" else shop_status)
    text := BuilderFinish(out)
    unused CopyCString(text, shop_answer[:])
    EntityFree(text)
    return TextUntilNul(shop_answer[:])
}

EntityGameShopPump :: () {
    ShopOwner()
    if shop_visit { shop_visit = false; unused OpenUri("https://waozi.xyz/") }
    if !DewReady() {
        CancelRequest(*shop_request)
        HttpTransferCancel(*shop_transfer)
        shop_active = false
        shop_requested = false
        shop_status = "signin"
        return
    }
    if shop_active {
        if !PollRequest(*shop_request) { return }
        shop_active = false
        shop_status = "failed"
        if shop_request.result != cast(Auth.AuthResult)Auth.AuthResult.AUTH_OK { return }
        response := TextUntilNul(shop_response[:])
        if shop_product > 0 {
            at := FieldAt(response, 0, "receipt")
            end := ValueEnd(response, at, 0)
            product := ifx at >= 0 && end > at then GameShopReceipt(response[at:end], TextUntilNul(shop_owner[:])) else 0
            if shop_request.status == 409 { shop_status = "insufficient" }
            if product != shop_product { return }
            shop_owned |= 1 << product
            // A confirmed receipt is the entitlement. Never grant on enqueue.
            shop_status = "done"
            if !dew_active && dew_queued[0] == cast(u8)0 { unused CopyCString("refresh", dew_queued[:]) }
        } else {
            at := FieldAt(response, 0, "events")
            if at >= 0 && at + 4 <= response.count && response[at:at + 4] == "null" {
                shop_loaded = true
                shop_status = "done"
                return
            }
            if at < 0 || response[at] != #char "[" { return }
            index: s32 = 0
            while true {
                item := ElementAt(response, at, index)
                if item < 0 { break }
                end := ValueEnd(response, item, 0)
                if end <= item { return }
                product := GameShopReceipt(response[item:end], TextUntilNul(shop_owner[:]))
                if product > 0 { shop_owned |= 1 << product }
                index += 1
            }
            shop_loaded = true
            shop_status = "done"
        }
        return
    }
    if !shop_requested { return }
    shop_requested = false
    client: Client
    body: Vec(u8)
    purchase := shop_product > 0
    if purchase {
        BuilderPrint(*body, "{\"app_id\":\"entity\",\"asset_id\":\"waozi:token\",\"amount\":%,\"action\":\"%\",\"idempotency_key\":\"%\"}",
            GameShopPrice(shop_product), GameShopProduct(shop_product), GameShopKey(shop_product))
    }
    headers: [0]HttpHeader
    transport := shop_transport
    if transport.start == null { transport = AsyncTransport.{.start = ShopStart, .poll = ShopPoll, .cancel = ShopCancel} }
    shop_response = .{}
    shop_active = AccountStoreClient(null, *client) && BeginRequest(*shop_request, client, *shop_session,
        UnixNow(), transport, ifx purchase then "POST" else "GET",
        ifx purchase then "/api/v1/tokens/spend" else "/api/v1/tokens/ledger?app_id=entity",
        TextView(VecSlice(body, 0, body.count)), shop_response[:], headers[:])
    VecFree(body)
    if !shop_active { shop_status = "failed" }
}
