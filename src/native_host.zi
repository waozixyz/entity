// Shared native host for Entity. Games keep only a route to this context;
// account keys remain in this provider and never enter a game bundle.
#import "account_store"
#import "dew_native"
#import "dew_model"
#import "recovery"
#import "entity_records"
#import "entity_dew"
#import "leaderboard_native"
#import "leaderboard_model"
#import "friends_native"
#import "model"
#import "profile_appearance"
#import "native_files"
#import "native_management"
#import "std/c_string"
#import "std/bundle_host"
#import "std/byte_text_linux"
#import "std/vec"
#import "std/text_buffer"
#import "kryon/app_context_host"
#import "kryon/hosted_app"
#import "kryon/app_protocol"
#import "kryon/hosted_values"
#import "kryon/widget_host"
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/text_input_props"
#import "kryon/system_clipboard"
#import "kryon/open_uri"
portable: AppContext;
profile_document: string;
asset_folder: [4096]u8;
entity_host_navigation: bool;
entity_host_game: bool;
entity_profile_sections: s32 = 31;
EntityHostProfileSections :: (sections: s32) { entity_profile_sections = sections & 31 }
EntityAppearance :: struct { theme: s32; accent: s32; material: bool }
EntityHostAppearance :: () -> EntityAppearance {
    return EntityAppearance.{account_profile.theme, account_profile.accent, account_profile.material}
}
entity_paste: [16384]u8;
// The Profile's Top up opens this page for the signed-in account; a host
// that is that page sets it empty and takes the request itself.
ENTITY_TOPUP_URL :: "https://dew.waozi.xyz/"
entity_topup_url: [256]u8;
entity_topup_custom: bool;
entity_topup_requested: bool;

EntityHostAllowFunding :: (allowed: bool) { DewAllowFunding(allowed) }

// The app's edition decides how Dew is bought: the direct and F-Droid
// editions use Monero (dew.waozi.xyz), the Google Play edition uses Google
// Play Billing. Builds choose it with the GOOGLE_PLAY or FDROID define;
// a host may also set it before opening the Profile.
ENTITY_EDITION_DIRECT :: 0
ENTITY_EDITION_FDROID :: 1
ENTITY_EDITION_GOOGLE_PLAY :: 2
EntityHostEdition :: (edition: s32) {
    DewUseGooglePlay(edition == ENTITY_EDITION_GOOGLE_PLAY)
    if edition != ENTITY_EDITION_GOOGLE_PLAY { DewAllowFunding(true) }
}

EntityHostText :: (text: string) -> HostValue {
    return HostValue.{.kind = cast(s32)HostValueKind.HostString, .type_name = HostTextData("string"),
        .data = HostTextData(text), .length = cast(usize)text.count}
}
EntityHostAllows :: (context: *void, name: string) -> bool {
    return name == "ReadStoreHost" || name == "WriteStoreHost" || name == "ClipboardCopyHost" ||
    name == "AppLocaleHost" || name == "entity.management" || name == "entity.assets" || name == "entity.dew" || name == "entity.friends" || name == LEADERBOARD_SERVICE
}
EntityHostServices :: (context: *void, module: *u8, function: *u8, arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    name := TextFromCString(function)
    if name == "AppServiceHost" && count == 2 {
        service := AppArgumentText(arguments[0])
        if service == "entity.friends" { result.* = EntityHostText(EntityFriendsAnswer(AppArgumentText(arguments[1]))); return 1 }
        if service == LEADERBOARD_SERVICE {
            result.* = EntityHostText(EntityLeaderboardAnswer(AppArgumentText(arguments[1])))
            return 1
        }
        if service == "entity.dew" {
            request := AppArgumentText(arguments[1])
            if request == "open-topup" {
                result.* = EntityHostText(ifx EntityHostOpenTopUp() then "opened" else "rejected")
                return 1
            }
            result.* = EntityHostText(ifx request == "" then DewSnapshot() else ifx DewEnqueue(request) then "queued" else "rejected")
            return 1
        }
        if service == "entity.assets" { result.* = EntityHostText(TextUntilNul(asset_folder[:])); return 1 }
        if service == "entity.management" {
            request := AppArgumentText(arguments[1])
            if request == "" { ProviderRefresh(*account_provider); result.* = EntityHostText(account_provider.document) }
            else { result.* = EntityHostText(ifx ProviderEnqueue(*account_provider, request) then "queued" else "rejected") }
            return 1
        }
    }
    if name == "AppLocaleHost" && count == 1 { result.* = EntityHostText(AppArgumentText(arguments[0])); return 1 }
    if name == "ClipboardCopyHost" && count == 2 {
        result.* = HostScalar("bool", ifx SystemClipboardSet(AppArgumentText(arguments[0])) then 1 else 0)
        return 1
    }
    if name == "ReadStoreHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.json" {
        owner: [65]u8
        for index: 0..64 { owner[index] = account_profile.owner_id[index] }
        unused SharedProfileLoad(TextUntilNul(owner[:]), *account_profile)
        EntityFree(profile_document)
        state := account_profile
        unused ProfileAppearanceApplyReply(EntityRecordsAnswer(PROFILE_APPEARANCE_GET), *state)
        account_profile.picture_kind = state.picture_kind
        account_profile.picture = state.picture
        account_profile.abstract_picture = state.abstract_picture
        state.host_navigation = entity_host_navigation
        state.profile_sections = entity_profile_sections
        state.show_storage = !entity_host_game
        if entity_host_game { state.controls = ENTITY_NODES }
        state.extensions = .{}
        state.extension_count = 0
        profile_document = EntityEncode(state)
        output := arguments[1]
        if output.kind != cast(s32)HostValueKind.HostSlice || output.elements == null || output.length <= cast(usize)profile_document.count { return 0 }
        for index: 0..profile_document.count {
            byte := ifx index < profile_document.count then profile_document[index] else cast(u8)0
            output.elements[index].bits = cast(u64)byte
            output.elements[index].integer = cast(s64)byte
        }
        result.* = HostScalar("s32", profile_document.count)
        return 1
    }
    if name == "WriteStoreHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.json" {
        state: EntityState
        decoded := EntityDecode(AppArgumentText(arguments[1]), *state)
        changed := decoded && (state.picture_kind != account_profile.picture_kind || state.picture != account_profile.picture || state.abstract_picture != account_profile.abstract_picture)
        saved := decoded && AccountStoreSaveProfile(state)
        if saved && changed {
            appearance := ProfileAppearancePut(state)
            unused EntityRecordsAnswer(appearance)
            EntityFree(appearance)
        }
        result.* = HostScalar("bool", ifx saved then 1 else 0)
        return 1
    }
    return 0
}
EntityHostAssetAllowed :: (path: string) -> bool {
    first: [4096]u8
    second: [4096]u8
    abstract: [4096]u8
    names: [3]string = .["assets/entity/abstract-jade.png", "assets/entity/abstract-amber.png", "assets/entity/abstract-violet.png"]
    for name: names { if path == NativeJoin(abstract[:], TextUntilNul(asset_folder[:]), name) { return true } }
    return path == "" || path == NativeJoin(first[:], TextUntilNul(asset_folder[:]), "assets/entity/pfp.png") ||
    path == NativeJoin(second[:], TextUntilNul(asset_folder[:]), "assets/entity/flowers.png")
}

// A key or connection code someone copied, read here so it never passes
// through the profile bundle.
EntityHostPaste :: (context: *void, output: []u8) -> bool {
    if output.count < 2 { return false }
    length := EntityHostClipboardLength(output[:output.count - 1])
    output[length] = cast(u8)0
    return length > 0
}
EntityHostClipboardLength :: (buffer: []u8) -> s64 {
    return SystemClipboardText(buffer).count
}

// Why EntityHostOpen failed, for a host to show instead of nothing.
entity_host_problem: string;

EntityHostProblem :: () -> string { return entity_host_problem }

EntityHostOpen :: (bytes: string, root: string, client_id: string, host_navigation: bool = false) -> bool {
    entity_host_navigation = host_navigation
    entity_host_game = client_id == "arcade"
    entity_host_problem = ""
    #if #defined(GOOGLE_PLAY) {
        EntityHostEdition(ENTITY_EDITION_GOOGLE_PLAY)
    }
    if !AccountStoreStartAt(root, client_id) || !CopyCString(root, asset_folder[:]) {
        entity_host_problem = "This browser or device does not let the profile save its data here."
        return false
    }
    account_provider.paste = EntityHostPaste
    portable = AppContext.{.expected_id = "entity", .allows = EntityHostAllows,
        .services = EntityHostServices, .widgets = WidgetHostCall}
    if !AppContextOpen(*portable, bytes) {
        entity_host_problem = "The profile could not start. Reload to try again."
        return false
    }
    asset_count := BundleAssets(portable.app.bundle)
    if asset_count > 0 {
        for index: cast(u64)0..asset_count - 1 {
            name := TextFromCString(BundleAssetPath(portable.app.bundle, index))
            if name != "assets/entity/pfp.png" && name != "assets/entity/flowers.png" &&
            name != "assets/entity/abstract-jade.png" && name != "assets/entity/abstract-amber.png" && name != "assets/entity/abstract-violet.png" { continue }
            folder: [4096]u8
            path: [4096]u8
            if !NativeDirectory(NativeJoin(folder[:], root, "assets/entity")) { return false }
            asset_bytes := BytesFromPointer(BundleAssetBytes(portable.app.bundle, index), BundleAssetLength(portable.app.bundle, index))
            if !NativeWrite(NativeJoin(path[:], root, name), TextFromBytes(asset_bytes)) { return false }
        }
    }
    return true
}

EntityHostReload :: () {
    portable.command = "reload"
    unused AppContextRun(*portable, APP_COMMAND)
}

EntityHostAccount :: () -> bool {
    portable.command = "account"
    return AppContextRun(*portable, APP_COMMAND)
}

EntityHostLeaderboard :: () -> bool {
    portable.command = "root:leaderboard"
    return AppContextRun(*portable, APP_COMMAND)
}
EntityHostPage :: (page: string) -> bool {
    if page == "profile" { portable.command = "root:profile" }
    else if page == "dew" { portable.command = "root:dew" }
    else if page == "appearance" { portable.command = "root:appearance" }
    else if page == "leaderboard" { portable.command = "root:leaderboard" }
    else { return false }
    return AppContextRun(*portable, APP_COMMAND)
}

EntityHostDewAvailable :: () -> bool { return DewReady() }

EntityHostDew :: () -> bool {
    if !DewReady() { return false }
    portable.command = "dew"
    return AppContextRun(*portable, APP_COMMAND)
}

// The account's Dew for a host that draws its own top-up page. The balance
// and the Monero funding address come from the node; keys stay here.
EntityDewStatus :: struct {
    ready: bool
    busy: bool
    error: bool
    known: bool
    funded: bool
    funding_allowed: bool
    account: DewAccount
    funding: DewFunding
    alias: [40]u8
    name: [64]u8
}

EntityHostDewStatus :: () -> EntityDewStatus {
    status: EntityDewStatus
    status.ready = DewReady()
    status.funding_allowed = dew_funding_allowed
    if !status.ready { return status }
    status.alias = account_alias
    status.name = account_profile.name
    owner := TextUntilNul(account_recovery.keys.public_id[:])
    if TextUntilNul(dew_owner[:]) != owner { return status }
    status.busy = dew_active || dew_queued[0] != cast(u8)0
    status.error = dew_error
    status.known = DewParseAccount(TextUntilNul(dew_plan[:]), owner, *status.account)
    status.funded = DewParseFunding(TextUntilNul(dew_address[:]), owner, *status.funding)
    return status
}

// Asks the node for the balance ("refresh"), the funding address
// ("address") or the recent deposits ("deposits"); false while another Dew
// request is still running.
EntityHostDewRequest :: (operation: string) -> bool {
    if !DewReady() || (operation != "refresh" && operation != "address" && operation != "deposits") { return false }
    if operation == "address" && !dew_funding_allowed { return false }
    if TextUntilNul(dew_owner[:]) != TextUntilNul(account_recovery.keys.public_id[:]) { DewReset() }
    if dew_active || dew_queued[0] != cast(u8)0 { return false }
    dew_queued = .{}
    return CopyCString(operation, dew_queued[:])
}

// The node's {"deposits":[…]} for the signed-in account, newest first, or ""
// until a request has listed them.
EntityHostDewDeposits :: () -> string {
    if !DewReady() || TextUntilNul(dew_owner[:]) != TextUntilNul(account_recovery.keys.public_id[:]) { return "" }
    return TextUntilNul(dew_deposits[:])
}

EntityHostTopUpUrl :: (url: string) {
    entity_topup_url = .{}
    entity_topup_custom = CopyCString(url, entity_topup_url[:])
}

// Whether the Profile asked to top up since the last call, for a host
// whose own page tops up (see EntityHostTopUpUrl).
EntityHostTopUpRequested :: () -> bool {
    requested := entity_topup_requested
    entity_topup_requested = false
    return requested
}

EntityHostOpenTopUp :: () -> bool {
    if !DewReady() || !dew_funding_allowed { return false }
    base := ifx entity_topup_custom then TextUntilNul(entity_topup_url[:]) else ENTITY_TOPUP_URL
    if base == "" {
        entity_topup_requested = true
        return true
    }
    link: Vec(u8)
    BuilderPrint(*link, "%?account=%", base, TextUntilNul(account_recovery.keys.public_id[:]))
    text := BuilderFinish(link)
    defer { EntityFree(text) }
    return OpenUri(text)
}

EntityHostSave :: () -> bool {
    return AppContextRun(*portable, APP_SAVE)
}

EntityHostBack :: () -> bool {
    portable.command = "back"
    return AppContextRun(*portable, APP_COMMAND) && portable.reply == "handled"
}

EntityHostFrame :: (session: Session, bounds: Rectangle, key: s32, modifiers: s32, input: TextFieldInput, dark: bool = false) -> bool {
    portable.session = session
    portable.bounds = bounds
    portable.scale = 1.0
    portable.font = 16
    portable.dark = dark
    portable.key = key
    portable.modifiers = modifiers
    field_input := input
    if field_input.paste { field_input.paste_text = SystemClipboardText(entity_paste[:]) }
    portable.input = field_input
    WidgetHostBegin(session, EntityHostAssetAllowed)
    ran := AppContextRun(*portable, APP_FRAME)
    WidgetHostEnd()
    portable.input = TextFieldInput.{}
    return ran
}

EntityHostPump :: () {
    AccountStorePump()
    DewPump()
    EntityDewPump()
    EntityRecordsPump()
    EntityLeaderboardPump()
    EntityFriendsPump()
}

EntityHostClose :: () -> bool {
    if !EntityHostSave() { return false }
    DewReset()
    HostedAppClose(*portable.app)
    EntityFree(profile_document)
    profile_document = ""
    return true
}
