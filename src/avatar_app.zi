// The Avatar sub-app uses the same account-scoped profile store as Entity.
#import "avatar_view"
#import "model"
#import "profile_theme"
#import "kryon/app_context"
#import "kryon/app_protocol"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/text_props"
#import "kryon/text_widget"
#import "kryon/text_align"
#import "std/c_string"
#import "std/text_buffer"
#import "kryon/geometry"
#import "kryon/button_props"
#import "kryon/button_widget"
avatar_profile: EntityState;
avatar_loaded: bool;

AvatarLabel :: (key: string, fallback: string) -> string {
    value := AppLocale(key)
    return ifx value == "" || value == key then fallback else value
}
#program_export
Main :: () -> s64 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        AppIdentity("entity")
        AppDescribe("Avatar", "S1.6rr:M12 12A4 4 0 1 0 12 4A4 4 0 0 0 12 12ZM4 22V20A8 8 0 0 1 20 20V22")
        return APP_PROTOCOL
    }
    if mode == APP_FRAME {
        if !avatar_loaded {
            bytes: [16385]u8
            avatar_profile = EntityDefault()
            if ReadStore("entity.json", bytes[:]) > 0 { unused EntityDecode(TextUntilNul(bytes[:]), *avatar_profile) }
            avatar_loaded = true
        }
        session := AppSession()
        area := AppBounds()
        scale := AppScale()
        if scale <= 0.0 { scale = 1.0 }
        Box(session, BoxProps.{.key = cast(u64)1, .bounds = area, .fill = ThemeOr("canvas", 0x142724ff, 0xeef4f2ff)})
        Text(session, TextProps.{.key = cast(u64)2, .text = AvatarLabel("entity.avatar", "Avatar"),
                .bounds = Rectangle.{area.x + 20.0 * scale, area.y + 16.0 * scale, area.width - 40.0 * scale, 40.0 * scale}, .font = cast(s32)(26.0 * scale)})
        Text(session, TextProps.{.key = cast(u64)3, .text = AvatarLabel("entity.avatar_help", "Drag a little left or right. Use + and − to zoom."),
                .bounds = Rectangle.{area.x + 20.0 * scale, area.y + 60.0 * scale, area.width - 40.0 * scale, 40.0 * scale},
                .font = cast(s32)(14.0 * scale), .wrap = TextWrap.TextWrapAuto})
        view := Rectangle.{area.x + 16.0 * scale, area.y + 104.0 * scale, area.width - 32.0 * scale, area.height - 236.0 * scale}
        if view.height > 0.0 {
            AvatarInteract(view)
            AvatarDraw(session, view, avatar_camera)
        }
        AvatarControls(session, Rectangle.{area.x + 20.0 * scale, area.y + area.height - 120.0 * scale, area.width - 40.0 * scale, 44.0 * scale}, AvatarLabel("entity.reset_view", "Reset view"))
        if Button(session, ButtonProps.{.id = 74500, .bounds = Rectangle.{area.x + 20.0 * scale, area.y + area.height - 64.0 * scale, area.width - 40.0 * scale, 44.0 * scale},
                .label = AvatarLabel("entity.use_avatar", "Use avatar")}) != 0 {
            avatar_profile.picture_kind = 2
            document := EntityEncode(avatar_profile)
            unused WriteStore("entity.json", document)
            #if !#defined(KRYON_HOSTED_UI) {
                EntityFree(document)
            }
        }
    }
    return 0
}
