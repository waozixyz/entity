// Fixed-price cosmetic purchases use the existing Dew ledger. The product's
// stable idempotency key makes retries and purchases on two devices one debit.
#import "std/json_scan"
#import "dew_model"
#import "std/text_buffer"
#import "std/c_string"
#import "std/vec"

GAME_SHOP_SERVICE :: "entity.game-shop"
// Product IDs double as ownership bits. Wurm reads `owned` and rejects any value
// above its own bits, so other games' products are reported separately.
GAME_SHOP_PRODUCTS: [11]s32 = .[1, 2, 3, 7, 9, 10, 11, 12, 13, 14, 15];
SHOVEY_ISLAND_PRODUCT :: 15;
SHOVEY_ISLAND_REGULAR_UNITS :: 85000000;
SHOVEY_ISLAND_SALE_UNITS :: 51000000;
GAME_SHOP_WURM_BITS :: 1023;
GAME_SHOP_CHOANO_BITS :: 7168;
GAME_SHOP_SHOVEY_BITS :: 24576;
GameShopWurmOwned :: (owned: s32) -> s32 { return owned & GAME_SHOP_WURM_BITS }
GameShopDecorations :: (owned: s32) -> s32 { return owned & GAME_SHOP_CHOANO_BITS }
GameShopShoveyOwned :: (owned: s32) -> s32 { return owned & GAME_SHOP_SHOVEY_BITS }
// Actual catalog title; account-host identity remains independent.
GameShopTitle :: (product: s32) -> string {
    if product >= 10 && product <= 12 { return "choano" }
    if product >= 13 && product <= 15 { return "shovey" }
    if product == 1 || product == 2 || product == 3 || product == 7 || product == 9 { return "wurm" }
    return ""
}
GameShopReceiptTitle :: (text: string, title: string) -> bool {
    return title != "" && (GameShopField(text, "app_id", title) || GameShopField(text, "app_id", "entity"))
}
GameShopPrice :: (product: s32) -> s64 {
    if product == SHOVEY_ISLAND_PRODUCT { return SHOVEY_ISLAND_REGULAR_UNITS }
    if product >= 10 && product <= 12 { return cast(s64)(product - 9) * 10000000 }
    if product == 13 { return 10000000 }
    if product == 14 { return 30000000 }
    if product == 9 { return 20000000 }
    if product == 7 { return 50000000 }
    if product < 1 || product > 3 { return 0 }
    return cast(s64)product * 10000000
}
GameShopProduct :: (product: s32) -> string {
    if product == SHOVEY_ISLAND_PRODUCT { return "shovey.island" }
    if product == 9 { return "wurm.mountains" }
    if product == 1 { return "wurm.mint" }
    if product == 2 { return "wurm.berry" }
    if product == 3 { return "wurm.rose" }
    if product == 7 { return "wurm.lunar-dragon" }
    if product == 10 { return "choano.pearl" }
    if product == 11 { return "choano.flower" }
    if product == 12 { return "choano.wizard" }
    if product == 13 { return "shovey.night" }
    if product == 14 { return "shovey.crystal" }
    return ""
}
GameShopKey :: (product: s32) -> string {
    if product == SHOVEY_ISLAND_PRODUCT { return "unlock:shovey.island" }
    if product == 9 { return "stage-wurm-mountains-v1" }
    if product == 1 { return "skin-wurm-mint-v2" }
    if product == 2 { return "skin-wurm-berry-v2" }
    if product == 3 { return "skin-wurm-rose-v2" }
    if product == 7 { return "skin-wurm-lunar-dragon-v1" }
    if product == 10 { return "decoration-choano-pearl-v1" }
    if product == 11 { return "decoration-choano-flower-v1" }
    if product == 12 { return "decoration-choano-wizard-v1" }
    if product == 13 { return "skin-shovey-night-v1" }
    if product == 14 { return "skin-shovey-crystal-v1" }
    return ""
}
GameShopReference :: (product: s32) -> string {
    if product == SHOVEY_ISLAND_PRODUCT { return "shovey.island" }
    if product == 9 { return "wurm.mountains:stage-wurm-mountains-v1" }
    if product == 1 { return "wurm.mint:skin-wurm-mint-v2" }
    if product == 2 { return "wurm.berry:skin-wurm-berry-v2" }
    if product == 3 { return "wurm.rose:skin-wurm-rose-v2" }
    if product == 7 { return "wurm.lunar-dragon:skin-wurm-lunar-dragon-v1" }
    if product == 10 { return "choano.pearl:decoration-choano-pearl-v1" }
    if product == 11 { return "choano.flower:decoration-choano-flower-v1" }
    if product == 12 { return "choano.wizard:decoration-choano-wizard-v1" }
    if product == 13 { return "shovey.night:skin-shovey-night-v1" }
    if product == 14 { return "shovey.crystal:skin-shovey-crystal-v1" }
    return ""
}
GameShopLegacyReference :: (product: s32) -> string {
    if product == 1 { return "wurm.mint:skin-wurm-mint-v1" }
    if product == 2 { return "wurm.berry:skin-wurm-berry-v1" }
    if product == 3 { return "wurm.rose:skin-wurm-rose-v1" }
    return ""
}
GameShopField :: (text: string, field: string, expected: string) -> bool {
    bytes: [128]u8
    return ReadStringText(text, FieldAt(text, 0, field), bytes[:]) >= 0 && TextUntilNul(bytes[:]) == expected
}
GameShopReceipt :: (text: string, owner: string) -> s32 {
    if owner.count == 64 && GameShopField(text, "account_id", owner) &&
    GameShopReceiptTitle(text, "shovey") && GameShopField(text, "asset_id", "waozi:token") &&
    GameShopField(text, "event_type", "debit") && GameShopField(text, "source_type", "unlock") &&
    GameShopField(text, "source_ref", "shovey.island") {
        // Historical sale receipts stay valid after the server's sale ends.
        amount := ReadNumber(text, FieldAt(text, 0, "amount_delta"))
        if amount.valid && (amount.value == -cast(float64)SHOVEY_ISLAND_REGULAR_UNITS ||
            amount.value == -cast(float64)SHOVEY_ISLAND_SALE_UNITS) { return SHOVEY_ISLAND_PRODUCT }
        return 0
    }
    if !GameShopField(text, "account_id", owner) || owner.count != 64 ||
    !GameShopField(text, "asset_id", "waozi:token") ||
    !GameShopField(text, "event_type", "debit") || !GameShopField(text, "source_type", "spend") { return 0 }
    amount := ReadNumber(text, FieldAt(text, 0, "amount_delta"))
    for product: GAME_SHOP_PRODUCTS {
        if product == SHOVEY_ISLAND_PRODUCT { continue }
        if GameShopReceiptTitle(text, GameShopTitle(cast(s32)product)) && amount.valid && amount.value == -cast(float64)GameShopPrice(cast(s32)product) &&
        GameShopField(text, "source_ref", GameShopReference(cast(s32)product)) { return cast(s32)product }
        if product <= 3 && GameShopField(text, "app_id", "entity") && amount.valid && amount.value == -cast(float64)(GameShopPrice(cast(s32)product) / 10) &&
        GameShopField(text, "source_ref", GameShopLegacyReference(cast(s32)product)) { return cast(s32)product }
    }
    return 0
}

// Wurm's coin packs are bought again and again. Each purchase names the
// account's next pack number, so a retry, or a second device asking for the
// same pack at once, is one debit; the ledger's receipts are the coins.
COIN_PACKS :: 3;
COIN_PACK_ACTION :: "wurm.coins";
CoinPackCoins :: (pack: s32) -> s32 {
    if pack == 1 { return 150 }
    if pack == 2 { return 400 }
    if pack == 3 { return 900 }
    return 0
}
CoinPackPrice :: (pack: s32) -> s64 {
    if pack == 1 { return 2000000 }
    if pack == 2 { return 5000000 }
    if pack == 3 { return 10000000 }
    return 0
}
CoinPackKey :: (pack: s32, number: s32, output: []u8) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "coins-wurm-%-%-v1", pack, number)
    text := BuilderFinish(out)
    unused CopyCString(text, output)
    return TextUntilNul(output)
}
GameShopPackSuffix :: (reference: string, prefix: string) -> bool {
    if reference.count <= prefix.count || reference[:prefix.count] != prefix { return false }
    at := prefix.count
    if reference[at] < #char "1" || reference[at] > #char "9" { return false }
    while at < reference.count && reference[at] >= #char "0" && reference[at] <= #char "9" { at += 1 }
    return reference[at:] == "-v1"
}
// The coins a debit receipt bought, or 0 when it is not a coin pack.
CoinPackReceipt :: (text: string, owner: string) -> s32 {
    if !GameShopField(text, "account_id", owner) || owner.count != 64 ||
    !GameShopReceiptTitle(text, "wurm") || !GameShopField(text, "asset_id", "waozi:token") ||
    !GameShopField(text, "event_type", "debit") || !GameShopField(text, "source_type", "spend") { return 0 }
    amount := ReadNumber(text, FieldAt(text, 0, "amount_delta"))
    reference: [128]u8
    if ReadStringText(text, FieldAt(text, 0, "source_ref"), reference[:]) < 0 { return 0 }
    ref := TextUntilNul(reference[:])
    for pack: cast(s32)1..COIN_PACKS {
        prefix: Vec(u8)
        BuilderPrint(*prefix, "%:coins-wurm-%-", COIN_PACK_ACTION, pack)
        start := BuilderFinish(prefix)
        matched := GameShopPackSuffix(ref, start)
        if matched && amount.valid && amount.value == -cast(float64)CoinPackPrice(pack) { return CoinPackCoins(pack) }
    }
    return 0
}

SHOVEY_COIN_PACKS :: 3;
SHOVEY_COIN_PACK_ACTION :: "shovey.coins";
ShoveyCoinPackCoins :: (pack: s32) -> s32 {
    if pack == 1 { return 150 }
    if pack == 2 { return 400 }
    if pack == 3 { return 900 }
    return 0
}
ShoveyCoinPackPrice :: (pack: s32) -> s64 {
    if pack == 1 { return 2000000 }
    if pack == 2 { return 5000000 }
    if pack == 3 { return 10000000 }
    return 0
}
ShoveyCoinPackKey :: (pack: s32, number: s32, output: []u8) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "coins-shovey-%-%-v1", pack, number)
    text := BuilderFinish(out)
    unused CopyCString(text, output)
    return TextUntilNul(output)
}
ShoveyCoinPackReceipt :: (text: string, owner: string) -> s32 {
    if !GameShopField(text, "account_id", owner) || owner.count != 64 ||
    !GameShopReceiptTitle(text, "shovey") || !GameShopField(text, "asset_id", "waozi:token") ||
    !GameShopField(text, "event_type", "debit") || !GameShopField(text, "source_type", "spend") { return 0 }
    amount := ReadNumber(text, FieldAt(text, 0, "amount_delta"))
    reference: [128]u8
    if ReadStringText(text, FieldAt(text, 0, "source_ref"), reference[:]) < 0 { return 0 }
    ref := TextUntilNul(reference[:])
    for pack: cast(s32)1..SHOVEY_COIN_PACKS {
        prefix: Vec(u8)
        BuilderPrint(*prefix, "%:coins-shovey-%-", SHOVEY_COIN_PACK_ACTION, pack)
        start := BuilderFinish(prefix)
        matched := GameShopPackSuffix(ref, start)
        if matched && amount.valid && amount.value == -cast(float64)ShoveyCoinPackPrice(pack) { return ShoveyCoinPackCoins(pack) }
    }
    return 0
}

ChristmasClaimWindow :: (unix_seconds: s64) -> bool {
    // December 2026, UTC. A claimed skin remains owned after the window.
    return unix_seconds >= 1796083200 && unix_seconds < 1798761600
}

// A complete, bounded replay across all title and historical Entity receipts.
GameShopRestore :: struct {
    cursor: s64
    owned: s32
    coins: s32
    packs: s32
    shovey_coins: s32
    shovey_packs: s32
}
GameShopRestorePage :: (document: string, owner: string, state: *GameShopRestore) -> s32 {
    at := FieldAt(document, 0, "events")
    if Space(document, ValueEnd(document, 0, 0)) != document.count || at < 0 { return -1 }
    if MatchLiteral(document, at, "null") { return 0 }
    if document[at] != #char "[" { return -1 }
    count := ArrayCount(document, at)
    if count < 0 || count > 100 { return -1 }
    next := state.*
    for i: cast(s32)0..count - 1 {
        start := ElementAt(document, at, i)
        end := ValueEnd(document, start, 0)
        if start < 0 || end <= start { return -1 }
        item := document[start:end]
        sequence: s64
        if !DewInteger(item, FieldAt(item, 0, "ledger_seq"), *sequence) || sequence <= next.cursor { return -1 }
        next.cursor = sequence
        product := GameShopReceipt(item, owner)
        if product > 0 { next.owned |= 1 << product }
        coins := CoinPackReceipt(item, owner)
        shovey := ShoveyCoinPackReceipt(item, owner)
        if coins > 2147483647 - next.coins || shovey > 2147483647 - next.shovey_coins { return -1 }
        if coins > 0 { next.coins += coins; next.packs += 1 }
        if shovey > 0 { next.shovey_coins += shovey; next.shovey_packs += 1 }
    }
    state.* = next
    return ifx count == 100 then 1 else 0
}
