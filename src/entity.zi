Field :: struct { cursor: s32; anchor: s32; scroll_x: s32; focused: bool }
state: EntityState;
loaded: bool;
fields: [6]Field;
node_text: [256]u8;
scroll_offset: s32;
choosing_picture: bool;
picture_tab: s32;
picture_scroll: s32;
notice: string;
session: Session;
scale: float32;
asset_root: [4096]u8;
management: Management;
management_tick: s32;
management_waiting: s32;
management_seen: s32;
management_page: s32;
management_scroll: s32;
account_alias: [40]u8;
account_passphrase: [512]u8;
account_code: [1024]u8;
account_short_id: [16]u8;
qr_code: QrCode;
qr_text: [1024]u8;
qr_valid: bool;
public_id_open: bool;
public_id_owner: [65]u8;
public_id_copied: bool;
public_id_scroll: s32;
public_id_display: [129]u8;
#load "alias_view.zi";

Label :: (key: string, fallback: string) -> string {
    value := AppLocale(key)
    return ifx value == "" || value == key then fallback else value
}

TextLine :: (key: u64, text: string, x: float32, y: float32, width: float32, font: s32 = 16) {
    Text(session, TextProps.{.key = key, .text = text,
            .bounds = Rectangle.{x, y, width, (ifx font > 20 then cast(float32)font * 1.4 else 28.0) * scale}, .font = cast(s32)(cast(float32)font * scale),
            .wrap = TextWrap.TextWrapEllipsis})
}

Action :: (id: s32, label: string, bounds: Rectangle, selected: bool = false, danger: bool = false) -> bool {
    return Button(session, ButtonProps.{.key = cast(u64)id, .id = id,
            .bounds = bounds, .label = label, .selected = selected,
            .tone = ifx danger then ButtonTone.ButtonToneDanger else ifx selected then ButtonTone.ButtonToneAccent else ButtonTone.ButtonToneNeutral,
            .emphasis = ifx selected then ButtonEmphasis.ButtonEmphasisFilled else ButtonEmphasis.ButtonEmphasisSoft,
            .fit_content = true}) != 0
}

Save :: () -> bool {
    document := EntityEncode(state)
    if !WriteStore("entity.json", document) {
        notice = Label("entity.save_error", "Could not save changes")
        return false
    } else {
        notice = ""
    }
    return true
}

EditField :: (index: s32, buffer: []u8, label: string, bounds: Rectangle, maximum: s32, secure: bool = false) -> bool {
    field := *fields[index]
    snapshot: [1024]u8
    for byte: 0..buffer.count - 1 { snapshot[byte] = buffer[byte] }
    props := TextFieldProps.{.key = cast(u64)(100 + index), .focus_id = 100 + index,
        .bounds = bounds, .label = label, .scale = scale,
        .placeholder = ifx index == 0 then Label("entity.name_placeholder", "Your name") else label,
        .value = TextUntilNul(snapshot[:]), .cursor = field.cursor,
        .anchor = field.anchor, .scroll_x = field.scroll_x, .focused = field.focused,
        .max_bytes = cast(s32)buffer.count - 1, .max_codepoints = maximum, .secure = secure}
    if secure && snapshot[0] != cast(u8)0 { props.display_value = "••••••••" }
    if field.focused { props.input = AppFieldInput() }
    result := TextField(session, props)
    if result.edit.changed {
        edit := result.edit
        length: s64 = 0
        while length < buffer.count && buffer[length] != cast(u8)0 { length += 1 }
        new_length := length - (edit.end - edit.start) + edit.replacement.count
        if edit.start >= 0 && edit.end >= edit.start && edit.end <= length && new_length < buffer.count {
            tail := length - edit.end
            if new_length > length {
                for offset: 0..tail { buffer[new_length - offset] = buffer[length - offset] }
            } else {
                for offset: 0..tail { buffer[edit.start + edit.replacement.count + offset] = buffer[edit.end + offset] }
            }
            for offset: 0..edit.replacement.count - 1 { buffer[edit.start + offset] = edit.replacement[offset] }
            buffer[new_length] = cast(u8)0
        }
    }
    if result.clipboard_write { unused ClipboardCopy(result.clipboard_text, 0) }
    finished := result.committed || (field.focused && !result.focused)
    field.* = Field.{result.cursor, result.anchor, result.scroll_x, result.focused && !result.escaped}
    return finished
}

Paragraph :: (key: u64, text: string, x: float32, y: float32, width: float32, height: float32, font: s32 = 14) {
    Text(session, TextProps.{.key = key, .text = text,
            .bounds = Rectangle.{x, y, width, height * scale},
            .font = cast(s32)(cast(float32)font * scale), .wrap = TextWrap.TextWrapAuto})
}

PollManagement :: () {
    management_tick += 1
    if management_tick != 1 && management_tick % 15 != 0 { return }
    next: Management
    if !ManagementDecode(AppService("entity.management", ""), *next) { return }
    result_changed := TextUntilNul(next.result[:]) != TextUntilNul(management.result[:])
    owner_changed := TextUntilNul(next.public_id[:]) != TextUntilNul(management.public_id[:])
    management = next
    if loaded && !choosing_picture && management.account {
        profile: [16384]u8
        count := ReadStore("entity.json", profile[:])
        refreshed: EntityState
        if count > 0 && EntityDecode(TextUntilNul(profile[:]), *refreshed) &&
        TextUntilNul(refreshed.owner_id[:]) == TextUntilNul(management.public_id[:]) {
            state.picture = refreshed.picture
            state.picture_kind = refreshed.picture_kind
            state.abstract_picture = refreshed.abstract_picture
        }
    }
    if owner_changed && loaded {
        loaded = false
        fields = .{}
        public_id_open = false
        public_id_copied = false
        AliasViewReset()
    }
    if !fields[3].focused && management_page != PAGE_ALIAS { account_alias = management.alias }
    if management.completed > management_seen || (result_changed && management.completed > 0) {
        management_seen = management.completed
        AliasManagementFinished()
        message: Vec(u8)
        BuilderPrint(*message, "%", TextUntilNul(management.message[:]))
        notice = BuilderFinish(message)
        if management_waiting <= management.completed {
            management_waiting = 0
            if TextUntilNul(management.result[:]) == "switch" { OpenManagement(PAGE_SWITCH) }
            else if TextUntilNul(management.result[:]) == "ok" {
                loaded = false
                // A finished key, link or alias step returns to the account.
                page := management_page
                // Link steps finish one by one; only an arriving account ends that page.
                if page != 0 && page != PAGE_ACCOUNT && page != PAGE_NODES && page != PAGE_NODE && page != PAGE_ADD_NODE &&
                (page != PAGE_LINK || owner_changed) {
                    ManagementHome(PAGE_ACCOUNT)
                }
            }
        }
    }
}

CanManage :: (capability: s32) -> bool {
    return management.available && (management.capabilities & capability) != 0
}

Manage :: (operation: string, value: string = "", target: string = "", choice: s32 = 0) {
    if management_waiting > management.completed || !CanManage(ManagementOperation(operation)) { return }
    if TextUntilNul(state.owner_id[:]) != TextUntilNul(management.public_id[:]) {
        loaded = false
        notice = Label("entity.account_changed", "The account changed; open its current profile again")
        return
    }
    if !Save() { return }
    request := ManagementRequest.{.sequence = management.sequence + 1, .choice = choice}
    request.owner_id = management.public_id
    if !CopyCString(operation, request.operation[:]) || !CopyCString(value, request.value[:]) || !CopyCString(target, request.target[:]) { return }
    reply := AppService("entity.management", ManagementRequestEncode(request))
    if reply == "queued" {
        management_waiting = request.sequence
        management.sequence = request.sequence
        management_tick = 0
        notice = ""
        for index: 0..account_passphrase.count - 1 { account_passphrase[index] = cast(u8)0 }
        fields[4] = Field.{}
    } else {
        notice = Label("entity.action_error", "Could not start this action")
    }
}

// Account pages, one short column each. Back returns to the page that
// opened it; the profile itself is page 0.
PAGE_ACCOUNT :: 1
PAGE_IMPORT :: 2
PAGE_BACKUP :: 3
PAGE_LOGOUT :: 4
PAGE_CLEAR :: 5
PAGE_SWITCH :: 6
PAGE_LINK :: 7
PAGE_NODES :: 8
PAGE_NODE :: 9
PAGE_ADD_NODE :: 10
PAGE_ALIAS :: 11
PAGE_FRIENDS :: 12
PAGE_APPEARANCE :: 13
root_page: string;
#load "friends_page.zi";

management_stack: [8]s32;
management_depth: s32;
node_open: s32;
// Content heights measured by the previous frame, so every page scrolls
// over exactly what it drew.
account_height: float32;
profile_height: float32;

OpenManagement :: (page: s32) {
    if page == PAGE_ALIAS {
        account_alias = management.alias
        AliasViewReset()
    }
    if page == PAGE_FRIENDS { friends_refresh = true; friends_remove = .{} }
    if page == PAGE_ACCOUNT { ManagementHome(0); return }
    if !Save() { return }
    if management_depth < cast(s32)management_stack.count {
        management_stack[management_depth] = management_page
        management_depth += 1
    }
    management_page = page
    management_scroll = 0
    notice = ""
    fields = .{}
}

// Shows page with only the profile behind it.
ManagementHome :: (page: s32) {
    management_page = ifx page == PAGE_ACCOUNT then 0 else page
    management_depth = 0
    if management_page != 0 {
        management_stack[0] = 0
        management_depth = 1
    }
    management_scroll = 0
    fields = .{}
}

// Returns to the page that opened this one; false on the profile.
ManagementBack :: () -> bool {
    if alias_modal_open {
        alias_modal_open = false
        return true
    }
    if management_page == 0 { return false }
    // Leaving the link page ends its code and the polling behind it.
    if management_page == PAGE_LINK && management.link_stage != 0 && management.link_stage != 6 { Manage("link_cancel") }
    management_page = 0
    if management_depth > 0 {
        management_depth -= 1
        management_page = management_stack[management_depth]
    }
    management_scroll = 0
    notice = ""
    for index: 0..account_passphrase.count - 1 { account_passphrase[index] = cast(u8)0 }
    fields = .{}
    return true
}

Muted :: (key: u64, text: string, x: float32, y: float32, width: float32, font: s32 = 14, align: TextAlign = TextAlign.TextAlignStart) {
    Text(session, TextProps.{.key = key, .text = text, .bounds = Rectangle.{x, y, width, 24.0 * scale},
            .font = cast(s32)(cast(float32)font * scale), .wrap = TextWrap.TextWrapEllipsis,
            .align = align, .disabled = true})
}

// A full-width button: filled for the page's main action, soft otherwise,
// plain text for quiet and dangerous actions.
WideButton :: (id: s32, label: string, x: float32, y: *float32, width: float32, filled: bool = false,
    quiet: bool = false, danger: bool = false) -> bool {
    pressed := Button(session, ButtonProps.{.key = cast(u64)id, .id = id,
            .bounds = Rectangle.{x, y.*, width, 48.0 * scale}, .label = label, .selected = filled,
            .tone = ifx danger then ButtonTone.ButtonToneDanger else ifx filled then ButtonTone.ButtonToneAccent else ButtonTone.ButtonToneNeutral,
            .emphasis = ifx filled then ButtonEmphasis.ButtonEmphasisFilled else ifx quiet || danger then ButtonEmphasis.ButtonEmphasisGhost else ButtonEmphasis.ButtonEmphasisSoft}) != 0
    y.* += 60.0 * scale
    return pressed
}

// One tappable row: a label, an optional quiet value and a chevron.
ListRow :: (id: s32, label: string, value: string, x: float32, y: *float32, width: float32, dot: s32 = 0) -> bool {
    height := 56.0 * scale
    row := Rectangle.{x, y.*, width, height}
    Box(session, BoxProps.{.key = cast(u64)(id + 30000), .bounds = row,
            .fill = ThemeOr("surface", 0x1c3330ff, 0xffffffff),
            .border = ThemeOr("border", 0x34514aff, 0xdde7e3ff), .radius = 14.0 * scale})
    pressed := Button(session, ButtonProps.{.key = cast(u64)id, .id = id, .bounds = row,
            .label = label, .invisible = true}) != 0
    left := x + 18.0 * scale
    if dot != 0 {
        // A status light: 1 connected, 2 not connected.
        Box(session, BoxProps.{.key = cast(u64)(id + 31000),
                .bounds = Rectangle.{left, y.* + 23.0 * scale, 10.0 * scale, 10.0 * scale}, .radius = 5.0 * scale,
                .fill = ifx dot == 1 then ThemeOr("accent", 0x49a68eff, 0x298a71ff) else ThemeOr("border", 0x34514aff, 0xc9d6d1ff)})
        left += 22.0 * scale
    }
    label_width := width - (left - x) - 48.0 * scale
    if value != "" { label_width = label_width * 0.55 }
    TextLine(cast(u64)(id + 32000), label, left, y.* + 14.0 * scale, label_width, 16)
    if value != "" {
        Muted(cast(u64)(id + 33000), value, left + label_width, y.* + 16.0 * scale,
            x + width - 44.0 * scale - (left + label_width), 14, TextAlign.TextAlignEnd)
    }
    SvgIcon(session, SvgIconProps.{.shape = "S1.8rr:M9 5L16 12L9 19", .color = ThemeOr("text", 0xe5eef3ff, 0x203b4bff),
            .bounds = Rectangle.{x + width - 34.0 * scale, y.* + 18.0 * scale, 20.0 * scale, 20.0 * scale}})
    y.* += height + 10.0 * scale
    return pressed
}

ShortId :: (identity: string) -> string {
    if identity.count <= 12 { return identity }
    unused CopyCString(identity[:4], account_short_id[:])
    unused CopyCString("…", account_short_id[4:])
    unused CopyCString(identity[identity.count - 4:], account_short_id[7:])
    return TextUntilNul(account_short_id[:])
}

account_name: [48]u8;

AccountName :: () -> string {
    alias := TextUntilNul(management.alias[:])
    if alias != "" && alias.count + 2 <= account_name.count {
        account_name = .{}
        account_name[0] = cast(u8)64
        for byte, index: alias { account_name[index + 1] = byte }
        return TextUntilNul(account_name[:])
    }
    return ShortId(TextUntilNul(management.public_id[:]))
}

ManagementNodeAt :: (address: string) -> s32 {
    for index: 0..management.node_count - 1 {
        if TextUntilNul(management.nodes[index].address[:]) == address { return cast(s32)index }
    }
    return -1
}

NodeConnected :: (index: s32) -> bool {
    at := ManagementNodeAt(TextUntilNul(state.nodes[index][:]))
    return at >= 0 && management.nodes[at].active
}

// A node's host name, which is how people know it.
NodeHost :: (address: string) -> string {
    if address.count > 8 && address[:8] == "https://" { return address[8:] }
    if address.count > 7 && address[:7] == "http://" { return address[7:] }
    return address
}

nodes_summary: [32]u8;

NodesSummary :: () -> string {
    connected: s32 = 0
    for index: 0..state.node_count - 1 { if NodeConnected(cast(s32)index) { connected += 1 } }
    if connected == 0 { return Label("entity.nodes_none", "None connected") }
    out: Vec(u8)
    BuilderPrint(*out, "% %", connected, Label("entity.nodes_connected", "connected"))
    unused CopyCString(BuilderFinish(out), nodes_summary[:])
    return TextUntilNul(nodes_summary[:])
}

ByteLabel :: (bytes: s64) -> string {
    out: Vec(u8)
    if bytes >= 1073741824 { BuilderPrint(*out, "% GB", bytes / 1073741824) }
    else if bytes >= 1048576 { BuilderPrint(*out, "% MB", bytes / 1048576) }
    else if bytes >= 1024 { BuilderPrint(*out, "% KB", bytes / 1024) }
    else { BuilderPrint(*out, "% B", bytes) }
    return BuilderFinish(out)
}

StorageUsageLabel :: (used: s64, limit: s64) -> string {
    template := Label("entity.storage_used_of", "%s of %s used")
    if limit <= 0 {
        template = Label("entity.storage_used_unlimited", "%s used · no limit")
    }
    values: [2]string = .[ByteLabel(used), ByteLabel(limit)]
    out: Vec(u8)
    start: s64 = 0
    at: s64 = 0
    argument: s32 = 0
    while at + 1 < template.count && argument < 2 {
        if template[at:at + 2] == "%s" {
            BuilderPrint(*out, "%", template[start:at])
            BuilderPrint(*out, "%", values[argument])
            argument += 1
            at += 2
            start = at
        } else {
            at += 1
        }
    }
    BuilderPrint(*out, "%", template[start:])
    return BuilderFinish(out)
}

// The choices for someone without an account here.
SignInChoices :: (x: float32, y: *float32, width: float32) {
    if CanManage(ACCOUNT_CREATE) && WideButton(820, Label("entity.create_account", "Create account"), x, y, width, true) { Manage("create") }
    if (CanManage(ACCOUNT_IMPORT) || CanManage(ACCOUNT_PASTE)) &&
    WideButton(821, Label("entity.import_key", "Import key"), x, y, width) { OpenManagement(PAGE_IMPORT) }
    if CanManage(ACCOUNT_LINK) && WideButton(822, Label("entity.link_from_device", "Link from another device"), x, y, width, false, true) {
        OpenManagement(PAGE_LINK)
    }
}

SignInChoicesHeight :: () -> float32 {
    count: s32 = 0
    if CanManage(ACCOUNT_CREATE) { count += 1 }
    if CanManage(ACCOUNT_IMPORT) || CanManage(ACCOUNT_PASTE) { count += 1 }
    if CanManage(ACCOUNT_LINK) { count += 1 }
    return cast(float32)count * 60.0 * scale
}

// The profile's account entry: a card of sign-in choices, or one row.
AccountSummary :: (x: float32, y: *float32, width: float32) {
    if management.account {
        PublicIdLine(705, Rectangle.{x, y.*, width, 44.0 * scale})
        y.* += 56.0 * scale
        return
    }
    padding := 16.0 * scale
    height := padding * 2.0 + 56.0 * scale + SignInChoicesHeight() - 12.0 * scale
    Box(session, BoxProps.{.key = cast(u64)703, .bounds = Rectangle.{x, y.*, width, height},
            .fill = ThemeOr("surface", 0x1c3330ff, 0xffffffff),
            .border = ThemeOr("border", 0x34514aff, 0xdde7e3ff), .radius = 16.0 * scale})
    inner := x + padding
    top := y.* + padding
    TextLine(700, Label("entity.account", "Account"), inner, top, width - padding * 2.0, 18)
    Muted(701, Label("entity.signed_out", "Not signed in"), inner, top + 28.0 * scale, width - padding * 2.0)
    top += 56.0 * scale
    SignInChoices(inner, *top, width - padding * 2.0)
    y.* += height + 12.0 * scale
}

// Show the alias in Profile; the full public ID stays in its copy/QR dialog.
PublicIdLine :: (id: s32, bounds: Rectangle) {
    identity := TextUntilNul(management.public_id[:])
    text_bounds := bounds
    text_bounds.width -= 48.0 * scale
    props := TextProps.{.key = cast(u64)(id + 1000), .text = AccountName(),
        .bounds = text_bounds, .font = cast(s32)(14.0 * scale),
        .align = TextAlign.TextAlignCenter, .vertical_align = TextAlign.TextAlignCenter,
        .wrap = TextWrap.TextWrapEllipsis}
    if TextWidth(session, props) > cast(s32)text_bounds.width { props.text = ShortId(identity) }
    group_width := cast(float32)TextWidth(session, props) + 52.0 * scale
    if group_width > bounds.width { group_width = bounds.width }
    text_bounds.x = bounds.x + (bounds.width - group_width) * 0.5
    text_bounds.width = group_width - 52.0 * scale
    props.bounds = text_bounds
    Text(session, props)
    if Button(session, ButtonProps.{.key = cast(u64)id, .id = id,
            .bounds = text_bounds, .label = Label("entity.public_id", "Public ID"), .invisible = true}) != 0 {
        public_id_owner = management.public_id
        public_id_copied = false
        public_id_scroll = 0
        public_id_open = true
        fields = .{}
    }
    if Button(session, ButtonProps.{.key = cast(u64)(id + 1), .id = id + 1,
            .bounds = Rectangle.{text_bounds.x + text_bounds.width + 8.0 * scale, bounds.y, 44.0 * scale, 44.0 * scale},
            .label = Label(ifx public_id_copied then "entity.copied" else "entity.copy_id", ifx public_id_copied then "Copied" else "Copy public ID"), .icon_only = true,
            .icon_shape = ifx public_id_copied then "S1.8rr:M5 12L10 17L20 7" else "S1.6rr:M8 8H20V20H8ZM16 8V4H4V16H8",
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisGhost}) != 0 {
        public_id_copied = ClipboardCopy(identity, 0)
    }
}

PublicIdModal :: () {
    if !public_id_open { return }
    identity := TextUntilNul(public_id_owner[:])
    if !management.account || identity != TextUntilNul(management.public_id[:]) {
        public_id_open = false
        return
    }
    area := AppBounds()
    width := area.width - 32.0 * scale
    if width > 680.0 * scale { width = 680.0 * scale }
    height := area.height - 24.0 * scale
    if height > 520.0 * scale { height = 520.0 * scale }
    modal := ModalFrame(session, ModalFrameProps.{.key = cast(u64)19500, .id = 19500,
            .title = Label("entity.public_id", "Public ID"),
            .bounds = Rectangle.{area.x + (area.width - width) * 0.5, area.y + (area.height - height) * 0.5, width, height},
            .scale = scale, .has_right_action = true, .right_label = Label("entity.done", "Done")})
    if modal.dismissed || modal.right_clicked { public_id_open = false }
    if !modal.opened { return }
    content := modal.layout.content
    // A public ID has no word boundaries; break it explicitly at the host's
    // measured line width, while copy and QR keep the original 64 digits.
    start: s64 = 0
    length: s64 = 0
    for byte, index: identity {
        probe := TextProps.{.text = identity[start:index + 1], .font = cast(s32)(15.0 * scale)}
        if index > start && TextWidth(session, probe) > cast(s32)(content.width - 16.0 * scale) {
            public_id_display[length] = #char "\n"; length += 1; start = index
        }
        public_id_display[length] = byte; length += 1
    }
    public_id_display[length] = 0
    props := TextProps.{.key = cast(u64)19502, .text = TextUntilNul(public_id_display[:]),
        .bounds = Rectangle.{0.0, 0.0, content.width - 16.0 * scale, 0.0},
        .font = cast(s32)(15.0 * scale), .align = TextAlign.TextAlignCenter, .wrap = TextWrap.TextWrapAuto}
    id_height := cast(float32)TextHeight(session, props) + 16.0 * scale
    if id_height < 44.0 * scale { id_height = 44.0 * scale }
    // Short landscape screens scroll; the complete ID never truncates.
    scroll := Scroll(session, ScrollProps.{.key = cast(u64)19501, .bounds = content,
            .content_height = cast(s32)(336.0 * scale + id_height), .scroll_offset = public_id_scroll, .scale = scale})
    public_id_scroll = scroll.scroll_offset
    if scroll.opened {
        y := scroll.content.y
        side := DrawConnectionCode(identity, scroll.content.x, y, scroll.content.width)
        y += side + 16.0 * scale
        props.bounds = Rectangle.{scroll.content.x + 8.0 * scale, y, scroll.content.width - 16.0 * scale, id_height}
        Text(session, props)
        if Button(session, ButtonProps.{.key = cast(u64)19503, .id = 19503,
                .bounds = props.bounds, .label = identity, .invisible = true}) != 0 {
            public_id_copied = ClipboardCopy(identity, 0)
        }
        y += id_height
        if Action(19504, Label(ifx public_id_copied then "entity.copied" else "entity.copy_id",
            ifx public_id_copied then "Copied" else "Copy public ID"),
            Rectangle.{scroll.content.x, y, scroll.content.width, 44.0 * scale}) {
            public_id_copied = ClipboardCopy(identity, 0)
        }
        unused End(session)
    }
    unused End(session)
    AppKeyboard(false)
}

// Connection codes are drawn as rectangles worked out once per code, so a
// shown code costs only its boxes each frame.
QrRect :: struct { column: s32; row: s32; width: s32; height: s32 }
QR_RECTS :: 2048
qr_rects: [QR_RECTS]QrRect;
qr_rect_count: s32;

QrBuild :: () {
    qr_rect_count = 0
    open: [QR_SIZE_MAX]s32
    next: [QR_SIZE_MAX]s32
    for column: 0..QR_SIZE_MAX - 1 { open[column] = -1 }
    for row: 0..qr_code.size - 1 {
        for column: 0..QR_SIZE_MAX - 1 { next[column] = -1 }
        column: s32 = 0
        while column < qr_code.size {
            if !QrModule(*qr_code, column, row) { column += 1; continue }
            start := column
            while column < qr_code.size && QrModule(*qr_code, column, row) { column += 1 }
            above := open[start]
            if above >= 0 && qr_rects[above].width == column - start {
                // The same run as the row above grows that rectangle.
                qr_rects[above].height += 1
                next[start] = above
            } else if qr_rect_count < QR_RECTS {
                qr_rects[qr_rect_count] = QrRect.{start, cast(s32)row, column - start, 1}
                next[start] = qr_rect_count
                qr_rect_count += 1
            } else {
                qr_valid = false
                return
            }
        }
        open = next
    }
}

// Draws the code in a square at most width wide; returns its side.
DrawConnectionCode :: (text: string, x: float32, y: float32, width: float32) -> float32 {
    if text != TextUntilNul(qr_text[:]) {
        qr_valid = CopyCString(text, qr_text[:]) && QrEncodeText(text, QrEcc.QrEccMedium, *qr_code)
        if qr_valid { QrBuild() }
    }
    if !qr_valid { return 0.0 }
    modules := qr_code.size + 8
    limit := cast(s32)width
    if limit > cast(s32)(260.0 * scale) { limit = cast(s32)(260.0 * scale) }
    cell := limit / modules
    if cell < 1 { return 0.0 }
    side := cell * modules
    left := cast(s32)(x + (width - cast(float32)side) * 0.5)
    top := cast(s32)y
    Box(session, BoxProps.{.key = cast(u64)19000, .radius = 8.0 * scale,
            .bounds = Rectangle.{cast(float32)left, y, cast(float32)side, cast(float32)side}, .fill = Color.{255, 255, 255, 255}})
    for index: 0..qr_rect_count - 1 {
        rect := qr_rects[index]
        Box(session, BoxProps.{.key = cast(u64)(20000 + index),
                .bounds = Rectangle.{cast(float32)(left + (rect.column + 4) * cell), cast(float32)(top + (rect.row + 4) * cell),
                    cast(float32)(rect.width * cell), cast(float32)(rect.height * cell)}, .fill = Color.{0, 0, 0, 255}})
    }
    return cast(float32)side
}

PageTitle :: () -> string {
    if management_page == PAGE_IMPORT { return Label("entity.import_key", "Import key") }
    if management_page == PAGE_BACKUP { return Label("entity.backup_key", "Back up key") }
    if management_page == PAGE_LOGOUT { return Label("entity.logout", "Log out") }
    if management_page == PAGE_CLEAR { return Label("entity.clear_remote", "Clear remote data") }
    if management_page == PAGE_SWITCH { return Label("entity.switch_account", "Switch account") }
    if management_page == PAGE_LINK { return Label("entity.link_device", "Link a device") }
    if management_page == PAGE_NODES { return Label("entity.nodes", "Nodes") }
    if management_page == PAGE_NODE && node_open < state.node_count { return NodeHost(TextUntilNul(state.nodes[node_open][:])) }
    if management_page == PAGE_ADD_NODE { return Label("entity.add_node", "Add node") }
    if management_page == PAGE_APPEARANCE { return Label("entity.appearance", "Appearance") }
    if management_page == PAGE_FRIENDS { return Label("profile_friends_title", "Friends") }
    if management_page == PAGE_ALIAS { return Label("entity.alias", "Alias") }
    return Label("entity.account", "Account")
}

// Account controls are part of Profile, with one navigation stack.
AccountActions :: (x: float32, y: *float32, width: float32) {
    if !management.account { return }
        if CanManage(ACCOUNT_SYNC) {
            TextLine(815, Label("entity.sync", "Sync"), x + 4.0 * scale, y.* + 10.0 * scale, width - 80.0 * scale, 16)
            result := Toggle(session, ToggleProps.{.key = cast(u64)816, .id = 816,
                    .bounds = Rectangle.{x + width - 64.0 * scale, y.*, 64.0 * scale, 40.0 * scale},
                    .label = Label("entity.sync", "Sync"), .value = management.enabled, .disabled = management_waiting > management.completed})
            if result.changed { Manage("set_sync", "", "", ifx result.value then 1 else 0) }
            y.* += 52.0 * scale
            if management.queued > 0 {
                out: Vec(u8)
                BuilderPrint(*out, "%: %", Label("entity.queued", "Waiting to sync"), management.queued)
                Muted(817, BuilderFinish(out), x + 4.0 * scale, y.*, width)
                y.* += 32.0 * scale
            }
            if WideButton(818, Label("entity.sync_now", "Sync now"), x, y, width) { Manage("sync") }
        }
        if CanManage(ACCOUNT_ALIAS) {
            alias := TextUntilNul(management.alias[:])
            if ListRow(819, Label("entity.alias", "Alias"), ifx alias == "" then Label("entity.alias_unset", "Not set") else alias, x, y, width) {
                OpenManagement(PAGE_ALIAS)
            }
        }
        if CanManage(ACCOUNT_BACKUP) && ListRow(823, Label("entity.backup_key", "Back up key"), "", x, y, width) { OpenManagement(PAGE_BACKUP) }
        if CanManage(ACCOUNT_IMPORT) && ListRow(832, Label("entity.import_key", "Import key"), "", x, y, width) { OpenManagement(PAGE_IMPORT) }
        if CanManage(ACCOUNT_LINK) && ListRow(824, Label("entity.link_another", "Link another device"), "", x, y, width) { OpenManagement(PAGE_LINK) }
    if management.account {
        y.* += 8.0 * scale
        if CanManage(ACCOUNT_LOGOUT) && WideButton(830, Label("entity.logout", "Log out"), x, y, width, false, true, true) { OpenManagement(PAGE_LOGOUT) }
        if CanManage(ACCOUNT_CLEAR_REMOTE) && WideButton(831, Label("entity.clear_remote", "Clear remote data"), x, y, width, false, true, true) {
            OpenManagement(PAGE_CLEAR)
        }
    }
}

AccountPage :: (x: float32, y: *float32, width: float32) {
    AccountSummary(x, y, width)
    AccountActions(x, y, width)
}

KeyPage :: (x: float32, y: *float32, width: float32) {
    importing := management_page == PAGE_IMPORT
    unused EditField(4, account_passphrase[:], Label(ifx importing then "entity.passphrase_if_set" else "entity.passphrase",
        ifx importing then "Passphrase (if set)" else "Passphrase (optional)"), Rectangle.{x, y.*, width, 48.0 * scale}, 160, true)
    y.* += 64.0 * scale
    passphrase: [512]u8
    for index: 0..account_passphrase.count - 1 { passphrase[index] = account_passphrase[index] }
    paste := CanManage(ACCOUNT_PASTE)
    {
        value := TextUntilNul(passphrase[:])
        if !importing {
            if WideButton(803, Label("entity.save_key", "Save key file"), x, y, width, true) { Manage("backup", value) }
        } else {
            if paste && WideButton(804, Label("entity.paste_key", "Paste key"), x, y, width, true) { Manage("import_paste", value) }
            if CanManage(ACCOUNT_IMPORT) && WideButton(805, Label("entity.choose_key", "Choose key file"), x, y, width, !paste) { Manage("import", value) }
        }
    }
    for index: 0..passphrase.count - 1 { passphrase[index] = cast(u8)0 }
}

ConfirmPage :: (x: float32, y: *float32, width: float32) {
    explanation := Label("entity.logout_help", "Your records stay on this device.")
    if management_page == PAGE_CLEAR { explanation = Label("entity.clear_remote_help", "Removes this account's data from its node.") }
    if management_page == PAGE_SWITCH { explanation = Label("entity.switch_help", "Keep this device's records with the new account?") }
    Paragraph(806, explanation, x, y.*, width, 48.0)
    y.* += 60.0 * scale
    if management_page == PAGE_SWITCH {
        if WideButton(807, Label("entity.merge", "Keep and merge"), x, y, width, true) { Manage("switch_apply", "", "", 1) }
        if WideButton(808, Label("entity.replace", "Replace them"), x, y, width, false, false, true) { Manage("switch_apply", "", "", 2) }
        if WideButton(809, Label("entity.cancel", "Cancel"), x, y, width, false, true) { Manage("switch_cancel"); unused ManagementBack() }
        return
    }
    if WideButton(807, PageTitle(), x, y, width, false, false, true) { Manage(ifx management_page == PAGE_LOGOUT then "logout" else "clear_remote") }
    if WideButton(809, Label("entity.cancel", "Cancel"), x, y, width, false, true) { unused ManagementBack() }
}

LinkPage :: (x: float32, y: *float32, width: float32) {
    stage := management.link_stage
    if stage == 0 || stage == 7 {
        if stage == 7 && management.link_message[0] != cast(u8)0 {
            Paragraph(832, TextUntilNul(management.link_message[:]), x, y.*, width, 48.0)
            y.* += 56.0 * scale
        }
        if WideButton(833, Label("entity.show_code", "Show a code"), x, y, width, true) { Manage("link_show") }
        if CanManage(ACCOUNT_SCAN) && WideButton(834, Label("entity.scan_code", "Scan a code"), x, y, width) { Manage("link_scan") }
        if CanManage(ACCOUNT_PASTE) && WideButton(835, Label("entity.paste_code", "Paste a code"), x, y, width) { Manage("link_paste") }
        y.* += 8.0 * scale
        unused EditField(5, account_code[:], Label("entity.enter_code", "Or type a code"), Rectangle.{x, y.*, width - 112.0 * scale, 48.0 * scale}, 1023)
        if Button(session, ButtonProps.{.key = cast(u64)836, .id = 836, .label = Label("entity.connect", "Connect"),
                .bounds = Rectangle.{x + width - 104.0 * scale, y.*, 104.0 * scale, 48.0 * scale},
                .disabled = account_code[0] == cast(u8)0,
                .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
            Manage("link_join", TextUntilNul(account_code[:]))
        }
        y.* += 64.0 * scale
        return
    }
    if management.link_code[0] != cast(u8)0 {
        side := DrawConnectionCode(TextUntilNul(management.link_code[:]), x, y.*, width)
        y.* += side + 12.0 * scale
        if WideButton(837, Label("entity.copy_code", "Copy code"), x, y, width, false, true) {
            if ClipboardCopy(TextUntilNul(management.link_code[:]), 0) { notice = Label("entity.copied", "Copied") }
        }
    }
    if management.link_message[0] != cast(u8)0 {
        Paragraph(838, TextUntilNul(management.link_message[:]), x, y.*, width, 48.0, 16)
        y.* += 56.0 * scale
    }
    if (stage == 2 || stage == 4) && WideButton(839, Label("entity.confirm_device", "The digits match, connect"), x, y, width, true) { Manage("link_confirm") }
    if stage != 6 && WideButton(842, Label("entity.cancel", "Cancel"), x, y, width, false, true) { Manage("link_cancel") }
}

NodesPage :: (x: float32, y: *float32, width: float32) {
    connected := false
    for index: 0..state.node_count - 1 { if NodeConnected(cast(s32)index) { connected = true } }
    if !connected {
        Muted(850, Label("entity.not_connected", "Not connected to a node"), x + 4.0 * scale, y.*, width)
        y.* += 36.0 * scale
    }
    for index: 0..state.node_count - 1 {
        address_bytes: [256]u8
        for byte: 0..255 { address_bytes[byte] = state.nodes[index][byte] }
        address := TextUntilNul(address_bytes[:])
        value := ifx state.preferred == index then Label("entity.default", "Default") else ""
        if ListRow(851 + cast(s32)index, NodeHost(address), value, x, y, width, ifx NodeConnected(cast(s32)index) then 1 else 2) {
            node_open = cast(s32)index
            OpenManagement(PAGE_NODE)
        }
    }
    y.* += 8.0 * scale
    if state.node_count < ENTITY_NODE_LIMIT && WideButton(860, Label("entity.add_node", "Add node"), x, y, width, false, true) {
        node_text[0] = cast(u8)0
        OpenManagement(PAGE_ADD_NODE)
    }
}

NodePage :: (x: float32, y: *float32, width: float32) {
    if node_open < 0 || node_open >= state.node_count { unused ManagementBack(); return }
    // A copy: removing the node below moves the saved list.
    address_bytes: [256]u8
    for byte: 0..255 { address_bytes[byte] = state.nodes[node_open][byte] }
    address := TextUntilNul(address_bytes[:])
    Muted(861, address, x, y.*, width)
    y.* += 32.0 * scale
    status := ifx NodeConnected(node_open) then Label("entity.connected", "Connected") else Label("entity.not_connected_short", "Not connected")
    TextLine(862, status, x, y.*, width, 16)
    y.* += 36.0 * scale
    at := ManagementNodeAt(address)
    if at >= 0 && management.nodes[at].known {
        node := management.nodes[at]
        Muted(863, StorageUsageLabel(node.used, node.limit), x, y.*, width)
        y.* += 32.0 * scale
    }
    if at >= 0 && management.nodes[at].media_supported {
        TextLine(864, Label("entity.node_media", "Upload photos and videos"), x, y.* + 10.0 * scale, width - 80.0 * scale, 15)
        result := Toggle(session, ToggleProps.{.key = cast(u64)865, .id = 865,
                .bounds = Rectangle.{x + width - 64.0 * scale, y.*, 64.0 * scale, 40.0 * scale},
                .label = Label("entity.node_media", "Upload photos and videos"), .value = management.nodes[at].media,
                .disabled = management.busy || management_waiting > management.completed})
        if result.changed { Manage("media", "", address, ifx result.value then 1 else 0) }
        y.* += 56.0 * scale
    }
    y.* += 8.0 * scale
    if state.preferred == node_open {
        Muted(866, Label("entity.default_node", "This is your default node"), x, y.*, width)
        y.* += 40.0 * scale
    } else if WideButton(867, Label("entity.make_default", "Make default"), x, y, width, true) {
        state.preferred = node_open
        unused Save()
    }
    if state.node_count > 1 && WideButton(868, Label("entity.remove", "Remove node"), x, y, width, false, true, true) {
        for next: node_open..state.node_count - 2 { state.nodes[next] = state.nodes[next + 1] }
        state.node_count -= 1
        if state.preferred > node_open || state.preferred >= state.node_count { state.preferred -= 1 }
        if state.preferred < 0 { state.preferred = 0 }
        unused Save()
        unused ManagementBack()
    }
}

AddNodePage :: (x: float32, y: *float32, width: float32) {
    submitted := EditField(2, node_text[:], Label("entity.node_address", "Node address"),
        Rectangle.{x, y.*, width, 48.0 * scale}, 255)
    y.* += 64.0 * scale
    add := WideButton(870, Label("entity.add", "Add"), x, y, width, true)
    if !submitted && !add { return }
    added := false
    {
        snapshot := node_text
        origin := NodeOrigin(TextUntilNul(snapshot[:]))
        known := false
        for index: 0..state.node_count - 1 { if TextUntilNul(state.nodes[index][:]) == origin { known = true } }
        if origin == "" {
            notice = Label("entity.node_invalid", "Enter a valid HTTPS node address")
        } else if known {
            added = true
        } else if state.node_count >= ENTITY_NODE_LIMIT {
            notice = Label("entity.node_limit", "Eight nodes are already saved")
        } else {
            unused CopyCString(origin, state.nodes[state.node_count][:])
            state.node_count += 1
            unused Save()
            added = true
        }
    }
    if added {
        node_text[0] = cast(u8)0
        unused ManagementBack()
    }
}

DrawAccount :: () {
    session = AppSession()
    scale = AppScale()
    if scale <= 0.0 { scale = 1.0 }
    area := AppBounds()
    width := area.width - 40.0 * scale
    if width > 680.0 * scale { width = 680.0 * scale }
    if width < 160.0 * scale { return }
    Box(session, BoxProps.{.key = cast(u64)2, .bounds = area,
            .fill = ThemeOr("canvas", 0x142724ff, 0xeef4f2ff)})
    scroll := Scroll(session, ScrollProps.{.key = cast(u64)1, .bounds = area,
            .content_height = cast(s32)account_height, .scroll_offset = management_scroll, .scale = scale})
    management_scroll = scroll.scroll_offset
    if !scroll.opened { return }
    x := scroll.content.x + (scroll.content.width - width) * 0.5
    top := scroll.content.y
    y := top + 16.0 * scale
    if !state.host_navigation {
        if Action(800, Label("entity.back", "Back"), Rectangle.{x, y, 84.0 * scale, 40.0 * scale}) { unused ManagementBack() }
        y += 56.0 * scale
    }
    if management_page != PAGE_FRIENDS || !state.host_navigation {
        TextLine(801, PageTitle(), x, y, width, 24)
        y += 52.0 * scale
    }
    page := management_page
    if page == PAGE_IMPORT || page == PAGE_BACKUP { KeyPage(x, *y, width) }
    else if page == PAGE_LOGOUT || page == PAGE_CLEAR || page == PAGE_SWITCH { ConfirmPage(x, *y, width) }
    else if page == PAGE_LINK { LinkPage(x, *y, width) }
    else if page == PAGE_NODES { NodesPage(x, *y, width) }
    else if page == PAGE_NODE { NodePage(x, *y, width) }
    else if page == PAGE_ADD_NODE { AddNodePage(x, *y, width) }
    else if page == PAGE_ALIAS { AliasPage(x, *y, width) }
    else if page == PAGE_FRIENDS { FriendsPage(x, *y, width) }
    else if page == PAGE_APPEARANCE { AppearanceControls(x, *y, width, ENTITY_APPEARANCE | ENTITY_ACCENT | ENTITY_WIDGETS) }
    else { AccountPage(x, *y, width) }
    if management_waiting > management.completed {
        Muted(841, Label("entity.working", "Working…"), x, y, width)
        y += 32.0 * scale
    } else if notice != "" {
        Paragraph(840, notice, x, y, width, 48.0)
        y += 56.0 * scale
    }
    account_height = y - top + 24.0 * scale
    unused End(session)
    AppKeyboard(fields[2].focused || fields[3].focused || fields[4].focused || fields[5].focused)
    PublicIdModal()
    PictureModal()
    AliasPurchaseModal()
}

Picture :: (index: s32, bounds: Rectangle) -> ImageProps {
    image := ImageProps.{.asset_path = "assets/entity/pfp.png", .alt_text = Label("entity.picture", "Profile picture"),
        .bounds = bounds, .source = Rectangle.{cast(float32)(index % 5) * 64.0, cast(float32)(index / 5) * 64.0, 64.0, 64.0}}
    if index == 9 {
        image.asset_path = "assets/entity/flowers.png"
        image.source = Rectangle.{}
        image.fit = ImageFit.ImageFitContain
    }
    if asset_root[0] != cast(u8)0 {
        path: Vec(u8)
        BuilderPrint(*path, "%/%", TextUntilNul(asset_root[:]), image.asset_path)
        image.asset_path = BuilderFinish(path)
    }
    return image
}

ExtensionShape :: (route: string) -> string {
    if route == "leaderboard" { return "S1.7rr:M4 21V13H8V21M10 21V4H14V21M16 21V9H20V21" }
    if route == "dew" { return "S1.7rr:M12 3C10 6 5 11 5 15C5 24 19 24 19 15C19 11 14 6 12 3ZM8 15C8 18 10 19 12 19" }
    if route == "achievements" { return "S1.7rr:M8 3H16V10C16 16 8 16 8 10ZM8 5H4V8L8 11M16 5H20V8L16 11M12 15V21M8 21H16" }
    if route == "inbe" { return "S1.7rr:M3 13H7L10 5L14 20L17 11H21" }
    if route == "friends" { return "S1.7rr:M9 3C4 3 4 11 9 11C14 11 14 3 9 3M2 21V18C2 12 16 12 16 18V21M17 4C22 4 22 11 17 11M19 14C22 15 22 18 22 21" }
    if route == "data" { return "S1.7rr:M4 5C4 1 20 1 20 5C20 9 4 9 4 5V18C4 22 20 22 20 18V5M4 11C4 15 20 15 20 11" }
    return "S1.7rr:M5 5H19V19H5ZM9 9L15 15M9 15L15 9"
}

ExtensionRows :: (left: float32, top: *float32, width: float32) {
    for index: 0..state.extension_count - 1 {
        entry := state.extensions[index]
        route := TextUntilNul(entry.id[:])
        if management.available && route == "account" { continue }
        if route == "dew" && AppSupports("entity.dew") { continue }
        if route == "leaderboard" { continue }
        detailed := entry.summary[0] != cast(u8)0
        row_height := (ifx detailed then 76.0 else 60.0) * scale
        row := Rectangle.{left, top.*, width, row_height}
        color := ThemeOr("text", 0xe5eef3ff, 0x203b4bff)
        SvgIcon(session, SvgIconProps.{.shape = ExtensionShape(route), .color = color,
                .bounds = Rectangle.{left + 4.0 * scale, top.* + 16.0 * scale, 24.0 * scale, 24.0 * scale}})
        label_x := left + 44.0 * scale
        TextLine(cast(u64)(920 + index), TextUntilNul(entry.label[:]), label_x,
            top.* + (ifx detailed then 8.0 else 16.0) * scale, width - 76.0 * scale, 16)
        if detailed {
            TextLine(cast(u64)(940 + index), TextUntilNul(entry.summary[:]), label_x,
                top.* + 36.0 * scale, width - 76.0 * scale, 13)
        }
        SvgIcon(session, SvgIconProps.{.shape = "S1.7rr:M9 5L16 12L9 19", .color = color,
                .bounds = Rectangle.{left + width - 24.0 * scale, top.* + 18.0 * scale, 20.0 * scale, 20.0 * scale}})
        if Button(session, ButtonProps.{.key = cast(u64)(500 + index), .id = 500 + cast(s32)index,
                .bounds = row, .label = TextUntilNul(entry.label[:]), .invisible = true}) != 0 && Save() {
            if route == "dew" && AppSupports("entity.dew") {
                dew_page = true
                dew_refresh = true
            } else if route == "leaderboard" { unused ProfileLeaderboardCommand(route) }
            else if !AchievementOpenRoute(route) { AppReply(route) }
        }
        Box(session, BoxProps.{.key = cast(u64)(900 + index),
                .bounds = Rectangle.{label_x, top.* + row_height, width - 44.0 * scale, 1.0},
                .fill = ThemeOr("border", 0x34514aff, 0xdde7e3ff)})
        top.* += row_height + 8.0 * scale
    }
    top.* += 16.0 * scale
}

Draw :: () {
    PollManagement()
    if !loaded {
        state = EntityDefault()
        assets := AppService("entity.assets", "")
        // An absolute folder: /home/… or, on Windows, a drive such as C:/….
        absolute := (assets.count > 0 && assets[0] == cast(u8)47) ||
        (assets.count > 2 && assets[1] == cast(u8)58 && assets[2] == cast(u8)47)
        if absolute { unused CopyCString(assets, asset_root[:]) }
        bytes: [16385]u8
        count := ReadStore("entity.json", bytes[:])
        if count > 0 { unused EntityDecode(TextUntilNul(bytes[:]), *state) }
        loaded = true
        dew_refresh = true
    }
    if ProfileLeaderboardFrame(!state.host_navigation) { return }
    if AchievementViewFrame(!state.host_navigation) { return }
    if dew_page { DrawDew(); return }
    if management_page != 0 { DrawAccount(); return }
    session = AppSession()
    scale = AppScale()
    if scale <= 0.0 { scale = 1.0 }
    area := AppBounds()
    width := area.width - 40.0 * scale
    if width > 680.0 * scale { width = 680.0 * scale }
    if width < 160.0 * scale { return }
    inline_dew := AppSupports("entity.dew") && (state.profile_sections & PROFILE_DEW) != 0
    if inline_dew { ProfileDewRead() }
    inline_activity := AppSupports("entity.activity")
    if inline_activity { ProfileActivityRead() }
    Box(session, BoxProps.{.key = cast(u64)2, .bounds = area,
            .fill = ThemeOr("canvas", 0x142724ff, 0xeef4f2ff)})
    // The column scrolls over the height the previous frame drew.
    scroll := Scroll(session, ScrollProps.{.key = cast(u64)1,
            .bounds = area, .content_height = cast(s32)profile_height,
            .scroll_offset = scroll_offset, .scale = scale})
    scroll_offset = scroll.scroll_offset
    if !scroll.opened { return }
    x := scroll.content.x + (scroll.content.width - width) * 0.5
    top := scroll.content.y
    y := top + 24.0 * scale
    if !state.host_navigation {
        TextLine(5, Label("entity.title", "Your profile"), x, y, width, 30)
        y += 44.0 * scale
    }
    center_x := x + width * 0.5
    Box(session, BoxProps.{.key = cast(u64)6,
            .bounds = Rectangle.{center_x - 44.0 * scale, y, 88.0 * scale, 88.0 * scale},
            .radius = 44.0 * scale, .fill = ThemeOr("surface", 0x2a4540ff, 0xeaf1eaff)})
    ProfilePicture(9, Rectangle.{center_x - 40.0 * scale, y + 4.0 * scale, 80.0 * scale, 80.0 * scale})
    y += 96.0 * scale
    change := ButtonProps.{.key = cast(u64)10, .id = 10,
        .bounds = Rectangle.{center_x - 72.0 * scale, y, 144.0 * scale, 32.0 * scale},
        .label = Label("entity.change_picture", "Change picture"),
        .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisGhost}
    if Button(session, change) != 0 { OpenPicturePicker() }
    y += 52.0 * scale
    if management.available { AccountSummary(x, *y, width) }
    // Dew needs an account; without one the card would only say so.
    if inline_dew && dew_profile_available { y += ProfileDewBalance(x, y, width, true).height }
    if inline_activity { y += ProfileActivity(x, y, width, true) }
    if (state.controls & ENTITY_NODES) != 0 && ListRow(704, Label("entity.nodes", "Nodes"), NodesSummary(), x, *y, width) {
        OpenManagement(PAGE_NODES)
    }
    if AppSupports("entity.friends") && (state.profile_sections & PROFILE_FRIENDS) != 0 &&
    ListRow(551, Label("profile_friends_title", "Friends"), "", x, *y, width) { OpenManagement(PAGE_FRIENDS) }
    if AppSupports(LEADERBOARD_SERVICE) && (state.profile_sections & PROFILE_LEADERBOARD) != 0 &&
    ListRow(550, Label("leaderboard_title", "Leaderboard"), "", x, *y, width) { unused ProfileLeaderboardCommand("leaderboard") }
    ExtensionRows(x, *y, width)
    if management.available { AccountActions(x, *y, width) }
    if notice != "" {
        Text(session, TextProps.{.key = cast(u64)22, .text = notice,
                .bounds = Rectangle.{x, y, width, 40.0 * scale}, .font = cast(s32)(13.0 * scale), .wrap = TextWrap.TextWrapAuto})
        y += 48.0 * scale
    }
    AppearanceControls(x, *y, width, state.controls)
    profile_height = y - top + 24.0 * scale
    unused End(session)
    AppKeyboard(fields[0].focused || fields[1].focused)
    PublicIdModal()
    PictureModal()
}

#program_export
Main :: () -> s64 {
    mode := AppMode()
    if mode == APP_COMMAND && AppCommand() == "back" && choosing_picture {
        choosing_picture = false
        AppReply("handled")
        return 0
    }
    if mode == APP_COMMAND && AppCommand() == "back" && public_id_open {
        public_id_open = false
        AppReply("handled")
        return 0
    }
    if mode == APP_COMMAND {
        command := AppCommand()
        if command == "root:profile" { root_page = ""; ManagementHome(0); return 0 }
        if command == "root:leaderboard" { root_page = "leaderboard"; unused ProfileLeaderboardCommand("leaderboard"); return 0 }
        if command == "root:dew" { root_page = "dew"; dew_page = true; dew_refresh = true; return 0 }
        if command == "root:appearance" { root_page = "appearance"; ManagementHome(PAGE_APPEARANCE); return 0 }
        if command == "back" && ((root_page == "leaderboard" && profile_leaderboard_open) ||
            (root_page == "dew" && dew_page && dew_confirmation < 0) ||
            (root_page == "appearance" && management_page == PAGE_APPEARANCE)) {
            root_page = ""
            dew_page = false
            profile_leaderboard_open = false
            ManagementHome(0)
            AppReply("close")
            return 0
        }
    }
    if mode == APP_IDENTIFY {
        AppIdentity("entity")
        AppDescribe("Entity", "S1.6rr:M12 12A4 4 0 1 0 12 4A4 4 0 0 0 12 12ZM4 22V20A8 8 0 0 1 20 20V22")
        return APP_PROTOCOL
    }
    if mode == APP_COMMAND && AppCommand() == "back" && dew_page {
        dew_page = false
        dew_confirmation = -1
        AppReply("handled")
        return 0
    }
    if mode == APP_COMMAND && ProfileLeaderboardCommand(AppCommand()) { return 0 }
    if mode == APP_COMMAND && AchievementCommand(AppCommand()) { return 0 }
    if mode == APP_FRAME { Draw() }
    if mode == APP_COMMAND && AppCommand() == "reload" {
        loaded = false
        public_id_open = false
        choosing_picture = false
        fields = .{}
    }
    if mode == APP_COMMAND && AppCommand() == "account" { ManagementHome(PAGE_ACCOUNT) }
    if mode == APP_COMMAND && AppCommand() == "dew" && AppSupports("entity.dew") {
        dew_page = true
        dew_refresh = true
        dew_confirmation = -1
        management_scroll = 0
    }
    if mode == APP_COMMAND && AppCommand() == "back" && ManagementBack() { AppReply("handled") }
    if mode == APP_SAVE && loaded { return ifx Save() then 0 else 1 }
    return 0
}

// One Dew page for native Entity providers. The host supplies verified node
// state and queues explicit requests; balances are never computed locally.
dew_page: bool;
dew_refresh: bool;
dew_confirmation: s32 = -1;
dew_view_tick: s32;
dew_view_json: [20000]u8;
dew_profile_account: DewAccount;
dew_profile_available: bool;
dew_profile_busy: bool;
dew_profile_error: bool;
dew_profile_host_actions: bool;
dew_profile_manage_data: bool;
// Whether the host sells Dew here; a host answering "top_up":false does not.
dew_profile_top_up: bool;
dew_profile_worth: [256]u8;
dew_profile_plan: [256]u8;
dew_profile_usage: [256]u8;

ProfileDewRead :: () {
    dew_view_tick += 1
    if dew_view_tick % 15 != 1 && !dew_refresh { return }
    unused CopyCString(AppService("entity.dew", ""), dew_view_json[:])
    json := TextUntilNul(dew_view_json[:])
    owner: [65]u8
    unused ReadStringText(json, FieldAt(json, 0, "owner"), owner[:])
    same_owner := TextUntilNul(owner[:]) == TextUntilNul(management.public_id[:]) && TextUntilNul(owner[:]).count == 64
    dew_profile_available = same_owner && MatchLiteral(json, FieldAt(json, 0, "available"), "true")
    dew_profile_busy = MatchLiteral(json, FieldAt(json, 0, "busy"), "true")
    dew_profile_error = MatchLiteral(json, FieldAt(json, 0, "error"), "true")
    dew_profile_host_actions = MatchLiteral(json, FieldAt(json, 0, "host_actions"), "true")
    dew_profile_manage_data = dew_profile_host_actions && MatchLiteral(json, FieldAt(json, 0, "manage_data"), "true")
    dew_profile_top_up = !MatchLiteral(json, FieldAt(json, 0, "top_up"), "false")
    dew_profile_account = .{}
    dew_profile_worth = .{}
    dew_profile_plan = .{}
    dew_profile_usage = .{}
    at := FieldAt(json, 0, "account")
    end := ValueEnd(json, at, 0)
    if same_owner && at >= 0 && end > at {
        unused DewParseAccount(json[at:end], TextUntilNul(owner[:]), *dew_profile_account)
        unused ReadStringText(json, FieldAt(json, 0, "worth"), dew_profile_worth[:])
        unused ReadStringText(json, FieldAt(json, 0, "plan_summary"), dew_profile_plan[:])
        unused ReadStringText(json, FieldAt(json, 0, "usage_summary"), dew_profile_usage[:])
    }
    if dew_refresh && dew_profile_available && !dew_profile_busy {
        sequence := cast(s32)ReadNumber(json, FieldAt(json, 0, "sequence")).value
        DewCommand("refresh", sequence)
        dew_refresh = false
    }
}

ProfileDewBalance :: (x: float32, y: float32, width: float32, draw: bool) -> DewBalanceResult {
    account := dew_profile_account
    amount: [64]u8
    unused CopyCString("—", amount[:])
    if account.known && dew_profile_available { unused DewFormat(account.balance, DewUnits, amount[:], "Dew") }
    plan := TextUntilNul(dew_profile_plan[:])
    usage := TextUntilNul(dew_profile_usage[:])
    own_plan: [256]u8
    own_usage: [256]u8
    if account.known && plan == "" {
        unused CopyCString(ifx account.plan_size > 0 then Label("profile_dew_paid_plan", "Paid storage") else Label("profile_dew_plan_free", "Free"), own_plan[:])
        plan = TextUntilNul(own_plan[:])
    }
    if account.known && usage == "" && account.limit_bytes > 0 {
        used: [64]u8
        limit: [64]u8
        unused DewFormat(account.used_bytes / 1048576, 1, used[:], "MB")
        unused DewFormat(account.limit_bytes / 1048576, 1, limit[:], "MB")
        at: s64 = 0
        for byte: TextUntilNul(used[:]) { own_usage[at] = byte; at += 1 }
        for byte: " / " { own_usage[at] = byte; at += 1 }
        for byte: TextUntilNul(limit[:]) { own_usage[at] = byte; at += 1 }
        usage = TextUntilNul(own_usage[:])
    }
    notice := ""
    if !dew_profile_available { notice = Label("profile_dew_connect", "Sign in to use Dew.") }
    else if dew_profile_error { notice = Label("profile_dew_error", "Could not refresh Dew. Any balance shown is the last confirmed balance.") }
    else if !account.known { notice = Label("profile_dew_loading", "Checking Dew…") }
    result := DewBalance(session, DewBalanceProps.{.bounds = Rectangle.{x, y, width, 0.0}, .scale = scale,
            .title = Label("profile_dew_title", "Dew balance"), .balance = TextUntilNul(amount[:]),
            .plan = plan, .usage = usage, .notice = notice,
            .top_up = ifx dew_profile_top_up then Label("profile_dew_topup", "Top up") else "", .plans = Label("profile_dew_plans", "Storage plans"),
            .data = ifx dew_profile_manage_data then Label("entity.manage_data", "Manage data") else "",
            .ready = dew_profile_available, .known = account.known, .busy = dew_profile_busy, .enabled = account.enabled,
            .has_usage = account.limit_bytes > 0,
            .usage_percent = ifx account.limit_bytes > 0 then cast(s32)(account.used_bytes * 100 / account.limit_bytes) else 0,
            .fill = Darken(ThemeOr("canvas", 0x142724ff, 0xeef4f2ff), 7), .track = ThemeOr("border", 0x34514aff, 0xdde7e3ff),
            .accent = ThemeOr("accent", 0x49a68eff, 0x298a71ff),
            .warning = Color.{163, 98, 0, 255}, .danger = Color.{179, 38, 30, 255}}, draw)
    if result.action != 0 {
        if dew_profile_host_actions {
            AppReply(ifx result.action == DewBalanceTopUp then "dew-topup" else ifx result.action == DewBalanceData then "dew-data" else "dew-plans")
        }
        // Hosts that know dew.waozi.xyz open it for this account; others keep
        // the Profile's own Dew page.
        else if result.action == DewBalanceTopUp && AppService("entity.dew", "open-topup") == "opened" {}
        else { dew_page = true; dew_refresh = true; management_scroll = 0 }
    }
    return result
}

// The same darkening Inner Breeze gives its cards, so they stand off the panel.
Darken :: (color: Color, percent: s32) -> Color {
    keep := cast(s32)(100 - percent)
    return Color.{cast(u8)(cast(s32)color.r * keep / 100), cast(u8)(cast(s32)color.g * keep / 100),
        cast(u8)(cast(s32)color.b * keep / 100), color.a}
}

// Up to three figures a host shows about its own use, such as Inner Breeze's
// practice days. Hosts without the service show nothing.
ActivityStat :: struct { label: [64]u8; value: [32]u8; icon: [16]u8 }
activity_stats: [3]ActivityStat;
activity_count: s32;
activity_tick: s32;

ProfileActivityRead :: () {
    activity_tick += 1
    if activity_tick % 30 != 1 { return }
    json := AppService("entity.activity", "")
    at := FieldAt(json, 0, "stats")
    count := ArrayCount(json, at)
    activity_count = 0
    for index: 0..count - 1 {
        if activity_count >= activity_stats.count { break }
        row := ElementAt(json, at, cast(s32)index)
        stat: ActivityStat
        if ReadStringText(json, FieldAt(json, row, "label"), stat.label[:]) < 1 ||
        ReadStringText(json, FieldAt(json, row, "value"), stat.value[:]) < 1 { continue }
        unused ReadStringText(json, FieldAt(json, row, "icon"), stat.icon[:])
        activity_stats[activity_count] = stat
        activity_count += 1
    }
}

ActivityShape :: (icon: string) -> string {
    if icon == "today" { return "S1.7rr:M4 6H20V20H4ZM4 10H20M8 3V7M16 3V7" }
    if icon == "days" { return "S1.7rr:M3 13H7L10 5L14 20L17 11H21" }
    if icon == "sessions" { return "S1.7rr:M5 20V12M12 20V5M19 20V9" }
    return ""
}

ProfileActivity :: (x: float32, y: float32, width: float32, draw: bool) -> float32 {
    if activity_count == 0 { return 0.0 }
    height := 112.0 * scale
    if draw {
        gap := 8.0 * scale
        tile := (width - gap * cast(float32)(activity_count - 1)) / cast(float32)activity_count
        for index: 0..activity_count - 1 {
            stat := activity_stats[index]
            left := x + cast(float32)index * (tile + gap)
            center := left + tile * 0.5
            Box(session, BoxProps.{.key = cast(u64)(1200 + index), .bounds = Rectangle.{left, y, tile, height},
                    .fill = Darken(ThemeOr("canvas", 0x142724ff, 0xeef4f2ff), 7), .radius = 12.0 * scale})
            shape := ActivityShape(TextUntilNul(stat.icon[:]))
            if shape != "" {
                Box(session, BoxProps.{.key = cast(u64)(1210 + index),
                        .bounds = Rectangle.{center - 17.0 * scale, y + 9.0 * scale, 34.0 * scale, 34.0 * scale},
                        .fill = ThemeOr("accent", 0x49a68eff, 0x298a71ff), .radius = 17.0 * scale})
                SvgIcon(session, SvgIconProps.{.shape = shape, .color = Color.{255, 255, 255, 255},
                        .bounds = Rectangle.{center - 9.0 * scale, y + 17.0 * scale, 18.0 * scale, 18.0 * scale}})
            }
            Text(session, TextProps.{.key = cast(u64)(1220 + index), .text = TextUntilNul(stat.label[:]),
                    .bounds = Rectangle.{left + 4.0 * scale, y + 50.0 * scale, tile - 8.0 * scale, 22.0 * scale},
                    .font = cast(s32)(13.0 * scale), .align = TextAlign.TextAlignCenter, .wrap = TextWrap.TextWrapEllipsis})
            Text(session, TextProps.{.key = cast(u64)(1230 + index), .text = TextUntilNul(stat.value[:]),
                    .bounds = Rectangle.{left + 4.0 * scale, y + 74.0 * scale, tile - 8.0 * scale, 30.0 * scale},
                    .font = cast(s32)(22.0 * scale), .align = TextAlign.TextAlignCenter, .wrap = TextWrap.TextWrapEllipsis})
        }
    }
    return height + 16.0 * scale
}

DewCommand :: (operation: string, sequence: s32, size: string = "", period: string = "") {
    request: Vec(u8)
    BuilderPrint(*request, "{\"owner\":\"%\",\"sequence\":%,\"operation\":\"%\",\"size\":\"%\",\"period\":\"%\"}",
        TextUntilNul(management.public_id[:]), sequence + 1, operation, size, period)
    document := BuilderFinish(request)
    unused AppService("entity.dew", document)
}

DewDecimal :: (units: s64, divisor: s64, suffix: string) -> string {
    text: Vec(u8)
    fraction := units % divisor
    BuilderPrint(*text, "%", units / divisor)
    if fraction != 0 {
        digits: [19]u8
        places: s32 = 0
        factor := divisor
        while factor > 1 { places += 1; factor /= 10 }
        value := fraction
        index := places
        while index > 0 { index -= 1; digits[index] = cast(u8)(48 + value % 10); value /= 10 }
        last := places
        while last > 0 && digits[last - 1] == cast(u8)48 { last -= 1 }
        BuilderPrint(*text, ".%", TextView(digits[:last]))
    }
    BuilderPrint(*text, " %", suffix)
    return BuilderFinish(text)
}

DrawDew :: () {
    session = AppSession()
    scale = AppScale()
    if scale <= 0.0 { scale = 1.0 }
    dew_view_tick += 1
    if dew_view_tick % 15 == 1 || dew_refresh { unused CopyCString(AppService("entity.dew", ""), dew_view_json[:]) }
    json := TextUntilNul(dew_view_json[:])
    owner: [65]u8
    unused ReadStringText(json, FieldAt(json, 0, "owner"), owner[:])
    sequence := cast(s32)ReadNumber(json, FieldAt(json, 0, "sequence")).value
    available := TextUntilNul(owner[:]) == TextUntilNul(management.public_id[:]) && MatchLiteral(json, FieldAt(json, 0, "available"), "true")
    busy := MatchLiteral(json, FieldAt(json, 0, "busy"), "true")
    if dew_refresh && available && !busy { DewCommand("refresh", sequence); dew_refresh = false }
    area := AppBounds()
    Box(session, BoxProps.{.key = cast(u64)45000, .bounds = area, .fill = ThemeOr("canvas", 0x142724ff, 0xeef4f2ff)})
    scroll := Scroll(session, ScrollProps.{.key = cast(u64)45001, .bounds = area, .content_height = cast(s32)(1180.0 * scale), .scroll_offset = management_scroll})
    management_scroll = scroll.scroll_offset
    if !scroll.opened { return }
    defer { End(session) }
    x := scroll.content.x + 24.0 * scale
    y := scroll.content.y + 16.0 * scale
    width := scroll.content.width - 48.0 * scale
    if !state.host_navigation {
        if Action(45002, Label("entity.back", "Back"), Rectangle.{x, y, 76.0 * scale, 44.0 * scale}) { dew_page = false; dew_confirmation = -1 }
        y += 56.0 * scale
    }
    TextLine(45003, "Dew", x, y, width, 28)
    y += 48.0 * scale
    if !available { Paragraph(45004, Label("entity.dew_connect", "Sign in to use Dew"), x, y, width, 70.0); return }
    if busy { Paragraph(45005, Label("entity.working", "Working…"), x, y, width, 36.0); y += 42.0 * scale }
    account: DewAccount
    at := FieldAt(json, 0, "account")
    account_end := ValueEnd(json, at, 0)
    known := at >= 0 && account_end > at && DewParseAccount(json[at:account_end], TextUntilNul(owner[:]), *account)
    if known {
        amount := DewDecimal(account.balance, DewUnits, "Dew")
        TextLine(45006, amount, x, y, width, 24)
        y += 48.0 * scale
    }
    if !busy && Action(45007, Label("entity.refresh", "Refresh"), Rectangle.{x, y, width, 44.0 * scale}) { DewCommand("refresh", sequence) }
    y += 56.0 * scale
    funding_allowed := !MatchLiteral(json, FieldAt(json, 0, "funding_allowed"), "false")
    if funding_allowed {
        if !busy && Action(45008, Label("entity.dew_fund", "Add Dew with Monero"), Rectangle.{x, y, width, 44.0 * scale}) { DewCommand("address", sequence) }
        y += 56.0 * scale
    }
    funding: DewFunding
    at = FieldAt(json, 0, "funding")
    funding_end := ValueEnd(json, at, 0)
    if funding_allowed && at >= 0 && funding_end > at && DewParseFunding(json[at:funding_end], TextUntilNul(owner[:]), *funding) {
        minimum := DewDecimal(funding.minimum, 1000000000000, "XMR")
        explanation: Vec(u8)
        BuilderPrint(*explanation, "%: % · %: %", Label("entity.dew_minimum", "Minimum"), minimum,
            Label("entity.dew_confirmations", "Confirmations"), funding.confirmations)
        Paragraph(45014, BuilderFinish(explanation), x, y, width, 64.0)
        y += 72.0 * scale
        Paragraph(45009, TextUntilNul(funding.address[:]), x, y, width, 100.0)
        y += 108.0 * scale
        if Action(45010, Label("entity.copy_address", "Copy address"), Rectangle.{x, y, width, 44.0 * scale}) { unused ClipboardCopy(TextUntilNul(funding.address[:]), 0) }
        y += 56.0 * scale
    }
    // The Google Play edition sells Dew packs through Play, priced in the buyer's currency.
    play_at := FieldAt(json, 0, "play")
    play_end := ValueEnd(json, play_at, 0)
    if play_at >= 0 && play_end > play_at && json[play_at] == #char "{" {
        play := json[play_at:play_end]
        TextLine(45050, Label("entity.dew_buy", "Buy Dew"), x, y, width, 20)
        y += 40.0 * scale
        products := FieldAt(play, 0, "products")
        shown: s32 = 0
        savings_shown := false
        for index: cast(s32)0..4 {
            item := ElementAt(play, products, index)
            if item < 0 { break }
            item_end := ValueEnd(play, item, 0)
            if item_end <= item { break }
            product := play[item:item_end]
            id: [32]u8
            price: [64]u8
            if ReadStringText(product, FieldAt(product, 0, "id"), id[:]) <= 4 || ReadStringText(product, FieldAt(product, 0, "price"), price[:]) <= 0 { continue }
            title: Vec(u8)
            BuilderPrint(*title, "% Dew · %", TextUntilNul(id[:])[4:], TextUntilNul(price[:]))
            savings := DewPlaySavings(play, TextUntilNul(id[:]))
            if savings > 0 {
                BuilderPrint(*title, " · −%", savings)
                BuilderPrint(*title, "%%")
                savings_shown = true
            }
            label := BuilderFinish(title)
            if !busy && Action(45051 + index, label, Rectangle.{x, y, width, 44.0 * scale}) { DewCommand("play", sequence, TextUntilNul(id[:])) }
            y += 56.0 * scale
            shown += 1
        }
        if savings_shown {
            Paragraph(45057, Label("profile_dew_play_comparison", "Savings per Dew compared with the 10 Dew pack."), x, y, width, 48.0)
            y += 56.0 * scale
        }
        status: [16]u8
        unused ReadStringText(json, FieldAt(json, 0, "play_status"), status[:])
        play_error: [64]u8
        unused ReadStringText(play, FieldAt(play, 0, "error"), play_error[:])
        message := ""
        if TextUntilNul(status[:]) == "verifying" { message = Label("entity.dew_play_verifying", "Adding the Dew from your Google Play purchase…") }
        else if TextUntilNul(status[:]) == "credited" { message = Label("entity.dew_play_credited", "Your Dew has been added.") }
        else if TextUntilNul(status[:]) == "failed" { message = Label("entity.dew_play_failed", "Google Play took the payment, but the Dew could not be added yet. It tries again automatically.") }
        else if shown == 0 && TextUntilNul(play_error[:]) != "" && TextUntilNul(play_error[:]) != "cancelled" { message = Label("entity.dew_play_unavailable", "Google Play purchases are not available right now.") }
        else if shown == 0 { message = Label("entity.dew_play_loading", "Loading Google Play prices…") }
        if message != "" {
            Paragraph(45056, message, x, y, width, 64.0)
            y += 72.0 * scale
        }
    }
    if MatchLiteral(json, FieldAt(json, 0, "pending"), "true") {
        Paragraph(45011, Label("entity.dew_pending", "A purchase is awaiting confirmation. Retry checks the same purchase."), x, y, width, 60.0)
        y += 68.0 * scale
        if !busy && Action(45012, Label("entity.retry", "Retry"), Rectangle.{x, y, width, 44.0 * scale}) { DewCommand("retry", sequence) }
        y += 56.0 * scale
    } else if known && account.enabled && !busy {
        TextLine(45013, Label("entity.storage_plans", "Storage plans"), x, y, width, 20)
        y += 40.0 * scale
        for index: cast(s32)0..3 {
            slot := index / 2
            yearly := index % 2 == 1
            cost := ifx yearly then account.plans[slot].yearly_units else account.plans[slot].monthly_units
            if cost <= 0 || cost > account.balance { continue }
            amount := DewDecimal(cost, DewUnits, "Dew")
            title: Vec(u8)
            BuilderPrint(*title, "% GB · % · %", ifx slot == 0 then 1 else 5,
                ifx yearly then Label("entity.yearly", "Yearly") else Label("entity.monthly", "Monthly"), amount)
            label := BuilderFinish(title)
            if Action(45020 + index, label, Rectangle.{x, y, width, 44.0 * scale}) { dew_confirmation = index }
            y += 56.0 * scale
            if dew_confirmation == index {
                if Action(45030 + index, Label("entity.confirm_purchase", "Confirm purchase"), Rectangle.{x, y, width, 44.0 * scale}, true) {
                    DewCommand("buy", sequence, DewPlanSizes[slot], ifx yearly then "yearly" else "monthly")
                    dew_confirmation = -1
                }
                y += 56.0 * scale
            }
        }
    }
    if MatchLiteral(json, FieldAt(json, 0, "error"), "true") { Paragraph(45040, Label("entity.dew_error", "Could not confirm the node's response. Refresh or retry."), x, y, width, 64.0) }
}

OpenPicturePicker :: () {
    picture_tab = 1
    choosing_picture = true
    picture_scroll = 0
    fields = .{}
}

AbstractPicture :: (index: s32, bounds: Rectangle) -> ImageProps {
    names: [3]string = .["assets/entity/abstract-jade.png", "assets/entity/abstract-amber.png", "assets/entity/abstract-violet.png"]
    path := names[index]
    if asset_root[0] != 0 {
        out: Vec(u8)
        BuilderPrint(*out, "%/%", TextUntilNul(asset_root[:]), path)
        path = BuilderFinish(out)
    }
    return ImageProps.{.asset_path = path, .bounds = bounds, .fit = ImageFit.ImageFitContain,
        .alt_text = Label("entity.abstract", "Abstract"), .radius = bounds.width * 0.5}
}

ProfilePicture :: (id: s32, bounds: Rectangle) {
    if state.picture_kind == 2 { AvatarDraw(session, bounds, AvatarDefaultCamera()) }
    else if state.picture_kind == 1 { Image(session, AbstractPicture(state.abstract_picture, bounds)) }
    else { Image(session, Picture(state.picture, bounds)) }
    if Button(session, ButtonProps.{.key = cast(u64)id, .id = id, .bounds = bounds,
            .label = Label("entity.change_picture", "Change picture"), .invisible = true}) != 0 {
        OpenPicturePicker()
    }
}

SelectPicture :: (kind: s32, picture: s32) {
    previous := state
    state.picture_kind = kind
    if kind == 0 { state.picture = picture }
    if kind == 1 { state.abstract_picture = picture }
    if Save() { choosing_picture = false }
    else { state = previous }
}

PictureModal :: () {
    if !choosing_picture { return }
    area := AppBounds()
    width := area.width - 24.0 * scale
    if width > 620.0 * scale { width = 620.0 * scale }
    height := area.height - 24.0 * scale
    if height > 650.0 * scale { height = 650.0 * scale }
    modal := ModalFrame(session, ModalFrameProps.{.key = cast(u64)76000, .id = 76000,
            .title = Label("entity.picture", "Profile picture"),
            .bounds = Rectangle.{area.x + (area.width - width) * 0.5, area.y + (area.height - height) * 0.5, width, height},
            .scale = scale, .has_right_action = true, .right_label = Label("entity.done", "Done")})
    if modal.dismissed || modal.right_clicked { choosing_picture = false }
    if !modal.opened { return }
    content := modal.layout.content
    labels: [3]string = .[Label("entity.abstract", "Abstract"), Label("entity.classic", "Classic"), Label("entity.avatar", "Avatar")]
    if picture_tab == 2 {
        view := content
        view.height -= 112.0 * scale
        if view.height > 0.0 {
            AvatarInteract(view)
            AvatarDraw(session, view, avatar_camera)
            AvatarControls(session, Rectangle.{content.x, view.y + view.height, content.width, 44.0 * scale}, Label("entity.reset_view", "Reset view"))
        }
        if Action(76200, Label("entity.use_avatar", "Use avatar"), Rectangle.{content.x, content.y + content.height - 52.0 * scale, content.width, 44.0 * scale}) {
            SelectPicture(2, 0)
        }
    } else {
        columns := cast(s32)((content.width + 12.0 * scale) / (76.0 * scale))
        if columns < 3 { columns = 3 }
        if columns > 7 { columns = 7 }
        count: s32 = ifx picture_tab == 0 then 3 else 28
        scroll := Scroll(session, ScrollProps.{.key = cast(u64)76300, .bounds = content,
                .content_height = ((count + columns - 1) / columns) * cast(s32)(84.0 * scale), .scroll_offset = picture_scroll, .scale = scale})
        picture_scroll = scroll.scroll_offset
        if scroll.opened {
            size := 64.0 * scale
            gap := (content.width - cast(float32)columns * size) / cast(float32)(columns - 1)
            position: s32 = 0
            for index: cast(s32)0..count - 1 {
                if picture_tab == 1 && (state.pictures & (1 << index)) == 0 { continue }
                image := ifx picture_tab == 0 then AbstractPicture(index, Rectangle.{}) else Picture(index, Rectangle.{})
                if Button(session, ButtonProps.{.key = cast(u64)(76400 + index), .id = 76400 + index,
                        .label = labels[picture_tab], .icon_only = true, .image = image,
                        .selected = ifx picture_tab == 0 then state.picture_kind == 1 && state.abstract_picture == index else state.picture_kind == 0 && state.picture == index,
                        .bounds = Rectangle.{content.x + cast(float32)(position % columns) * (size + gap),
                            scroll.content.y + cast(float32)(position / columns) * 84.0 * scale, size, size}}) != 0 {
                    SelectPicture(ifx picture_tab == 0 then 1 else 0, index)
                }
                position += 1
            }
            unused End(session)
        }
    }
    unused End(session)
    AppKeyboard(false)
}

ExtensionButton :: (id: s32, route: string, label: string, left: float32, top: *float32, width: float32) {
    color := ThemeOr("text", 0xe5eef3ff, 0x203b4bff)
    SvgIcon(session, SvgIconProps.{.shape = ExtensionShape(route), .color = color,
            .bounds = Rectangle.{left + 4.0 * scale, top.* + 16.0 * scale, 24.0 * scale, 24.0 * scale}})
    TextLine(cast(u64)(id + 1000), label, left + 44.0 * scale, top.* + 16.0 * scale, width - 76.0 * scale, 16)
    SvgIcon(session, SvgIconProps.{.shape = "S1.7rr:M9 5L16 12L9 19", .color = color,
            .bounds = Rectangle.{left + width - 24.0 * scale, top.* + 18.0 * scale, 20.0 * scale, 20.0 * scale}})
    if Button(session, ButtonProps.{.key = cast(u64)id, .id = id,
            .bounds = Rectangle.{left, top.*, width, 60.0 * scale}, .label = label, .invisible = true}) != 0 && Save() {
        if route == "friends" { OpenManagement(PAGE_FRIENDS) }
        else { unused ProfileLeaderboardCommand(route) }
    }
    top.* += 60.0 * scale
}

AppearanceControls :: (x: float32, top: *float32, width: float32, controls: s32) {
    y := top.*
    if (controls & ENTITY_APPEARANCE) != 0 {
        TextLine(30, Label("entity.appearance", "Appearance"), x, y, width, 20)
        y += 36.0 * scale
        modes: [3]string = .[Label("entity.system", "System"), Label("entity.light", "Light"), Label("entity.dark", "Dark")]
        third := (width - 16.0 * scale) / 3.0
        for index: 0..2 {
            if Action(50 + cast(s32)index, modes[index], Rectangle.{x + cast(float32)index * (third + 8.0 * scale), y, third, 40.0 * scale}, state.theme == index) {
                state.theme = cast(s32)index
                Save()
            }
        }
        y += 64.0 * scale
    }
    if (controls & ENTITY_ACCENT) != 0 {
        TextLine(31, Label("entity.accent", "Accent"), x, y, width, 20)
        y += 36.0 * scale
        colors: [16]u32 = .[0x7355d9ff, 0x2563ebff, 0x059669ff, 0xdb2777ff, 0xd97706ff, 0x0891b2ff, 0xdc2626ff, 0x7c3aedff,
        0x4f46e5ff, 0x0d9488ff, 0x65a30dff, 0xc026d3ff, 0xea580cff, 0x0284c7ff, 0x9333eaff, 0x475569ff]
        size := (width - 7.0 * 8.0 * scale) / 8.0
        for index: 0..15 {
            if Button(session, ButtonProps.{.key = cast(u64)(300 + index), .id = 300 + cast(s32)index,
                    .bounds = Rectangle.{x + cast(float32)(index % 8) * (size + 8.0 * scale), y + cast(float32)(index / 8) * (size + 8.0 * scale), size, size},
                    .label = Label("entity.accent", "Accent"), .icon_only = true, .swatch = true, .swatch_color = ColorFromPacked(colors[index]), .selected = state.accent == index}) != 0 {
                state.accent = cast(s32)index
                Save()
            }
        }
        y += 2.0 * (size + 8.0 * scale) + 16.0 * scale
    }
    if (controls & ENTITY_WIDGETS) != 0 {
        TextLine(32, Label("entity.widgets", "Widgets"), x, y, width, 20)
        y += 36.0 * scale
        half := (width - 8.0 * scale) * 0.5
        if Action(60, "Material", Rectangle.{x, y, half, 40.0 * scale}, state.material) { state.material = true; Save() }
        if Action(61, "Classic", Rectangle.{x + half + 8.0 * scale, y, half, 40.0 * scale}, !state.material) { state.material = false; Save() }
        y += 64.0 * scale
    }
    top.* = y
}
