// The entity.dew service an app calls through its host: the account's Dew
// to show, and rewards to claim, such as a game's secret chest. The node
// grants every reward and gives each to an account once (daochi_client's
// rewards); an app only names it. Without a connected account the balance is
// shown as 0 and a claim answers "signin", so the app can ask the player to
// connect one and claim again.
//
//     balance            {"connected":true,"units":1200000} (units -1 until known)
//     refresh            asks the node for the balance again: {"status":"queued"}
//     claim:REWARD       {"status":"pending"}, "signin" or "busy"
//     claim-status       {"status":"pending"} or, once answered,
//                        {"status":"done","reward":"…","credited":true,"units":…,"balance":…}
//                        or {"status":"failed","reward":"…"}
//                        or {"status":"ineligible","reward":"…"} when the
//                        node still requires qualifying completion histories.
#import "account_store"
#import "dew_model"
#import "dew_native"
#import "model"
#import "recovery"
#import "std/net_http"
#import "std/c_string"
#import "std/text_buffer"
#import "std/vec"
#import "std/date_time_linux"
#import "daochi_client/async_client"
#import "daochi_client/client"
#import "daochi_client/rewards"
#import "daochi_client/crypto"
#import "daochi_client/keys"
#import "reward_migration"
#import "game_shop_native"
Auth :: #import "daochi_client/auth";
#import "kryon/http_transfer"

ENTITY_DEW_SERVICE :: "entity.dew"

dew_reward: PendingReward;
dew_reward_session: Auth.Session;
dew_reward_transfer: HttpTransfer;
dew_reward_active: bool;
dew_reward_name: [80]u8;
dew_reward_owner: [65]u8;
// A rejected old save gets one migration attempt and one normal claim retry.
dew_reward_migration_tried: bool;
dew_reward_migration_stage: s32;
dew_reward_migration_body: [256]u8;
dew_reward_migration_response: [REWARD_MIGRATION_RESPONSE_MAX]u8;
dew_reward_migration_scratch: RewardMigrationScratch;
// The last claim's answer for the app, kept until the next claim.
dew_reward_answer: [320]u8;
dew_answer: [320]u8;

DewRewardStart :: (context: *void, request: HttpRequest, output: []u8) -> bool {
    return HttpTransferStart(*dew_reward_transfer, request, output, 15000)
}
DewRewardPoll :: (context: *void, status: *s32) -> s32 { return HttpTransferPoll(*dew_reward_transfer, status) }
DewRewardCancel :: (context: *void) { HttpTransferCancel(*dew_reward_transfer) }

#scope_export
EntityDewAnswer :: (request: string) -> string {
    // Existing hosts already forward entity.dew. Keep the shop available to
    // those hosts without exposing another credential or transport surface.
    if request.count > 5 && request[:5] == "shop:" { return EntityGameShopAnswer(request[5:]) }
    out: Vec(u8)
    if request == "balance" {
        if !DewReady() {
            BuilderPrint(*out, "{\"connected\":false,\"units\":0}")
        } else {
            account: DewAccount
            known := DewParseAccount(TextUntilNul(dew_plan[:]), TextUntilNul(dew_owner[:]), *account)
            // The balance comes with the storage plan; ask for it once.
            if !known && !dew_active && dew_queued[0] == cast(u8)0 { dew_queued = DewOperation("refresh") }
            BuilderPrint(*out, "{\"connected\":true,\"units\":%}", ifx known then account.balance else cast(s64)-1)
        }
        return DewAnswerText(out)
    }
    // Apps ask again when their balance comes into view, so Dew spent or
    // earned elsewhere shows without reopening Profile.
    if request == "refresh" {
        if DewReady() && !dew_active && dew_queued[0] == cast(u8)0 { dew_queued = DewOperation("refresh") }
        BuilderPrint(*out, "{\"status\":\"queued\"}")
        return DewAnswerText(out)
    }
    if request.count > 6 && request[:6] == "claim:" {
        reward := request[6:]
        if !DewReady() {
            BuilderPrint(*out, "{\"status\":\"signin\"}")
        } else if dew_reward_active {
            BuilderPrint(*out, "{\"status\":\"busy\"}")
        } else if !RewardNameValid(reward) || !CopyCString(reward, dew_reward_name[:]) {
            BuilderPrint(*out, "{\"status\":\"failed\"}")
        } else {
            client: Client
            transport := AsyncTransport.{.start = DewRewardStart, .poll = DewRewardPoll, .cancel = DewRewardCancel}
            if TextUntilNul(dew_reward_owner[:]) != TextUntilNul(account_recovery.keys.public_id[:]) {
                dew_reward_session = Auth.Session.{}
                dew_reward_owner = account_recovery.keys.public_id
            }
            dew_reward_answer = .{}
            dew_reward_migration_tried = false
            dew_reward_migration_stage = 0
            dew_reward_active = AccountStoreClient(null, *client) &&
            BeginRewardClaim(*dew_reward, client, *dew_reward_session, UnixNow(), transport, reward)
            if dew_reward_active { BuilderPrint(*out, "{\"status\":\"pending\"}") }
            else { BuilderPrint(*out, "{\"status\":\"failed\"}") }
        }
        return DewAnswerText(out)
    }
    if request == "claim-status" {
        if dew_reward_active || dew_reward_answer[0] == cast(u8)0 { BuilderPrint(*out, "{\"status\":\"pending\"}") }
        else { BuilderPrint(*out, "%", TextUntilNul(dew_reward_answer[:])) }
        return DewAnswerText(out)
    }
    BuilderPrint(*out, "{\"status\":\"unknown\"}")
    return DewAnswerText(out)
}

// The account's Dew as an app shows it beside its Profile: the number alone,
// 0 without a connected account or until the node has answered.
EntityDewBalanceText :: (output: []u8) -> string {
    units: s64 = 0
    if DewReady() {
        account: DewAccount
        if DewParseAccount(TextUntilNul(dew_plan[:]), TextUntilNul(dew_owner[:]), *account) {
            units = account.balance
        } else if !dew_active && dew_queued[0] == cast(u8)0 {
            dew_queued = DewOperation("refresh")
        }
    }
    if !DewFormat(units, DewUnits, output) { return "0" }
    return TextUntilNul(output)
}

// Advances a claim each frame; a credited reward refreshes the balance.
EntityDewPump :: () {
    EntityGameShopPump()
    if !dew_reward_active { return }
    if !DewReady() || TextUntilNul(dew_reward_owner[:]) != TextUntilNul(account_recovery.keys.public_id[:]) {
        CancelRequest(*dew_reward.request)
        HttpTransferCancel(*dew_reward_transfer)
        SecureWipe(*dew_reward_migration_body[0], dew_reward_migration_body.count)
        dew_reward_session = Auth.Session.{}
        dew_reward_migration_stage = 0
        dew_reward_active = false
        dew_reward_answer = .{}
        return
    }
    if dew_reward_migration_stage != 0 {
        if !PollRequest(*dew_reward.request) { return }
        if DewRewardMigrationAdvance() { return }
        // A missing or refused snapshot leaves the original eligibility result.
        dew_reward.request.stage = 3
        if dew_reward.request.status == 200 || dew_reward.request.status == 404 {
            dew_reward.request.status = 403
        }
    }
    claim: RewardClaim
    if !PollRewardClaim(*dew_reward, *claim) { return }
    if claim.units == 0 && dew_reward.request.stage == 3 && dew_reward.request.status == 403 &&
    !dew_reward_migration_tried && DewRewardMigrationBegin() { return }
    dew_reward_active = false
    out: Vec(u8)
    if claim.units > 0 {
        BuilderPrint(*out, "{\"status\":\"done\",\"reward\":")
        EntityQuote(*out, TextUntilNul(dew_reward_name[:]))
        BuilderPrint(*out, ",\"credited\":%,\"units\":%,\"balance\":%}", claim.credited, claim.units, claim.balance)
        if !dew_active && dew_queued[0] == cast(u8)0 { dew_queued = DewOperation("refresh") }
    } else {
        BuilderPrint(*out, "{\"status\":\"%\",\"reward\":",
            ifx dew_reward.request.stage == 3 && dew_reward.request.status == 403 then "ineligible" else "failed")
        EntityQuote(*out, TextUntilNul(dew_reward_name[:]))
        BuilderPrint(*out, "}")
    }
    text := BuilderFinish(out)
    unused CopyCString(text, dew_reward_answer[:])
    EntityFree(text)
}

#scope_file
DewRewardTransport :: () -> AsyncTransport {
    return AsyncTransport.{.start = DewRewardStart, .poll = DewRewardPoll, .cancel = DewRewardCancel}
}

DewRewardMigrationRequest :: (method: string, body: string) -> bool {
    client: Client
    headers: [0]HttpHeader
    return AccountStoreClient(null, *client) && BeginRequest(*dew_reward.request, client,
        *dew_reward_session, UnixNow(), DewRewardTransport(), method, REWARD_MIGRATION_PATH,
        body, dew_reward_migration_response[:], headers[:])
}

DewRewardMigrationBegin :: () -> bool {
    dew_reward_migration_tried = true
    reward := TextUntilNul(dew_reward_name[:])
    if reward != "shovey.secret-chest" && reward != "shovey.campaign-complete" { return false }
    if !DewRewardMigrationRequest("GET", "") { return false }
    dew_reward_migration_stage = 1
    return true
}

DewRewardMigrationAdvance :: () -> bool {
    stage := dew_reward_migration_stage
    dew_reward_migration_stage = 0
    SecureWipe(*dew_reward_migration_body[0], dew_reward_migration_body.count)
    if dew_reward.request.result != cast(Auth.AuthResult)Auth.AuthResult.AUTH_OK ||
    dew_reward.request.status != 200 { return false }
    prepared := false
    done := false
    {
        response := TextUntilNul(dew_reward_migration_response[:])
        status := RewardMigrationStatus(response)
        done = status == "done"
        if stage == 1 && status == "available" {
            private_key: [AccountPrivateKeyBytes]u8
            defer { SecureWipe(*private_key[0], private_key.count) }
            prepared = HexToBytes(TextUntilNul(account_recovery.keys.private_key_hex[:]),
                *private_key[0], private_key.count) == 1 &&
                RewardMigrationProof(private_key[:], TextUntilNul(dew_reward_owner[:]), response,
                    *dew_reward_migration_scratch, dew_reward_migration_body[:])
        }
    }
    if prepared {
        if !DewRewardMigrationRequest("POST", TextUntilNul(dew_reward_migration_body[:])) {
            SecureWipe(*dew_reward_migration_body[0], dew_reward_migration_body.count)
            return false
        }
        dew_reward_migration_stage = 2
        return true
    }
    if !done { return false }
    client: Client
    return AccountStoreClient(null, *client) && BeginRewardClaim(*dew_reward, client,
        *dew_reward_session, UnixNow(), DewRewardTransport(), TextUntilNul(dew_reward_name[:]))
}

DewOperation :: (name: string) -> [24]u8 {
    operation: [24]u8
    unused CopyCString(name, operation[:])
    return operation
}

DewAnswerText :: (out: Vec(u8)) -> string {
    text := BuilderFinish(out)
    unused CopyCString(text, dew_answer[:])
    EntityFree(text)
    return TextUntilNul(dew_answer[:])
}
