// One account workflow for native Entity providers. The UI sends bounded
// intentions; this module owns staged recovery, file access and completion.
#import "management"
#import "alias_model"
#import "dew_model"
#import "model"
#import "recovery"
#import "account_backup"
#import "shared_account"
#import "account_handoff"
#import "native_files"
#import "drive_backup"
#import "passkey"
#import "sign_in_bridge"
#import "std/c_string"
#import "std/text_buffer"
#import "std/date_time_linux"
#import "std/net_http"
#import "daochi_client/keys"
#import "daochi_client/crypto"
#import "daochi_client/client"
Auth :: #import "daochi_client/auth";
#import "daochi_client/async_client"
#import "daochi_client/async_account"
#import "daochi_client/social"
#import "kryon/http_transfer"
Json :: #import "std/json_scan";

ProviderSnapshot :: #type (context: *void, output: *Management) -> void;
ProviderLoad :: #type (context: *void, output: *Recovery) -> bool;
// 0 failed, 1 applied, 2 requires the person's merge/replace decision.
ProviderApply :: #type (context: *void, value: *Recovery, choice: s32) -> s32;
ProviderAction :: #type (context: *void, request: *ManagementRequest) -> s32;
ProviderClient :: #type (context: *void, output: *Client) -> bool;
// 1 selected, 0 cancelled, -1 unavailable/error, 2 awaiting a platform picker.
// A host resumes a pending picker by clearing delegated before its next pump.
ProviderFile :: #type (context: *void, save: bool, output: []u8) -> s32;
ProviderDeliver :: #type (context: *void, path: string) -> bool;
// Copies the system clipboard's text into output; false when it has none.
ProviderPaste :: #type (context: *void, output: []u8) -> bool;

ManagementProvider :: struct {
    context: *void
    snapshot: ProviderSnapshot
    load: ProviderLoad
    apply: ProviderApply
    action: ProviderAction
    client: ProviderClient
    choose_file: ProviderFile
    deliver_file: ProviderDeliver
    paste: ProviderPaste
    queue: ManagementQueue
    incoming: Recovery
    has_incoming: bool
    incoming_owner: [65]u8
    document: string
    transfer: HttpTransfer
    pending_request: PendingRequest
    pending_deletion: PendingDeletion
    session: Auth.Session
    response: [4096]u8
    request_body: [512]u8
    request_node: [512]u8
    network_operation: s32
    drive_pending: bool
    handoff_pending: bool
    asynchronous: bool
    delegated: bool
    alias_offer: AliasOffer
    alias_owner: [65]u8
    alias_node: [512]u8
    alias_retry: bool
    alias_purchase: AliasPurchase
    // Still sealed; kept so a mistyped password does not mean choosing the file again.
    held_backup: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    // Signing in online: the password waits for the node's salt, then is wiped.
    online_password: [512]u8
    online_account: [ACCOUNT_BACKUP_REFERENCE_MAX]u8
    online_keys: RecoveryKeys
    online_url: [640]u8
    online_body: [ACCOUNT_BACKUP_BODY_MAX]u8
    online_reply: [ACCOUNT_BACKUP_BODY_MAX]u8
    // The account shared with the other waozi apps on this device.
    shared_name: [SHARED_ACCOUNT_NAME_MAX]u8
    // share.js keeps this host's account files in step with the shared web
    // sign-in, so the provider leaves that to it.
    shared_web_files: bool
    shared_web_tried: [65]u8
    shared_owner: [65]u8
    shared_alias: [40]u8
    shared_next: s64
    backed_up: bool
    backed_up_owner: [65]u8
    // Passkey and Google sign-in. Nothing here is kept after the request ends.
    bridge_known: bool
    bridge_passkey: bool
    bridge_google: bool
    bridge_operation: s32
    sign_in_message: [160]u8
    passkey_keys: RecoveryKeys
    passkey_credential: [65]u8
    passkey_account: [65]u8
    passkey_count: s32
    passkeys: [MANAGEMENT_PASSKEY_LIMIT]ManagementPasskey
    google_client: [256]u8
    google_linked: bool
    found_account: [65]u8
    methods_transfer: HttpTransfer
    methods_asked: bool
    methods_next: s64
    methods_url: [640]u8
    methods_reply: [512]u8
}

// The name to offer when saving this account's backup.
ProviderBackupFileName :: (provider: *ManagementProvider, output: []u8) -> string {
    state := ProviderState(provider)
    return RecoveryFileName(TextUntilNul(state.alias[:]), TextUntilNul(state.public_id[:]), output)
}

ProviderForgetBackup :: (provider: *ManagementProvider) {
    SecureWipe(*provider.held_backup[0], provider.held_backup.count)
}

ProviderState :: (provider: *ManagementProvider) -> Management {
    state: Management
    if provider.snapshot != null { provider.snapshot(provider.context, *state) }
    if DriveBackupAvailable() { state.capabilities |= ACCOUNT_DRIVE }
    ProviderBridgeState(provider, *state)
    state.alias_pricing = true
    state.busy = state.busy || provider.asynchronous || provider.drive_pending || provider.handoff_pending || provider.bridge_operation != 0
    if provider.has_incoming { state.candidate_id = provider.incoming.keys.public_id }
    state.password_needed = provider.held_backup[0] != cast(u8)0
    state.backed_up = state.account && provider.backed_up && TextUntilNul(state.public_id[:]) == TextUntilNul(provider.backed_up_owner[:])
    if provider.shared_name[0] != cast(u8)0 {
        state.shared_name = provider.shared_name
        state.capabilities |= ACCOUNT_CONTINUE
    }
    client: Client
    if provider.client != null && provider.client(provider.context, *client) &&
    TextUntilNul(state.public_id[:]) == TextUntilNul(provider.alias_owner[:]) &&
    client.server_url == TextUntilNul(provider.alias_node[:]) {
        state.alias_offer = provider.alias_offer
        state.alias_retry = provider.alias_retry
    }
    ManagementApplyQueue(*state, *provider.queue)
    return state
}

ProviderRefresh :: (provider: *ManagementProvider) {
    EntityFree(provider.document)
    provider.document = ManagementEncode(ProviderState(provider))
}

ProviderOwnerMatches :: (provider: *ManagementProvider, request: *ManagementRequest) -> bool {
    state := ProviderState(provider)
    return TextUntilNul(state.public_id[:]) == TextUntilNul(request.owner_id[:])
}

ProviderEnqueue :: (provider: *ManagementProvider, text: string) -> bool {
    request: ManagementRequest
    if !ManagementRequestDecode(text, *request) || !ProviderOwnerMatches(provider, *request) { return false }
    state := ProviderState(provider)
    if TextUntilNul(request.operation[:]) == "logout" { ProviderSignOutFirst(provider) }
    return ManagementEnqueue(*provider.queue, text, state.capabilities)
}

ProviderFinish :: (provider: *ManagementProvider, result: string, message: string) {
    provider.delegated = false
    ManagementFinish(*provider.queue, result, message)
}

ProviderApplyIncoming :: (provider: *ManagementProvider, choice: s32) {
    if !provider.has_incoming || provider.apply == null { ProviderFinish(provider, "error", "No account is ready to import"); return }
    state := ProviderState(provider)
    if TextUntilNul(provider.incoming_owner[:]) != TextUntilNul(state.public_id[:]) {
        RecoveryClear(*provider.incoming)
        provider.has_incoming = false
        ProviderFinish(provider, "error", "The account changed; sign in again")
        return
    }
    result := provider.apply(provider.context, *provider.incoming, choice)
    if result == 2 { ProviderFinish(provider, "switch", "Choose what to do with the local records"); return }
    if result != 1 { ProviderFinish(provider, "error", "Could not save the account"); return }
    // A sign-in here signs in the other waozi.xyz sites too.
    ProviderSharedWebOffer(provider, *provider.incoming, false)
    provider.shared_name = .{}
    RecoveryClear(*provider.incoming)
    provider.has_incoming = false
    ProviderFinish(provider, "ok", ifx TextUntilNul(provider.queue.request.operation[:]) == "create" then "Account created" else "Signed in")
}

ProviderSelectFile :: (provider: *ManagementProvider, save: bool, output: []u8) -> s32 {
    if provider.choose_file != null { return provider.choose_file(provider.context, save, output) }
    return -1
}

ProviderImport :: (provider: *ManagementProvider, passphrase: string) {
    path: [4096]u8
    chosen := ProviderSelectFile(provider, false, path[:])
    if chosen == 2 { provider.delegated = true; return }
    if chosen == 0 { ProviderFinish(provider, "cancelled", "Sign-in cancelled"); return }
    if chosen < 0 { ProviderFinish(provider, "error", "Could not open the file chooser"); return }
    text: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    defer { SecureWipe(*text[0], text.count) }
    if NativeRead(TextUntilNul(path[:]), text[:]) <= 0 { ProviderFinish(provider, "error", "Could not read the backup file"); return }
    ProviderImportText(provider, TextUntilNul(text[:]), passphrase)
}

// A key someone copied: the host reads the clipboard, so the key never
// passes through the profile bundle.
ProviderImportPaste :: (provider: *ManagementProvider, passphrase: string) {
    text: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    defer { SecureWipe(*text[0], text.count) }
    if provider.paste == null || !provider.paste(provider.context, text[:]) || ProviderTrim(TextUntilNul(text[:])) == "" {
        ProviderFinish(provider, "error", "Copy your backup, then paste it here")
        return
    }
    ProviderImportText(provider, ProviderTrim(TextUntilNul(text[:])), passphrase)
}

ProviderTrim :: (text: string) -> string {
    start: s64 = 0
    end := text.count
    while start < end && text[start] <= cast(u8)32 { start += 1 }
    while end > start && text[end - 1] <= cast(u8)32 { end -= 1 }
    return text[start:end]
}

ProviderImportText :: (provider: *ManagementProvider, text: string, passphrase: string) {
    protected := RecoveryNeedsPassword(text)
    if protected && passphrase == "" {
        if !CopyCString(text, provider.held_backup[:]) { ProviderFinish(provider, "error", "That is not an account backup"); return }
        ProviderFinish(provider, "password", "")
        return
    }
    incoming: Recovery
    defer { RecoveryClear(*incoming) }
    if !RecoveryDecode(text, passphrase, *incoming) {
        // Authentication cannot tell a wrong password from a damaged file.
        if protected && CopyCString(text, provider.held_backup[:]) {
            ProviderFinish(provider, "password", "Wrong password, or the backup file is damaged")
            return
        }
        ProviderFinish(provider, "error", "That is not an account backup")
        return
    }
    ProviderForgetBackup(provider)
    RecoveryClear(*provider.incoming)
    provider.incoming = incoming
    provider.has_incoming = true
    state := ProviderState(provider)
    provider.incoming_owner = state.public_id
    ProviderApplyIncoming(provider, 0)
}

// The password for a backup given earlier; the file is not chosen again.
ProviderImportHeld :: (provider: *ManagementProvider, passphrase: string) {
    text: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    defer { SecureWipe(*text[0], text.count) }
    text = provider.held_backup
    if text[0] == cast(u8)0 { ProviderFinish(provider, "error", "Choose your backup first"); return }
    ProviderImportText(provider, TextUntilNul(text[:]), passphrase)
}

ProviderBackup :: (provider: *ManagementProvider, passphrase: string) {
    if !ManagementPasswordAccepted(passphrase) {
        ProviderFinish(provider, "error", "Use a password of at least 12 characters")
        return
    }
    recovery: Recovery
    defer { RecoveryClear(*recovery) }
    if provider.load == null || !provider.load(provider.context, *recovery) {
        ProviderFinish(provider, "error", "No account is signed in on this device")
        return
    }
    path: [4096]u8
    chosen := ProviderSelectFile(provider, true, path[:])
    if chosen == 2 { provider.delegated = true; return }
    if chosen == 0 { ProviderFinish(provider, "cancelled", "Backup cancelled"); return }
    if chosen < 0 { ProviderFinish(provider, "error", "Could not open the file chooser"); return }
    text: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    defer { SecureWipe(*text[0], text.count) }
    if !RecoveryEncode(*recovery, passphrase, text[:]) || !NativeWrite(TextUntilNul(path[:]), TextUntilNul(text[:])) {
        ProviderFinish(provider, "error", "Could not save the backup")
        return
    }
    if provider.deliver_file != null && !provider.deliver_file(provider.context, TextUntilNul(path[:])) {
        ProviderFinish(provider, "error", "Could not save the backup")
        return
    }
    ProviderBackedUpSet(provider, true)
    ProviderFinish(provider, "ok", "Backup saved. Keep the file and your password safe.")
}

// Drive is optional: local file saves never call this path.
ProviderDriveStart :: (provider: *ManagementProvider, saving: bool) {
    if !DriveBackupAvailable() { ProviderFinish(provider, "error", "Google Drive"); return }
    if !saving {
        provider.drive_pending = DriveImportStart()
    } else {
        recovery: Recovery
        defer { RecoveryClear(*recovery) }
        password: [1024]u8
        password = provider.queue.request.value
        defer { SecureWipe(*password[0], password.count) }
        passphrase := TextUntilNul(password[:])
        if !ManagementPasswordAccepted(passphrase) {
            ProviderFinish(provider, "error", "Use a password of at least 12 characters")
            return
        }
        if provider.load == null || !provider.load(provider.context, *recovery) {
            ProviderFinish(provider, "error", "No account is signed in on this device")
            return
        }
        provider.drive_pending = DriveBackupStart(*recovery, passphrase)
    }
    // Only the sealed file is retained while Android handles authorization.
    SecureWipe(*provider.queue.request.value[0], provider.queue.request.value.count)
    if !provider.drive_pending { ProviderFinish(provider, "error", "Google Drive") }
}

ProviderDrivePoll :: (provider: *ManagementProvider) {
    status: [32]u8
    content: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    defer { SecureWipe(*content[0], content.count) }
    if !DriveBackupPoll(status[:], content[:]) { return }
    provider.drive_pending = false
    result := TextUntilNul(status[:])
    if result == "restored" {
        // Existing password, validation and account-switch flow; no Drive login proof.
        ProviderImportText(provider, TextUntilNul(content[:]), "")
    } else if result == "saved" {
        ProviderBackedUpSet(provider, true)
        ProviderFinish(provider, "ok", "Google Drive")
    } else if result == "cancelled" {
        ProviderFinish(provider, "cancelled", "")
    } else {
        // Android has already shown a localized, specific failure explanation.
        ProviderFinish(provider, "error", "Google Drive")
    }
}

// Keeps the shared account current: an account signed in here is offered to the
// other apps, and a device with none signed in here sees what they offer.
ProviderSharedPump :: (provider: *ManagementProvider) {
    now := UnixNow()
    if now < provider.shared_next { return }
    provider.shared_next = now + 2
    #if #defined(PLATFORM_WEB) {
        ProviderSharedWebPump(provider)
        return
    }
    #if #defined(ANDROID_BUILD) {
        ProviderSharedAndroidPump(provider)
        return
    }
    root_buffer: [4096]u8
    root := SharedAccountRoot(root_buffer[:])
    if root == "" { return }
    state := ProviderState(provider)
    if !state.account {
        provider.shared_owner = .{}
        unused SharedAccountName(root, provider.shared_name[:])
        return
    }
    provider.shared_name = .{}
    if TextUntilNul(state.public_id[:]) == TextUntilNul(provider.shared_owner[:]) &&
    TextUntilNul(state.alias[:]) == TextUntilNul(provider.shared_alias[:]) { return }
    provider.shared_owner = state.public_id
    provider.shared_alias = state.alias
    recovery: Recovery
    defer { RecoveryClear(*recovery) }
    if provider.load != null && provider.load(provider.context, *recovery) {
        unused SharedAccountOffer(root, *recovery, TextUntilNul(state.alias[:]))
    }
}

// The name to offer for the shared web account: the name in its public
// profile, or its short ID.
ProviderSharedWebName :: (provider: *ManagementProvider, owner: string) {
    document: [65536]u8
    state: EntityState
    text := SharedWebText("sharedProfileDocument", document[:])
    if text != "" && EntityDecode(text, *state) && TextUntilNul(state.owner_id[:]) == owner && state.name[0] != cast(u8)0 {
        provider.shared_name = .{}
        unused CopyCString(TextUntilNul(state.name[:]), provider.shared_name[:])
        return
    }
    provider.shared_name = .{}
    unused CopyCString(owner, provider.shared_name[:])
}

// Passes this host's own sign-in on to the other waozi.xyz sites.
ProviderSharedWebOffer :: (provider: *ManagementProvider, recovery: *Recovery, only_if_empty: bool) {
    #if #defined(PLATFORM_WEB) {
        if provider.shared_web_files { return }
        text: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
        defer { SecureWipe(*text[0], text.count) }
        if RecoveryEncode(recovery, "", text[:]) {
            SharedWebShare(TextUntilNul(text[:]), TextUntilNul(recovery.keys.public_id[:]), only_if_empty)
        }
    }
}

// Hosts with their own key store, such as Breeze and Werk, follow the shared
// web sign-in here. Until the hub answers, each keeps working on its own.
ProviderSharedWebPump :: (provider: *ManagementProvider) {
    if provider.shared_web_files || !SharedWebFlag("sharedAccountReady") || provider.queue.pending { return }
    key_buffer: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    defer { SecureWipe(*key_buffer[0], key_buffer.count) }
    owner_buffer: [65]u8
    gone_buffer: [65]u8
    key := SharedWebText("sharedAccountKey", key_buffer[:])
    owner := SharedWebText("sharedAccountOwner", owner_buffer[:])
    state := ProviderState(provider)
    local := ifx state.account then TextUntilNul(state.public_id[:]) else ""
    decision := SharedWebDecide(local, key, owner, SharedWebFlag("sharedAccountInitialized"),
        SharedWebText("sharedAccountSignedOut", gone_buffer[:]))
    if decision != SHARED_WEB_OFFER && decision != SHARED_WEB_ADOPT { provider.shared_name = .{} }
    if decision == SHARED_WEB_SEED {
        if TextUntilNul(provider.shared_web_tried[:]) == local { return }
        provider.shared_web_tried = state.public_id
        recovery: Recovery
        defer { RecoveryClear(*recovery) }
        if provider.load != null && provider.load(provider.context, *recovery) { ProviderSharedWebOffer(provider, *recovery, true) }
    } else if decision == SHARED_WEB_OFFER {
        ProviderSharedWebName(provider, owner)
    } else if decision == SHARED_WEB_ADOPT {
        if TextUntilNul(provider.shared_web_tried[:]) == owner { return }
        unused CopyCString(owner, provider.shared_web_tried[:])
        incoming: Recovery
        defer { RecoveryClear(*incoming) }
        if provider.apply == null || !RecoveryDecode(key, "", *incoming) ||
        TextUntilNul(incoming.keys.public_id[:]) != owner { return }
        // Local records from another owner are the owner's choice to make.
        if provider.apply(provider.context, *incoming, 0) != 1 { ProviderSharedWebName(provider, owner) }
    } else if decision == SHARED_WEB_SIGN_OUT {
        request: ManagementRequest
        unused CopyCString("logout", request.operation[:])
        unused CopyCString(local, request.owner_id[:])
        if provider.action != null && provider.action(provider.context, *request) == 1 {
            ProviderBridgeSignOut(provider)
            ProviderSignOutClear(provider, local, false)
        }
    }
}

// On Android the signed-in app keeps the copy its consent dialog offers, and
// an app with no account asks which one another app offers.
ProviderSharedAndroidPump :: (provider: *ManagementProvider) {
    state := ProviderState(provider)
    if !state.account {
        provider.shared_owner = .{}
        AccountHandoffWithdraw()
        unused AccountHandoffOfferedName(provider.shared_name[:])
        return
    }
    provider.shared_name = .{}
    if TextUntilNul(state.public_id[:]) == TextUntilNul(provider.shared_owner[:]) &&
    TextUntilNul(state.alias[:]) == TextUntilNul(provider.shared_alias[:]) { return }
    provider.shared_owner = state.public_id
    provider.shared_alias = state.alias
    recovery: Recovery
    defer { RecoveryClear(*recovery) }
    if provider.load != null && provider.load(provider.context, *recovery) {
        unused AccountHandoffPublish(*recovery, TextUntilNul(state.alias[:]))
    }
}

// The other app's consent dialog answers on a later frame.
ProviderHandoffPoll :: (provider: *ManagementProvider) {
    incoming: Recovery
    defer { RecoveryClear(*incoming) }
    result := AccountHandoffPoll(*incoming)
    if result == ACCOUNT_HANDOFF_PENDING { return }
    provider.handoff_pending = false
    if result == ACCOUNT_HANDOFF_DONE {
        RecoveryClear(*provider.incoming)
        provider.incoming = incoming
        provider.has_incoming = true
        state := ProviderState(provider)
        provider.incoming_owner = state.public_id
        ProviderApplyIncoming(provider, 0)
    } else if result == ACCOUNT_HANDOFF_CANCELLED {
        ProviderFinish(provider, "cancelled", "")
    } else if result == ACCOUNT_HANDOFF_REFUSED {
        provider.shared_name = .{}
        ProviderFinish(provider, "error", "That account is no longer signed in on this device")
    } else {
        ProviderFinish(provider, "error", "Could not get the account from the other app. Sign in instead.")
    }
}

ProviderContinue :: (provider: *ManagementProvider) {
    #if #defined(ANDROID_BUILD) {
        provider.handoff_pending = AccountHandoffStart()
        if !provider.handoff_pending { ProviderFinish(provider, "error", "Could not get the account from the other app. Sign in instead.") }
        return
    }
    root_buffer: [4096]u8
    incoming: Recovery
    defer { RecoveryClear(*incoming) }
    web_key: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    defer { SecureWipe(*web_key[0], web_key.count) }
    shared_key := SharedWebText("sharedAccountKey", web_key[:])
    available := false
    if shared_key != "" { available = RecoveryDecode(shared_key, "", *incoming) }
    else { available = SharedAccountRead(SharedAccountRoot(root_buffer[:]), *incoming) }
    if !available {
        provider.shared_name = .{}
        ProviderFinish(provider, "error", "That account is no longer signed in on this device")
        return
    }
    RecoveryClear(*provider.incoming)
    provider.incoming = incoming
    provider.has_incoming = true
    state := ProviderState(provider)
    provider.incoming_owner = state.public_id
    ProviderApplyIncoming(provider, 0)
}

// Host storage answers per account; a host without it means unknown, which warns.
ProviderBackedUpAction :: (provider: *ManagementProvider, owner: string, operation: string) -> bool {
    if provider.action == null { return false }
    request: ManagementRequest
    unused CopyCString(owner, request.owner_id[:])
    unused CopyCString(operation, request.operation[:])
    return provider.action(provider.context, *request) == 1
}

ProviderBackedUpPump :: (provider: *ManagementProvider) {
    state := ProviderState(provider)
    if TextUntilNul(state.public_id[:]) == TextUntilNul(provider.backed_up_owner[:]) { return }
    provider.backed_up_owner = state.public_id
    provider.backed_up = state.account && ProviderBackedUpAction(provider, TextUntilNul(state.public_id[:]), "backup_marked")
}

ProviderBackedUpSet :: (provider: *ManagementProvider, value: bool) {
    state := ProviderState(provider)
    provider.backed_up_owner = state.public_id
    provider.backed_up = value
    unused ProviderBackedUpAction(provider, TextUntilNul(state.public_id[:]), ifx value then "backup_mark" else "backup_unmark")
}

// Signing out goes ahead whatever else is in flight; that work is abandoned.
ProviderSignOutFirst :: (provider: *ManagementProvider) {
    if !provider.queue.pending { return }
    if provider.drive_pending { DriveBackupCancel() }
    provider.drive_pending = false
    if provider.handoff_pending { AccountHandoffCancel() }
    provider.handoff_pending = false
    if provider.asynchronous { ProviderCancelTransfer(cast(*void)provider) }
    provider.asynchronous = false
    ProviderOnlineForget(provider)
    ProviderFinish(provider, "cancelled", "")
}

// Nothing of the account stays in memory once it is signed out here.
ProviderSignOutClear :: (provider: *ManagementProvider, owner: string, share: bool = true) {
    root_buffer: [4096]u8
    if share && !provider.shared_web_files { SharedWebShare("", owner, false) }
    provider.shared_web_tried = .{}
    provider.shared_name = .{}
    AccountHandoffWithdraw()
    unused SharedAccountRemove(SharedAccountRoot(root_buffer[:]), owner)
    provider.shared_owner = .{}
    provider.shared_next = 0
    provider.session = .{}
    provider.backed_up = false
    provider.backed_up_owner = .{}
    ProviderForgetBackup(provider)
    RecoveryClear(*provider.incoming)
    provider.has_incoming = false
}

ProviderOnlineForget :: (provider: *ManagementProvider) {
    SecureWipe(*provider.online_password[0], provider.online_password.count)
    SecureWipe(*provider.online_body[0], provider.online_body.count)
    SecureWipe(*provider.online_reply[0], provider.online_reply.count)
    RecoveryKeysClear(*provider.online_keys)
}

ProviderOnlineFinish :: (provider: *ManagementProvider, result: string, message: string) {
    ProviderOnlineForget(provider)
    provider.asynchronous = false
    ProviderFinish(provider, result, message)
}

// The node to ask before any account is signed in here.
ProviderOnlineNode :: (provider: *ManagementProvider, output: []u8) -> bool {
    state := ProviderState(provider)
    for index: 0..state.node_count - 1 {
        if state.nodes[index].active { return CopyCString(TextUntilNul(state.nodes[index].address[:]), output) }
    }
    if state.node_count > 0 { return CopyCString(TextUntilNul(state.nodes[0].address[:]), output) }
    fallback := EntityDefault()
    return CopyCString(TextUntilNul(fallback.nodes[fallback.preferred][:]), output)
}

ProviderOnlinePost :: (provider: *ManagementProvider, path: string, operation: s32) -> bool {
    node: [512]u8
    if !ProviderOnlineNode(provider, node[:]) { return false }
    address: [640]u8
    at: s64 = 0
    if !AccountBackupAppend(address[:], *at, TextUntilNul(node[:])) || !AccountBackupAppend(address[:], *at, path) { return false }
    provider.online_url = address
    provider.online_reply[0] = cast(u8)0
    provider.network_operation = operation
    provider.asynchronous = HttpTransferStart(*provider.transfer, HttpRequest.{.method = "POST",
            .url = TextUntilNul(provider.online_url[:]), .content_type = "application/json",
            .accept = "application/json", .body = TextUntilNul(provider.online_body[:])},
        provider.online_reply[:], 15000)
    return provider.asynchronous
}

ProviderOnlineSignIn :: (provider: *ManagementProvider) {
    reference := AccountBackupReference(TextUntilNul(provider.queue.request.target[:]), provider.online_account[:])
    if reference == "" {
        ProviderOnlineFinish(provider, "error", "Enter your username or public ID")
        return
    }
    if provider.queue.request.value[0] == cast(u8)0 || !CopyCString(TextUntilNul(provider.queue.request.value[:]), provider.online_password[:]) {
        ProviderOnlineFinish(provider, "error", "Enter your password")
        return
    }
    if !AccountBackupSaltBody(reference, provider.online_body[:]) || !ProviderOnlinePost(provider, ACCOUNT_BACKUP_SALT_PATH, 10) {
        ProviderOnlineFinish(provider, "error", "Could not reach the node. Try again, use a backup file or link a device.")
    }
}

ProviderOnlineSignInPump :: (provider: *ManagementProvider) {
    status: s32 = 0
    state := HttpTransferPoll(*provider.transfer, *status)
    if state < 0 { return }
    if state == 0 { status = 0 }
    if status == 404 || status == 405 {
        ProviderOnlineFinish(provider, "error", "This node does not keep online backups. Use a backup file or link a device.")
        return
    }
    if status == 429 {
        out: Vec(u8)
        BuilderPrint(*out, "Too many attempts. Try again in % min.", AccountBackupWaitMinutes(TextUntilNul(provider.online_reply[:])))
        message := BuilderFinish(out)
        defer { EntityFree(message) }
        ProviderOnlineFinish(provider, "error", message)
        return
    }
    if status == 403 {
        ProviderOnlineFinish(provider, "error", "Wrong username or password")
        return
    }
    if status != 200 {
        ProviderOnlineFinish(provider, "error", "Could not reach the node. Try again, use a backup file or link a device.")
        return
    }
    if provider.network_operation == 10 {
        salt_text: [RECOVERY_SALT_BYTES * 2 + 1]u8
        salt := AccountBackupSalt(TextUntilNul(provider.online_reply[:]), salt_text[:])
        if salt == "" || !RecoveryDeriveFromHex(TextUntilNul(provider.online_password[:]), salt, *provider.online_keys) ||
        !AccountBackupOpenBody(TextUntilNul(provider.online_account[:]), *provider.online_keys, provider.online_body[:]) ||
        !ProviderOnlinePost(provider, ACCOUNT_BACKUP_OPEN_PATH, 11) {
            ProviderOnlineFinish(provider, "error", "Could not sign in. Try again, use a backup file or link a device.")
        }
        return
    }
    incoming: Recovery
    defer { RecoveryClear(*incoming) }
    if !AccountBackupOpen(TextUntilNul(provider.online_reply[:]), *provider.online_keys, *incoming) {
        ProviderOnlineFinish(provider, "error", "The node returned a backup this password cannot open")
        return
    }
    ProviderOnlineForget(provider)
    provider.asynchronous = false
    RecoveryClear(*provider.incoming)
    provider.incoming = incoming
    provider.has_incoming = true
    current := ProviderState(provider)
    provider.incoming_owner = current.public_id
    ProviderApplyIncoming(provider, 0)
}

// Seals on this device and sends only the sealed copy. Local saves never wait
// for this: it is its own action and its failure changes nothing here.
ProviderBackupOnline :: (provider: *ManagementProvider, passphrase: string) {
    if !ManagementPasswordAccepted(passphrase) {
        ProviderOnlineFinish(provider, "error", "Use a password of at least 12 characters")
        return
    }
    recovery: Recovery
    defer { RecoveryClear(*recovery) }
    client: Client
    if provider.load == null || !provider.load(provider.context, *recovery) ||
    provider.client == null || !provider.client(provider.context, *client) {
        ProviderOnlineFinish(provider, "error", "No account is signed in on this device")
        return
    }
    if !CopyCString(client.server_url, provider.request_node[:]) {
        ProviderOnlineFinish(provider, "error", "The node address is not valid")
        return
    }
    client.server_url = TextUntilNul(provider.request_node[:])
    text: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    defer { SecureWipe(*text[0], text.count) }
    if !RecoverySeal(*recovery, passphrase, text[:], *provider.online_keys) ||
    !AccountBackupUploadBody(TextUntilNul(text[:]), *provider.online_keys, provider.online_body[:]) {
        ProviderOnlineFinish(provider, "error", "Could not prepare the backup")
        return
    }
    RecoveryKeysClear(*provider.online_keys)
    headers: [0]HttpHeader
    provider.network_operation = 5
    provider.asynchronous = BeginRequest(*provider.pending_request, client, *provider.session, UnixNow(),
        ProviderTransport(provider), "POST", ACCOUNT_BACKUP_PATH, TextUntilNul(provider.online_body[:]), provider.response[:], headers[:])
    if !provider.asynchronous { ProviderOnlineFinish(provider, "error", "Could not reach the node. Save a backup file instead.") }
}

ProviderBackupOnlineRemove :: (provider: *ManagementProvider) {
    client: Client
    if provider.client == null || !provider.client(provider.context, *client) || !CopyCString(client.server_url, provider.request_node[:]) {
        ProviderOnlineFinish(provider, "error", "No account is signed in on this device")
        return
    }
    client.server_url = TextUntilNul(provider.request_node[:])
    headers: [0]HttpHeader
    provider.network_operation = 6
    provider.asynchronous = BeginRequest(*provider.pending_request, client, *provider.session, UnixNow(),
        ProviderTransport(provider), "DELETE", ACCOUNT_BACKUP_PATH, "", provider.response[:], headers[:])
    if !provider.asynchronous { ProviderOnlineFinish(provider, "error", "Could not reach the node") }
}

ProviderBackupOnlineFinished :: (provider: *ManagementProvider) {
    status := provider.pending_request.status
    if provider.pending_request.result == Auth.AuthResult.AUTH_OK {
        ProviderBackedUpSet(provider, provider.network_operation == 5)
        message := ifx provider.network_operation == 5 then "Backup saved online. Sign in with your username or public ID and this password." else "Online backup removed"
        ProviderOnlineFinish(provider, "ok", message)
        return
    }
    if status == 404 || status == 405 {
        ProviderOnlineFinish(provider, "error", "This node does not keep online backups. Save a backup file instead.")
        return
    }
    ProviderOnlineFinish(provider, "error", "Could not reach the node. Your account here is unchanged.")
}

// What the platform can ask for is settled once; it does not change while running.
ProviderBridgeState :: (provider: *ManagementProvider, state: *Management) {
    if !provider.bridge_known {
        provider.bridge_known = true
        provider.bridge_passkey = PasskeyBridgeAvailable()
        provider.bridge_google = GoogleBridgeAvailable()
    }
    if provider.bridge_passkey { state.capabilities |= ACCOUNT_PASSKEY }
    if provider.bridge_google && provider.google_client[0] != cast(u8)0 { state.capabilities |= ACCOUNT_GOOGLE }
    state.found_account = provider.found_account
    state.google_linked = provider.google_linked
    state.passkeys = provider.passkeys
    state.passkey_count = provider.passkey_count
}

// Asks the node once which Google client it accepts, beside everything else:
// nothing waits for this, and a node without the route means no Google button.
ProviderMethodsPump :: (provider: *ManagementProvider) {
    if !provider.bridge_known || !provider.bridge_google || provider.google_client[0] != cast(u8)0 { return }
    if provider.methods_asked {
        status: s32 = 0
        state := HttpTransferPoll(*provider.methods_transfer, *status)
        if state < 0 { return }
        provider.methods_asked = false
        provider.methods_next = UnixNow() + 60
        if state != 0 && status == 200 {
            unused SignInGoogleClient(TextUntilNul(provider.methods_reply[:]), provider.google_client[:])
        }
        return
    }
    if UnixNow() < provider.methods_next { return }
    provider.methods_next = UnixNow() + 60
    node: [512]u8
    if !ProviderOnlineNode(provider, node[:]) { return }
    address: [640]u8
    at: s64 = 0
    if !AccountBackupAppend(address[:], *at, TextUntilNul(node[:])) || !AccountBackupAppend(address[:], *at, SIGN_IN_METHODS_PATH) { return }
    provider.methods_url = address
    provider.methods_reply[0] = cast(u8)0
    provider.methods_asked = HttpTransferStart(*provider.methods_transfer, HttpRequest.{.method = "GET",
            .url = TextUntilNul(provider.methods_url[:]), .accept = "application/json"},
        provider.methods_reply[:], 15000)
}

ProviderPasskeyForget :: (provider: *ManagementProvider) {
    RecoveryKeysClear(*provider.passkey_keys)
    provider.passkey_credential = .{}
    provider.passkey_account = .{}
}

ProviderBridgeFinish :: (provider: *ManagementProvider, result: string, message: string) {
    ProviderPasskeyForget(provider)
    provider.bridge_operation = 0
    ProviderOnlineFinish(provider, result, message)
}

// Signing out needs nothing from Google or a passkey manager, and leaves nothing
// of theirs behind that could sign this device back in.
ProviderBridgeSignOut :: (provider: *ManagementProvider) {
    SignInBridgeForget()
    ProviderPasskeyForget(provider)
    provider.bridge_operation = 0
    provider.found_account = .{}
    provider.google_linked = false
    provider.passkey_count = 0
    provider.passkeys = .{}
}

ProviderPasskeyStart :: (provider: *ManagementProvider, adding: bool) {
    started := false
    if adding {
        state := ProviderState(provider)
        name := TextUntilNul(state.alias[:])
        if name == "" { name = TextUntilNul(state.public_id[:]) }
        unused CopyCString(TextUntilNul(state.public_id[:]), provider.passkey_account[:])
        started = PasskeyBridgeCreate(TextUntilNul(state.public_id[:]), name)
        provider.bridge_operation = 1
    } else {
        started = PasskeyBridgeGet()
        provider.bridge_operation = 2
    }
    if !started { ProviderBridgeFinish(provider, "error", SIGN_IN_NO_PASSKEY) }
}

ProviderGoogleStart :: (provider: *ManagementProvider, linking: bool) {
    client := TextUntilNul(provider.google_client[:])
    nonce: [65]u8
    if linking {
        state := ProviderState(provider)
        if !SignInGoogleNonce(TextUntilNul(state.public_id[:]), nonce[:]) {
            ProviderBridgeFinish(provider, "error", "No account is signed in on this device")
            return
        }
    }
    provider.bridge_operation = ifx linking then 4 else 3
    if client == "" || !GoogleBridgeStart(client, TextUntilNul(nonce[:])) {
        ProviderBridgeFinish(provider, "error", SIGN_IN_NO_GOOGLE)
    }
}

ProviderSignedRequest :: (provider: *ManagementProvider, method: string, path: string, body: string, operation: s32) -> bool {
    client: Client
    if provider.client == null || !provider.client(provider.context, *client) || !CopyCString(client.server_url, provider.request_node[:]) { return false }
    client.server_url = TextUntilNul(provider.request_node[:])
    headers: [0]HttpHeader
    provider.response[0] = cast(u8)0
    provider.network_operation = operation
    provider.asynchronous = BeginRequest(*provider.pending_request, client, *provider.session, UnixNow(),
        ProviderTransport(provider), method, path, body, provider.response[:], headers[:])
    return provider.asynchronous
}

// Seals on this device, so the node receives only the wrapper and the verifier.
ProviderPasskeyUpload :: (provider: *ManagementProvider, answer: *SignInAnswer) {
    credential := TextUntilNul(answer.credential[:])
    recovery: Recovery
    defer { RecoveryClear(*recovery) }
    if provider.load == null || !provider.load(provider.context, *recovery) {
        ProviderBridgeFinish(provider, "error", "No account is signed in on this device")
        return
    }
    if !SignInSameAccount(TextUntilNul(provider.passkey_account[:]), TextUntilNul(recovery.keys.public_id[:])) {
        ProviderBridgeFinish(provider, "error", "The account changed while adding this passkey. Add it again.")
        return
    }
    wrapper: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    defer { SecureWipe(*wrapper[0], wrapper.count) }
    label: [64]u8
    if !PasskeyDeriveFromHex(TextUntilNul(answer.prf[:]), *provider.passkey_keys) ||
    !PasskeySeal(*recovery, credential, *provider.passkey_keys, wrapper[:]) ||
    !PasskeyUploadBody(TextUntilNul(wrapper[:]), credential, *provider.passkey_keys, SignInDeviceLabel(label[:]), provider.online_body[:]) {
        ProviderBridgeFinish(provider, "error", SIGN_IN_NO_PRF)
        return
    }
    RecoveryKeysClear(*provider.passkey_keys)
    if !ProviderSignedRequest(provider, "POST", PASSKEY_PATH, TextUntilNul(provider.online_body[:]), 22) {
        ProviderBridgeFinish(provider, "error", "Could not reach the node. Your account here is unchanged.")
    }
}

ProviderPasskeySignIn :: (provider: *ManagementProvider, answer: *SignInAnswer) {
    account := TextUntilNul(answer.account[:])
    credential := TextUntilNul(answer.credential[:])
    if !CopyCString(account, provider.online_account[:]) || !CopyCString(credential, provider.passkey_credential[:]) ||
    !PasskeyDeriveFromHex(TextUntilNul(answer.prf[:]), *provider.passkey_keys) ||
    !PasskeyOpenBody(account, credential, *provider.passkey_keys, provider.online_body[:]) {
        ProviderBridgeFinish(provider, "error", SIGN_IN_WRONG_PASSKEY)
        return
    }
    provider.bridge_operation = 0
    if !ProviderOnlinePost(provider, PASSKEY_OPEN_PATH, 20) {
        ProviderBridgeFinish(provider, "error", "Could not reach the node. Try again, use a backup file or link a device.")
    }
}

ProviderBridgePoll :: (provider: *ManagementProvider) {
    answer: SignInAnswer
    defer { SignInAnswerClear(*answer) }
    if !SignInBridgePoll(*answer) { return }
    operation := provider.bridge_operation
    google := operation >= 3
    if TextUntilNul(answer.status[:]) == "cancelled" { ProviderBridgeFinish(provider, "cancelled", ""); return }
    if TextUntilNul(answer.status[:]) == "no_prf" { ProviderBridgeFinish(provider, "error", SIGN_IN_NO_PRF); return }
    if TextUntilNul(answer.status[:]) != "ok" {
        ProviderBridgeFinish(provider, "error", ifx google then SIGN_IN_NO_GOOGLE else SIGN_IN_NO_PASSKEY)
        return
    }
    if operation == 1 { ProviderPasskeyUpload(provider, *answer); return }
    if operation == 2 { ProviderPasskeySignIn(provider, *answer); return }
    if !SignInTokenBody(TextUntilNul(answer.token[:]), provider.online_body[:]) {
        ProviderBridgeFinish(provider, "error", SIGN_IN_NO_GOOGLE)
        return
    }
    provider.bridge_operation = 0
    started := ifx operation == 3 then ProviderOnlinePost(provider, SIGN_IN_GOOGLE_FIND_PATH, 21) else ProviderSignedRequest(provider, "POST", SIGN_IN_GOOGLE_PATH, TextUntilNul(provider.online_body[:]), 25)
    if !started { ProviderBridgeFinish(provider, "error", "Could not reach the node. Your account here is unchanged.") }
}

// The public routes: a passkey's sealed copy and Google's account lookup.
ProviderSignInPump :: (provider: *ManagementProvider) {
    status: s32 = 0
    state := HttpTransferPoll(*provider.transfer, *status)
    if state < 0 { return }
    if state == 0 { status = 0 }
    reply := TextUntilNul(provider.online_reply[:])
    operation := provider.network_operation
    if status == 429 {
        ProviderBridgeFinish(provider, "error", "Too many attempts. Try again in a minute.")
        return
    }
    if operation == 21 {
        if status == 200 && SignInFoundAccount(reply, provider.found_account[:]) {
            ProviderBridgeFinish(provider, "ok", SIGN_IN_GOOGLE_FOUND)
        } else if status == 404 {
            ProviderBridgeFinish(provider, "error", SIGN_IN_GOOGLE_UNLINKED)
        } else if status == 401 {
            ProviderBridgeFinish(provider, "error", SIGN_IN_GOOGLE_REFUSED)
        } else {
            ProviderBridgeFinish(provider, "error", "Could not reach the node. Try again, use a backup file or link a device.")
        }
        return
    }
    if status == 404 || status == 405 {
        ProviderBridgeFinish(provider, "error", "This node does not keep passkey copies. Use your password.")
        return
    }
    if status == 403 {
        ProviderBridgeFinish(provider, "error", SIGN_IN_WRONG_PASSKEY)
        return
    }
    if status != 200 {
        ProviderBridgeFinish(provider, "error", "Could not reach the node. Try again, use a backup file or link a device.")
        return
    }
    incoming: Recovery
    defer { RecoveryClear(*incoming) }
    if !PasskeyOpenReply(reply, TextUntilNul(provider.online_account[:]), TextUntilNul(provider.passkey_credential[:]), *provider.passkey_keys, *incoming) {
        ProviderBridgeFinish(provider, "error", SIGN_IN_WRONG_PASSKEY)
        return
    }
    ProviderPasskeyForget(provider)
    ProviderOnlineForget(provider)
    provider.asynchronous = false
    RecoveryClear(*provider.incoming)
    provider.incoming = incoming
    provider.has_incoming = true
    current := ProviderState(provider)
    provider.incoming_owner = current.public_id
    ProviderApplyIncoming(provider, 0)
}

// The signed routes finish here. A list runs passkeys then Google, and adding,
// removing or linking refreshes that list before it reports.
ProviderSignInRequestFinished :: (provider: *ManagementProvider) {
    status := provider.pending_request.status
    operation := provider.network_operation
    succeeded := provider.pending_request.result == Auth.AuthResult.AUTH_OK
    provider.asynchronous = false
    if operation == 24 {
        if succeeded { provider.passkey_count = SignInPasskeyList(TextUntilNul(provider.response[:]), provider.passkeys[:]) }
        if ProviderSignedRequest(provider, "GET", SIGN_IN_GOOGLE_PATH, "", 27) { return }
        ProviderBridgeFinish(provider, "ok", "")
        return
    }
    if operation == 27 {
        if succeeded { provider.google_linked = SignInGoogleLinked(TextUntilNul(provider.response[:])) }
        message := provider.sign_in_message
        provider.sign_in_message = .{}
        ProviderBridgeFinish(provider, "ok", TextUntilNul(message[:]))
        return
    }
    if !succeeded {
        message := "Could not reach the node. Your account here is unchanged."
        if status == 404 || status == 405 { message = "This node does not offer this yet. Your account here is unchanged." }
        if operation == 25 && status == 409 { message = SIGN_IN_GOOGLE_TAKEN }
        if operation == 25 && status == 401 { message = SIGN_IN_GOOGLE_REFUSED }
        ProviderBridgeFinish(provider, "error", message)
        return
    }
    done := "Google link removed"
    if operation == 22 { done = "Passkey added" }
    if operation == 23 { done = "Passkey removed" }
    if operation == 25 { done = "Google can now find this account" }
    unused CopyCString(done, provider.sign_in_message[:])
    if !ProviderSignedRequest(provider, "GET", PASSKEY_PATH, "", 24) { ProviderBridgeFinish(provider, "ok", done) }
}

ProviderPasskeyRemove :: (provider: *ManagementProvider) {
    credential := TextUntilNul(provider.queue.request.target[:])
    if !PasskeyCredentialValid(credential) || !SignInRemoveBody(credential, provider.online_body[:]) ||
    !ProviderSignedRequest(provider, "POST", SIGN_IN_PASSKEY_REMOVE_PATH, TextUntilNul(provider.online_body[:]), 23) {
        ProviderBridgeFinish(provider, "error", "Could not reach the node. Your account here is unchanged.")
    }
}

ProviderStartTransfer :: (context: *void, request: HttpRequest, output: []u8) -> bool {
    provider := cast(*ManagementProvider)context
    return HttpTransferStart(*provider.transfer, request, output, 15000)
}

ProviderPollTransfer :: (context: *void, status: *s32) -> s32 {
    provider := cast(*ManagementProvider)context
    return HttpTransferPoll(*provider.transfer, status)
}

ProviderCancelTransfer :: (context: *void) {
    provider := cast(*ManagementProvider)context
    HttpTransferCancel(*provider.transfer)
}

ProviderTransport :: (provider: *ManagementProvider) -> AsyncTransport {
    return AsyncTransport.{.context = cast(*void)provider, .start = ProviderStartTransfer,
        .poll = ProviderPollTransfer, .cancel = ProviderCancelTransfer}
}

// The alias as the node stores it: as on the node, the spaces around it, a
// leading @ and capital letters do not matter, so "@Waozi " is "waozi".
// Returns "" when it does not fit `output`.
ProviderNormalizeAlias :: (value: string, output: []u8) -> string {
    start: s64 = 0
    end := value.count
    while start < end && value[start] <= cast(u8)32 { start += 1 }
    while end > start && value[end - 1] <= cast(u8)32 { end -= 1 }
    if start < end && value[start] == #char "@" { start += 1 }
    if end - start >= output.count { return "" }
    count: s64 = 0
    for index: start..end - 1 {
        byte := value[index]
        if byte >= #char "A" && byte <= #char "Z" { byte = byte - #char "A" + #char "a" }
        output[count] = byte
        count += 1
    }
    output[count] = cast(u8)0
    return TextUntilNul(output)
}

// Why the node did not save an alias or clear the remote data, in words the
// person can act on.
ProviderNetworkFailure :: (provider: *ManagementProvider) -> string {
    result := ifx provider.network_operation == 2 then provider.pending_deletion.result else provider.pending_request.result
    if result == Auth.AuthResult.AUTH_FAILED {
        return "The node did not accept this account's key"
    }
    if provider.network_operation == 1 && result == Auth.AuthResult.AUTH_REQUEST_FAILED {
        status := provider.pending_request.status
        if status == 409 { return "That alias is already taken; choose another" }
        if status == 400 { return "Use 4–32 lowercase letters, numbers or underscores" }
        if status == 0 { return "Could not reach the node; check the connection and try again" }
    }
    if result == Auth.AuthResult.AUTH_CHALLENGE_FAILED && provider.pending_request.status == 0 {
        return "Could not reach the node; check the connection and try again"
    }
    return "The node could not complete the account request"
}

ProviderAliasValid :: (alias: string) -> bool {
    if alias.count < 1 || alias.count > 32 { return false }
    for byte: alias {
        if !((byte >= cast(u8)97 && byte <= cast(u8)122) || (byte >= cast(u8)65 && byte <= cast(u8)90) ||
            (byte >= cast(u8)48 && byte <= cast(u8)57) || byte == cast(u8)95) { return false }
    }
    return true
}

// Host storage callbacks run only in the verified owner's private store.
// They are not UI operations, and no purchase is sent until save succeeds.
ProviderAliasRecord :: (provider: *ManagementProvider, operation: string, purchase: *AliasPurchase) -> s32 {
    if provider.action == null { return 0 }
    request: ManagementRequest
    request.owner_id = provider.queue.request.owner_id
    unused CopyCString(operation, request.operation[:])
    if operation == "alias_purchase_save" {
        document := AliasPurchaseEncode(purchase.*)
        defer { EntityFree(document) }
        if !CopyCString(document, request.value[:]) { return 0 }
    }
    result := provider.action(provider.context, *request)
    if result == 1 && operation == "alias_purchase_load" {
        if !AliasPurchaseParse(TextUntilNul(request.value[:]), purchase) { return 0 }
    }
    return result
}

ProviderPendingAliasOffer :: (provider: *ManagementProvider) {
    provider.alias_offer = .{}
    provider.alias_offer.known = true
    provider.alias_offer.available = true
    provider.alias_offer.premium = true
    provider.alias_offer.alias = provider.alias_purchase.alias
    provider.alias_offer.units = provider.alias_purchase.units
    provider.alias_retry = true
}

ProviderStartAlias :: (provider: *ManagementProvider, buying: bool) {
    client: Client
    if provider.client == null || !provider.client(provider.context, *client) {
        ProviderFinish(provider, "error", "The account is unavailable")
        return
    }
    if TextUntilNul(provider.alias_owner[:]) != TextUntilNul(provider.queue.request.owner_id[:]) ||
    TextUntilNul(provider.alias_node[:]) != client.server_url {
        provider.alias_offer = .{}
        provider.alias_retry = false
        provider.alias_purchase = .{}
    }
    provider.alias_owner = provider.queue.request.owner_id
    if !CopyCString(client.server_url, provider.request_node[:]) ||
    !CopyCString(client.server_url, provider.alias_node[:]) {
        ProviderFinish(provider, "error", "The node address is not valid")
        return
    }
    client.server_url = TextUntilNul(provider.request_node[:])
    normalized: [40]u8
    alias := AliasNormalize(TextUntilNul(provider.queue.request.value[:]), normalized[:])
    state := ProviderState(provider)
    if !AliasValid(alias) && alias != TextUntilNul(state.alias[:]) {
        ProviderFinish(provider, "error", "Use 4–32 lowercase letters, numbers or underscores")
        return
    }
    saved: AliasPurchase
    found := ProviderAliasRecord(provider, "alias_purchase_load", *saved)
    if buying && found == 0 {
        ProviderFinish(provider, "error", "Could not read the saved username purchase")
        return
    }
    if found == 1 {
        if TextUntilNul(saved.owner[:]) != TextUntilNul(provider.queue.request.owner_id[:]) ||
        TextUntilNul(saved.node[:]) != client.server_url {
            ProviderFinish(provider, "error", "Retry the pending username purchase on its original node first")
            return
        }
        provider.alias_purchase = saved
        ProviderPendingAliasOffer(provider)
        if !buying {
            ProviderFinish(provider, "quote", "A username purchase needs an explicit retry")
            return
        }
    }
    headers: [0]HttpHeader
    if !buying {
        provider.alias_offer = .{}
        provider.alias_retry = false
        provider.network_operation = 3
        unused CopyCString(alias, provider.queue.request.value[:])
        route: Vec(u8)
        BuilderPrint(*route, "/api/v1/account/alias?alias=%", alias)
        path := BuilderFinish(route)
        defer { EntityFree(path) }
        if !CopyCString(path, provider.request_body[:]) {
            ProviderFinish(provider, "error", "The username request is too long")
            return
        }
        provider.asynchronous = BeginRequest(*provider.pending_request, client, *provider.session, UnixNow(),
            ProviderTransport(provider), "GET", TextUntilNul(provider.request_body[:]), "", provider.response[:], headers[:])
    } else {
        confirmed: s64
        text := TextUntilNul(provider.queue.request.target[:])
        if !DewInteger(text, 0, *confirmed) || Json.ValueEnd(text, 0, 0) != text.count || confirmed <= 0 {
            ProviderFinish(provider, "error", "Confirm the quoted username price first")
            return
        }
        if found == 1 {
            if alias != TextUntilNul(saved.alias[:]) || confirmed != saved.units {
                ProviderFinish(provider, "error", "Retry the pending username purchase before choosing another")
                return
            }
        } else {
            offer := provider.alias_offer
            if !offer.known || !offer.available || TextUntilNul(offer.alias[:]) != alias || offer.units != confirmed {
                ProviderFinish(provider, "error", "Check availability and confirm the current username price")
                return
            }
            purchase: AliasPurchase
            purchase.owner = provider.queue.request.owner_id
            purchase.node = provider.alias_node
            purchase.alias = offer.alias
            purchase.units = confirmed
            random: [16]u8
            if SecureRandom(*random[0], random.count) == 0 {
                ProviderFinish(provider, "error", "Could not prepare the username purchase")
                return
            }
            BytesToHex(*random[0], random.count, *purchase.request_id[0], purchase.request_id.count)
            if ProviderAliasRecord(provider, "alias_purchase_save", *purchase) != 1 {
                ProviderFinish(provider, "error", "Could not save the username purchase for a safe retry")
                return
            }
            provider.alias_purchase = purchase
            ProviderPendingAliasOffer(provider)
        }
        unused CopyCString(alias, provider.queue.request.value[:])
        body: Vec(u8)
        BuilderPrint(*body, "{\"alias\":\"%\",\"price_units\":%,\"request_id\":\"%\"}",
            alias, provider.alias_purchase.units, TextUntilNul(provider.alias_purchase.request_id[:]))
        document := BuilderFinish(body)
        defer { EntityFree(document) }
        if !CopyCString(document, provider.request_body[:]) {
            ProviderFinish(provider, "alias_retry", "Retry the saved username purchase")
            return
        }
        provider.network_operation = 4
        provider.asynchronous = BeginRequest(*provider.pending_request, client, *provider.session, UnixNow(),
            ProviderTransport(provider), "POST", "/api/v1/account/alias/purchase", TextUntilNul(provider.request_body[:]),
            provider.response[:], headers[:])
    }
    if !provider.asynchronous {
        ProviderFinish(provider, ifx buying then "alias_retry" else "error", "Could not start the username request")
    }
}

ProviderFinishAlias :: (provider: *ManagementProvider, succeeded: bool) {
    buying := provider.network_operation == 4
    if !succeeded {
        status := provider.pending_request.status
        if !buying && (status == 404 || status == 405) {
            ProviderFinish(provider, "quote_unsupported", "This node uses the normal alias form")
            return
        }
        if buying && (status == 400 || status == 402 || status == 404 || status == 409) {
            if ProviderAliasRecord(provider, "alias_purchase_clear", *provider.alias_purchase) == 1 {
                provider.alias_retry = false
                provider.alias_offer = .{}
            }
            if status == 402 {
                ProviderFinish(provider, "alias_funds", "Not enough Dew; top up and check the username again")
            } else {
                ProviderFinish(provider, "alias_changed", "The username or price changed; check availability again")
            }
        } else {
            ProviderFinish(provider, ifx buying then "alias_retry" else "error",
                ifx buying then "The result is uncertain; retry the saved purchase" else "Could not check username availability")
        }
        return
    }
    if !buying {
        offer: AliasOffer
        if !AliasOfferParse(TextUntilNul(provider.response[:]), TextUntilNul(provider.queue.request.value[:]), *offer) {
            ProviderFinish(provider, "error", "The node returned an invalid username offer")
            return
        }
        provider.alias_offer = offer
        ProviderFinish(provider, "quote", "")
        return
    }
    document := TextUntilNul(provider.response[:])
    alias: [40]u8
    units: s64
    receipt: [128]u8
    if Json.ReadStringText(document, Json.FieldAt(document, 0, "alias"), alias[:]) <= 0 ||
    TextUntilNul(alias[:]) != TextUntilNul(provider.alias_purchase.alias[:]) ||
    !DewInteger(document, Json.FieldAt(document, 0, "price_units"), *units) ||
    (units != 0 && units != provider.alias_purchase.units) ||
    (units > 0 && Json.ReadStringText(document, Json.FieldAt(document, 0, "receipt_id"), receipt[:]) <= 0) {
        ProviderFinish(provider, "alias_retry", "The result is uncertain; retry the saved purchase")
        return
    }
    request := provider.queue.request
    unused CopyCString("alias_saved", request.operation[:])
    unused CopyCString(TextUntilNul(alias[:]), request.value[:])
    if provider.action == null || provider.action(provider.context, *request) != 1 ||
    ProviderAliasRecord(provider, "alias_purchase_clear", *provider.alias_purchase) != 1 {
        ProviderFinish(provider, "alias_retry", "The node saved the username; retry to finish saving it on this device")
        return
    }
    provider.alias_offer = .{}
    provider.alias_retry = false
    ProviderFinish(provider, "ok", "Account alias saved")
}

ProviderStartNetwork :: (provider: *ManagementProvider, deleting: bool) {
    client: Client
    if provider.client == null || !provider.client(provider.context, *client) { ProviderFinish(provider, "error", "The account is unavailable"); return }
    if !CopyCString(client.server_url, provider.request_node[:]) { ProviderFinish(provider, "error", "The node address is not valid"); return }
    // Requests retain their original endpoint even if another window changes
    // the preferred node while a challenge/login is in progress.
    client.server_url = TextUntilNul(provider.request_node[:])
    started := false
    if deleting {
        provider.network_operation = 2
        started = BeginDeletion(*provider.pending_deletion, client, ProviderTransport(provider))
    } else {
        alias_buffer: [1024]u8
        for index: 0..alias_buffer.count - 1 { alias_buffer[index] = provider.queue.request.value[index] }
        normalized: [1024]u8
        alias := ProviderNormalizeAlias(TextUntilNul(alias_buffer[:]), normalized[:])
        current_normalized: [40]u8
        current := ProviderState(provider)
        same := alias != "" && alias == AliasNormalize(TextUntilNul(current.alias[:]), current_normalized[:])
        display: [1024]u8
        if same { alias = AliasDisplay(TextUntilNul(alias_buffer[:]), display[:]) }
        if !ProviderAliasValid(alias) || (alias.count < 4 && !same) ||
        !BuildAliasBody(client.identity.account_id, alias, provider.request_body[:]) {
            ProviderFinish(provider, "error", "Use 4–32 lowercase letters, numbers or underscores")
            return
        }
        // The saved account keeps the alias as the node stores it.
        unused CopyCString(alias, provider.queue.request.value[:])
        provider.network_operation = 1
        extra_headers: [0]HttpHeader
        started = BeginRequest(*provider.pending_request, client, *provider.session, UnixNow(),
            ProviderTransport(provider), "POST", "/api/v1/account/alias", TextUntilNul(provider.request_body[:]), provider.response[:], extra_headers[:])
    }
    provider.asynchronous = started
    if !started { ProviderFinish(provider, "error", "Could not start the account request") }
}

ProviderPump :: (provider: *ManagementProvider) {
    ProviderBackedUpPump(provider)
    ProviderSharedPump(provider)
    ProviderMethodsPump(provider)
    if !provider.queue.pending { return }
    if !ProviderOwnerMatches(provider, *provider.queue.request) {
        if provider.drive_pending { DriveBackupCancel(); provider.drive_pending = false }
        if provider.handoff_pending { AccountHandoffCancel(); provider.handoff_pending = false }
        if provider.bridge_operation != 0 { SignInBridgeCancel(); provider.bridge_operation = 0 }
        ProviderPasskeyForget(provider)
        if provider.asynchronous { ProviderCancelTransfer(cast(*void)provider) }
        provider.asynchronous = false
        ProviderOnlineForget(provider)
        ProviderFinish(provider, "error", "The account changed; open its current profile again")
        return
    }
    if provider.drive_pending { ProviderDrivePoll(provider); return }
    if provider.handoff_pending { ProviderHandoffPoll(provider); return }
    if provider.bridge_operation != 0 { ProviderBridgePoll(provider); return }
    if provider.delegated { return }
    if provider.asynchronous && (provider.network_operation == 20 || provider.network_operation == 21) {
        ProviderSignInPump(provider)
        return
    }
    if provider.asynchronous && provider.network_operation >= 10 && provider.network_operation < 20 {
        ProviderOnlineSignInPump(provider)
        return
    }
    if provider.asynchronous {
        finished := ifx provider.network_operation == 2 then PollDeletion(*provider.pending_deletion) else PollRequest(*provider.pending_request)
        if !finished { return }
        if provider.network_operation == 5 || provider.network_operation == 6 {
            ProviderBackupOnlineFinished(provider)
            return
        }
        if provider.network_operation >= 22 {
            ProviderSignInRequestFinished(provider)
            return
        }
        succeeded := ifx provider.network_operation == 2 then provider.pending_deletion.result == Auth.AuthResult.AUTH_OK else provider.pending_request.result == Auth.AuthResult.AUTH_OK
        provider.asynchronous = false
        current: Client
        if !succeeded && provider.network_operation < 3 { ProviderFinish(provider, "error", ProviderNetworkFailure(provider)); return }
        if provider.client == null || !provider.client(provider.context, *current) || current.server_url != TextUntilNul(provider.request_node[:]) {
            ProviderFinish(provider, "error", "The original node completed the request; the current node changed")
            return
        }
        if provider.network_operation == 3 || provider.network_operation == 4 {
            ProviderFinishAlias(provider, succeeded)
            return
        }
        request := provider.queue.request
        unused CopyCString(ifx provider.network_operation == 2 then "remote_cleared" else "alias_saved", request.operation[:])
        if provider.action == null || provider.action(provider.context, *request) != 1 {
            ProviderFinish(provider, "error", "The node updated the account, but its local state could not be saved")
            return
        }
        ProviderFinish(provider, "ok", ifx provider.network_operation == 2 then "Remote account data cleared" else "Account alias saved")
        return
    }
    operation_buffer: [32]u8
    for index: 0..operation_buffer.count - 1 { operation_buffer[index] = provider.queue.request.operation[index] }
    operation := TextUntilNul(operation_buffer[:])
    if operation == "create" {
        RecoveryClear(*provider.incoming)
        provider.has_incoming = CreateAccountKeys(*provider.incoming.keys) != 0
        state := ProviderState(provider)
        provider.incoming_owner = state.public_id
        ProviderApplyIncoming(provider, 0)
    } else if operation == "import" {
        passphrase: [1024]u8
        for index: 0..passphrase.count - 1 { passphrase[index] = provider.queue.request.value[index] }
        ProviderImport(provider, TextUntilNul(passphrase[:]))
        SecureWipe(*passphrase[0], passphrase.count)
    } else if operation == "import_paste" {
        passphrase: [1024]u8
        for index: 0..passphrase.count - 1 { passphrase[index] = provider.queue.request.value[index] }
        ProviderImportPaste(provider, TextUntilNul(passphrase[:]))
        SecureWipe(*passphrase[0], passphrase.count)
    } else if operation == "import_password" {
        passphrase: [1024]u8
        for index: 0..passphrase.count - 1 { passphrase[index] = provider.queue.request.value[index] }
        ProviderImportHeld(provider, TextUntilNul(passphrase[:]))
        SecureWipe(*passphrase[0], passphrase.count)
    } else if operation == "import_cancel" {
        ProviderForgetBackup(provider)
        ProviderFinish(provider, "cancelled", "")
    } else if operation == "link_paste" {
        // A pasted connection code joins like a typed one.
        code: [1024]u8
        request := provider.queue.request
        if provider.paste == null || !provider.paste(provider.context, code[:]) ||
        !CopyCString(ProviderTrim(TextUntilNul(code[:])), request.value[:]) || request.value[0] == cast(u8)0 {
            ProviderFinish(provider, "error", "Copy a connection code, then paste it here")
            return
        }
        unused CopyCString("link_join", request.operation[:])
        result := ifx provider.action == null then 0 else provider.action(provider.context, *request)
        if result == 1 { ProviderFinish(provider, "ok", "") }
        else { ProviderFinish(provider, "error", "That is not a connection code") }
    } else if operation == "drive_backup" || operation == "drive_import" {
        ProviderDriveStart(provider, operation == "drive_backup")
    } else if operation == "backup" {
        passphrase: [1024]u8
        for index: 0..passphrase.count - 1 { passphrase[index] = provider.queue.request.value[index] }
        ProviderBackup(provider, TextUntilNul(passphrase[:]))
        SecureWipe(*passphrase[0], passphrase.count)
    } else if operation == "backup_online" {
        passphrase: [1024]u8
        for index: 0..passphrase.count - 1 { passphrase[index] = provider.queue.request.value[index] }
        ProviderBackupOnline(provider, TextUntilNul(passphrase[:]))
        SecureWipe(*passphrase[0], passphrase.count)
    } else if operation == "backup_online_remove" {
        ProviderBackupOnlineRemove(provider)
    } else if operation == "sign_in_online" {
        ProviderOnlineSignIn(provider)
    } else if operation == "continue" {
        ProviderContinue(provider)
    } else if operation == "passkey_add" || operation == "passkey_sign_in" {
        ProviderPasskeyStart(provider, operation == "passkey_add")
    } else if operation == "passkey_remove" {
        ProviderPasskeyRemove(provider)
    } else if operation == "sign_in_methods" {
        provider.sign_in_message = .{}
        if !ProviderSignedRequest(provider, "GET", PASSKEY_PATH, "", 24) { ProviderBridgeFinish(provider, "ok", "") }
    } else if operation == "google_sign_in" || operation == "google_link" {
        ProviderGoogleStart(provider, operation == "google_link")
    } else if operation == "google_unlink" {
        if !ProviderSignedRequest(provider, "POST", SIGN_IN_GOOGLE_UNLINK_PATH, "", 26) {
            ProviderBridgeFinish(provider, "error", "Could not reach the node. Your account here is unchanged.")
        }
    } else if operation == "switch_apply" {
        ProviderApplyIncoming(provider, provider.queue.request.choice)
    } else if operation == "switch_cancel" {
        RecoveryClear(*provider.incoming)
        provider.has_incoming = false
        ProviderFinish(provider, "cancelled", "Account switch cancelled")
    } else if operation == "alias_quote" || operation == "alias_purchase" {
        ProviderStartAlias(provider, operation == "alias_purchase")
    } else if operation == "alias" || operation == "clear_remote" {
        ProviderStartNetwork(provider, operation == "clear_remote")
    } else {
        leaving: [65]u8
        if operation == "logout" {
            current := ProviderState(provider)
            leaving = current.public_id
        }
        result := ifx provider.action == null then 0 else provider.action(provider.context, *provider.queue.request)
        if result == 1 && leaving[0] != cast(u8)0 {
            ProviderBridgeSignOut(provider)
            ProviderSignOutClear(provider, TextUntilNul(leaving[:]))
        }
        if result == 1 { ProviderFinish(provider, "ok", "") }
        else if result == 2 { provider.delegated = true; return }
        else { ProviderFinish(provider, "error", "Could not complete this action") }
    }
}
