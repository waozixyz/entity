// An illustrated portrait with a small left/right turn. The same drawing is
// shared by Profile and the independent Avatar app.
#import "std/math"
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/session"
#import "kryon/shape_props"
#import "kryon/shape_widget"
#import "kryon/pointer_input"
#import "kryon/button_props"
#import "kryon/button_widget"
#import "kryon/control_props"
#import "kryon/app_context"

AvatarFace :: struct { a: Vector2; b: Vector2; c: Vector2; depth: float32; color: Color }
AvatarCamera :: struct {
    yaw: float32
    pitch: float32
    distance: float32
    dragging: bool
    x: float32
    y: float32
}
avatar_draw_count: s32;
avatar_portrait_scale: float32;
avatar_portrait_origin: Vector2;
avatar_portrait_yaw: float32;
avatar_portrait_bounds: Rectangle;
avatar_portrait_session: Session;
AvatarDefaultCamera :: () -> AvatarCamera { return AvatarCamera.{.yaw = 0.04, .distance = 2.6} }
avatar_camera: AvatarCamera = AvatarCamera.{.yaw = 0.04, .distance = 2.6};

AvatarClipEdge :: (points: []Vector2, count: s32, output: []Vector2, axis: s32, edge: float32, greater: bool) -> s32 {
    if count == 0 { return 0 }
    previous := points[count - 1]
    before := (ifx axis == 0 then previous.x else previous.y) - edge
    if !greater { before = -before }
    written: s32 = 0
    for index: cast(s32)0..count - 1 {
        current := points[index]
        after := (ifx axis == 0 then current.x else current.y) - edge
        if !greater { after = -after }
        if (before >= 0.0) != (after >= 0.0) {
            fraction := before / (before - after)
            output[written] = Vector2.{previous.x + (current.x - previous.x) * fraction,
                previous.y + (current.y - previous.y) * fraction}
            written += 1
        }
        if after >= 0.0 { output[written] = current; written += 1 }
        previous = current
        before = after
    }
    return written
}
AvatarPaintFace :: (session: Session, face: AvatarFace, bounds: Rectangle) {
    points: [8]Vector2
    clipped: [8]Vector2
    points[0] = face.a
    points[1] = face.b
    points[2] = face.c
    inside := true
    for index: cast(s32)0..2 {
        p := points[index]
        if p.x < bounds.x || p.x > bounds.x + bounds.width || p.y < bounds.y || p.y > bounds.y + bounds.height { inside = false }
    }
    count: s32 = 3
    if !inside {
        count = AvatarClipEdge(points[:], count, clipped[:], 0, bounds.x, true)
        count = AvatarClipEdge(clipped[:], count, points[:], 0, bounds.x + bounds.width, false)
        count = AvatarClipEdge(points[:], count, clipped[:], 1, bounds.y, true)
        count = AvatarClipEdge(clipped[:], count, points[:], 1, bounds.y + bounds.height, false)
    }
    if count < 3 { return }
    for index: cast(s32)1..count - 2 {
        Triangle(session, TriangleProps.{.key = cast(u64)(70000 + avatar_draw_count),
                .first = points[0], .second = points[index], .third = points[index + 1], .color = face.color})
        avatar_draw_count += 1
    }
}

AvatarSeamPoint :: (a: Vector2, b: Vector2, c: Vector2, padding: float32) -> Vector2 {
    if padding <= 0.0 { return a }
    u := Vector2.{b.x - a.x, b.y - a.y}
    v := Vector2.{c.x - a.x, c.y - a.y}
    area := u.x * v.y - u.y * v.x
    if area < 0.0 { area = -area }
    if area < 0.001 { return a }
    lu := cast(float32)Sqrt(cast(float64)(u.x * u.x + u.y * u.y))
    lv := cast(float32)Sqrt(cast(float64)(v.x * v.x + v.y * v.y))
    factor := padding * lu * lv / area
    dx := -(u.x / lu + v.x / lv) * factor
    dy := -(u.y / lu + v.y / lv) * factor
    maximum := dx
    if maximum < 0.0 { maximum = -maximum }
    if dy > maximum { maximum = dy }
    if -dy > maximum { maximum = -dy }
    if maximum > 16.0 { dx *= 16.0 / maximum; dy *= 16.0 / maximum }
    return Vector2.{a.x + dx, a.y + dy}
}
AvatarPortraitPoint :: (point: Vector2, depth: float32) -> Vector2 {
    turn := avatar_portrait_yaw
    magnitude := ifx turn < 0.0 then -turn else turn
    return Vector2.{avatar_portrait_origin.x + (point.x * (1.0 - magnitude * 0.12) + turn * depth) * avatar_portrait_scale,
        avatar_portrait_origin.y + point.y * avatar_portrait_scale}
}
AvatarPortraitTriangle :: (a: Vector2, b: Vector2, c: Vector2, color: Color, depth: float32) {
    first := AvatarPortraitPoint(a, depth)
    second := AvatarPortraitPoint(b, depth)
    third := AvatarPortraitPoint(c, depth)
    AvatarPaintFace(avatar_portrait_session, AvatarFace.{AvatarSeamPoint(first, second, third, 0.65),
            AvatarSeamPoint(second, third, first, 0.65), AvatarSeamPoint(third, first, second, 0.65), 0.0, color}, avatar_portrait_bounds)
}
AvatarPortraitCurve :: (a: Vector2, b: Vector2, c: Vector2, d: Vector2, t: float32) -> Vector2 {
    square := t * t
    cube := square * t
    return Vector2.{0.5 * (2.0 * b.x + (-a.x + c.x) * t + (2.0 * a.x - 5.0 * b.x + 4.0 * c.x - d.x) * square + (-a.x + 3.0 * b.x - 3.0 * c.x + d.x) * cube),
        0.5 * (2.0 * b.y + (-a.y + c.y) * t + (2.0 * a.y - 5.0 * b.y + 4.0 * c.y - d.y) * square + (-a.y + 3.0 * b.y - 3.0 * c.y + d.y) * cube)}
}
AvatarPortraitShape :: (center: Vector2, points: []Vector2, color: Color, depth: float32 = 0.0) {
    count := cast(s32)points.count
    for index: cast(s32)0..count - 1 {
        previous := points[index]
        for step: cast(s32)1..4 {
            next := AvatarPortraitCurve(points[(index + count - 1) % count], points[index],
                points[(index + 1) % count], points[(index + 2) % count], cast(float32)step / 4.0)
            AvatarPortraitTriangle(center, previous, next, color, depth)
            previous = next
        }
    }
}
AvatarPortraitOval :: (center: Vector2, radius: Vector2, color: Color, depth: float32 = 0.0) {
    segments := cast(s32)(radius.x * avatar_portrait_scale * 0.5)
    if segments < 12 { segments = 12 }
    if segments > 64 { segments = 64 }
    for index: cast(s32)0..segments - 1 {
        angle := cast(float64)index * 6.283185307179586 / cast(float64)segments
        next := cast(float64)(index + 1) * 6.283185307179586 / cast(float64)segments
        a := Vector2.{center.x + radius.x * cast(float32)Cos(angle), center.y + radius.y * cast(float32)Sin(angle)}
        b := Vector2.{center.x + radius.x * cast(float32)Cos(next), center.y + radius.y * cast(float32)Sin(next)}
        AvatarPortraitTriangle(center, a, b, color, depth)
    }
}
AvatarPortraitStroke :: (points: []Vector2, width: float32, color: Color, depth: float32 = 0.0) {
    for index: cast(s32)0..cast(s32)points.count - 2 {
        a := points[index]
        b := points[index + 1]
        dx := b.x - a.x
        dy := b.y - a.y
        length := cast(float32)Sqrt(cast(float64)(dx * dx + dy * dy))
        if length < 0.00001 { continue }
        x := -dy * width * 0.5 / length
        y := dx * width * 0.5 / length
        AvatarPortraitTriangle(Vector2.{a.x + x, a.y + y}, Vector2.{b.x + x, b.y + y}, Vector2.{b.x - x, b.y - y}, color, depth)
        AvatarPortraitTriangle(Vector2.{a.x + x, a.y + y}, Vector2.{b.x - x, b.y - y}, Vector2.{a.x - x, a.y - y}, color, depth)
    }
    for index: cast(s32)0..cast(s32)points.count - 1 {
        AvatarPortraitOval(points[index], Vector2.{width * 0.5, width * 0.5}, color, depth)
    }
}
AvatarDraw :: (session: Session, bounds: Rectangle, camera: AvatarCamera) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    avatar_portrait_session = session
    avatar_portrait_bounds = bounds
    fit := bounds.height / 1.12
    if bounds.width / 1.02 < fit { fit = bounds.width / 1.02 }
    avatar_portrait_scale = fit * 2.6 / camera.distance
    avatar_portrait_origin = Vector2.{bounds.x + bounds.width * 0.5,
        bounds.y + (bounds.height - avatar_portrait_scale * 1.12) * 0.5}
    avatar_portrait_yaw = camera.yaw
    if avatar_portrait_yaw < -0.24 { avatar_portrait_yaw = -0.24 }
    if avatar_portrait_yaw > 0.24 { avatar_portrait_yaw = 0.24 }
    avatar_draw_count = 0
    ink := Color.{54, 46, 42, 255}
    skin := Color.{232, 180, 143, 255}
    warm := Color.{197, 132, 99, 255}
    hair := Color.{64, 47, 39, 255}
    AvatarPortraitOval(Vector2.{0.0, 0.57}, Vector2.{0.425, 0.45}, Color.{215, 230, 222, 255})
    AvatarPortraitOval(Vector2.{0.0, 0.366}, Vector2.{0.211, 0.260}, hair, 0.03)
    AvatarPortraitOval(Vector2.{0.0, 0.666}, Vector2.{0.086, 0.134}, warm, 0.04)
    AvatarPortraitOval(Vector2.{0.0, 0.648}, Vector2.{0.075, 0.122}, skin, 0.05)
    shirt: [14]Vector2 = .[.{-0.438, 1.09}, .{-0.418, 0.902}, .{-0.354, 0.793}, .{-0.221, 0.729},
    .{-0.108, 0.699}, .{-0.067, 0.733}, .{0.0, 0.746}, .{0.068, 0.733}, .{0.108, 0.699},
    .{0.221, 0.729}, .{0.354, 0.793}, .{0.418, 0.902}, .{0.438, 1.09}, .{0.0, 1.10}];
    AvatarPortraitShape(Vector2.{0.0, 0.90}, shirt[:], Color.{46, 76, 91, 255}, 0.01)
    panel: [7]Vector2 = .[.{-0.355, 1.09}, .{-0.351, 0.836}, .{-0.209, 0.758}, .{-0.093, 0.746},
    .{0.013, 0.78}, .{0.026, 1.10}, .{-0.12, 1.10}];
    AvatarPortraitShape(Vector2.{-0.15, 0.94}, panel[:], Color.{64, 104, 117, 255}, 0.01)
    collar: [7]Vector2 = .[.{-0.108, 0.704}, .{-0.081, 0.733}, .{-0.042, 0.752}, .{0.0, 0.759},
    .{0.042, 0.752}, .{0.081, 0.733}, .{0.108, 0.704}];
    AvatarPortraitStroke(collar[:], 0.015, Color.{35, 63, 76, 255}, 0.05)
    for side: cast(s32)0..1 {
        sign: float32 = ifx side == 0 then -1.0 else 1.0
        AvatarPortraitOval(Vector2.{sign * 0.195, 0.418}, Vector2.{0.043, 0.065}, warm)
        AvatarPortraitOval(Vector2.{sign * 0.195, 0.415}, Vector2.{0.033, 0.052}, skin)
        AvatarPortraitOval(Vector2.{sign * 0.200, 0.423}, Vector2.{0.014, 0.029}, Color.{211, 148, 117, 255})
    }
    face: [22]Vector2 = .[.{0.0, 0.143}, .{0.095, 0.155}, .{0.160, 0.195}, .{0.188, 0.259},
    .{0.194, 0.333}, .{0.187, 0.417}, .{0.173, 0.490}, .{0.142, 0.550}, .{0.095, 0.598},
    .{0.045, 0.622}, .{0.0, 0.630}, .{-0.045, 0.622}, .{-0.095, 0.598}, .{-0.142, 0.550},
    .{-0.173, 0.490}, .{-0.187, 0.417}, .{-0.194, 0.333}, .{-0.188, 0.259},
    .{-0.160, 0.195}, .{-0.095, 0.155}, .{-0.045, 0.146}, .{-0.015, 0.143}];
    AvatarPortraitShape(Vector2.{0.0, 0.40}, face[:], skin, 0.06)
    AvatarPortraitOval(Vector2.{-0.105, 0.464}, Vector2.{0.043, 0.023}, Color.{224, 151, 126, 255}, 0.12)
    AvatarPortraitOval(Vector2.{0.105, 0.464}, Vector2.{0.043, 0.023}, Color.{224, 151, 126, 255}, 0.12)
    for side: cast(s32)0..1 {
        sign: float32 = ifx side == 0 then -1.0 else 1.0
        x := sign * 0.082
        AvatarPortraitOval(Vector2.{x, 0.379}, Vector2.{0.055, 0.030}, warm, 0.13)
        AvatarPortraitOval(Vector2.{x, 0.375}, Vector2.{0.050, 0.026}, Color.{255, 248, 232, 255}, 0.14)
        AvatarPortraitOval(Vector2.{x + 0.003, 0.375}, Vector2.{0.023, 0.025}, Color.{69, 100, 82, 255}, 0.15)
        AvatarPortraitOval(Vector2.{x + 0.003, 0.376}, Vector2.{0.011, 0.017}, ink, 0.16)
        AvatarPortraitOval(Vector2.{x - 0.004, 0.366}, Vector2.{0.006, 0.007}, Color.{255, 253, 240, 255}, 0.17)
        lid: [5]Vector2 = .[.{x - 0.049, 0.370}, .{x - 0.027, 0.351}, .{x, 0.347}, .{x + 0.027, 0.351}, .{x + 0.049, 0.370}];
        AvatarPortraitStroke(lid[:], 0.005, hair, 0.15)
        lift: float32 = ifx side == 0 then -0.004 else 0.002
        brow: [5]Vector2 = .[.{x - 0.050, 0.318 + lift}, .{x - 0.025, 0.306 + lift},
        .{x + 0.002, 0.305 + lift}, .{x + 0.028, 0.310 + lift}, .{x + 0.047, 0.319 + lift}];
        AvatarPortraitStroke(brow[:], 0.012, hair, 0.13)
        for freckle: cast(s32)0..2 {
            AvatarPortraitOval(Vector2.{sign * (0.095 + cast(float32)freckle * 0.015),
                    0.446 + (ifx freckle == 1 then -0.006 else 0.0)}, Vector2.{0.0025, 0.0025}, Color.{173, 114, 88, 255}, 0.13)
        }
    }
    nose: [5]Vector2 = .[.{0.007, 0.397}, .{0.008, 0.431}, .{0.017, 0.456}, .{0.004, 0.466}, .{-0.012, 0.464}];
    AvatarPortraitStroke(nose[:], 0.005, Color.{190, 124, 93, 255}, 0.18)
    smile: [7]Vector2 = .[.{-0.059, 0.515}, .{-0.041, 0.525}, .{-0.020, 0.532}, .{0.004, 0.534},
    .{0.027, 0.528}, .{0.047, 0.518}, .{0.060, 0.506}];
    AvatarPortraitStroke(smile[:], 0.007, Color.{139, 76, 67, 255}, 0.14)
    lip: [3]Vector2 = .[.{-0.020, 0.547}, .{0.004, 0.550}, .{0.028, 0.544}];
    AvatarPortraitStroke(lip[:], 0.005, Color.{241, 191, 157, 255}, 0.14)
    fringe: [18]Vector2 = .[.{-0.195, 0.316}, .{-0.207, 0.242}, .{-0.182, 0.171}, .{-0.135, 0.127},
    .{-0.070, 0.107}, .{0.008, 0.112}, .{0.055, 0.100}, .{0.128, 0.128}, .{0.181, 0.178},
    .{0.202, 0.240}, .{0.183, 0.304}, .{0.155, 0.270}, .{0.120, 0.236}, .{0.067, 0.231},
    .{0.017, 0.245}, .{-0.039, 0.231}, .{-0.091, 0.226}, .{-0.143, 0.262}];
    AvatarPortraitShape(Vector2.{0.0, 0.181}, fringe[:], hair, 0.075)
    sweep: [6]Vector2 = .[.{-0.146, 0.193}, .{-0.104, 0.156}, .{-0.045, 0.139}, .{0.019, 0.142}, .{0.067, 0.130}, .{0.110, 0.151}];
    AvatarPortraitStroke(sweep[:], 0.012, Color.{96, 69, 49, 255}, 0.08)
}
AvatarInteract :: (bounds: Rectangle) {
    pointer := SamplePointer()
    if pointer.pressed && pointer.x >= bounds.x && pointer.x < bounds.x + bounds.width &&
    pointer.y >= bounds.y && pointer.y < bounds.y + bounds.height {
        avatar_camera.dragging = true
        avatar_camera.x = pointer.x
        avatar_camera.y = pointer.y
    }
    if !pointer.down { avatar_camera.dragging = false }
    if avatar_camera.dragging {
        avatar_camera.yaw += (pointer.x - avatar_camera.x) * 0.003
        avatar_camera.x = pointer.x
        avatar_camera.y = pointer.y
    }
    if AppKey() == 262 { avatar_camera.yaw += 0.03 }
    if AppKey() == 263 { avatar_camera.yaw -= 0.03 }
    if avatar_camera.yaw < -0.24 { avatar_camera.yaw = -0.24 }
    if avatar_camera.yaw > 0.24 { avatar_camera.yaw = 0.24 }
    avatar_camera.pitch = 0.0
}
AvatarControls :: (session: Session, bounds: Rectangle, reset: string) {
    third := (bounds.width - 16.0) / 3.0
    labels: [3]string = .["−", "+", reset]
    for index: cast(s32)0..2 {
        if Button(session, ButtonProps.{.key = cast(u64)(74000 + index), .id = 74000 + index,
                .bounds = Rectangle.{bounds.x + cast(float32)index * (third + 8.0), bounds.y, third, bounds.height},
                .label = labels[index]}) != 0 {
            if index == 0 { avatar_camera.distance += 0.2 }
            if index == 1 { avatar_camera.distance -= 0.2 }
            if index == 2 { avatar_camera = AvatarDefaultCamera() }
            if avatar_camera.distance < 2.2 { avatar_camera.distance = 2.2 }
            if avatar_camera.distance > 3.6 { avatar_camera.distance = 3.6 }
        }
    }
}
