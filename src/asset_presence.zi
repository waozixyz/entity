// Optional imagery is available only when present in this actual bundle.
// Never infer availability from old extracted files in an account folder.
#import "std/bundle_host"
#import "std/byte_text_linux"

// Native extraction and hosted image access must agree on this exact set.
// Game thumbnails are optional, but may be used when the bundle contains them.
ENTITY_PROFILE_ASSET_COUNT :: 17
EntityProfileAssetAt :: (index: s32) -> string {
    names: [17]string = .[
    "assets/entity/pfp.webp", "assets/entity/flowers.webp",
    "assets/entity/abstract-jade.webp", "assets/entity/abstract-amber.webp", "assets/entity/abstract-violet.webp",
    "assets/entity/wurm-special-skins.webp", "assets/entity/wurm-skins.webp",
    "assets/entity/wurm-reward-skins.webp", "assets/entity/wurm-base.webp",
    "assets/entity/shovey-0.png", "assets/entity/shovey-1.png", "assets/entity/shovey-2.png",
    "assets/entity/shovey-3.png", "assets/entity/shovey-4.png", "assets/entity/shovey-5.png",
    "assets/entity/shovey-6.png", "assets/entity/shovey-7.png"]
    if index < 0 || index >= names.count { return "" }
    return names[index]
}

EntityProfileAssetName :: (path: string) -> bool {
    for index: cast(s32)0..ENTITY_PROFILE_ASSET_COUNT - 1 {
        if path == EntityProfileAssetAt(index) { return true }
    }
    return false
}

EntityAssetPathValid :: (path: string) -> bool {
    if path.count <= 14 || path[:14] != "assets/entity/" { return false }
    for index: cast(s64)14..path.count - 1 {
        byte := path[index]
        if byte == cast(u8)47 || byte == cast(u8)92 || byte == cast(u8)0 { return false }
        if byte == cast(u8)46 && index + 1 < path.count && path[index + 1] == cast(u8)46 { return false }
    }
    return true
}

EntityAssetPresent :: (bundle: *void, path: string) -> bool {
    if bundle == null || !EntityAssetPathValid(path) { return false }
    count := BundleAssets(bundle)
    if count == 0 { return false }
    for index: cast(u64)0..count - 1 {
        if path == TextFromCString(BundleAssetPath(bundle, index)) && BundleAssetLength(bundle, index) > 0 { return true }
    }
    return false
}
