// Standalone Entity keeps its own private account key. Common preferences are
// shared only through the verified account's public profile directory.
#import "model"
#import "management"
#import "native_management"
#import "native_files"
#import "recovery"
#import "pairing"
#import "pairing_client"
#import "daochi_client/keys"
#import "daochi_client/crypto"
#import "daochi_client/client"
Auth :: #import "daochi_client/auth";
#import "std/c_string"
#import "std/text_buffer"
#import "std/vec"
#import "std/byte_text_linux"
#import "std/file"
#import "std/date_time_linux"
#import "std/net_http"
#import "daochi_client/async_client"
#import "kryon/http_transfer"
#if #defined(PLATFORM_WEB) {
    #import "kryon/file_picker"
    #import "kryon/page_files"
    #import "kryon/bundle_storage_web"
    #import "std/web"
}
#if #defined(_WIN32) {
    // Windows shows its common file dialog.
    #import "kryon/file_picker"
}
#if !#defined(ANDROID_BUILD) && !#defined(PLATFORM_WEB) && !#defined(_WIN32) {
    Dialog :: #import "file_dialog_linux";
}
#if #defined(ANDROID_BUILD) {
    // Android's document pickers answer later, through the activity.
    #import "kryon/android_picker"
}

account_profile: EntityState;
account_recovery: Recovery;
account_provider: ManagementProvider;
account_alias: [40]u8;
alias_owner: [65]u8;
alias_node: [512]u8;
alias_pending: PendingRequest;
alias_session: Auth.Session;
alias_transfer: HttpTransfer;
alias_active: bool;
alias_next: s64;
alias_sequence: s32;
picture_pending: PendingRequest;
picture_session: Auth.Session;
picture_transfer: HttpTransfer;
picture_active: bool;
picture_dirty: bool;
picture_remote: bool;
picture_sequence: s32;
picture_sending: s32;
picture_next: s64;
picture_body: [256]u8;
picture_response: [1024]u8;
account_pairing_delivered: bool;
account_standalone_ready: bool;
account_root: [4096]u8;
account_client_id: [64]u8;
// Why the stored account could not be used, shown in the Profile.
account_store_problem: [192]u8;
account_application_id: [64]u8;
// What the account's node last reported, for the node list.
account_node_connected: bool;
account_node_used: s64;
account_node_limit: s64;
ACCOUNT_PICKER_REQUEST :: 7401
account_picker_open: bool;
account_picker_save: bool;
// 0 waiting, 1 chosen, 2 cancelled, 3 failed.
account_picker_result: s32;
account_picker_path: [512]u8;
// The private copy of an opened key file, removed once it has been read.
account_picker_copy: [512]u8;

AccountStorePath :: (name: string, output: []u8) -> string {
    return NativeJoin(output, TextUntilNul(account_root[:]), name)
}
AccountStoreChooseFile :: (context: *void, save: bool, output: []u8) -> s32 {
    #if #defined(PLATFORM_WEB) || #defined(_WIN32) {
        return PickFile(FilePickerProps.{.title = ifx save then "Back up account key" else "Import account key",
                .filter = "Account keys | *.key *.json", .suggested_name = "entity-account.key", .save = save}, output)
    } else #if #defined(ANDROID_BUILD) {
        if account_picker_result != 0 {
            result := account_picker_result
            account_picker_result = 0
            if result != 1 { return ifx result == 2 then 0 else -1 }
            if !save { account_picker_copy = account_picker_path }
            return ifx CopyCString(TextUntilNul(account_picker_path[:]), output) then 1 else -1
        }
        opened := false
        if save {
            opened = AndroidSavePickerOpen(ACCOUNT_PICKER_REQUEST, "entity-account.key", "application/octet-stream")
        } else {
            opened = AndroidPickerOpen(ACCOUNT_PICKER_REQUEST, "*/*")
        }
        if !opened { return -1 }
        account_picker_open = true
        account_picker_save = save
        return 2
    } else {
        patterns: [2]string = .["*.key", "*.json"]
        props := Dialog.FileDialogProps.{.title = ifx save then "Back up account key" else "Import account key",
            .filename = ifx save then "entity-account.key" else "", .save = save,
            .filter_name = "Account keys", .patterns = patterns[:]}
        selected := Dialog.FileDialog(props, output)
        if !selected.available { return -1 }
        return ifx selected.accepted then 1 else 0
    }
}
AccountStoreDeliverFile :: (context: *void, path: string) -> bool {
    #if #defined(PLATFORM_WEB) {
        scope := WebScope()
        defer WebEnd(scope)
        data := WebCall1(PageFileSystem(), WebName("readFile"), WebText(path))
        parts := WebNewArray()
        unused WebCall1(parts, WebName("push"), data)
        blob := WebNew1(WebGetObject(WebGlobal, WebName("Blob")), WebObject(parts))
        urls := WebGetObject(WebGlobal, WebName("URL"))
        url := WebCall1(urls, WebName("createObjectURL"), WebObject(blob))
        document := WebGetObject(WebGlobal, WebName("document"))
        anchor := WebAsObject(WebCall1(document, WebName("createElement"), WebText("a")))
        WebSet(anchor, WebName("href"), url)
        WebSet(anchor, WebName("download"), WebText("entity-account.key"))
        unused WebCall0(anchor, WebName("click"))
        unused WebCall1(urls, WebName("revokeObjectURL"), url)
        unused RemoveFile(path)
        return !WebFailed()
    } else #if #defined(ANDROID_BUILD) {
        // The backup was written to the picker's staging file.
        return AndroidSavePickerCommit(path)
    } else {
        return true
    }
}

// Every waozi.xyz site shares one sign-in. account.waozi.xyz keeps the key;
// the page's share.js reads it into Module.sharedAccountKey before the app
// starts and passes changes on through Module.shareAccount(key, owner, only_if_empty).
// Other hosts have no shared sign-in.
AccountStoreSharedKey :: (output: []u8) -> string {
    #if #defined(PLATFORM_WEB) {
        scope := WebScope()
        defer WebEnd(scope)
        module := WebGetObject(WebGlobal, WebName("Module"))
        if module == 0 || WebFailed() { return "" }
        handle := WebAsObject(WebGet(module, WebName("sharedAccountKey")))
        if handle == 0 || WebFailed() || WebTypeOf(handle) != WebTypeString { return "" }
        length := WebCopyString(handle, output)
        if length <= 0 || length >= cast(s32)output.count { return "" }
        output[length] = cast(u8)0
        return TextUntilNul(output)
    }
    return ""
}
AccountStoreShare :: (key: string, owner: string, only_if_empty: bool) {
    #if #defined(PLATFORM_WEB) {
        scope := WebScope()
        defer WebEnd(scope)
        module := WebGetObject(WebGlobal, WebName("Module"))
        if module == 0 || WebFailed() || WebTypeOf(WebGetObject(module, WebName("shareAccount"))) != WebTypeFunction { return }
        unused WebCall3(module, WebName("shareAccount"), WebText(key), WebText(owner), WebBool(only_if_empty))
    }
}

AccountStorePersist :: () -> bool {
    #if #defined(PLATFORM_WEB) {
        return BundleStorageFlush()
    }
    return true
}

AccountStoreSaveKey :: (recovery: *Recovery) -> bool {
    text: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    defer { SecureWipe(*text[0], text.count) }
    path: [4096]u8
    if !RecoveryEncode(recovery, "", text[:]) || !NativeWrite(AccountStorePath("account.key", path[:]), TextUntilNul(text[:])) ||
    !AccountStorePersist() { return false }
    // A sign-in here signs in the other waozi.xyz sites too.
    AccountStoreShare(TextUntilNul(text[:]), TextUntilNul(recovery.keys.public_id[:]), false)
    return true
}
AccountStoreSaveProfile :: (state: EntityState) -> bool {
    if TextUntilNul(state.owner_id[:]) != TextUntilNul(account_recovery.keys.public_id[:]) { return false }
    document := EntityEncode(state)
    defer { EntityFree(document) }
    path: [4096]u8
    if !NativeWrite(AccountStorePath("entity.json", path[:]), document) { return false }
    if !SharedProfileSave(TextUntilNul(state.owner_id[:]), state) { return false }
    if !AccountStorePersist() { return false }
    if !picture_remote && state.picture_kind == 0 && state.picture != account_profile.picture {
        pending_path: [4096]u8
        if !NativeWrite(AccountStorePicturePath(pending_path[:]), "pending") { return false }
        picture_dirty = true
        picture_sequence += 1
        picture_next = 0
    }
    account_profile = state
    return true
}
AccountStoreAliasPath :: (output: []u8) -> string {
    owner := TextUntilNul(account_recovery.keys.public_id[:])
    if !NativeAccountId(owner) { return "" }
    name: Vec(u8)
    BuilderPrint(*name, "alias.%.txt", owner)
    filename := BuilderFinish(name)
    defer { EntityFree(filename) }
    return AccountStorePath(filename, output)
}
AccountStorePicturePath :: (output: []u8) -> string {
    owner := TextUntilNul(account_recovery.keys.public_id[:])
    name: Vec(u8)
    BuilderPrint(*name, "picture.%.pending", owner)
    filename := BuilderFinish(name)
    defer { EntityFree(filename) }
    return AccountStorePath(filename, output)
}
AccountStoreReadAlias :: () {
    account_alias = .{}
    path: [4096]u8
    text: [40]u8
    if NativeRead(AccountStoreAliasPath(path[:]), text[:]) > 0 && ProviderAliasValid(TextUntilNul(text[:])) { account_alias = text }
}

AliasStart :: (context: *void, request: HttpRequest, output: []u8) -> bool {
    return HttpTransferStart(*alias_transfer, request, output, 15000)
}
AliasPoll :: (context: *void, status: *s32) -> s32 { return HttpTransferPoll(*alias_transfer, status) }
AliasCancel :: (context: *void) { HttpTransferCancel(*alias_transfer) }

// Login already returns the node's public alias. Keep that answer with the
// same verified account, rather than relying on a file from this device.
AccountStoreAliasPump :: () {
    owner_bytes: [65]u8
    node_bytes: [256]u8
    for index: 0..64 { owner_bytes[index] = account_recovery.keys.public_id[index] }
    for index: 0..255 { node_bytes[index] = account_profile.nodes[account_profile.preferred][index] }
    owner := TextUntilNul(owner_bytes[:])
    node := TextUntilNul(node_bytes[:])
    if owner != TextUntilNul(alias_owner[:]) || node != TextUntilNul(alias_node[:]) {
        CancelRequest(*alias_pending)
        HttpTransferCancel(*alias_transfer)
        alias_owner = account_recovery.keys.public_id
        unused CopyCString(node, alias_node[:])
        alias_active = false
        alias_next = 0
        CancelRequest(*picture_pending)
        HttpTransferCancel(*picture_transfer)
        picture_active = false
        pending_path: [4096]u8
        picture_dirty = PathExists(AccountStorePicturePath(pending_path[:]))
        picture_next = 0
    }
    if !account_standalone_ready { return }
    now := UnixNow()
    if alias_active {
        if !PollRequest(*alias_pending) { return }
        alias_active = false
        alias_next = now + 60
        // A completed local rename takes precedence over an older login.
        if alias_pending.result == cast(Auth.AuthResult)Auth.AuthResult.AUTH_OK && alias_session.account_alias_known &&
        alias_sequence == account_provider.queue.sequence && !account_provider.queue.pending {
            value := TextUntilNul(alias_session.account_alias[:])
            if value == "" || ProviderAliasValid(value) {
                path: [4096]u8
                if NativeWrite(AccountStoreAliasPath(path[:]), value) {
                    account_alias = alias_session.account_alias
                    unused AccountStorePersist()
                }
            }
        }
        if alias_pending.result == cast(Auth.AuthResult)Auth.AuthResult.AUTH_OK && alias_session.profile_icon_known &&
        !picture_dirty && !picture_active {
            icon := alias_session.profile_icon
            choice: s32 = -1
            if icon >= 41 && icon <= 65 { choice = cast(s32)icon - 41 }
            if icon >= 124 && icon <= 126 { choice = cast(s32)icon - 124 + 25 }
            if choice >= 0 && account_profile.picture_kind == 0 && choice != account_profile.picture {
                state := account_profile
                state.picture = choice
                picture_remote = true
                unused AccountStoreSaveProfile(state)
                picture_remote = false
            }
        }
        return
    }
    if now < alias_next || account_provider.queue.pending || account_provider.asynchronous { return }
    client: Client
    if !AccountStoreClient(null, *client) { return }
    alias_session = .{}
    alias_sequence = account_provider.queue.sequence
    transport := AsyncTransport.{.start = AliasStart, .poll = AliasPoll, .cancel = AliasCancel}
    alias_active = BeginSession(*alias_pending, client, *alias_session, now, transport)
    if !alias_active { alias_next = now + 60 }
}

PictureStart :: (context: *void, request: HttpRequest, output: []u8) -> bool {
    return HttpTransferStart(*picture_transfer, request, output, 15000)
}
PicturePoll :: (context: *void, status: *s32) -> s32 { return HttpTransferPoll(*picture_transfer, status) }
PictureCancel :: (context: *void) { HttpTransferCancel(*picture_transfer) }
AccountStorePicturePump :: () {
    if !account_standalone_ready { return }
    now := UnixNow()
    if picture_active {
        if !PollRequest(*picture_pending) { return }
        picture_active = false
        if picture_pending.result == cast(Auth.AuthResult)Auth.AuthResult.AUTH_OK && picture_pending.status == 200 && picture_sending == picture_sequence {
            picture_dirty = false
            pending_path: [4096]u8
            unused RemoveFile(AccountStorePicturePath(pending_path[:]))
            unused AccountStorePersist()
        }
        picture_next = now + 30
        return
    }
    if !picture_dirty || alias_active || now < picture_next || account_provider.queue.pending { return }
    client: Client
    if !AccountStoreClient(null, *client) { return }
    icon := ifx account_profile.picture < 25 then account_profile.picture + 41 else account_profile.picture - 25 + 124
    out: Vec(u8)
    BuilderPrint(*out, "{\"user_id_hash\":\"%\",\"profile_icon\":%}", TextUntilNul(account_recovery.keys.public_id[:]), icon)
    document := BuilderFinish(out)
    unused CopyCString(document, picture_body[:])
    EntityFree(document)
    headers: [1]HttpHeader
    transport := AsyncTransport.{.start = PictureStart, .poll = PicturePoll, .cancel = PictureCancel}
    picture_sending = picture_sequence
    picture_active = BeginRequest(*picture_pending, client, *picture_session, now, transport, "POST", "/api/v1/account/profile-icon", TextUntilNul(picture_body[:]), picture_response[:], headers[:0])
    if !picture_active { picture_next = now + 30 }
}
AccountStoreLoad :: (context: *void, output: *Recovery) -> bool {
    if !account_standalone_ready { return false }
    output.* = account_recovery
    return true
}
AccountStoreServer :: (context: *void, output: []u8) -> bool {
    return CopyCString(TextUntilNul(account_profile.nodes[account_profile.preferred][:]), output)
}
AccountStoreSnapshot :: (context: *void, output: *Management) {
    output.available = true
    output.account = account_standalone_ready
    output.public_id = account_recovery.keys.public_id
    output.alias = account_alias
    output.capabilities = ACCOUNT_CREATE | ACCOUNT_IMPORT | ACCOUNT_SWITCH | ACCOUNT_LINK
    // Hosts with a clipboard hand the provider their paste.
    if account_provider.paste != null { output.capabilities |= ACCOUNT_PASTE }
    if account_standalone_ready { output.capabilities |= ACCOUNT_BACKUP | ACCOUNT_ALIAS | ACCOUNT_LOGOUT | ACCOUNT_CLEAR_REMOTE }
    output.node_count = account_profile.node_count
    for index: 0..output.node_count - 1 {
        output.nodes[index].address = account_profile.nodes[index]
        // Connected only once the node has answered for this account; no
        // sync or quota is claimed before then.
        if account_standalone_ready && account_node_connected && index == account_profile.preferred {
            output.nodes[index].active = true
            output.nodes[index].known = account_node_limit > 0
            output.nodes[index].used = account_node_used
            output.nodes[index].limit = account_node_limit
        }
    }
    status := ifx account_standalone_ready then "Account connected on this device" else "Connect an account to share your profile"
    if account_store_problem[0] != cast(u8)0 && !account_standalone_ready { status = TextUntilNul(account_store_problem[:]) }
    unused CopyCString(status, output.status[:])
    output.link_stage = cast(s32)device_link.stage
    unused CopyCString(DeviceLinkCodeShown(), output.link_code[:])
    if output.link_stage == 2 || output.link_stage == 3 {
        digits: Vec(u8)
        BuilderPrint(*digits, "Compare this number on both devices: %", device_link.confirmation)
        message := BuilderFinish(digits)
        unused CopyCString(message, output.link_message[:])
        EntityFree(message)
    } else if output.link_stage == 4 {
        unused CopyCString("Send this device your account key?", output.link_message[:])
    } else if output.link_stage == 7 {
        unused CopyCString("The connection could not finish. Start a new code to try again.", output.link_message[:])
    }
}
AccountStoreApply :: (context: *void, recovery: *Recovery, choice: s32) -> s32 {
    id := TextUntilNul(recovery.keys.public_id[:])
    same := id == TextUntilNul(account_recovery.keys.public_id[:])
    local_data := account_profile.name[0] != cast(u8)0 || account_profile.intention[0] != cast(u8)0
    if !same && local_data && choice == 0 { return 2 }
    previous := account_recovery
    defer { RecoveryClear(*previous) }
    next := EntityDefault()
    if same || choice == 1 { next = account_profile }
    if !same && TextUntilNul(account_provider.queue.request.operation[:]) == "create" {
        next.picture = EntityInitialPicture(id,next.pictures)
        next.picture_kind = 0
    }
    unused CopyCString(id, next.owner_id[:])
    unused SharedProfileLoad(id, *next)
    candidate := recovery.*
    defer { RecoveryClear(*candidate) }
    if same && candidate.context[0] == cast(u8)0 { candidate.context = account_recovery.context }
    if !AccountStoreSaveKey(*candidate) {
        if previous.keys.public_id[0] != cast(u8)0 { unused AccountStoreSaveKey(*previous) }
        else { path: [4096]u8; unused RemoveFile(AccountStorePath("account.key", path[:])); unused AccountStorePersist() }
        return 0
    }
    account_recovery = candidate
    if !AccountStoreSaveProfile(next) {
        account_recovery = previous
        if previous.keys.public_id[0] != cast(u8)0 { unused AccountStoreSaveKey(*previous) }
        else { path: [4096]u8; unused RemoveFile(AccountStorePath("account.key", path[:])) }
        return 0
    }
    account_standalone_ready = true
    AccountStoreReadAlias()
    return 1
}
AccountStoreDigest :: (body: string, output: []u8) -> bool {
    if output.count < 65 { return false }
    descriptor := cast(*TextDescriptor)(*body)
    Sha256Hex(descriptor.data, body.count, *output[0])
    return true
}
AccountStoreClient :: (context: *void, output: *Client) -> bool {
    if !account_standalone_ready { return false }
    output.server_url = TextUntilNul(account_profile.nodes[account_profile.preferred][:])
    output.app_id = TextUntilNul(account_application_id[:])
    output.identity = Auth.Identity.{.account_id = TextUntilNul(account_recovery.keys.public_id[:]),
        .public_key = TextUntilNul(account_recovery.keys.public_key_hex[:]), .client_id = TextUntilNul(account_client_id[:]),
        .signing_context = cast(*void)*account_recovery.keys}
    output.digest = AccountStoreDigest
    output.signer = SignAccountMessage
    return true
}
AccountStoreAction :: (context: *void, request: *ManagementRequest) -> s32 {
    operation := TextUntilNul(request.operation[:])
    if operation == "logout" || operation == "remote_cleared" {
        path: [4096]u8
        address := AccountStorePath("account.key", path[:])
        if PathExists(address) && !RemoveFile(address) { return 0 }
        // Logging out here logs this account out of the shared sign-in too.
        AccountStoreShare("", TextUntilNul(account_recovery.keys.public_id[:]), false)
        DeviceLinkCancel()
        RecoveryClear(*account_recovery)
        account_standalone_ready = false
        account_alias = .{}
        account_profile.owner_id = .{}
        return ifx AccountStoreSaveProfile(account_profile) then 1 else 0
    }
    if operation == "alias_saved" {
        path: [4096]u8
        alias := TextUntilNul(request.value[:])
        if !ProviderAliasValid(alias) || !NativeWrite(AccountStoreAliasPath(path[:]), alias) { return 0 }
        unused CopyCString(alias, account_alias[:])
        return 1
    }
    if operation == "link_show" { account_pairing_delivered = false; return ifx DeviceLinkShow() then 1 else 0 }
    if operation == "link_join" { account_pairing_delivered = false; return ifx DeviceLinkScan(TextUntilNul(request.value[:])) then 1 else 0 }
    if operation == "link_confirm" { DeviceLinkAccept(); return 1 }
    if operation == "link_cancel" { DeviceLinkCancel(); return 1 }
    return 0
}
AccountStoreStart :: () -> bool {
    root: [4096]u8
    return AccountStoreStartAt(NativeRoot(root[:]), "entity")
}

// Every standalone host owns its account files. Nested apps use that host's
// provider; they never open another credential store.
AccountStoreStartAt :: (root: string, client_id: string) -> bool {
    if root == "" || client_id == "" || !CopyCString(root, account_root[:]) ||
    !CopyCString(client_id, account_application_id[:]) || !NativeDirectory(root) { return false }
    // The node requires an installation ID of at least eight characters.
    // Product names such as arcade/entity are app IDs, not device IDs.
    client_path: [4096]u8
    account_client_id = .{}
    if NativeRead(AccountStorePath("client.id", client_path[:]), account_client_id[:]) != 32 {
        random: [16]u8
        if SecureRandom(*random[0], random.count) == 0 { return false }
        BytesToHex(*random[0], random.count, *account_client_id[0], account_client_id.count)
        if !NativeWrite(AccountStorePath("client.id", client_path[:]), TextUntilNul(account_client_id[:])) { return false }
    }
    account_profile = EntityDefault()
    path: [4096]u8
    text: [ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE]u8
    defer { SecureWipe(*text[0], text.count) }
    account_store_problem = .{}
    if NativeRead(AccountStorePath("account.key", path[:]), text[:]) <= 0 {
        // No account on this site yet: use the one signed in on another
        // waozi.xyz site, if there is one.
        shared := AccountStoreSharedKey(text[:])
        if shared != "" && RecoveryDecode(shared, "", *account_recovery) &&
        NativeWrite(AccountStorePath("account.key", path[:]), shared) {
            unused AccountStorePersist()
            account_standalone_ready = true
        } else {
            account_recovery = Recovery.{}
        }
    } else {
        if RecoveryDecode(TextUntilNul(text[:]), "", *account_recovery) {
            account_standalone_ready = true
            // An account signed in before sign-ins were shared reaches the
            // other sites, unless one of them already shares another.
            AccountStoreShare(TextUntilNul(text[:]), TextUntilNul(account_recovery.keys.public_id[:]), true)
        } else {
            // An unreadable key never keeps the Profile closed: it is set
            // aside, never deleted, and the Profile says so.
            aside: [4096]u8
            if NativeWrite(AccountStorePath("account.key.unreadable", aside[:]), TextUntilNul(text[:])) {
                unused RemoveFile(AccountStorePath("account.key", path[:]))
            }
            account_recovery = Recovery.{}
            unused CopyCString("The account key saved here could not be read. It was kept as account.key.unreadable; sign in again to continue.", account_store_problem[:])
        }
    }
    if NativeRead(AccountStorePath("entity.json", path[:]), text[:]) > 0 {
        // Unreadable display preferences fall back to the defaults.
        loaded: EntityState
        if EntityDecode(TextUntilNul(text[:]), *loaded) &&
        TextUntilNul(loaded.owner_id[:]) == TextUntilNul(account_recovery.keys.public_id[:]) { account_profile = loaded }
    }
    unused CopyCString(TextUntilNul(account_recovery.keys.public_id[:]), account_profile.owner_id[:])
    unused SharedProfileLoad(TextUntilNul(account_recovery.keys.public_id[:]), *account_profile)
    account_provider = ManagementProvider.{.snapshot = AccountStoreSnapshot, .load = AccountStoreLoad,
        .apply = AccountStoreApply, .action = AccountStoreAction, .client = AccountStoreClient, .choose_file = AccountStoreChooseFile,
        .deliver_file = AccountStoreDeliverFile}
    AccountStoreReadAlias()
    pairing_load = AccountStoreLoad
    pairing_server = AccountStoreServer
    return true
}
AccountStorePump :: () {
    AccountStoreAliasPump()
    AccountStorePicturePump()
    #if #defined(ANDROID_BUILD) {
        if account_picker_open {
            path: [512]u8
            answer := AndroidPickerPoll(ACCOUNT_PICKER_REQUEST, path[:])
            if answer != AndroidPickerResult.AndroidPickerNone {
                account_picker_open = false
                account_picker_path = path
                account_picker_result = 1
                if path[0] == cast(u8)0 { account_picker_result = 3 }
                if answer == AndroidPickerResult.AndroidPickerCancelled { account_picker_result = 2 }
                // The import or backup resumes with the answer.
                account_provider.delegated = false
            }
        }
    }
    ProviderPump(*account_provider)
    #if #defined(ANDROID_BUILD) {
        if account_picker_copy[0] != cast(u8)0 && !account_provider.delegated {
            unused RemoveFile(TextUntilNul(account_picker_copy[:]))
            account_picker_copy = .{}
        }
    }
    DeviceLinkPump()
    if cast(s32)device_link.stage == 8 && !account_pairing_delivered {
        account_provider.incoming.keys = device_link_pending.account
        account_provider.incoming.context = device_link_pending.context
        account_provider.incoming_owner = account_recovery.keys.public_id
        account_provider.has_incoming = true
        account_pairing_delivered = true
        // Completion is attached to the originating pairing intent, and a
        // new identity still requires the same merge/replace choice.
        ProviderApplyIncoming(*account_provider, 0)
        DeviceLinkImported()
    }
}
