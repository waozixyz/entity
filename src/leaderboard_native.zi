// Game reports are accepted only with a verified host-supplied identity.
// Installed membership stays with the host; retained scores never install apps.
#import "leaderboard_model"
#import "account_store"
#import "recovery"
#import "daochi_client/keys"
#import "daochi_client/crypto"
#import "native_files"
#import "std/number_text"
#import "std/byte_text_linux"
#import "std/date_time_linux"
#import "std/net_http"
#import "std/json_scan"
#import "std/c_string"
#import "std/text_buffer"
#import "std/vec"
#import "model"
#import "daochi_client/client"
#import "daochi_client/async_client"
#import "daochi_client/social"
Auth :: #import "daochi_client/auth";
#import "kryon/http_transfer"

LeaderboardInstalled :: #type (game: string) -> bool;
leaderboard_installed: LeaderboardInstalled;
leaderboard_transport: AsyncTransport;

NativeGameScore :: struct {
    board: ProfileBoard
    value: s64
    // A run board, such as Apfelwurm's, ranks the best run's score and shows
    // the level that run reached beside it; other boards count levels solved.
    run: bool
    level: s64
    appearance: s32
}

native_scores: [LEADERBOARD_BOARDS]NativeGameScore;
native_score_count: s32;
native_leaderboard_owner: [97]u8;
native_leaderboard_node: [256]u8;
native_leaderboard_page: ProfileLeaderboard;
native_leaderboard_selected: [65]u8;
native_leaderboard_requested: bool;
native_leaderboard_loaded: bool;
native_leaderboard_error: bool;
native_leaderboard_stage: s32;
native_leaderboard_pending: PendingRequest;
native_leaderboard_session: Auth.Session;
native_leaderboard_transfer: HttpTransfer;
native_leaderboard_response: [16384]u8;
native_leaderboard_stats: [16384]u8;
native_leaderboard_friends: [16384]u8;
// A run board's second column: every friend's best level.
native_leaderboard_levels: [16384]u8;
// 0 ranks the first column, 1 the second (a run board's level).
native_leaderboard_metric: s32;
native_leaderboard_body: string;
native_leaderboard_path: [768]u8;
native_leaderboard_answer: string;
native_leaderboard_rows: [LEADERBOARD_ROWS]ProfileRank;
native_leaderboard_row_count: s32;
native_leaderboard_rows_dirty: bool = true;

NativeBoardLabels :: (score: *NativeGameScore) {
    score.board.primary = .{}
    score.board.average = .{}
    unused CopyCString(ifx score.run then "Score" else "Levels solved", score.board.primary[:])
    if score.run { unused CopyCString("Level", score.board.average[:]) }
}



LeaderboardNameValid :: (name: string, maximum: s64) -> bool {
    if name.count == 0 || name.count > maximum { return false }
    for byte: name {
        if !((byte >= #char "a" && byte <= #char "z") || (byte >= #char "A" && byte <= #char "Z") ||
            (byte >= #char "0" && byte <= #char "9") || byte == #char "." || byte == #char "_" || byte == #char ":" || byte == #char "-") { return false }
    }
    return true
}

NativeLeaderboardFile :: (output: []u8) -> string {
    directory: [4096]u8
    root := AccountStorePath("leaderboards", directory[:])
    if !NativeDirectory(root) { return "" }
    return NativeJoin(output, root, TextUntilNul(native_leaderboard_owner[:]))
}

NativeLeaderboardSave :: () -> bool {
    out: Vec(u8)
    BuilderPrint(*out, "{\"scores\":[")
    for index: cast(s32)0..native_score_count - 1 {
        score := *native_scores[index]
        BuilderPrint(*out, "%{\"app\":", ifx index > 0 then "," else "")
        EntityQuote(*out, TextUntilNul(score.board.app[:]))
        BuilderPrint(*out, ",\"app_title\":")
        EntityQuote(*out, TextUntilNul(score.board.app_title[:]))
        BuilderPrint(*out, ",\"id\":")
        EntityQuote(*out, TextUntilNul(score.board.id[:]))
        BuilderPrint(*out, ",\"title\":")
        EntityQuote(*out, TextUntilNul(score.board.title[:]))
        BuilderPrint(*out, ",\"value\":%", score.value)
        BuilderPrint(*out, ",\"appearance\":%", score.appearance)
        if score.run { BuilderPrint(*out, ",\"level\":%", score.level) }
        BuilderPrint(*out, "}")
    }
    BuilderPrint(*out, "]}")
    document := BuilderFinish(out)
    defer { EntityFree(document) }
    path: [4096]u8
    name := NativeLeaderboardFile(path[:])
    return name != "" && NativeWrite(name, document)
}

NativeLeaderboardOwner :: () {
    owner := TextUntilNul(account_recovery.keys.public_id[:])
    if owner == "" { owner = "local" }
    node := TextUntilNul(account_profile.nodes[account_profile.preferred][:])
    if owner == TextUntilNul(native_leaderboard_owner[:]) && node == TextUntilNul(native_leaderboard_node[:]) { return }
    CancelRequest(*native_leaderboard_pending)
    HttpTransferCancel(*native_leaderboard_transfer)
    native_leaderboard_session = .{}
    unused CopyCString(owner, native_leaderboard_owner[:])
    unused CopyCString(node, native_leaderboard_node[:])
    native_score_count = 0
    native_scores = .{}
    native_leaderboard_page = .{}
    native_leaderboard_selected = .{}
    native_leaderboard_stage = 0
    native_leaderboard_loaded = false
    native_leaderboard_requested = false
    native_leaderboard_error = false
    native_leaderboard_stats = .{}
    native_leaderboard_friends = .{}
    native_leaderboard_levels = .{}
    native_leaderboard_metric = 0
    native_leaderboard_rows = .{}
    native_leaderboard_row_count = 0
    native_leaderboard_rows_dirty = true
    path: [4096]u8
    name := NativeLeaderboardFile(path[:])
    if name == "" { return }
    buffer: [32768]u8
    if NativeRead(name, buffer[:]) < 1 { return }
    document := TextUntilNul(buffer[:])
    at := FieldAt(document, 0, "scores")
    count := ArrayCount(document, at)
    if count < 0 || count > LEADERBOARD_BOARDS { return }
    for index: cast(s32)0..count - 1 {
        score: NativeGameScore
        item := ElementAt(document, at, index)
        value := ReadNumber(document, FieldAt(document, item, "value"))
        if ReadStringText(document, FieldAt(document, item, "app"), score.board.app[:]) < 1 ||
        ReadStringText(document, FieldAt(document, item, "app_title"), score.board.app_title[:]) < 1 ||
        ReadStringText(document, FieldAt(document, item, "id"), score.board.id[:]) < 1 ||
        ReadStringText(document, FieldAt(document, item, "title"), score.board.title[:]) < 1 ||
        !LeaderboardNameValid(TextUntilNul(score.board.id[:]), 31) ||
        !value.valid || value.value < 0 || value.value > 100000 || value.value != cast(float64)cast(s64)value.value { continue }
        score.value = cast(s64)value.value
        appearance := ReadNumber(document, FieldAt(document, item, "appearance"))
        if appearance.valid && appearance.value >= 1 && appearance.value <= 256 &&
        appearance.value == cast(float64)cast(s32)appearance.value { score.appearance = cast(s32)appearance.value }
        level := ReadNumber(document, FieldAt(document, item, "level"))
        if level.valid && level.value >= 0 && level.value <= 100000 && level.value == cast(float64)cast(s64)level.value {
            score.run = true
            score.level = cast(s64)level.value
        }
        NativeBoardLabels(*score)
        native_scores[native_score_count] = score
        native_score_count += 1
    }
}

// A game reports "levels N" (levels solved) or "run LEVEL SCORE" (its best
// run: the level it reached and its score).
NativeLeaderboardChanged :: (game: string) {
    native_leaderboard_loaded = false
    native_leaderboard_rows_dirty = true
    if TextUntilNul(native_leaderboard_owner[:]) == "local" || leaderboard_installed == null ||
    !leaderboard_installed(game) { return }
    if native_leaderboard_selected[0] == 0 { unused CopyCString(game, native_leaderboard_selected[:]) }
    native_leaderboard_requested = true
}

EntityLeaderboardReport :: (app: string, app_title: string, game: string, title: string, request: string) -> bool {
    if !LeaderboardNameValid(app, 96) || !LeaderboardNameValid(game, 31) { return false }
    cosmetic := request.count > 5 && request[:5] == "skin "
    appearance: s64
    if cosmetic && (!ProfileScoreNumber(request[5:], *appearance) || appearance > 8 ||
        (game != "xyz.waozi.wurm" && game != "wurm")) { return false }
    report: ProfileScore
    if !cosmetic && !ProfileScoreReport(request, *report) { return false }
    value := report.value
    level := report.level
    run := report.run
    NativeLeaderboardOwner()
    index: s32 = -1
    for item: cast(s32)0..native_score_count - 1 {
        if TextUntilNul(native_scores[item].board.id[:]) == game { index = item }
    }
    if index < 0 {
        if native_score_count >= LEADERBOARD_BOARDS { return false }
        index = native_score_count
        native_score_count += 1
    }
    score := *native_scores[index]
    previous := score.*
    if cosmetic {
        if previous.board.id[0] == 0 {
            // A cosmetic cannot install a board or invent a score.
            native_score_count -= 1
            return false
        }
        if score.appearance == cast(s32)appearance + 1 {
            // The game reports once after account reload too, so a saved
            // choice that was offline last time gets another publication.
            NativeLeaderboardChanged(game)
            return true
        }
        score.appearance = cast(s32)appearance + 1
        if NativeLeaderboardSave() { NativeLeaderboardChanged(game); return true }
        score.* = previous
        return false
    }
    if TextUntilNul(score.board.id[:]) == game && score.value == value && score.run == run && score.level == level &&
    TextUntilNul(score.board.title[:]) == title { return true }
    score.value = value
    score.run = run
    score.level = level
    unused CopyCString(app, score.board.app[:])
    unused CopyCString(app_title, score.board.app_title[:])
    unused CopyCString(game, score.board.id[:])
    unused CopyCString(ifx title == "" then game else title, score.board.title[:])
    NativeBoardLabels(score)
    if NativeLeaderboardSave() { NativeLeaderboardChanged(game); return true }
    score.* = previous
    if previous.board.id[0] == cast(u8)0 { native_score_count -= 1 }
    return false
}

NativeLeaderboardStart :: (context: *void, request: HttpRequest, output: []u8) -> bool {
    return HttpTransferStart(*native_leaderboard_transfer, request, output, 15000)
}
NativeLeaderboardPoll :: (context: *void, status: *s32) -> s32 { return HttpTransferPoll(*native_leaderboard_transfer, status) }
NativeLeaderboardCancel :: (context: *void) { HttpTransferCancel(*native_leaderboard_transfer) }

NativeSelectedRun :: () -> bool {
    for index: cast(s32)0..native_score_count - 1 {
        if TextUntilNul(native_scores[index].board.id[:]) == TextUntilNul(native_leaderboard_selected[:]) { return native_scores[index].run }
    }
    return false
}

// A friend's best level on the selected run board, or 0.
NativeLevelOf :: (id: string) -> s64 {
    levels := TextUntilNul(native_leaderboard_levels[:])
    at := FieldAt(levels, 0, "rows")
    for index: cast(s32)0..ArrayCount(levels, at) - 1 {
        item := ElementAt(levels, at, index)
        found: [97]u8
        unused ReadStringText(levels, FieldAt(levels, item, "user_id_hash"), found[:])
        if TextUntilNul(found[:]) != id { continue }
        value := ReadNumber(levels, FieldAt(levels, item, "value"))
        if value.valid && value.value >= 0 && value.value <= 100000 { return cast(s64)value.value }
    }
    return 0
}

NativeLeaderboardRow :: (document: string, at: s32, value: s64, own: bool, run: bool = false, level: s64 = 0) {
    page := *native_leaderboard_page
    if page.row_count >= LEADERBOARD_ROWS { return }
    alias: [49]u8
    id: [97]u8
    unused ReadStringText(document, FieldAt(document, at, "alias"), alias[:])
    unused ReadStringText(document, FieldAt(document, at, "user_id_hash"), id[:])
    if id[0] == cast(u8)0 { unused ReadStringText(document, FieldAt(document, at, "id"), id[:]) }
    row := *page.rows[page.row_count]
    game_icon := ReadNumber(document, FieldAt(document, at, "game_icon"))
    row.game_icon = 0
    if game_icon.valid && game_icon.value >= 1 && game_icon.value <= 256 &&
    game_icon.value == cast(float64)cast(s32)game_icon.value { row.game_icon = cast(s32)game_icon.value }
    icon := ReadNumber(document, FieldAt(document, at, "profile_icon"))
    row.icon = 0
    if icon.valid && icon.value >= 0 && icon.value <= 129 &&
    icon.value == cast(float64)cast(s32)icon.value { row.icon = cast(s32)icon.value }
    if row.icon == 0 {
        friends := TextUntilNul(native_leaderboard_friends[:])
        list := FieldAt(friends, 0, "friends")
        for index: cast(s32)0..ArrayCount(friends, list) - 1 {
            item := ElementAt(friends, list, index)
            friend: [97]u8
            unused ReadStringText(friends, FieldAt(friends, item, "user_id_hash"), friend[:])
            if friend[0] == 0 { unused ReadStringText(friends, FieldAt(friends, item, "id"), friend[:]) }
            if TextUntilNul(friend[:]) != TextUntilNul(id[:]) { continue }
            picture := ReadNumber(friends, FieldAt(friends, item, "profile_icon"))
            if picture.valid && picture.value >= 0 && picture.value <= 129 &&
            picture.value == cast(float64)cast(s32)picture.value { row.icon = cast(s32)picture.value }
            break
        }
    }
    display: Vec(u8)
    if alias[0] != cast(u8)0 { BuilderPrint(*display, "@%", TextUntilNul(alias[:])) }
    else {
        public_id := TextUntilNul(id[:])
        BuilderPrint(*display, "%", ifx public_id.count > 12 then public_id[:12] else public_id)
    }
    text := BuilderFinish(display)
    unused CopyCString(text, row.name[:])
    EntityFree(text)
    digits: [24]u8
    unused CopyCString(FormatInteger(value, digits[:]), row.value[:])
    if run { unused CopyCString(FormatInteger(level, digits[:]), row.average[:]) }
    row.own = own
    page.row_count += 1
}

NativeLeaderboardRows :: () {
    page := *native_leaderboard_page
    if page.selected < 0 { return }
    if !native_leaderboard_rows_dirty {
        page.rows = native_leaderboard_rows
        page.row_count = native_leaderboard_row_count
        return
    }
    selected := TextUntilNul(page.boards[page.selected].id[:])
    own: s64 = 0
    own_level: s64 = 0
    own_appearance: s32 = 0
    run := false
    for index: cast(s32)0..native_score_count - 1 {
        if TextUntilNul(native_scores[index].board.id[:]) == selected {
            own = native_scores[index].value
            own_level = native_scores[index].level
            run = native_scores[index].run
            own_appearance = native_scores[index].appearance
        }
    }
    stats := TextUntilNul(native_leaderboard_stats[:])
    ids: [LEADERBOARD_ROWS][97]u8
    at := FieldAt(stats, 0, "rows")
    count := ArrayCount(stats, at)
    for index: cast(s32)0..count - 1 {
        if page.row_count >= LEADERBOARD_ROWS - 1 { break }
        item := ElementAt(stats, at, index)
        id: [97]u8
        unused ReadStringText(stats, FieldAt(stats, item, "user_id_hash"), id[:])
        if id[0] == cast(u8)0 || TextUntilNul(id[:]) == TextUntilNul(page.owner[:]) { continue }
        duplicate := false
        for prior: cast(s32)0..page.row_count - 1 {
            if TextUntilNul(ids[prior][:]) == TextUntilNul(id[:]) { duplicate = true }
        }
        value := ReadNumber(stats, FieldAt(stats, item, "value"))
        if duplicate || !value.valid || value.value < 0 || value.value > 100000 { continue }
        ids[page.row_count] = id
        NativeLeaderboardRow(stats, item, cast(s64)value.value, false, run, ifx run then NativeLevelOf(TextUntilNul(id[:])) else 0)
    }
    friends := TextUntilNul(native_leaderboard_friends[:])
    at = FieldAt(friends, 0, "friends")
    count = ArrayCount(friends, at)
    for index: cast(s32)0..count - 1 {
        if page.row_count >= LEADERBOARD_ROWS - 1 { break }
        item := ElementAt(friends, at, index)
        id: [97]u8
        unused ReadStringText(friends, FieldAt(friends, item, "user_id_hash"), id[:])
        if id[0] == cast(u8)0 { unused ReadStringText(friends, FieldAt(friends, item, "id"), id[:]) }
        if id[0] == cast(u8)0 || TextUntilNul(id[:]) == TextUntilNul(page.owner[:]) { continue }
        duplicate := false
        for prior: cast(s32)0..page.row_count - 1 {
            if TextUntilNul(ids[prior][:]) == TextUntilNul(id[:]) { duplicate = true }
        }
        if duplicate { continue }
        ids[page.row_count] = id
        NativeLeaderboardRow(friends, item, 0, false, run, ifx run then NativeLevelOf(TextUntilNul(id[:])) else 0)
    }
    row := *page.rows[page.row_count]
    alias := TextUntilNul(account_alias[:])
    display: Vec(u8)
    if alias != "" { BuilderPrint(*display, "@%", alias) }
    else {
        id := TextUntilNul(page.owner[:])
        BuilderPrint(*display, "%", ifx id.count > 12 then id[:12] else id)
    }
    text := BuilderFinish(display)
    unused CopyCString(text, row.name[:])
    EntityFree(text)
    digits: [24]u8
    unused CopyCString(FormatInteger(own, digits[:]), row.value[:])
    if run { unused CopyCString(FormatInteger(own_level, digits[:]), row.average[:]) }
    row.own = true
    row.game_icon = own_appearance
    row.icon = EntityPublicIcon(account_profile)
    page.row_count += 1
    // A run board ranks by the column the player chose.
    by_level := run && native_leaderboard_metric == 1
    for index: cast(s32)1..page.row_count - 1 {
        current := page.rows[index]
        value := ReadNumber(TextUntilNul(ifx by_level then current.average[:] else current.value[:]), 0)
        position := index
        while position > 0 {
            prior := *page.rows[position - 1]
            other := ReadNumber(TextUntilNul(ifx by_level then prior.average[:] else prior.value[:]), 0)
            if other.value >= value.value { break }
            page.rows[position] = prior.*
            position -= 1
        }
        page.rows[position] = current
    }
    native_leaderboard_rows = page.rows
    native_leaderboard_row_count = page.row_count
    native_leaderboard_rows_dirty = false
}

EntityLeaderboardAnswer :: (request: string) -> string {
    NativeLeaderboardOwner()
    page := *native_leaderboard_page
    page.* = .{}
    page.owner = native_leaderboard_owner
    for index: cast(s32)0..native_score_count - 1 {
        score := *native_scores[index]
        if leaderboard_installed == null || !leaderboard_installed(TextUntilNul(score.board.id[:])) { continue }
        page.boards[page.board_count] = score.board
        page.board_count += 1
    }
    page.selected = ProfileBoardFind(page, TextUntilNul(native_leaderboard_selected[:]))
    if page.selected < 0 && page.board_count > 0 { page.selected = 0 }
    owner: [97]u8
    board: [65]u8
    if request == "refresh" { native_leaderboard_loaded = false }
    if ReadStringText(request, FieldAt(request, 0, "owner"), owner[:]) > 0 &&
    TextUntilNul(owner[:]) == TextUntilNul(page.owner[:]) &&
    ReadStringText(request, FieldAt(request, 0, "board"), board[:]) > 0 {
        chosen := ProfileBoardFind(page, TextUntilNul(board[:]))
        if chosen >= 0 { page.selected = chosen }
        metric := ReadNumber(request, FieldAt(request, 0, "metric"))
        if metric.valid && (metric.value == 0 || metric.value == 1) && cast(s32)metric.value != native_leaderboard_metric {
            native_leaderboard_metric = cast(s32)metric.value
            native_leaderboard_rows_dirty = true
        }
    }
    if page.selected >= 0 {
        chosen := page.boards[page.selected].id
        if TextUntilNul(chosen[:]) != TextUntilNul(native_leaderboard_selected[:]) {
            CancelRequest(*native_leaderboard_pending)
            native_leaderboard_stage = 0
            native_leaderboard_selected = chosen
            native_leaderboard_stats = .{}
            native_leaderboard_levels = .{}
            native_leaderboard_metric = 0
            native_leaderboard_loaded = false
            native_leaderboard_rows_dirty = true
            NativeLeaderboardCacheLoad()
        }
        if !native_leaderboard_loaded && native_leaderboard_stage == 0 && TextUntilNul(page.owner[:]) != "local" {
            native_leaderboard_requested = true
        }
        NativeLeaderboardRows()
        for index: cast(s32)0..page.row_count - 1 {
            if page.rows[index].own { page.rows[index].icon = EntityPublicIcon(account_profile) }
        }
    } else {
        CancelRequest(*native_leaderboard_pending)
        native_leaderboard_stage = 0
        native_leaderboard_requested = false
        native_leaderboard_selected = .{}
        native_leaderboard_stats = .{}
    }
    page.loading = native_leaderboard_requested || native_leaderboard_stage != 0
    page.error = native_leaderboard_error
    if page.selected >= 0 && page.boards[page.selected].average[0] != cast(u8)0 { page.metric = native_leaderboard_metric }
    EntityFree(native_leaderboard_answer)
    native_leaderboard_answer = ProfileLeaderboardEncode(page)
    return native_leaderboard_answer
}

EntityLeaderboardPump :: () {
    NativeLeaderboardOwner()
    if native_leaderboard_stage != 0 {
        if !PollRequest(*native_leaderboard_pending) { return }
        valid := native_leaderboard_pending.result == cast(Auth.AuthResult)Auth.AuthResult.AUTH_OK && native_leaderboard_pending.status == 200
        if valid && native_leaderboard_stage >= 2 {
            document := TextUntilNul(native_leaderboard_response[:])
            end := ValueEnd(document, Space(document, 0), 0)
            key := ifx native_leaderboard_stage == 2 then "friends" else "rows"
            count := ArrayCount(document, FieldAt(document, 0, key))
            valid = end >= 0 && Space(document, end) == document.count && count >= 0 && count <= LEADERBOARD_ROWS
        }
        native_leaderboard_error = native_leaderboard_error || !valid
        if native_leaderboard_stage == 2 && valid { native_leaderboard_friends = native_leaderboard_response }
        if native_leaderboard_stage == 3 && valid { native_leaderboard_stats = native_leaderboard_response }
        if native_leaderboard_stage == 4 && valid { native_leaderboard_levels = native_leaderboard_response }
        if native_leaderboard_stage == 4 || (native_leaderboard_stage == 3 && !NativeSelectedRun()) {
            native_leaderboard_rows_dirty = true
            if valid && !native_leaderboard_error { NativeLeaderboardCacheSave() }
            native_leaderboard_stage = 0
            // A score or skin changed while this request was in flight.
            // Keep its queued publication for the next pump.
            native_leaderboard_loaded = !native_leaderboard_requested
            return
        }
        native_leaderboard_stage += 1
    } else {
        if !native_leaderboard_requested { return }
        native_leaderboard_requested = false
        native_leaderboard_error = false
        native_leaderboard_stage = 1
    }
    client: Client
    if !AccountStoreClient(null, *client) {
        native_leaderboard_stage = 0
        native_leaderboard_loaded = true
        native_leaderboard_error = true
        return
    }
    EntityFree(native_leaderboard_body)
    native_leaderboard_body = ""
    path: string
    if native_leaderboard_stage == 1 {
        now := LocalNow()
        date := now.year * 10000 + now.month * 100 + now.day
        out: Vec(u8)
        BuilderPrint(*out, "{\"app\":\"inbe\",\"metrics\":[")
        count: s32 = 0
        for index: cast(s32)0..native_score_count - 1 {
            score := *native_scores[index]
            if leaderboard_installed == null || !leaderboard_installed(TextUntilNul(score.board.id[:])) { continue }
            if score.run {
                BuilderPrint(*out, "%{\"practice\":\"%\",\"metric\":\"score\",\"value\":%,\"label\":\"%\",\"local_date\":%}",
                    ifx count > 0 then "," else "", TextUntilNul(score.board.id[:]), score.value, score.value, date)
                BuilderPrint(*out, ",{\"practice\":\"%\",\"metric\":\"level\",\"value\":%,\"label\":\"%\",\"local_date\":%}",
                    TextUntilNul(score.board.id[:]), score.level, score.level, date)
            } else {
                BuilderPrint(*out, "%{\"practice\":\"%\",\"metric\":\"levels\",\"value\":%,\"label\":\"%\",\"local_date\":%}",
                    ifx count > 0 then "," else "", TextUntilNul(score.board.id[:]), score.value, score.value, date)
            }
            count += 1
            if score.appearance > 0 && score.appearance <= 256 {
                BuilderPrint(*out, ",{\"practice\":\"%\",\"metric\":\"appearance\",\"value\":%,\"local_date\":%}",
                    TextUntilNul(score.board.id[:]), score.appearance, date)
            }
        }
        BuilderPrint(*out, "]}")
        native_leaderboard_body = BuilderFinish(out)
        path = "/api/v1/profile/stats"
    } else if native_leaderboard_stage == 2 {
        path = "/api/v1/friends"
    } else {
        metric := ifx native_leaderboard_stage == 4 then "level" else ifx NativeSelectedRun() then "score" else "levels"
        if !BuildFriendStatsPath("inbe", TextUntilNul(native_leaderboard_selected[:]), metric, native_leaderboard_path[:]) {
            native_leaderboard_stage = 0
            native_leaderboard_loaded = true
            native_leaderboard_error = true
            return
        }
        path = TextUntilNul(native_leaderboard_path[:])
    }
    headers: [0]HttpHeader
    transport := leaderboard_transport
    if transport.start == null {
        transport = AsyncTransport.{.start = NativeLeaderboardStart, .poll = NativeLeaderboardPoll, .cancel = NativeLeaderboardCancel}
    }
    native_leaderboard_response = .{}
    if !BeginRequest(*native_leaderboard_pending, client, *native_leaderboard_session, UnixNow(), transport,
        ifx native_leaderboard_stage == 1 then "PUT" else "GET", path, native_leaderboard_body, native_leaderboard_response[:], headers[:]) {
        native_leaderboard_stage = 0
        native_leaderboard_loaded = true
        native_leaderboard_error = true
    }
}


// Last complete ranking inputs, scoped to the node, account and board. A
// background refresh never replaces these with a partial/failed response.
NativeLeaderboardCachePath :: (output: []u8) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "%\n%\n%", TextUntilNul(native_leaderboard_node[:]), TextUntilNul(native_leaderboard_owner[:]), TextUntilNul(native_leaderboard_selected[:]))
    text := BuilderFinish(out)
    defer { EntityFree(text) }
    digest: [65]u8
    bytes := cast(*TextDescriptor)(*text)
    Sha256Hex(bytes.data, text.count, *digest[0])
    folder: [4096]u8
    directory := AccountStorePath("leaderboards", folder[:])
    if !NativeDirectory(directory) { return "" }
    name: Vec(u8)
    BuilderPrint(*name, "cache.%.json", TextUntilNul(digest[:]))
    filename := BuilderFinish(name)
    defer { EntityFree(filename) }
    return NativeJoin(output, directory, filename)
}
NativeLeaderboardCacheSave :: () {
    out: Vec(u8)
    BuilderPrint(*out, "{\"friends\":%,\"stats\":%,\"levels\":%}",
        ifx native_leaderboard_friends[0] != 0 then TextUntilNul(native_leaderboard_friends[:]) else "{\"friends\":[]}",
        ifx native_leaderboard_stats[0] != 0 then TextUntilNul(native_leaderboard_stats[:]) else "{\"rows\":[]}",
        ifx native_leaderboard_levels[0] != 0 then TextUntilNul(native_leaderboard_levels[:]) else "{\"rows\":[]}")
    document := BuilderFinish(out)
    defer { EntityFree(document) }
    path: [4096]u8
    unused NativeWrite(NativeLeaderboardCachePath(path[:]), document)
}
NativeLeaderboardCachePart :: (document: string, name: string, array: string, output: []u8) -> bool {
    at := FieldAt(document, 0, name)
    end := ValueEnd(document, at, 0)
    if at < 0 || end <= at { return false }
    data := document[at:end]
    count := ArrayCount(data, FieldAt(data, 0, array))
    return count >= 0 && count <= LEADERBOARD_ROWS && CopyCString(data, output)
}
NativeLeaderboardCacheLoad :: () {
    path: [4096]u8
    buffer: [65536]u8
    if NativeRead(NativeLeaderboardCachePath(path[:]), buffer[:]) <= 0 { return }
    document := TextUntilNul(buffer[:])
    if Space(document, ValueEnd(document, 0, 0)) != document.count { return }
    friends: [16384]u8
    stats: [16384]u8
    levels: [16384]u8
    if !NativeLeaderboardCachePart(document, "friends", "friends", friends[:]) ||
    !NativeLeaderboardCachePart(document, "stats", "rows", stats[:]) ||
    !NativeLeaderboardCachePart(document, "levels", "rows", levels[:]) { return }
    native_leaderboard_friends = friends
    native_leaderboard_stats = stats
    native_leaderboard_levels = levels
}
