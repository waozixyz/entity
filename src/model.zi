// Self's public document contains profile preferences, never account keys.
// Hosts map it to their existing storage and provide their own extension routes.
#import "std/c_string"
#import "std/byte_text_linux"
#import "std/text"
#import "std/text_buffer"
#import "std/vec"
Json :: #import "std/json_scan";
#import "node_url"

SELF_IDENTITY :: 1
SELF_INTENTION :: 2
SELF_APPEARANCE :: 4
SELF_ACCENT :: 8
SELF_WIDGETS :: 16
SELF_NODES :: 32
SELF_NODE_LIMIT :: 8
SELF_EXTENSION_LIMIT :: 8
SELF_DEFAULT_NODE :: "https://api.waozi.xyz"

SelfExtension :: struct {
    id: [40]u8
    label: [128]u8
    summary: [256]u8
    badge: [64]u8
    icon: [32]u8
}

SelfState :: struct {
    owner_id: [65]u8
    name: [64]u8
    intention: [128]u8
    picture: s32
    pictures: s32
    theme: s32
    accent: s32
    material: bool
    controls: s32
    nodes: [SELF_NODE_LIMIT][256]u8
    node_count: s32
    preferred: s32
    extensions: [SELF_EXTENSION_LIMIT]SelfExtension
    extension_count: s32
}

SelfDefault :: () -> SelfState {
    state := SelfState.{.material = true,
        .pictures = 268435455,
        .controls = SELF_IDENTITY | SELF_NODES,
        .node_count = 1}
    unused CopyCString(SELF_DEFAULT_NODE, state.nodes[0][:])
    return state
}

SelfFree :: (text: string) {
    if text.count == 0 { return }
    descriptor := cast(*TextDescriptor)(*text)
    FreeBytes(descriptor.data)
}
libc :: #system_library "libc";
FreeBytes :: (bytes: *u8) #foreign libc "free";

SelfQuote :: (out: *Vec(u8), text: string) {
    BuilderPrint(out, "\"")
    for byte: text {
        if byte == cast(u8)34 { BuilderPrint(out, "\\\"") }
        else if byte == cast(u8)92 { BuilderPrint(out, "\\\\") }
        else if byte == cast(u8)10 { BuilderPrint(out, "\\n") }
        else if byte == cast(u8)13 { BuilderPrint(out, "\\r") }
        else if byte == cast(u8)9 { BuilderPrint(out, "\\t") }
        else if byte >= cast(u8)32 {
            bytes: [1]u8 = .[byte]
            BuilderPrint(out, "%", TextView(bytes[:]))
        }
    }
    BuilderPrint(out, "\"")
}

SelfEncode :: (state: SelfState) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "{\"version\":1,\"owner_id\":")
    SelfQuote(*out, TextUntilNul(state.owner_id[:]))
    BuilderPrint(*out, ",\"name\":")
    SelfQuote(*out, TextUntilNul(state.name[:]))
    BuilderPrint(*out, ",\"intention\":")
    SelfQuote(*out, TextUntilNul(state.intention[:]))
    BuilderPrint(*out, ",\"picture\":%,\"pictures\":%,\"theme\":%,\"accent\":%,\"material\":%,\"controls\":%,\"preferred\":%,\"nodes\":[",
        state.picture, state.pictures, state.theme, state.accent, ifx state.material then 1 else 0, state.controls, state.preferred)
    for index: 0..state.node_count - 1 {
        if index > 0 { BuilderPrint(*out, ",") }
        SelfQuote(*out, TextUntilNul(state.nodes[index][:]))
    }
    BuilderPrint(*out, "],\"extensions\":[")
    for index: 0..state.extension_count - 1 {
        if index > 0 { BuilderPrint(*out, ",") }
        BuilderPrint(*out, "{\"id\":")
        SelfQuote(*out, TextUntilNul(state.extensions[index].id[:]))
        BuilderPrint(*out, ",\"label\":")
        SelfQuote(*out, TextUntilNul(state.extensions[index].label[:]))
        BuilderPrint(*out, ",\"summary\":")
        SelfQuote(*out, TextUntilNul(state.extensions[index].summary[:]))
        BuilderPrint(*out, ",\"badge\":")
        SelfQuote(*out, TextUntilNul(state.extensions[index].badge[:]))
        BuilderPrint(*out, ",\"icon\":")
        SelfQuote(*out, TextUntilNul(state.extensions[index].icon[:]))
        BuilderPrint(*out, "}")
    }
    BuilderPrint(*out, "]}")
    return BuilderFinish(out)
}

SelfNumber :: (text: string, at: s32, minimum: s32, maximum: s32) -> s32 {
    number := Json.ReadNumber(text, at)
    value := cast(s32)number.value
    if !number.valid || number.value != cast(float64)value || value < minimum || value > maximum {
        return -1
    }
    return value
}

SelfDecode :: (text: string, output: *SelfState) -> bool {
    if text.count == 0 || text.count > 16384 { return false }
    end := Json.ValueEnd(text, Json.Space(text, 0), 0)
    if end < 0 || Json.Space(text, end) != text.count { return false }
    keys: [11]string = .["version", "name", "intention", "picture", "theme", "accent", "material", "controls", "preferred", "nodes", "extensions"]
    at: [11]s32
    if !Json.ObjectPositions(text, 0, keys[:], at[:]) || SelfNumber(text, at[0], 1, 1) != 1 {
        return false
    }
    state: SelfState
    owner_at := Json.FieldAt(text, 0, "owner_id")
    if owner_at >= 0 && Json.ReadStringText(text, owner_at, state.owner_id[:]) < 0 { return false }
    if state.owner_id[0] != cast(u8)0 {
        owner := TextUntilNul(state.owner_id[:])
        if owner.count != 64 { return false }
        for byte: owner {
            if !((byte >= cast(u8)48 && byte <= cast(u8)57) || (byte >= cast(u8)97 && byte <= cast(u8)102)) { return false }
        }
    }
    if Json.ReadStringText(text, at[1], state.name[:]) < 0 ||
    Json.ReadStringText(text, at[2], state.intention[:]) < 0 { return false }
    state.picture = SelfNumber(text, at[3], 0, 27)
    if state.picture < 0 { return false }
    picture_keys: [1]string = .["pictures"]
    picture_at: [1]s32
    unused Json.ObjectPositions(text, 0, picture_keys[:], picture_at[:])
    state.pictures = ifx picture_at[0] < 0 then 268435455 else SelfNumber(text, picture_at[0], 1, 268435455)
    if state.pictures < 1 || (state.pictures & (1 << state.picture)) == 0 { return false }
    state.theme = SelfNumber(text, at[4], 0, 2)
    state.accent = SelfNumber(text, at[5], 0, 15)
    material := SelfNumber(text, at[6], 0, 1)
    state.controls = SelfNumber(text, at[7], 0, 63)
    state.preferred = SelfNumber(text, at[8], 0, SELF_NODE_LIMIT - 1)
    if state.picture < 0 || state.theme < 0 || state.accent < 0 || material < 0 || state.controls < 0 || state.preferred < 0 { return false }
    state.material = material == 1
    positions: [SELF_NODE_LIMIT]s32
    state.node_count = Json.ArrayPositions(text, at[9], positions[:])
    if state.node_count < 1 || state.node_count > SELF_NODE_LIMIT || state.preferred >= state.node_count { return false }
    for index: 0..state.node_count - 1 {
        value: [256]u8
        if Json.ReadStringText(text, positions[index], value[:]) <= 0 { return false }
        normalized := NodeOrigin(TextUntilNul(value[:]))
        if normalized == "" || !CopyCString(normalized, state.nodes[index][:]) { return false }
        for previous: 0..index - 1 {
            if TextUntilNul(state.nodes[previous][:]) == normalized { return false }
        }
    }
    extensions: [SELF_EXTENSION_LIMIT]s32
    state.extension_count = Json.ArrayPositions(text, at[10], extensions[:])
    if state.extension_count < 0 || state.extension_count > SELF_EXTENSION_LIMIT { return false }
    for index: 0..state.extension_count - 1 {
        fields: [2]string = .["id", "label"]
        offsets: [2]s32
        if !Json.ObjectPositions(text, extensions[index], fields[:], offsets[:]) ||
        Json.ReadStringText(text, offsets[0], state.extensions[index].id[:]) <= 0 ||
        Json.ReadStringText(text, offsets[1], state.extensions[index].label[:]) <= 0 { return false }
        extra: [3]string = .["summary", "badge", "icon"]
        extra_at: [3]s32
        unused Json.ObjectPositions(text, extensions[index], extra[:], extra_at[:])
        if extra_at[0] >= 0 && Json.ReadStringText(text, extra_at[0], state.extensions[index].summary[:]) < 0 { return false }
        if extra_at[1] >= 0 && Json.ReadStringText(text, extra_at[1], state.extensions[index].badge[:]) < 0 { return false }
        if extra_at[2] >= 0 && Json.ReadStringText(text, extra_at[2], state.extensions[index].icon[:]) < 0 { return false }
        for previous: 0..index - 1 {
            if TextUntilNul(state.extensions[index].id[:]) == TextUntilNul(state.extensions[previous].id[:]) { return false }
        }
    }
    output.* = state
    return true
}

SelfAddExtension :: (state: *SelfState, id: string, label: string) {
    if state.extension_count >= SELF_EXTENSION_LIMIT { return }
    entry := *state.extensions[state.extension_count]
    if CopyCString(id, entry.id[:]) && CopyCString(label, entry.label[:]) {
        state.extension_count += 1
    }
}

SelfDescribeExtension :: (state: *SelfState, id: string, summary: string, badge: string, icon: string) -> bool {
    for index: 0..state.extension_count - 1 {
        entry := state.extensions[index]
        if TextUntilNul(entry.id[:]) != id { continue }
        if !CopyCString(summary, entry.summary[:]) || !CopyCString(badge, entry.badge[:]) || !CopyCString(icon, entry.icon[:]) { return false }
        state.extensions[index] = entry
        return true
    }
    return false
}
