// Entity's public document contains profile preferences, never account keys.
// Hosts map it to their existing storage and provide their own extension routes.
#import "std/c_string"
#import "std/byte_text_linux"
#import "std/text"
#import "std/text_buffer"
#import "std/vec"
Json :: #import "std/json_scan";
#import "node_url"

ENTITY_IDENTITY :: 1
ENTITY_INTENTION :: 2
ENTITY_APPEARANCE :: 4
ENTITY_ACCENT :: 8
ENTITY_WIDGETS :: 16
ENTITY_NODES :: 32
ENTITY_NODE_LIMIT :: 8
ENTITY_EXTENSION_LIMIT :: 8
ENTITY_DEFAULT_NODE :: "https://api.waozi.xyz"
PROFILE_DEW :: 1
PROFILE_FRIENDS :: 2
PROFILE_LEADERBOARD :: 4
PROFILE_ACHIEVEMENTS :: 8
PROFILE_APPEARANCE :: 16

// New account IDs carry fresh cryptographic randomness. Derive the initial
// picture from that ID once, so reconnecting never rerolls a chosen picture.
EntityInitialPicture :: (owner: string, allowed: s32) -> s32 {
    count: s32
    for index: 0..27 {
        if (allowed & (1 << cast(s32)index)) != 0 { count += 1 }
    }
    if count == 0 || owner.count != 64 { return 0 }
    hash: u64 = 2166136261
    for byte: owner { hash = ((hash ^ cast(u64)byte) * 16777619) & 4294967295 }
    choice := cast(s32)(hash % cast(u64)count)
    for index: 0..27 {
        if (allowed & (1 << cast(s32)index)) == 0 { continue }
        if choice == 0 { return cast(s32)index }
        choice -= 1
    }
    return 0
}

EntityExtension :: struct {
    id: [40]u8
    label: [128]u8
    summary: [256]u8
    badge: [64]u8
    icon: [32]u8
}

EntityState :: struct {
    owner_id: [65]u8
    name: [64]u8
    intention: [128]u8
    picture: s32
    // Classic icon, abstract artwork, or the account's 3D avatar.
    picture_kind: s32
    abstract_picture: s32
    pictures: s32
    theme: s32
    accent: s32
    material: bool
    host_navigation: bool
    controls: s32
    profile_sections: s32
    // Host capability: games keep Dew without storage controls.
    show_storage: bool
    nodes: [ENTITY_NODE_LIMIT][256]u8
    node_count: s32
    preferred: s32
    extensions: [ENTITY_EXTENSION_LIMIT]EntityExtension
    extension_count: s32
}

EntityDefault :: () -> EntityState {
    state := EntityState.{.material = true,
        .pictures = 268435455,
        .controls = ENTITY_IDENTITY | ENTITY_NODES,
        .profile_sections = 31,
        .show_storage = true,
        .node_count = 1}
    unused CopyCString(ENTITY_DEFAULT_NODE, state.nodes[0][:])
    return state
}

EntityFree :: (text: string) {
    if text.count == 0 { return }
    descriptor := cast(*TextDescriptor)(*text)
    FreeBytes(descriptor.data)
}
libc :: #system_library "libc";
FreeBytes :: (bytes: *u8) #foreign libc "free";

EntityQuote :: (out: *Vec(u8), text: string) {
    BuilderPrint(out, "\"")
    for byte: text {
        if byte == cast(u8)34 { BuilderPrint(out, "\\\"") }
        else if byte == cast(u8)92 { BuilderPrint(out, "\\\\") }
        else if byte == cast(u8)10 { BuilderPrint(out, "\\n") }
        else if byte == cast(u8)13 { BuilderPrint(out, "\\r") }
        else if byte == cast(u8)9 { BuilderPrint(out, "\\t") }
        else if byte >= cast(u8)32 {
            bytes: [1]u8 = .[byte]
            BuilderPrint(out, "%", TextView(bytes[:]))
        }
    }
    BuilderPrint(out, "\"")
}

EntityEncode :: (state: EntityState) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "{\"version\":1,\"owner_id\":")
    EntityQuote(*out, TextUntilNul(state.owner_id[:]))
    BuilderPrint(*out, ",\"name\":")
    EntityQuote(*out, TextUntilNul(state.name[:]))
    BuilderPrint(*out, ",\"intention\":")
    EntityQuote(*out, TextUntilNul(state.intention[:]))
    BuilderPrint(*out, ",\"picture_kind\":%,\"abstract_picture\":%", state.picture_kind, state.abstract_picture)
    BuilderPrint(*out, ",\"host_navigation\":%", ifx state.host_navigation then 1 else 0)
    BuilderPrint(*out, ",\"profile_sections\":%", state.profile_sections)
    BuilderPrint(*out, ",\"show_storage\":%", ifx state.show_storage then 1 else 0)
    BuilderPrint(*out, ",\"picture\":%,\"pictures\":%,\"theme\":%,\"accent\":%,\"material\":%,\"controls\":%,\"preferred\":%,\"nodes\":[",
        state.picture, state.pictures, state.theme, state.accent, ifx state.material then 1 else 0, state.controls, state.preferred)
    for index: 0..state.node_count - 1 {
        if index > 0 { BuilderPrint(*out, ",") }
        EntityQuote(*out, TextUntilNul(state.nodes[index][:]))
    }
    BuilderPrint(*out, "],\"extensions\":[")
    for index: 0..state.extension_count - 1 {
        if index > 0 { BuilderPrint(*out, ",") }
        BuilderPrint(*out, "{\"id\":")
        EntityQuote(*out, TextUntilNul(state.extensions[index].id[:]))
        BuilderPrint(*out, ",\"label\":")
        EntityQuote(*out, TextUntilNul(state.extensions[index].label[:]))
        BuilderPrint(*out, ",\"summary\":")
        EntityQuote(*out, TextUntilNul(state.extensions[index].summary[:]))
        BuilderPrint(*out, ",\"badge\":")
        EntityQuote(*out, TextUntilNul(state.extensions[index].badge[:]))
        BuilderPrint(*out, ",\"icon\":")
        EntityQuote(*out, TextUntilNul(state.extensions[index].icon[:]))
        BuilderPrint(*out, "}")
    }
    BuilderPrint(*out, "]}")
    return BuilderFinish(out)
}

EntityNumber :: (text: string, at: s32, minimum: s32, maximum: s32) -> s32 {
    number := Json.ReadNumber(text, at)
    value := cast(s32)number.value
    if !number.valid || number.value != cast(float64)value || value < minimum || value > maximum {
        return -1
    }
    return value
}

EntityDecode :: (text: string, output: *EntityState) -> bool {
    if text.count == 0 || text.count > 16384 { return false }
    end := Json.ValueEnd(text, Json.Space(text, 0), 0)
    if end < 0 || Json.Space(text, end) != text.count { return false }
    keys: [11]string = .["version", "name", "intention", "picture", "theme", "accent", "material", "controls", "preferred", "nodes", "extensions"]
    at: [11]s32
    if !Json.ObjectPositions(text, 0, keys[:], at[:]) || EntityNumber(text, at[0], 1, 1) != 1 {
        return false
    }
    state: EntityState
    navigation_at := Json.FieldAt(text, 0, "host_navigation")
    navigation := ifx navigation_at < 0 then 0 else EntityNumber(text, navigation_at, 0, 1)
    if navigation < 0 { return false }
    state.host_navigation = navigation == 1
    owner_at := Json.FieldAt(text, 0, "owner_id")
    if owner_at >= 0 && Json.ReadStringText(text, owner_at, state.owner_id[:]) < 0 { return false }
    if state.owner_id[0] != cast(u8)0 {
        owner := TextUntilNul(state.owner_id[:])
        if owner.count != 64 { return false }
        for byte: owner {
            if !((byte >= cast(u8)48 && byte <= cast(u8)57) || (byte >= cast(u8)97 && byte <= cast(u8)102)) { return false }
        }
    }
    if Json.ReadStringText(text, at[1], state.name[:]) < 0 ||
    Json.ReadStringText(text, at[2], state.intention[:]) < 0 { return false }
    state.picture = EntityNumber(text, at[3], 0, 27)
    sections_at := Json.FieldAt(text, 0, "profile_sections")
    state.profile_sections = ifx sections_at < 0 then 31 else EntityNumber(text, sections_at, 0, 31)
    if state.profile_sections < 0 { return false }
    storage_at := Json.FieldAt(text, 0, "show_storage")
    storage := ifx storage_at < 0 then 1 else EntityNumber(text, storage_at, 0, 1)
    if storage < 0 { return false }
    state.show_storage = storage == 1
    if state.picture < 0 { return false }
    kind_at := Json.FieldAt(text, 0, "picture_kind")
    abstract_at := Json.FieldAt(text, 0, "abstract_picture")
    state.picture_kind = ifx kind_at < 0 then 0 else EntityNumber(text, kind_at, 0, 2)
    state.abstract_picture = ifx abstract_at < 0 then 0 else EntityNumber(text, abstract_at, 0, 2)
    if state.picture_kind < 0 || state.abstract_picture < 0 { return false }
    picture_keys: [1]string = .["pictures"]
    picture_at: [1]s32
    unused Json.ObjectPositions(text, 0, picture_keys[:], picture_at[:])
    state.pictures = ifx picture_at[0] < 0 then 268435455 else EntityNumber(text, picture_at[0], 1, 268435455)
    if state.pictures < 1 || (state.pictures & (1 << state.picture)) == 0 { return false }
    state.theme = EntityNumber(text, at[4], 0, 2)
    state.accent = EntityNumber(text, at[5], 0, 15)
    material := EntityNumber(text, at[6], 0, 1)
    state.controls = EntityNumber(text, at[7], 0, 63)
    state.preferred = EntityNumber(text, at[8], 0, ENTITY_NODE_LIMIT - 1)
    if state.picture < 0 || state.theme < 0 || state.accent < 0 || material < 0 || state.controls < 0 || state.preferred < 0 { return false }
    state.material = material == 1
    positions: [ENTITY_NODE_LIMIT]s32
    state.node_count = Json.ArrayPositions(text, at[9], positions[:])
    if state.node_count < 1 || state.node_count > ENTITY_NODE_LIMIT || state.preferred >= state.node_count { return false }
    for index: 0..state.node_count - 1 {
        value: [256]u8
        if Json.ReadStringText(text, positions[index], value[:]) <= 0 { return false }
        normalized := NodeOrigin(TextUntilNul(value[:]))
        if normalized == "" || !CopyCString(normalized, state.nodes[index][:]) { return false }
        for previous: 0..index - 1 {
            if TextUntilNul(state.nodes[previous][:]) == normalized { return false }
        }
    }
    extensions: [ENTITY_EXTENSION_LIMIT]s32
    state.extension_count = Json.ArrayPositions(text, at[10], extensions[:])
    if state.extension_count < 0 || state.extension_count > ENTITY_EXTENSION_LIMIT { return false }
    for index: 0..state.extension_count - 1 {
        fields: [2]string = .["id", "label"]
        offsets: [2]s32
        if !Json.ObjectPositions(text, extensions[index], fields[:], offsets[:]) ||
        Json.ReadStringText(text, offsets[0], state.extensions[index].id[:]) <= 0 ||
        Json.ReadStringText(text, offsets[1], state.extensions[index].label[:]) <= 0 { return false }
        extra: [3]string = .["summary", "badge", "icon"]
        extra_at: [3]s32
        unused Json.ObjectPositions(text, extensions[index], extra[:], extra_at[:])
        if extra_at[0] >= 0 && Json.ReadStringText(text, extra_at[0], state.extensions[index].summary[:]) < 0 { return false }
        if extra_at[1] >= 0 && Json.ReadStringText(text, extra_at[1], state.extensions[index].badge[:]) < 0 { return false }
        if extra_at[2] >= 0 && Json.ReadStringText(text, extra_at[2], state.extensions[index].icon[:]) < 0 { return false }
        for previous: 0..index - 1 {
            if TextUntilNul(state.extensions[index].id[:]) == TextUntilNul(state.extensions[previous].id[:]) { return false }
        }
    }
    output.* = state
    return true
}

EntityAddExtension :: (state: *EntityState, id: string, label: string) {
    if state.extension_count >= ENTITY_EXTENSION_LIMIT { return }
    entry := *state.extensions[state.extension_count]
    if CopyCString(id, entry.id[:]) && CopyCString(label, entry.label[:]) {
        state.extension_count += 1
    }
}

EntityDescribeExtension :: (state: *EntityState, id: string, summary: string, badge: string, icon: string) -> bool {
    for index: 0..state.extension_count - 1 {
        entry := state.extensions[index]
        if TextUntilNul(entry.id[:]) != id { continue }
        if !CopyCString(summary, entry.summary[:]) || !CopyCString(badge, entry.badge[:]) || !CopyCString(icon, entry.icon[:]) { return false }
        state.extensions[index] = entry
        return true
    }
    return false
}

// Public node icons retain the same image across legacy and current clients.
// Zero means no public choice; it must not invent a bamboo picture.
EntityPictureFromPublicIcon :: (icon: s32) -> s32 {
    if icon >= 41 && icon <= 65 { return icon - 41 }
    if icon >= 124 && icon <= 126 { return icon - 124 + 25 }
    legacy: [12]s32 = .[-1, 1, 2, 5, 12, 13, 14, 21, 22, 23, 24, 24]
    if icon >= 0 && icon < 12 { return legacy[icon] }
    return -1
}

EntityAbstractFromPublicIcon :: (icon: s32) -> s32 {
    return ifx icon >= 127 && icon <= 129 then icon - 127 else -1
}

EntityAbstractPictureAsset :: (index: s32) -> string {
    names: [3]string = .["assets/entity/abstract-jade.png", "assets/entity/abstract-amber.png", "assets/entity/abstract-violet.png"]
    return names[index]
}

EntityPublicIcon :: (state: EntityState) -> s32 {
    if state.picture_kind == 1 { return 127 + state.abstract_picture }
    return ifx state.picture < 25 then state.picture + 41 else state.picture - 25 + 124
}
